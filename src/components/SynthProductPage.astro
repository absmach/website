---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import FAQAccordion from "./FAQAccordion.astro";
import SynthLogo from "./SynthLogo.astro";
import {
  ArrowRight,
  Check,
  CircuitBoard,
  CircleAlert,
  GitBranch,
  LockKeyhole,
  Search,
  Sparkles,
} from "@lucide/astro";

const edition = "Community + Enterprise";
const faqs = [
  {
    q: "What is Synth?",
    a: "Synth is an open-source AI-assisted PCB design workspace. It helps turn requirements into schematics, component choices, placement, routing suggestions, and reviewable KiCad-ready work—while keeping the engineer in control of the design.",
  },
  {
    q: "What is the difference between Synth Community and Synth EE?",
    a: "They are two editions of the same Synth product, and both can connect to LLMs. Community is the open-source starting point for individuals and teams. Synth EE is the managed SaaS edition, adding a custom agent harness, MCP tools, access to world-model and EBM capabilities, MCTS-style simulation tools, organisation-wide governance, and support for teams shipping sensitive hardware.",
  },
  {
    q: "Can Synth work with existing EDA tools?",
    a: "Yes. Synth is designed around open, inspectable project artifacts and can fit alongside KiCad and other ECAD tools. The goal is to accelerate design work without hiding the source files engineers need to verify and ship.",
  },
  {
    q: "What does Synth EE include?",
    a: "Synth EE is delivered as SaaS. It includes the Synth workflow and LLM access, plus a custom agent harness, MCP tools, world-model and EBM access, and MCTS-style simulation capabilities for more advanced PCB design tasks.",
  },
];

const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map(({ q, a }) => ({
    "@type": "Question",
    name: q,
    acceptedAnswer: { "@type": "Answer", text: a },
  })),
});

const features = [
  {
    icon: CircuitBoard,
    title: "Design from intent",
    desc: "Start with a board brief or an existing KiCad project. Synth keeps requirements, interfaces, constraints, and design decisions connected to the board.",
  },
  {
    icon: Search,
    title: "Parts with context",
    desc: "Compare component options against availability, electrical requirements, package constraints, and the role each part plays in the circuit.",
  },
  {
    icon: GitBranch,
    title: "Placement and routing you can review",
    desc: "Generate candidates, inspect the affected nets, and see what changed. The result is a design conversation—not a black-box export.",
  },
  {
    icon: Sparkles,
    title: "Model-flexible and open",
    desc: "Use the right model for the task. Synth keeps project artifacts inspectable and the workflow portable across providers and deployments.",
  },
];

const comparison = [
  [
    "Primary workflow",
    "Requirements → schematic → board",
    "Agent operates EDA tools",
    "AI schematic + routing workspace",
    "Automated placement + routing",
  ],
  [
    "KiCad fit",
    "Open project artifacts + guided flow",
    "Shown operating KiCad",
    "KiCad supported in cloud flow",
    "KiCad import / export",
  ],
  [
    "Routing approach",
    "Constraint-aware candidates + review",
    "Prompt-led computer use",
    "AI auto-layout + DRC",
    "Physics-driven optimization",
  ],
  [
    "Design traceability",
    "Requirements, nets, parts, changes",
    "Session and tool trace",
    "Workspace history",
    "Candidate layouts + checks",
  ],
  [
    "Deployment model",
    "Open source / private / self-hosted",
    "Provider-controlled model",
    "Cloud platform",
    "Cloud service",
  ],
  [
    "Best fit",
    "Repeatable, inspectable engineering work",
    "Fast visual prototyping",
    "Integrated cloud EDA",
    "Offloading layout work",
  ],
];

const heroLabel = "Synth · AI-assisted PCB design";
const heroTitle = "From circuit intent to a board you can review.";
const heroDesc =
  "Turn requirements into schematics, component choices, placement, and routing suggestions—then inspect every decision in the tools engineers already use. Both editions connect to LLMs; Synth EE adds a deeper agent and simulation toolchain.";
---

<BaseLayout
  title="Synth — AI-Assisted PCB Design | Abstract Machines"
  description={heroDesc}
  ogImageAlt={`Synth ${edition}`}
>
  <Header />
  <main class="synth-page">
    <section class="synth-hero">
      <div class="container-wide synth-hero-grid">
        <div class="synth-hero-copy">
          <div class="synth-wordmark">
            <SynthLogo /><span class="synth-edition">{edition}</span>
          </div>
          <p class="kicker">{heroLabel}</p>
          <h1>{heroTitle}</h1>
          <p class="lede">{heroDesc}</p>
          <div class="btn-row" style="margin-top:32px;">
            <a
              href="https://github.com/absmach/synth"
              class="btn btn-primary"
              target="_blank"
              rel="noopener">Explore Synth on GitHub <ArrowRight size={16} /></a
            >
            <a href="#editions" class="btn">Compare editions</a>
          </div>
          <div class="synth-hero-notes">
            <span><Check size={14} /> Constraint-aware</span><span
              ><Check size={14} /> Open source</span
            ><span><Check size={14} /> Agent-ready</span>
          </div>
        </div>
        <div
          class="document-stage"
          aria-label="Synth design intelligence illustration"
        >
          <div class="stage-topbar">
            <span class="window-dots"><i></i><i></i><i></i></span><span
              class="stage-path">SYNTH / DESIGN INTELLIGENCE</span
            ><span class="stage-status">BOARD CANDIDATE</span>
          </div>
          <div class="synth-illustration">
            <div class="illustration-inputs">
              <span class="illustration-kicker">DESIGN INPUTS</span><b
                >USB-C field node</b
              ><span><i class="input-dot blue"></i>Power budget</span><span
                ><i class="input-dot orange"></i>Approved parts</span
              ><span><i class="input-dot green"></i>RF keepout</span>
            </div>
            <div class="illustration-board">
              <div class="board-grid"></div><span
                class="illustration-chip chip-mcu"
                >RP2350<small>MCU</small></span
              ><span class="illustration-chip chip-power"
                >3V3<small>POWER</small></span
              ><span class="illustration-chip chip-radio"
                >BG95<small>MODEM</small></span
              ><span class="illustration-chip chip-usb"
                >USB-C<small>EDGE</small></span
              ><span class="illustration-trace t-one"></span><span
                class="illustration-trace t-two"></span><span
                class="illustration-trace t-three"></span><span
                class="illustration-board-label">4-LAYER BOARD · 50Ω RF</span
              >
            </div>
            <div class="illustration-checks">
              <span class="illustration-kicker">DESIGN CHECKS</span><b
                ><Check size={13} /> 18 nets resolved</b
              ><b><Check size={13} /> 4 constraints held</b><b
                ><Check size={13} /> KiCad output ready</b
              >
            </div>
          </div>
          <div class="stage-footer">
            <span
              ><span class="pulse-dot"></span> Requirements remain attached to the
              board</span
            ><span>SPECIFY · DESIGN · VERIFY</span>
          </div>
        </div>
      </div>
      <div class="hero-grid-lines" aria-hidden="true"></div>
    </section>

    <section class="synth-intro section-tight">
      <div class="container-narrow intro-lockup">
        <span class="kicker">The missing layer</span><h2>
          Models can draw. Synth helps you <em>ship the board.</em>
        </h2><p class="lede">
          A screenshot of traces is not a finished design. Real PCB work needs
          constraints, net integrity, part choices, reviewable files, and a
          clear path from requirement to manufacturing output.
        </p>
      </div>
    </section>

    <section class="synth-evidence" id="evidence">
      <div class="container-wide">
        <div class="section-head">
          <div class="left">
            <span class="kicker">Built with Synth EE</span><h2 class="h-2">
              A board brief that turns into a KiCad board.
            </h2>
          </div><p class="lede">
            This Synth field node combines USB-C power and charging, an RP2350
            controller, secure-element storage, cellular connectivity, RF
            matching, and explicit antenna keepouts.
          </p>
        </div><div class="evidence-grid">
          <article class="evidence-board">
            <div class="evidence-label">
              <span>SYNTH FIELD NODE / 4-LAYER BOARD</span><b
                >KiCad 3D render · generated output</b
              >
            </div><div class="kicad-render">
              <img
                src="/img/synth/synth-field-node-kicad-tight.png"
                alt="KiCad 3D render of a Synth-generated four-layer field node board with USB-C on the board edge"
              /><span class="kicad-edge-label">USB-C EDGE</span>
            </div><div class="evidence-stats">
              <span><b>4</b> layers</span><span><b>50Ω</b> antenna pair</span
              ><span><b>1</b> secure element</span>
            </div>
          </article><article class="evidence-copy">
            <span class="kicker">The source is the artifact</span><h3>
              Not a generated picture of a board.
            </h3><p>
              The field node is authored as a readable <code>.synth</code> design,
              compiled by Synth EE, and exported as KiCad source. The render is the
              last step in a chain that still exposes parts, nets, constraints, keepouts,
              and manufacturing intent.
            </p><div class="source-callout">
              <code
                >diff_pair u3_main_ant bal1_unbal<br />&#123; impedance 50ohm
                &#125;</code
              ><span>RF constraints stay attached to the design.</span>
            </div><a href="/synth/orbit-board.synth" class="btn" download
              >Download the Synth source <ArrowRight size={15} /></a
            >
          </article>
        </div>
      </div>
    </section>

    <section class="synth-features">
      <div class="container-wide">
        <div class="section-head">
          <div class="left">
            <span class="kicker">One workspace, fewer dead ends</span><h2
              class="h-2"
            >
              From circuit intent to a board you can defend.
            </h2>
          </div><p class="lede">
            Synth gives the work a shape—without forcing engineering decisions
            into a chat transcript.
          </p>
        </div><div class="synth-feature-grid">
          {
            features.map(({ icon: Icon, title, desc }, index) => (
              <article class="synth-feature card">
                <>
                  <div class="feature-number">0{index + 1}</div>
                  <Icon size={22} stroke-width={1.6} />
                  <h3>{title}</h3>
                  <p>{desc}</p>
                </>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="synth-editions" id="editions">
      <div class="container-wide">
        <div class="section-head">
          <div class="left">
            <span class="kicker">One product, two editions</span><h2
              class="h-2"
            >
              Start open. Scale with an agent harness.
            </h2>
          </div><p class="lede">
            Both editions can use LLMs. Synth EE adds the tools and managed
            infrastructure for deeper, more autonomous design exploration.
          </p>
        </div><div class="edition-grid">
          <article class="edition-card">
            <div class="edition-card-top">
              <span class="synth-mark">S</span><span class="edition-badge"
                >Community Edition</span
              >
            </div><h3>Open design intelligence for every engineer.</h3><p>
              Explore requirements, schematics, parts, placement, and routing
              with an open foundation you can extend and run yourself.
            </p><ul>
              <li><Check size={15} /> Open-source foundation</li><li>
                <Check size={15} /> LLM access
              </li><li><Check size={15} /> KiCad-friendly project flow</li><li>
                <Check size={15} /> Model-flexible architecture
              </li>
            </ul><a
              href="https://github.com/absmach/synth"
              class="btn"
              target="_blank"
              rel="noopener"
              >View the GitHub repository <ArrowRight size={15} /></a
            >
          </article><article class="edition-card edition-card-enterprise">
            <div class="edition-card-top">
              <span class="synth-mark">S</span><span class="edition-badge"
                >Enterprise Edition</span
              >
            </div><h3>Managed SaaS with a custom agent harness.</h3><p>
              Bring repeatable, governed AI-assisted PCB design to your
              engineering organisation with a deeper toolchain for exploring and
              validating design choices.
            </p><ul>
              <li><Check size={15} /> Everything in Community</li><li>
                <Check size={15} /> Custom agent harness + MCP tools
              </li><li><Check size={15} /> World-model / EBM access</li><li>
                <Check size={15} /> MCTS-style simulation tools
              </li><li>
                <Check size={15} /> Managed SaaS operations and support
              </li>
            </ul><a href="/contact" class="btn btn-primary"
              >Talk to our team <ArrowRight size={15} /></a
            >
          </article>
        </div>
      </div>
    </section>

    <section class="synth-workflow">
      <div class="container-wide workflow-grid">
        <div>
          <span class="kicker">A calmer way to work</span><h2 class="h-2">
            The board is the interface.
          </h2><p class="lede">
            Synth turns the messy middle of PCB design into a visible,
            reviewable flow.
          </p><div class="workflow-steps">
            <div>
              <span>01</span><b>Specify</b><p>
                Bring in requirements, interfaces, constraints, and target
                parts.
              </p>
            </div><div>
              <span>02</span><b>Design</b><p>
                Explore schematic, placement, and routing candidates in context.
              </p>
            </div><div>
              <span>03</span><b>Verify</b><p>
                Review nets, design rules, diffs, and manufacturing readiness.
              </p>
            </div>
          </div>
        </div><div class="source-map">
          <div class="map-center">
            <span class="synth-mark">S</span><b>Board candidate</b><small
              >18 nets · 6 constraints</small
            >
          </div><div class="map-node node-a">
            <span class="source-dot blue"></span><b>Requirements</b><small
              >USB · power · size</small
            >
          </div><div class="map-node node-b">
            <span class="source-dot orange"></span><b>Part decisions</b><small
              >MCU · regulator · passives</small
            >
          </div><div class="map-node node-c">
            <span class="source-dot green"></span><b>Design checks</b><small
              >DRC · ERC · review</small
            >
          </div><svg class="map-lines" viewBox="0 0 500 440" aria-hidden="true"
            ><path d="M250 210 L95 96 M250 210 L405 96 M250 235 L250 365"
            ></path></svg
          >
        </div>
      </div>
    </section>

    <section class="synth-compare">
      <div class="container-wide">
        <div class="section-head">
          <div class="left">
            <span class="kicker">AI-assisted PCB design</span><h2 class="h-2">
              Where Synth fits in the new EDA stack.
            </h2>
          </div><p class="lede">
            Astra proves that an AI agent can operate KiCad. Flux and Quilter
            automate important parts of the EDA workflow. Synth is built around
            the engineering loop that connects intent, constraints, design
            files, and review.
          </p>
        </div><div class="compare-shell">
          <div class="compare-header">
            <span>Capability</span><span class="synth-column">Synth</span><span
              >GPT-6 Astra</span
            ><span>Flux</span><span>Quilter</span>
          </div>{
            comparison.map(([label, synth, astra, flux, quilter]) => (
              <div class="compare-row">
                <>
                  <b>{label}</b>
                  <span class="synth-column">
                    <Check size={15} />
                    {synth}
                  </span>
                  <span class="astra-column">
                    <CircleAlert size={15} />
                    {astra}
                  </span>
                  <span>
                    <CircleAlert size={15} />
                    {flux}
                  </span>
                  <span>
                    <CircleAlert size={15} />
                    {quilter}
                  </span>
                </>
              </div>
            ))
          }
        </div><p class="compare-note">
          <LockKeyhole size={15} /> The point is not to replace the engineer with
          a prompt. Synth makes AI-assisted design inspectable enough to earn an
          engineer’s trust.
        </p>
      </div>
    </section>

    <section class="synth-cta">
      <div class="container-wide cta-panel">
        <div>
          <span class="kicker">Start with the board you already have</span><h2
            class="h-2"
          >
            Give your engineering team a better copilot.
          </h2><p>
            Build with the open Synth Community Edition and connect it to
            LLMs—or talk to us about Synth EE’s managed agent, MCP, world-model,
            EBM, and MCTS toolchain.
          </p>
        </div><div class="btn-row">
          <a
            href="https://github.com/absmach/synth"
            class="btn btn-primary"
            target="_blank"
            rel="noopener">Start with Synth <ArrowRight size={16} /></a
          >
        </div>
      </div>
    </section>

    <section class="section synth-faq">
      <div class="container-narrow">
        <div class="section-head" style="display:block; margin-bottom:40px;">
          <span class="kicker">Questions</span><h2
            class="h-2"
            style="margin-top:14px;"
          >
            A clear place to start.
          </h2>
        </div><FAQAccordion items={faqs} />
      </div>
    </section>
    <script type="application/ld+json" set:html={faqSchema} />
  </main>
  <Footer />
</BaseLayout>

<style>
  .synth-page {
    --synth-violet: #6d45e8;
    --synth-violet-soft: #eeeaff;
    --synth-ink: #1c1640;
    background: var(--paper);
    color: var(--synth-ink);
  }
  .synth-page .kicker {
    color: var(--synth-violet);
  }
  .synth-hero {
    min-height: calc(100vh - 70px);
    padding: 90px 0 86px;
    position: relative;
    overflow: hidden;
    background: linear-gradient(130deg, #f7f5ff 0%, #fff 52%, #fbf8ff 100%);
    border-bottom: 1px solid #e7e0fa;
  }
  .synth-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.86fr) minmax(500px, 1.14fr);
    gap: clamp(36px, 6vw, 88px);
    align-items: center;
    position: relative;
    z-index: 1;
  }
  .synth-wordmark {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--synth-ink);
    font: 600 14px var(--font-mono);
    letter-spacing: 0.16em;
    margin-bottom: 24px;
  }
  .synth-mark {
    width: 32px;
    height: 32px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
    color: #fff;
    background: var(--ink);
    box-shadow: 0 8px 20px rgba(7, 55, 99, 0.18);
    font: 600 17px var(--font-sans);
    letter-spacing: 0;
  }
  .synth-edition {
    color: var(--synth-violet);
    font-size: 10px;
    letter-spacing: 0.1em;
    border: 1px solid #cfc3f2;
    border-radius: 99px;
    padding: 6px 9px;
    margin-left: 4px;
  }
  .synth-hero-copy h1 {
    max-width: 680px;
    margin-top: 14px;
    font-size: clamp(48px, 5.3vw, 78px);
    line-height: 1.01;
    letter-spacing: -0.05em;
    color: var(--synth-ink);
  }
  .synth-hero-copy .lede {
    margin-top: 24px;
    max-width: 560px;
    color: #514b6f;
  }
  .synth-hero-copy .btn-primary {
    background: var(--synth-violet);
    border-color: var(--synth-violet);
  }
  .synth-hero-notes {
    display: flex;
    gap: 18px;
    flex-wrap: wrap;
    margin-top: 28px;
    color: #6b6486;
    font: 11px var(--font-mono);
  }
  .synth-hero-notes span {
    display: flex;
    align-items: center;
    gap: 5px;
  }
  .synth-hero-notes svg {
    color: #35a273;
  }
  .document-stage {
    min-height: 510px;
    background: #1c1732;
    color: #fff;
    border: 1px solid #4d3d78;
    border-radius: 16px;
    box-shadow:
      0 28px 70px #4f3c9c2b,
      0 3px 8px #31225e33;
    overflow: hidden;
    transform: perspective(1200px) rotateY(-4deg) rotateX(2deg);
  }
  .live-cockpit-stage {
    min-height: 0;
  }
  .cockpit-shot-wrap {
    padding: 14px;
    background: #0b0f19;
  }
  .cockpit-shot {
    display: block;
    width: 100%;
    height: auto;
    max-height: 520px;
    object-fit: cover;
    object-position: top center;
    border: 1px solid #293246;
    border-radius: 10px;
    background: #0b0f19;
  }
  .synth-illustration {
    display: grid;
    grid-template-columns: 132px minmax(0, 1fr) 142px;
    gap: 14px;
    align-items: center;
    min-height: 424px;
    padding: 28px 24px;
    background: linear-gradient(135deg, #f3f6fb, #fff);
    color: var(--ink);
  }
  .illustration-inputs,
  .illustration-checks {
    display: grid;
    gap: 12px;
    align-content: center;
    font-size: 10px;
  }
  .illustration-inputs b,
  .illustration-checks b {
    font-size: 11px;
    line-height: 1.35;
  }
  .illustration-kicker {
    color: var(--ink-3);
    font: 9px var(--font-mono);
    letter-spacing: 0.12em;
  }
  .illustration-inputs > span:not(.illustration-kicker),
  .illustration-checks b {
    display: flex;
    align-items: center;
    gap: 7px;
    color: var(--ink-2);
  }
  .input-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    flex: none;
  }
  .input-dot.blue {
    background: #2547ff;
  }
  .input-dot.orange {
    background: #ff7a4a;
  }
  .input-dot.green {
    background: #1f6b3a;
  }
  .illustration-checks b svg {
    flex: none;
    color: #1f6b3a;
  }
  .illustration-board {
    height: 280px;
    position: relative;
    overflow: hidden;
    border: 1px solid #547a98;
    border-radius: 12px;
    background: #174d4a;
    box-shadow:
      inset 0 0 0 7px #113c3b,
      inset 0 0 0 8px #4b8c7e,
      0 14px 30px rgba(7, 55, 99, 0.15);
  }
  .board-grid {
    position: absolute;
    inset: 16px;
    opacity: 0.26;
    background-image: radial-gradient(#c1e2d4 1px, transparent 1px);
    background-size: 16px 16px;
  }
  .illustration-chip {
    position: absolute;
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    width: 68px;
    height: 48px;
    border: 1px solid #bdd5e3;
    border-radius: 5px;
    color: #f4fbff;
    background: #234c70;
    box-shadow: 0 5px 14px #09221f88;
    font: 600 10px var(--font-mono);
  }
  .illustration-chip small {
    margin-top: 4px;
    color: #b6cedb;
    font-size: 7px;
    font-weight: 400;
  }
  .chip-mcu {
    width: 88px;
    height: 78px;
    top: 101px;
    left: 35%;
    background: #073763;
  }
  .chip-power {
    top: 38px;
    left: 12%;
    background: #3f526d;
  }
  .chip-radio {
    top: 46px;
    right: 10%;
    background: #46604a;
    border-color: #bce29a;
  }
  .chip-usb {
    bottom: 38px;
    left: 10%;
    background: #64434c;
    border-color: #dda5ae;
  }
  .illustration-trace {
    position: absolute;
    z-index: 1;
    display: block;
    height: 3px;
    border-radius: 99px;
    transform-origin: left center;
  }
  .t-one {
