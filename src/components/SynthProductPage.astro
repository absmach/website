---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import FAQAccordion from "./FAQAccordion.astro";
import SynthLogo from "./SynthLogo.astro";
import SynthHeroIllustration from "./SynthHeroIllustration.astro";
import {
  ArrowRight,
  Check,
  CircuitBoard,
  GitBranch,
  ShieldCheck,
  Sparkles,
} from "@lucide/astro";

const edition = "Community + Enterprise";
const quickStartUrl =
  "https://www.absmach.eu/docs/synth/user-guide/quick-start";
const agentGuideUrl = "https://www.absmach.eu/docs/synth/user-guide/mcp-server";
const docsUrl = "https://www.absmach.eu/docs/synth";
const faqs = [
  {
    q: "How do I start with Synth?",
    a: "Build the Community Edition from the repository, then compile an example design or connect your AI agent. Start with a board brief: the agent can look up parts, write the circuit source, and use compiler feedback to refine it.",
    link: { href: quickStartUrl, label: "Follow the quick start" },
  },
  {
    q: "How do I connect my AI agent?",
    a: "Run Synth’s Model Context Protocol (MCP) server and connect an MCP-compatible agent. It exposes the circuit language reference, part search, validation, fixes, placement, routing, and export. MCP is included in Community; use your own agent and model access.",
    link: { href: agentGuideUrl, label: "Read the agent integration guide" },
  },
  {
    q: "What files does Synth generate?",
    a: "Synth generates KiCad schematics, PCB layouts, and a bill of materials from .synth circuit source. Open the outputs in KiCad for inspection and downstream work. Keep design changes in the source so they are preserved when you regenerate the outputs.",
  },
  {
    q: "Can I review designs in Git and run checks in CI?",
    a: "Yes. Components, connections, and constraints are stored as readable circuit code. Review source changes in commits and pull requests, and run the compiler and validation commands in your CI pipeline. Pin the compiler, component registry, and settings for reproducible builds.",
  },
  {
    q: "How do Community and Enterprise differ?",
    a: "Community provides the open-source compiler, CLI, MCP agent tools, electrical and physical checks, and KiCad outputs to run yourself. Enterprise builds on that foundation with a managed service, a custom agent harness, and team support. Talk to us about your workflow and deployment requirements.",
    link: { href: "/contact", label: "Discuss Synth Enterprise" },
  },
];

const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map(({ q, a }) => ({
    "@type": "Question",
    name: q,
    acceptedAnswer: { "@type": "Answer", text: a },
  })),
});

const features = [
  {
    icon: CircuitBoard,
    title: "Deterministic compilation",
    desc: "A typed compiler turns circuit source into KiCad schematics, boards, and BOMs. Deterministic placement and routing make results reproducible for the same source, parts, and settings.",
  },
  {
    icon: Sparkles,
    title: "Errors agents can act on",
    desc: "Agents work as they do with other programming languages: write code, compile, read errors, fix the source, and recompile. Structured diagnostics identify source locations and provide suggested fixes where available.",
  },
  {
    icon: ShieldCheck,
    title: "Electrical and physical checks",
    desc: "Electrical-rule checks (ERC) flag circuit issues such as missing decoupling. Design-rule checks (DRC) inspect routed boards for clearance, trace-width, drill-size, and courtyard violations.",
  },
  {
    icon: GitBranch,
    title: "Review the agent’s changes",
    desc: "Components, connections, and constraints live in readable circuit source. Review the agent’s edits in Git, rerun the compiler and checks, and inspect generated outputs in KiCad.",
  },
];

const comparison = [
  [
    "Design input",
    "Prompt → generated circuit specification (.synth)",
    "Prompt + KiCad project",
    "Prompt or editor project",
    "Schematic + board outline",
  ],
  [
    "How designs are built",
    "AI-written source → deterministic compiler",
    "LLM-directed edits in KiCad",
    "LLM-driven design in a PCB editor (non-deterministic)",
    "Reinforcement-learning layout engine",
  ],
  [
    "Validation and feedback",
    "The coding loop agents know: compile → fix → recompile, with deterministic compiler checks + ERC/DRC",
    "KiCad ERC/DRC reports via editor or CLI",
    "Non-deterministic LLM review + separate DRC checks",
    "Layout validation + physics-rule checks",
  ],
  [
    "Design traceability",
    "Readable circuit source, Git diffs, reproducible builds",
    "KiCad files + agent session history",
    "Workspace version history",
    "Layout candidates + validation reports",
  ],
  [
    "Compiler / engine access",
    "Open compiler + MCP; run locally (CE)",
    "Open-source KiCad; provider AI",
    "Hosted editor and AI",
    "Vendor-managed layout engine",
  ],
];

const heroLabel = "Synth · AI-assisted PCB design";
const heroTitle = "From prompt to PCB. Built on a compiler.";
const heroDesc =
  "Describe your board. Your AI agent writes the circuit code; Synth checks it and generates KiCad schematics, layouts, and BOMs through a deterministic compiler workflow.";
---

<BaseLayout
  title="Synth — AI-Assisted PCB Design | Abstract Machines"
  description={heroDesc}
  ogImageAlt={`Synth ${edition}`}
>
  <Header />
  <main class="synth-page">
    <section class="prod-hero synth-hero">
      <div class="container-wide synth-hero-grid">
        <div class="synth-hero-copy">
          <div class="synth-wordmark">
            <SynthLogo />
          </div>
          <p class="kicker">{heroLabel}</p>
          <h1>{heroTitle}</h1>
          <p class="lede">{heroDesc}</p>
          <div class="btn-row" style="margin-top:32px;">
            <a href={quickStartUrl} class="btn btn-primary"
              >Build your first board <ArrowRight size={16} /></a
            >
            <a href={docsUrl} class="btn">Read Documentation</a>
            <a href="#editions" class="btn">Compare editions</a>
          </div>
          <div class="synth-hero-notes">
            <span><Check size={14} /> Deterministic compiler</span><span
              ><Check size={14} /> Open source</span
            ><span><Check size={14} /> Agent-ready</span>
          </div>
        </div>
        <div class="hero-art"><SynthHeroIllustration /></div>
      </div>
      <div class="hero-grid-lines" aria-hidden="true"></div>
    </section>

    <section class="synth-evidence" id="evidence">
      <div class="container-wide">
        <div class="section-head">
          <div class="left">
            <span class="kicker">Built with Synth EE</span><h2 class="h-2">
              Explore a board built with Synth.
            </h2>
          </div><p class="lede">
            This Synth field node combines USB-C power and charging, an RP2350
            controller, secure-element storage, cellular connectivity, RF
            matching, and explicit antenna keepouts.
          </p>
        </div><div class="evidence-grid">
          <article class="evidence-board">
            <div class="evidence-label">
              <span>SYNTH FIELD NODE / 4-LAYER BOARD</span><b
                >KiCad 3D render · generated output</b
              >
            </div><div class="kicad-render">
              <img
                src="/img/synth/synth-field-node-kicad-tight.png"
                alt="KiCad 3D render of a Synth-generated four-layer field node board with USB-C on the board edge"
              /><span class="kicad-edge-label">USB-C EDGE</span>
            </div><div class="evidence-stats">
              <span><b>4</b> layers</span><span><b>50Ω</b> antenna pair</span
              ><span><b>1</b> secure element</span>
            </div>
          </article><article class="evidence-copy">
            <span class="kicker">Open the design</span><h3 class="h-3">
              Circuit source. A real KiCad board.
            </h3><p>
              Follow the field node from its readable <code>.synth</code> source to
              the PCB generated by Synth EE. Inspect the components, connections,
              and constraints in the source, then open the board in KiCad to explore
              the layout.
            </p><div class="source-callout">
              <code
                >diff_pair u3_main_ant bal1_unbal<br />&#123; impedance 50ohm
                &#125;</code
              ><span>RF constraints stay attached to the design.</span>
            </div><div class="btn-row evidence-downloads">
              <a href="/synth/orbit-board.synth" class="btn" download>
                Download circuit source <ArrowRight size={15} />
              </a>
              <a href="/synth/orbit-board.kicad_pcb" class="btn" download>
                Download KiCad board <ArrowRight size={15} />
              </a>
            </div>
          </article>
        </div>
      </div>
    </section>

    <section class="synth-features">
      <div class="container-wide">
        <div class="section-head">
          <div class="left">
            <span class="kicker">Built for the agent loop</span><h2 class="h-2">
              Hardware design, with software discipline.
            </h2>
          </div><p class="lede">
            A shared language for engineers and agents, backed by repeatable
            builds, explicit design rules, and changes you can inspect.
          </p>
        </div><div class="synth-feature-grid">
          {
            features.map(({ icon: Icon, title, desc }) => (
              <article class="synth-feature feature">
                <>
                  <div class="ic">
                    <Icon size={20} />
                  </div>
                  <h3 class="h-4">{title}</h3>
                  <p>{desc}</p>
                </>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="synth-workflow" id="agent-workflow">
      <div class="container-wide workflow-grid">
        <div>
          <span class="kicker">A compiler error, a concrete fix</span>
          <h2 class="h-2">Turn compiler errors into source fixes.</h2>
          <p class="lede">
            If an agent invents a pin name, Synth’s resolver reports exactly
            where the design is wrong. The agent can fix the source and compile
            again using the same workflow it uses to write software.
          </p>
          <div class="workflow-steps">
            <div>
              <span>01</span><b>Write</b><p>
                The agent connects a controller to a secure element in circuit
                source.
              </p>
            </div>
            <div>
              <span>02</span><b>Compile</b><p>
                Synth checks the connection against the component’s defined
                pins.
              </p>
            </div>
            <div>
              <span>03</span><b>Correct</b><p>
                The agent replaces the invalid pin, then reruns compilation and
                checks.
              </p>
            </div>
          </div>
        </div>
        <div class="diagnostic-example">
          <div class="example-heading">
            <span>Compiler example</span><span>Undefined pin</span>
          </div>
          <div class="example-code">
            <span class="example-label">Source with a pin-name typo</span>
            <pre><code>{`component U1: mcu "rp2350"
component U2: secure_element "atecc608"
connect U1.gpo -> U2.sda`}</code></pre>
          </div>
          <div class="example-diagnostic">
            <b>E-SYNTH-COMP-002 · undefined pin</b>
            <p><code>U1.gpo</code> — part has no pin named <code>gpo</code>.</p>
          </div>
          <div class="example-code example-fix">
            <span class="example-label">Source correction</span>
            <pre><code><del>- connect U1.gpo -&gt; U2.sda</del><ins>+ connect U1.gp0 -&gt; U2.sda</ins></code></pre>
          </div>
          <a
            class="example-reference"
            href="https://github.com/absmach/synth/blob/main/docs/diagnostics/E-SYNTH-COMP-002.md"
            target="_blank"
            rel="noopener"
          >
            Read the compiler diagnostic <ArrowRight size={14} />
          </a>
        </div>
      </div>
    </section>

    <section class="synth-editions" id="editions">
      <div class="container-wide">
        <div class="section-head">
          <div class="left">
            <span class="kicker">One product, two editions</span><h2
              class="h-2"
            >
              Run it yourself. Or build with us.
            </h2>
          </div><p class="lede">
            Both editions include the compiler and MCP agent tools. Choose
            Community for a workflow you run yourself, or Enterprise for a
            managed service and a custom agent harness.
          </p>
        </div><div class="edition-grid">
          <article class="edition-card">
            <div class="edition-card-top">
              <SynthLogo compact edition="CE" /><span class="edition-badge"
                >Community Edition</span
              >
            </div><h3 class="h-3">The open compiler and agent tools.</h3><p>
              Build locally, connect your own AI agent, and keep circuit source
              in your repository. Extend the compiler and component registry to
              fit your work.
            </p><ul>
              <li><Check size={15} /> Apache-2.0 circuit compiler</li>
              <li><Check size={15} /> CLI and MCP tools for your AI agent</li>
              <li><Check size={15} /> Electrical and physical design checks</li>
              <li><Check size={15} /> KiCad schematics, boards, and BOMs</li>
              <li>
                <Check size={15} /> Local builds and Git-based source review
              </li>
            </ul>
            <div
              class="btn-row"
              style="margin-top:auto; gap:10px; flex-wrap:wrap;"
            >
              <a
                href="https://www.absmach.eu/docs/synth/community"
                class="btn btn-primary"
                >Community Docs <ArrowRight size={15} /></a
              >
              <a
                href="https://github.com/absmach/synth"
                class="btn"
                target="_blank"
                rel="noopener">GitHub Repository <ArrowRight size={15} /></a
              >
            </div>
          </article><article class="edition-card edition-card-enterprise">
            <div class="edition-card-top">
              <SynthLogo compact inverted edition="EE" /><span
                class="edition-badge">Enterprise Edition</span
              >
            </div><h3 class="h-3">A managed workflow for your team.</h3><p>
              Bring Synth into your engineering organisation with a managed
              service, a custom agent harness, and support for your team’s
              design workflow.
            </p><ul>
              <li><Check size={15} /> Everything in Community</li>
              <li><Check size={15} /> Custom agent harness</li>
              <li><Check size={15} /> Managed SaaS operations</li>
              <li><Check size={15} /> Engineering team support</li>
            </ul><a href="/contact" class="btn btn-primary"
              >Talk to our team <ArrowRight size={15} /></a
            >
          </article>
        </div>
      </div>
    </section>

    <section class="synth-compare">
      <div class="container-wide">
        <div class="section-head">
          <div class="left">
            <span class="kicker">AI-assisted PCB design</span>
            <h2 class="h-2">Where Synth fits in the new EDA stack.</h2>
          </div>
          <p class="lede">
            Compare how a prompt becomes a design, how errors are checked, and
            what you can inspect and run yourself.
          </p>
        </div>
        <div class="compare-shell">
          <div class="compare-header">
            <span>Capability</span>
            <span class="synth-column">Synth</span>
            <span>Astra + KiCad</span>
            <span>Other AI PCB workspaces</span>
            <span>Other AI layout services</span>
          </div>
          {
            comparison.map(([label, synth, astra, workspace, layout]) => (
              <div class="compare-row">
                <b>{label}</b>
                <span class="synth-column">{synth}</span>
                <span>{astra}</span>
                <span>{workspace}</span>
                <span>{layout}</span>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section synth-faq">
      <div class="container-wide">
        <div class="section-head">
          <div class="left">
            <span class="kicker">Questions</span><h2 class="h-2">
              A clear place to start.
            </h2>
          </div>
        </div><FAQAccordion items={faqs} />
      </div>
    </section>

    <section class="synth-cta">
      <div class="container-narrow cta-panel">
        <div>
          <span class="kicker">Put the compiler to work</span>
          <h2 class="h-2">Build your first board with Synth.</h2>
          <p>
            Start with an example, connect your agent, and generate your first
            KiCad design. For a managed team workflow, talk to us about
            Enterprise.
          </p>
        </div><div class="btn-row">
          <a href={quickStartUrl} class="btn btn-primary">
            Follow the quick start <ArrowRight size={16} />
          </a>
          <a href={docsUrl} class="btn"
            >Documentation <ArrowRight size={16} /></a
          >
          <a href="/contact" class="btn"
            >Talk about Enterprise <ArrowRight size={16} /></a
          >
        </div>
      </div>
    </section>

    <script type="application/ld+json" set:html={faqSchema} />
  </main>
  <Footer />
</BaseLayout>

<style>
  /* Page layout uses the shared product typography, spacing, and Blueprint tokens. */
  .synth-page {
    background: var(--paper);
    color: var(--ink);
  }
  .synth-hero {
    background: var(--paper-2);
  }
  .synth-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(28px, 5vw, 56px);
    align-items: center;
    position: relative;
    z-index: 1;
  }
  .synth-wordmark {
    display: flex;
    margin-bottom: 24px;
  }
  .synth-hero-copy .lede {
    margin-top: 24px;
  }
  .synth-hero-notes {
    display: flex;
    gap: 18px;
    flex-wrap: wrap;
    margin-top: 28px;
    color: var(--ink-2);
    font: 11px var(--font-mono);
  }
  .synth-hero-notes span {
    display: flex;
    align-items: center;
    gap: 5px;
  }
  .synth-hero-notes svg {
    color: var(--green);
  }
  .hero-art {
    min-width: 0;
    width: 100%;
    max-width: 640px;
    margin-inline: auto;
  }
  .evidence-downloads {
    gap: 12px;
  }
  .hero-grid-lines {
    position: absolute;
    inset: 0;
    opacity: 0.32;
    pointer-events: none;
    background-image:
      linear-gradient(var(--line-3) 1px, transparent 1px),
      linear-gradient(90deg, var(--line-3) 1px, transparent 1px);
    background-size: 70px 70px;
    mask-image: linear-gradient(90deg, transparent, black 72%);
  }
  .synth-evidence,
  .synth-faq {
    background: var(--paper-2);
    border-top: 1px solid var(--line-3);
    border-bottom: 1px solid var(--line-3);
  }
  .evidence-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
    gap: 48px;
    align-items: center;
  }
  .evidence-board {
    padding: 24px;
    border: 1px solid var(--line-3);
    border-radius: var(--radius-lg);
    background: var(--paper);
  }
  .evidence-label {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px;
    color: var(--ink-3);
    font: 10px var(--font-mono);
    line-height: 1.5;
    letter-spacing: 0.08em;
  }
  .evidence-label b {
    color: var(--ink);
    font-weight: 500;
  }
  .kicad-render {
    margin: 24px 0;
    position: relative;
    overflow: hidden;
    border-radius: var(--radius);
    background: #173f32;
  }
  .kicad-render img {
    display: block;
    width: 100%;
    height: 350px;
    object-fit: cover;
    object-position: center;
  }
  .kicad-edge-label {
    position: absolute;
    left: 15px;
    top: 15px;
    padding: 6px 8px;
    border: 1px solid #93dfb7aa;
    border-radius: var(--radius-sm);
    color: #c8f4d8;
    background: #102a24dd;
    font: 9px var(--font-mono);
    letter-spacing: 0.1em;
  }
  .evidence-stats {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 16px;
    color: var(--ink-3);
    font: 11px var(--font-mono);
  }
  .evidence-stats b {
    display: block;
    margin-bottom: 6px;
    color: var(--ink);
    font: 600 28px var(--font-sans);
  }
  .evidence-copy h3 {
    margin-top: 14px;
  }
  .evidence-copy p {
    margin-top: 16px;
    color: var(--ink-2);
    font-size: 15px;
    line-height: 1.65;
  }
  .evidence-copy code {
    color: var(--ink);
    font: 12px var(--font-mono);
    overflow-wrap: anywhere;
  }
  .source-callout {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin: 24px 0 28px;
    padding: 16px;
    border-left: 3px solid var(--ink);
    background: var(--paper);
  }
  .source-callout span {
    color: var(--ink-3);
    font-size: 13px;
  }
  .synth-feature-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
  }
  .synth-feature {
    padding: 36px;
  }
  .synth-feature .ic {
    width: 40px;
    height: 40px;
    margin-bottom: 18px;
  }
  .synth-feature h3 {
    line-height: 1.55;
  }
  .synth-feature p {
    margin-top: 10px;
    color: var(--ink-2);
    font-size: 15px;
    line-height: 1.65;
  }
  .synth-editions {
    background: var(--paper-2);
    border-top: 1px solid var(--line-3);
  }
  .edition-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
  }
  .edition-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 32px;
    border: 1px solid var(--line-3);
    border-radius: var(--radius-lg);
    background: var(--paper);
  }
  .edition-card-enterprise {
    color: var(--on-accent);
    background: var(--surface-accent);
    border-color: var(--dark-border);
  }
  .edition-card-top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    width: 100%;
    min-height: 32px;
  }
  .edition-badge {
    color: var(--ink-3);
    font: 11px var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }
  .edition-card-enterprise .edition-badge {
    color: var(--on-accent-muted);
  }
  .edition-card h3 {
    margin-top: 28px;
  }
  .edition-card p {
    margin-top: 16px;
    color: var(--ink-2);
    font-size: 15px;
    line-height: 1.65;
  }
  .edition-card ul {
    display: grid;
    gap: 10px;
    margin: 24px 0 30px;
    padding: 0;
    list-style: none;
    color: var(--ink-2);
    font-size: 14px;
  }
  .edition-card li {
    display: flex;
    align-items: baseline;
    gap: 8px;
  }
  .edition-card li svg {
    color: var(--green);
    flex: none;
  }
  .edition-card .btn {
    margin-top: auto;
  }
  .edition-card-enterprise p,
  .edition-card-enterprise ul {
    color: var(--on-accent-dim);
  }
  .edition-card-enterprise li svg {
    color: #9de4bd;
  }
  .edition-card-enterprise .btn-primary {
    background: var(--paper);
    color: var(--ink);
    border-color: var(--paper);
  }
  .edition-card-enterprise .btn-primary:hover {
    background: var(--paper-3);
    border-color: var(--paper-3);
  }
  .synth-workflow {
    background: var(--surface-accent);
    color: var(--on-accent);
  }
  .workflow-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 56px;
    align-items: center;
  }
  .synth-workflow .kicker {
    color: var(--on-accent-muted);
  }
  .synth-workflow h2 {
    margin-top: 14px;
  }
  .synth-workflow .lede {
    margin-top: 20px;
