---
import { ArrowUpRight, ArrowRight } from "@lucide/astro";
import IdentityLayout from "../../layouts/IdentityLayout.astro";
import "../../styles/identity-editorial.css";
import "../../styles/identity-legal.css";

interface Section {
  id: string;
  label: string;
}
interface Props {
  title: string;
  description: string;
  eyebrow?: string;
  sections: Section[];
  /** Metadata shown under the introduction, e.g. effective date. */
  meta?: { label: string; value: string }[];
  contactEmail?: string;
}
const {
  title,
  description,
  eyebrow = "Legal",
  sections,
  meta = [],
  contactEmail = "legal@abstractmachines.dev",
} = Astro.props;
const documents = [
  { href: "/privacy/", label: "Privacy Policy" },
  { href: "/terms/", label: "Terms of Service" },
  { href: "/imprint/", label: "Legal Notice" },
];
const related = documents.filter(
  (document) => document.href !== Astro.url.pathname,
);
---

<IdentityLayout title={title} description={description}>
  <section class="il-hero ie-shell">
    <nav class="is-breadcrumb" aria-label="Breadcrumb">
      <a href="/">Abstract Machines</a><span>/</span>
      {title}
    </nav>
    <div class="il-hero-grid">
      <div>
        <p class="ie-eyebrow">{eyebrow}</p>
        <h1>{title}</h1>
      </div>
      <div class="il-hero-aside">
        <slot name="lead" />
        {
          meta.length > 0 && (
            <p class="il-meta">
              {meta.map((item) => (
                <span>
                  {item.label} <strong>{item.value}</strong>
                </span>
              ))}
            </p>
          )
        }
      </div>
    </div>
  </section>
  <div class="ie-shell ie-article-layout il-layout">
    <aside class="ie-article-index">
      <span>In this document</span>
      <nav aria-label={`${title} sections`}>
        {
          sections.map((section) => (
            <a href={`#${section.id}`}>{section.label}</a>
          ))
        }
      </nav>
      <div class="il-related">
        <span>Other documents</span>
        {
          related.map((document) => (
            <a class="text-link" href={document.href}>
              {document.label} <ArrowRight size={16} />
            </a>
          ))
        }
      </div>
    </aside>
    <article class="il-article">
      <slot />
    </article>
  </div>
  <section class="il-closing ie-shell" aria-labelledby="legal-closing-title">
    <div>
      <p class="ie-eyebrow">Questions</p>
      <h2 id="legal-closing-title">
        Something unclear?<br /><span>Ask us directly.</span>
      </h2>
    </div>
    <div>
      <p>
        We answer questions about this document, our data practices, and our
        services from our registered office in Paris.
      </p>
      <a class="ie-button ie-button-white" href={`mailto:${contactEmail}`}
        >Write to {contactEmail} <ArrowUpRight size={20} /></a
      >
    </div>
  </section>
</IdentityLayout>
