---
import LegalPage from "../components/identity/LegalPage.astro";

const sections = [
  { id: "publisher", label: "Publisher" },
  { id: "hosting", label: "Website hosting" },
  { id: "legal-documents", label: "Related documents" },
];
---

<LegalPage
  title="Legal Notice"
  description="Company identity, website publisher and hosting information for Abstract Machines."
  eyebrow="Legal / Mentions légales"
  sections={sections}
>
  <section id="publisher">
    <h2>Publisher</h2>
    <div class="il-card">
      <dl>
        <dt>Company</dt>
        <dd>Abstract Machines SAS</dd>
        <dt>Legal form and capital</dt>
        <dd>Société par actions simplifiée — €1,000</dd>
        <dt>Registered office</dt>
        <dd>141 Quai de Valmy, 75010 Paris, France</dd>
        <dt>Registration</dt>
        <dd>952 033 033 RCS Paris — SIRET 95203303300012</dd>
        <dt>VAT number</dt>
        <dd>FR71 952033033</dd>
        <dt>Publication director</dt>
        <dd>Drasko Draskovic</dd>
        <dt>General and legal enquiries</dt>
        <dd><a href="mailto:info@absmach.eu">info@absmach.eu</a></dd>
      </dl>
    </div>
  </section>
  <section id="hosting">
    <h2>Website hosting</h2>
    <p>
      Cloudflare, Inc., 101 Townsend Street, San Francisco, CA 94107, United
      States. Telephone: +1 650 319 8930. <a href="https://www.cloudflare.com/"
        >cloudflare.com</a
      >.
    </p>
  </section>
  <section id="legal-documents">
    <h2>Related documents</h2>
    <p>
      See our <a href="/terms/">website terms</a> and <a href="/privacy/"
        >privacy notice</a
      >. Privacy enquiries: <a href="mailto:privacy@absmach.eu"
        >privacy@absmach.eu</a
      >.
    </p>
    <p>
      Atomic is a product of Abstract Machines SAS. Its terms, privacy
      information and customer data processing agreement are on the <a
        href="https://atomicapp.dev/legal/">Atomic legal documents page</a
      >.
    </p>
  </section>
</LegalPage>
