---
import "../styles/global.css";

const {
  title = "Abstract Machines",
  description = "Infrastructure for event-driven systems.",
  ogType = "website",
  ogImage = "/og-image.png", 
  canonical,
  pageType = "homepage",
  author = { name: "", url: "" },
  startDate,
  endDate,
  keywords = [],
  product = { name: "", description: "", category: "", os: "Linux, Docker", price: "0", currency: "USD" },
  breadcrumb = [] 
} = Astro.props;

const resolveMetaUrl = (value) => {
  if (!value) return undefined;
  try {
    return new URL(value, Astro.url).toString();
  } catch {
    return undefined;
  }
};

const resolveImgUrl = (path) =>
  path?.startsWith("http") ? path : `https://www.absmach.eu${path}`;

const canonicalUrl = pageType === "homepage"
  ? "https://www.absmach.eu/"
  : resolveMetaUrl(canonical ?? Astro.url.pathname);

const ogImageUrl = resolveImgUrl(ogImage);
const ogImageAlt = pageType === "product" ? product.name : title;

const getJsonLd = () => {
  const breadcrumbJson = breadcrumb.length ? {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": breadcrumb.map((b, index) => ({
      "@type": "ListItem",
      "position": index + 1,
      "name": b.name,
      "item": resolveMetaUrl(b.url)
    }))
  } : null;

  switch (pageType) {
    case "homepage":
      return [
        {
          "@context": "https://schema.org",
          "@type": "Organization",
          "name": "Abstract Machines",
          "url": "https://www.absmach.eu/",
          "logo": "https://www.absmach.eu/logo.png",
          "description": "Open-source IoT platform and edge computing company.",
          "address": {
            "@type": "PostalAddress",
            "streetAddress": "141 Quai de Valmy",
            "addressLocality": "Paris",
            "postalCode": "75010",
            "addressCountry": "FR"
          },
          "sameAs": [
            "https://twitter.com/absmach",
            "https://www.linkedin.com/company/absmach",
            "https://github.com/absmach"
          ]
        },
        breadcrumbJson
      ].filter(Boolean);

    case "product":
      return [
        {
          "@context": "https://schema.org",
          "@type": "SoftwareApplication",
          "name": product.name,
          "applicationCategory": product.category,
          "operatingSystem": product.os,
          "offers": {
            "@type": "Offer",
            "price": product.price,
            "priceCurrency": product.currency
          },
          "description": product.description,
          "url": canonicalUrl,
          "breadcrumb": breadcrumbJson?.itemListElement ? breadcrumbJson : undefined
        }
      ].filter(Boolean);

    case "blog":
      return [
        {
          "@context": "https://schema.org",
          "@type": "BlogPosting",
          "@id": canonicalUrl,
          "headline": title,
          "description": description,
          ...(author?.name && {
            "author": {
              "@type": "Person",
              "name": author.name,
              "url": author.url
            }
          }),
          "publisher": {
            "@type": "Organization",
            "name": "Abstract Machines",
            "logo": {
              "@type": "ImageObject",
              "url": "https://www.absmach.eu/logo.png"
            }
          },
          ...(startDate && { "datePublished": startDate }),
          ...(endDate && { "dateModified": endDate }),
          ...(keywords?.length && { "keywords": keywords }),
          "mainEntityOfPage": canonicalUrl,
          ...(ogImageUrl && { "image": ogImageUrl }),
          ...(breadcrumbJson && { "breadcrumb": breadcrumbJson })
        }
      ].filter(Boolean);

    default:
      return breadcrumbJson ? [breadcrumbJson] : [];
  }
};

const jsonLd = getJsonLd().filter(Boolean);
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>
      {pageType === "homepage"
        ? "Secure Event-Driven Connectivity | Abstract Machines"
        : pageType === "product"
          ? `${product.name} | Abstract Machines`
          : `${title} | Abstract Machines`}
    </title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}

    <meta property="og:site_name" content="Abstract Machines" />
    <meta property="og:title" content={title || "Abstract Machines"} />
    <meta property="og:description" content={description || "Infrastructure for event-driven systems."} />
    <meta property="og:type" content={pageType === "blog" ? "article" : ogType} />
    <meta property="og:locale" content="en_US" />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    {ogImageUrl && <meta property="og:image:alt" content={ogImageAlt} />}
    {pageType === "blog" && author?.url && <meta property="article:author" content={author.url} />}
    {pageType === "blog" && startDate && <meta property="article:published_time" content={startDate} />}
    {pageType === "blog" && endDate && <meta property="article:modified_time" content={endDate} />}

    <meta name="twitter:card" content={ogImageUrl ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}
    {pageType === "blog" && author?.url && <meta name="twitter:creator" content={author.url} />}

    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&family=JetBrains+Mono:wght@500&display=swap"
      rel="stylesheet"
    />

    {Astro.site && <link rel="sitemap" href="/sitemap-index.xml" />}
    <link rel="alternate" type="application/rss+xml" title="Abstract Machines Blog" href="/rss.xml" />

    {jsonLd.map((item) => (
      <script type="application/ld+json" set:html={JSON.stringify(item)} />
    ))}

    <script is:inline>
      (() => {
        const key = "am_theme";
        const doc = document.documentElement;
        const getSystem = () =>
          window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        const safeGet = () => { try { const val = localStorage.getItem(key); return val === "dark" || val === "light" ? val : null; } catch { return null; } };
        const applyTheme = (theme) => doc.setAttribute("data-theme", theme);
        const init = () => { const stored = safeGet(); const theme = stored || getSystem(); applyTheme(theme); };
        init();
      })();
    </script>
  </head>

  <body>
    <slot />
    <script is:inline>
      (() => {
        const UTM_PARAMS = { utm_source: "absmach.eu", utm_medium: "referral", utm_campaign: "website" };
        const isExternal = (href) => { try { const url = new URL(href, window.location.href); return /^https?:$/.test(url.protocol) && url.origin !== window.location.origin; } catch { return false; } };
        document.querySelectorAll("a[href]").forEach(a => {
          const href = a.getAttribute("href");
          if (!href || href.startsWith("#") || a.hasAttribute("data-no-utm")) return;
          if (!isExternal(href)) return;
          const url = new URL(href, window.location.href);
          Object.entries(UTM_PARAMS).forEach(([k,v]) => { if(!url.searchParams.has(k)) url.searchParams.set(k,v); });
          a.setAttribute("href", url.toString());
        });
      })();
    </script>
  </body>
</html>
