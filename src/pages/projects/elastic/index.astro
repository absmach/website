---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Header from "../../../components/Header.astro";
import Footer from "../../../components/Footer.astro";
import FinalCTA from "../../../components/FinalCTA.astro";

const partners = [
  { alt: "Technical University of Crete", src: "/img/logos/TUC.png" },
  { alt: "Ericsson", src: "/img/logos/ericsson.png" },
  { alt: "Telefonica", src: "/img/logos/telefonica.png" },
  { alt: "Thales", src: "/img/logos/THALES.png" },
  { alt: "IMEC", src: "/img/logos/IMEC.png" },
  { alt: "Ultraviolet", src: "/img/logos/ultraviolet.png" },
  { alt: "Aalto University", src: "/img/logos/AAL.png" },
  { alt: "Lund University", src: "/img/logos/LUND.png" },
  { alt: "Zentriz Lab", src: "/img/logos/zen.png" },
  { alt: "Politecnico di Torino", src: "/img/logos/POLITO.png" },
  { alt: "Abstract Machines", src: "/img/logos/AMA.png" },
];

const objectives = [
  {
    title: "Executable Isolation Techniques",
    desc: "Enhance efficiency, portability, and security in in-network cloud and edge computing by analyzing and improving executable isolation across the entire lifecycle.",
  },
  {
    title: "6G Edge Workload Orchestration",
    desc: "Develop secure and efficient orchestration for edge and far-edge IoT workloads in critical 6G infrastructure, ensuring reliability, trust, and resilience.",
  },
  {
    title: "Secure Serverless FaaS Orchestration",
    desc: "Design architecture-agnostic, secure serverless FaaS orchestration to support diverse artifacts and workloads, ensuring data authenticity and trusted digital interactions.",
  },
  {
    title: "6G Standardization and Technology Dissemination",
    desc: "Support the standardization and dissemination of 6G technologies, aligning with EU supply capabilities for efficient, secure service deployment.",
  },
  {
    title: "Confidential and Privacy-Preserving Execution",
    desc: "Implement secure, architecture-agnostic execution environments using confidential computing and privacy-enhancing technologies for multi-stakeholders.",
  },
];

const outcomes = [
  { title: "Cryptographic libraries", desc: "Post-quantum libraries and SDKs for 6G" },
  { title: "Computing framework", desc: "Confidential computing framework for cloud-edge environments" },
  { title: "Privacy protocols", desc: "Privacy-preserving protocols for heterogeneous 6G networks" },
  { title: "Security tools", desc: "Quantum-resistant security tools and artifacts" },
  { title: "Security standards", desc: "Enhanced security standards for future 6G deployments" },
];

const responsibilities = [
  {
    title: "Task 2.1 Leadership (WP2)",
    desc: "Design and development of lightweight FaaS orchestration, including workload scheduling and supervision.",
  },
  {
    title: "Access Control Implementation",
    desc: "Implementing distributed access control policies for secure edge computing.",
  },
  {
    title: "Wasm Optimization",
    desc: "Assessing efficiency of Wasm workload execution and exploring eBPF/XDP for low-latency networking.",
  },
  {
    title: "Task 4.4 Leadership (WP4)",
    desc: "Leveraging OP-TEE protocol expertise to enhance workload orchestration on constrained IoT devices.",
  },
  {
    title: "Edge Security Enhancement",
    desc: "Improving Wasm support on embedded devices and strengthening Magistrala edge security features.",
  },
];

const infoItems = [
  { label: "Duration", value: "1 March 2024 – 28 February 2027" },
  { label: "Funding Program", value: "Horizon Europe" },
  { label: "Total Budget", value: "€4 Million" },
  { label: "Project Coordinator", value: "Technical University of Crete" },
  { label: "Status", value: "Active", pill: true },
];

const infoLinks = [
  { label: "Visit Project Site", href: "https://elasticproject.eu/" },
  { label: "View on CORDIS", href: "https://cordis.europa.eu/project/id/101139067" },
];
---

<BaseLayout
  title="ELASTIC Project — Abstract Machines"
  description="ELASTIC: Efficient, portabLe And Secure orchesTration for reliable serviCes in 6G networks."
>
  <Header />

  <main>
    <!-- Hero -->
    <div class="proj-hero">
      <div class="container-wide">
        <div class="hero-inner">
          <div>
            <span class="kicker">EU Horizon Europe · 2024–2027</span>
            <h1>ELASTIC</h1>
            <p class="lede" style="max-width:560px; margin-top:16px;">
              Efficient, portabLe And Secure orchesTration for reLIable serviCes in 6G networks.
            </p>
            <div class="btn-row" style="margin-top:28px;">
              <a href="https://elasticproject.eu/" class="btn btn-primary" target="_blank" rel="noopener noreferrer">Visit Project Site ↗</a>
              <a href="https://cordis.europa.eu/project/id/101139067" class="btn" target="_blank" rel="noopener noreferrer">View on CORDIS ↗</a>
            </div>
            <span class="badge active" style="margin-top:24px; display:inline-flex;">
              <span class="dot"></span>Active
            </span>
          </div>
          <div class="logo-card">
            <img
              src="/img/logos/elastic-dark.png"
              alt="ELASTIC Project Logo"
              style="height:80px; width:auto; object-fit:contain;"
            />
          </div>
        </div>
        <div class="meta-grid">
          <div><div class="l">Duration</div><div class="v">1 Mar 2024 – 28 Feb 2027</div></div>
          <div><div class="l">Funding</div><div class="v">Horizon Europe</div></div>
          <div><div class="l">Total Budget</div><div class="v">€4 Million</div></div>
          <div><div class="l">Coordinator</div><div class="v">Technical Univ. of Crete</div></div>
        </div>
      </div>
    </div>

    <!-- Main content + sidebar -->
    <section class="section-pad-top">
      <div class="container-wide">
        <div class="content-grid">

          <!-- Left: main content -->
          <div class="main-content stack stack-lg">

            <!-- Description -->
            <div>
              <span class="kicker">Overview</span>
              <h2 class="h-2" style="margin-top:14px;">Project Description</h2>
              <p style="margin-top:16px; color:var(--ink-2); line-height:1.7; font-size:15px;">
                ELASTIC redefines service orchestration within 6G networks, integrating
                cutting-edge technologies like WebAssembly and Confidential Computing to
                optimize network functionality and security. Our project not only aims to
                advance the capabilities and reach of connectivity services but also ensures
                robust security measures across diverse infrastructures.
              </p>
            </div>

            <!-- Objectives + Outcomes -->
            <div>
              <span class="kicker">Project Summary</span>
              <div class="two-col" style="margin-top:24px;">
                <div>
                  <h3 class="h-3">Key Objectives</h3>
                  <div class="stack stack-sm" style="margin-top:16px;">
                    {objectives.map(({ title, desc }) => (
                      <div class="obj-item">
                        <div class="obj-check" aria-hidden="true">✓</div>
                        <div>
                          <div style="font-weight:600; font-size:14px;">{title}</div>
                          <div style="font-size:13px; color:var(--ink-2); margin-top:4px; line-height:1.6;">{desc}</div>
                        </div>
                      </div>
                    ))}
                  </div>
                </div>
                <div>
                  <h3 class="h-3">Expected Outcomes</h3>
                  <div class="stack stack-sm" style="margin-top:16px;">
                    {outcomes.map(({ title, desc }) => (
                      <div class="obj-item">
                        <div class="obj-check" aria-hidden="true">✓</div>
                        <div>
                          <div style="font-weight:600; font-size:14px;">{title}</div>
                          <div style="font-size:13px; color:var(--ink-2); margin-top:4px; line-height:1.6;">{desc}</div>
                        </div>
                      </div>
                    ))}
                  </div>
                </div>
              </div>
            </div>

            <!-- Our involvement -->
            <div>
              <span class="kicker">Our Role</span>
              <h2 class="h-2" style="margin-top:14px;">Our Involvement</h2>
              <p style="margin-top:16px; color:var(--ink-2); line-height:1.7; font-size:15px;">
                Abstract Machines supports FaaS and workload orchestration at the edge in
                ELASTIC, enhancing IoT security and monitoring capabilities. Our expertise
                in IoT security, fine-grained access control, and the Magistrala platform
                makes us uniquely positioned to advance edge computing and secure
                orchestration in 6G networks.
              </p>
              <h3 class="h-3" style="margin-top:28px;">Our Responsibilities</h3>
              <div class="stack stack-sm" style="margin-top:16px;">
                {responsibilities.map(({ title, desc }) => (
                  <div class="obj-item">
                    <div class="obj-check" aria-hidden="true">✓</div>
                    <div>
                      <div style="font-weight:600; font-size:14px;">{title}</div>
                      <div style="font-size:13px; color:var(--ink-2); margin-top:4px; line-height:1.6;">{desc}</div>
                    </div>
                  </div>
                ))}
              </div>
            </div>

          </div>

          <!-- Right: sidebar -->
          <aside class="stack stack-md">

            <!-- Project info card -->
            <div class="card">
              <div class="sidebar-section-label">Project</div>
              <div style="font-weight:700; font-size:20px; margin-top:4px;">ELASTIC</div>
              <div class="info-list" style="margin-top:20px;">
                {infoItems.map(({ label, value, pill }) => (
                  <div class="info-row">
                    <div class="info-label">{label}</div>
                    <div class="info-val">
                      {pill ? (
                        <span class="badge active"><span class="dot"></span>{value}</span>
                      ) : (
                        value
                      )}
                    </div>
                  </div>
                ))}
              </div>
              <div class="stack stack-sm" style="margin-top:20px;">
                {infoLinks.map(({ label, href }) => (
                  <a href={href} class="btn" style="width:100%; justify-content:space-between;" target="_blank" rel="noopener noreferrer">
                    <span>{label}</span><span>↗</span>
                  </a>
                ))}
              </div>
            </div>

            <!-- Partners card -->
            <div class="card">
              <div class="sidebar-section-label">Network</div>
              <div style="font-weight:700; font-size:18px; margin-top:4px;">Project Partners</div>
              <p style="font-size:13px; color:var(--ink-3); margin-top:4px;">Organizations collaborating across this project.</p>
              <div class="partners-grid" style="margin-top:16px;">
                {partners.map(({ alt, src }) => (
                  <div class="partner-tile">
                    <img src={src} alt={alt} loading="lazy" />
                  </div>
                ))}
              </div>
            </div>

          </aside>
        </div>
      </div>
    </section>

    <!-- Goals & Impact -->
    <section style="background:var(--paper-2); border-top:1px solid var(--line-3);">
      <div class="container-wide">
        <div style="text-align:center;">
          <span class="kicker">Goals & Impact</span>
          <h2 class="h-2" style="margin-top:14px;">Elevating Cloud-to-Edge Orchestration</h2>
          <p class="lede" style="max-width:720px; margin:20px auto 0;">
            ELASTIC addresses key challenges in orchestrating secure, efficient services
            across cloud, fog, and edge infrastructures. By combining emerging technologies
            like WebAssembly, eBPF, Trusted Execution Environments (TEEs), and Federated
            Learning, ELASTIC optimizes latency, throughput, and cybersecurity resilience.
          </p>
          <p class="lede" style="max-width:720px; margin:16px auto 0;">
            Through targeted research and innovation, the project strengthens data privacy
            and integrity, enabling secure collaboration and scalable service delivery
            across digital and physical domains.
          </p>
        </div>
      </div>
    </section>

    <FinalCTA
      title="Collaborate with us"
      subtitle="Interested in partnering on research or joining a consortium? Let's talk."
      primary={{ label: "Get in touch", href: "/contact" }}
      secondary={null}
    />
  </main>

  <Footer />
</BaseLayout>

<style>
  .hero-inner {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 48px;
    align-items: start;
  }
  .logo-card {
    background: var(--paper);
    border: 1px solid var(--line-3);
    border-radius: var(--radius);
    padding: 28px 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 180px;
  }
  .content-grid {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: 56px;
    align-items: start;
    padding-bottom: 96px;
  }
  .two-col {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
  }
  .obj-item {
    display: grid;
    grid-template-columns: 20px 1fr;
    gap: 10px;
    align-items: start;
  }
  .obj-check {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--paper-3);
    color: var(--ink-2);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 10px;
    font-weight: 700;
    flex-shrink: 0;
    margin-top: 2px;
  }
  .sidebar-section-label {
    font-family: "JetBrains Mono", monospace;
    font-size: 10px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--ink-3);
  }
  .info-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .info-row {
    background: var(--paper-2);
    border: 1px solid var(--line-3);
    border-radius: var(--radius-sm);
    padding: 10px 14px;
  }
  .info-label {
    font-family: "JetBrains Mono", monospace;
    font-size: 10px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--ink-3);
  }
  .info-val {
    font-size: 13px;
    font-weight: 600;
    margin-top: 4px;
  }
  .partners-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
  }
  .partner-tile {
    background: var(--paper-2);
    border: 1px solid var(--line-3);
    border-radius: var(--radius-sm);
    padding: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 60px;
    transition: border-color 0.15s ease;
  }
  .partner-tile:hover {
    border-color: var(--line-2);
  }
  .partner-tile img {
    max-height: 36px;
    max-width: 100%;
    object-fit: contain;
  }
  @media (max-width: 980px) {
    .hero-inner {
      grid-template-columns: 1fr;
    }
    .logo-card {
      max-width: 200px;
    }
    .content-grid {
      grid-template-columns: 1fr;
    }
    .two-col {
      grid-template-columns: 1fr;
    }
  }
</style>
