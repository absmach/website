---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import FinalCTA from "../../components/FinalCTA.astro";
import { Lightbulb, Lock, Network, ShieldCheck } from "@lucide/astro";

const projects = [
  {
    name: "CONFIDENTIAL6G",
    tagline: "Quantum-Resistant Security for 6G Networks",
    description:
      "Developing cutting-edge cryptographic protocols and security mechanisms to ensure confidentiality in next-generation 6G networks. Building quantum-resistant libraries and architectural blueprints for secure telecommunications.",
    status: "Completed",
    year: "2023–2025",
    funding: "EU Horizon Europe",
    areas: [
      "6G Security",
      "Quantum Cryptography",
      "Network Architecture",
      "Privacy",
    ],
    logo: "/img/logos/confidential6G.jpg",
    link: "/projects/confidential6g",
  },
  {
    name: "ELASTIC",
    tagline: "Next-Gen Network Orchestration",
    description:
      "Pioneering WebAssembly-based network orchestration with Confidential Computing for efficient, secure service delivery across 6G infrastructures. Enabling dynamic workload distribution from cloud to edge.",
    status: "Active",
    year: "2024–2027",
    funding: "EU Horizon Europe",
    areas: ["WebAssembly", "Edge Computing", "Confidential Computing", "6G"],
    logo: "/img/logos/elastic-dark.png",
    link: "/projects/elastic",
  },
  {
    name: "EdgeX Foundry",
    tagline: "Open Source Edge Platform",
    description:
      "Contributing to the Linux Foundation's EdgeX Foundry project, providing edge intelligence and interoperability for IoT deployments. Magistrala integration enables seamless edge-cloud communication.",
    status: "Ongoing",
    year: "2017–Present",
    funding: "Linux Foundation",
    areas: ["Edge Computing", "IoT", "Open Source", "Interoperability"],
    logo: "/img/logos/lf.png",
    link: "https://www.edgexfoundry.org",
  },
  {
    name: "6G-IA",
    tagline: "European 6G Industry Association",
    description:
      "Active participation in shaping Europe's 6G vision and standards. Contributing to industrial IoT use cases, security frameworks, and edge computing architectures for next-gen networks.",
    status: "Member",
    year: "2021–Present",
    funding: "Industry Consortium",
    areas: ["6G Standards", "Industry Collaboration", "Policy", "Innovation"],
    logo: "/img/logos/6g-ia-long.png",
    link: "https://6g-ia.eu",
  },
];

const researchAreas = [
  {
    title: "Edge Intelligence",
    description: "Distributed AI and machine learning at the network edge",
    icon: Lightbulb,
  },
  {
    title: "Confidential Computing",
    description: "Secure execution environments for sensitive workloads",
    icon: Lock,
  },
  {
    title: "Network Slicing",
    description: "Dynamic resource allocation for heterogeneous services",
    icon: Network,
  },
  {
    title: "Zero Trust Architecture",
    description: "Security models for distributed systems",
    icon: ShieldCheck,
  },
];

const impactStats = [
  { value: "5+", label: "Open-source Products" },
  { value: "5+", label: "EU-Funded Projects" },
  { value: "15+", label: "Research Partners" },
];
---

<BaseLayout
  title="EU-Funded IoT & 6G Research Projects — Abstract Machines"
  description="Horizon Europe research initiatives spanning 6G security, WebAssembly edge orchestration, and confidential computing — with partners across industry and academia."
>
  <Header />

  <main>
    <!-- Hero -->
    <div class="proj-hero">
      <div class="container-wide">
        <span class="kicker">Research & Projects</span>
        <h1>Advancing the edge,<br />one programme at a time.</h1>
        <p class="lede" style="max-width:600px; margin-top:20px;">
          Horizon Europe–funded research initiatives and open-source ecosystem
          participation, pushing 6G security, WebAssembly orchestration, and
          confidential computing forward.
        </p>
        <div class="btn-row" style="margin-top:32px;">
          <a href="/contact" class="btn btn-primary">Partner with us</a>
          <a href="#projects" class="btn">Explore projects</a>
        </div>
        <div class="meta-grid">
          {
            impactStats.map(({ value, label }) => (
              <div>
                <div class="l">{label}</div>
                <div class="v">{value}</div>
              </div>
            ))
          }
          <div>
            <div class="l">Funding source</div>
            <div class="v">EU Horizon Europe</div>
          </div>
        </div>
      </div>
    </div>

    <!-- Projects grid -->
    <section id="projects">
      <div class="container-wide">
        <div class="section-head">
          <div class="left">
            <span class="kicker">Projects & collaborations</span>
            <h2 class="h-2" style="margin-top:14px;">
              EU-funded research &amp; open-source participation.
            </h2>
          </div>
        </div>
        <div class="proj-grid" style="margin-top:40px;">
          {
            projects.map(
              ({
                name,
                tagline,
                description,
                status,
                year,
                funding,
                areas,
                logo,
                link,
              }) => {
                const isExternal = link.startsWith("http");
                const badgeClass =
                  status === "Active"
                    ? "badge active"
                    : status === "Completed"
                      ? "badge complete"
                      : "badge";
                return (
                  <a
                    class="proj-card"
                    href={link}
                    target={isExternal ? "_blank" : undefined}
                    rel={isExternal ? "noopener noreferrer" : undefined}
                  >
                    <div class="logo">
                      <img src={logo} alt={`${name} logo`} loading="lazy" />
                    </div>
                    <div>
                      <span class={badgeClass}>
                        <span class="dot" />
                        {status}
                      </span>
                      <h3 class="name" style="margin-top:10px;">
                        {name}
                      </h3>
                      <p class="tagline">{tagline}</p>
                      <p style="font-size:13px; color:var(--ink-2); margin-top:10px; line-height:1.6;">
                        {description}
                      </p>
                      <div style="display:flex; flex-wrap:wrap; gap:6px; margin-top:14px;">
                        {areas.map((a) => (
                          <span class="tag">{a}</span>
                        ))}
                      </div>
                      <div class="meta">
                        <span>{funding}</span>
                        <span>{year}</span>
                      </div>
                    </div>
                  </a>
                );
              },
            )
          }
        </div>
      </div>
    </section>

    <!-- Research focus areas -->
    <section
      style="background:var(--paper-2); border-top:1px solid var(--line-3); border-bottom:1px solid var(--line-3);"
    >
      <div class="container-wide">
        <div class="section-head">
          <div class="left">
            <span class="kicker">Research focus</span>
            <h2 class="h-2" style="margin-top:14px;">
              Core competencies driving our innovation.
            </h2>
          </div>
        </div>
        <div class="focus-grid" style="margin-top:40px;">
          {
            researchAreas.map(({ title, description, icon: Icon }) => (
              <div
                class="card"
                style="display:flex; flex-direction:column; gap:16px; text-align:center; align-items:center;"
              >
                <div
                  class="icon-frame"
                  style="width:56px; height:56px; border-radius:50%; background:color-mix(in srgb,var(--accent) 10%,transparent); border:1px solid color-mix(in srgb,var(--accent) 20%,transparent); display:flex; align-items:center; justify-content:center; color:var(--accent);"
                >
                  <Icon size={22} />
                </div>
                <h3 class="h-3" style="margin:0;">
                  {title}
                </h3>
                <p style="font-size:14px; color:var(--ink-2); line-height:1.6; margin:0;">
                  {description}
                </p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <FinalCTA
      title="Collaborate with us"
      subtitle="Interested in partnering on research or joining a consortium? Let's talk."
      primary={{ label: "Get in touch", href: "/contact" }}
      secondary={null}
    />
  </main>

  <Footer />
</BaseLayout>

<style>
  .focus-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }
  @media (max-width: 980px) {
    .focus-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 600px) {
    .focus-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
