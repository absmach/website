---
const solutions = [
  ["Industrial IoT", "Secure, low-latency data flows for factory automation and industrial equipment.", ["Factory Automation", "Predictive Maintenance", "Energy"]],
  ["Smart Cities", "Distributed sensor networks for intelligent urban infrastructure.", ["Lighting", "Traffic", "Environmental"]],
  ["Edge AI & Analytics", "WebAssembly-orchestrated AI workloads at the network edge.", ["Live Inference", "Vision", "Anomaly Detection"]],
  ["Connected Healthcare", "Secure patient monitoring and compliant medical device integration.", ["Remote Monitoring", "Privacy", "Live Alerts"]],
  ["Fleet Management", "Continuous vehicle telemetry and route optimisation at scale.", ["GPS", "Fuel", "Diagnostics"]],
  ["Energy & Utilities", "Monitoring and control for distributed energy resources.", ["Smart Metering", "Grid", "Solar"]],
];
---

<section>
  <div class="container-wide">
    <div class="section-head">
      <div class="left">
        <span class="kicker">Solutions · Production deployments</span>
        <h2 class="h-1" style="margin-top:14px;">Infrastructure for demanding environments.</h2>
      </div>
      <a href="/solutions" class="btn-link">All solutions →</a>
    </div>
    <div class="sol-grid">
      {solutions.map(([title, description, tags]) => (
        <a class="sol-card" href="/solutions">
          <div class="icon-frame">{(title as string).charAt(0)}</div>
          <h3 class="name">{title}</h3>
          <p class="desc">{description}</p>
          <div class="tags">
            {(tags as string[]).map((tag) => <span class="tag">{tag}</span>)}
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
