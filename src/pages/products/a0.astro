---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import FAQAccordion from "../../components/FAQAccordion.astro";
import Radio from "lucide-astro/Radio";
import Battery from "lucide-astro/Battery";
import Layers from "lucide-astro/Layers";
import Shield from "lucide-astro/Shield";
import Zap from "lucide-astro/Zap";
import LockOpen from "lucide-astro/LockOpen";
import Gauge from "lucide-astro/Gauge";
import Settings2 from "lucide-astro/Settings2";
import MapPin from "lucide-astro/MapPin";
import Brain from "lucide-astro/Brain";

const a0BoardSpecs = [
  "ESP32-C6 RISC-V Core",
  "Wireless M-Bus (868 MHz)",
  "NB-IoT / LTE-M (SIM7080G)",
  "WiFi & Bluetooth LE",
  "Zephyr RTOS",
  "Open Source Hardware",
];

const baseboardSpecs = [
  "W5500 Ethernet Controller",
  "TSS721A M-Bus Transceiver",
  "SD Card Data Logging",
  "24V DC Power Input (18–36V)",
  "Battery Backup & Charging",
  "DIN-Rail Mountable",
];

const features = [
  {
    icon: Radio,
    name: "Multi-Protocol",
    desc: "Support for Wireless M-Bus, NB-IoT, LTE-M, WiFi, and BLE. Connect any device with any protocol.",
  },
  {
    icon: Battery,
    name: "Low Power Design",
    desc: "Ultra-low power operation with battery backup and charging. Perfect for remote deployments.",
  },
  {
    icon: Layers,
    name: "Modular Architecture",
    desc: "ESP32-C6 RISC-V core with expansion options. Add Ethernet, M-Bus, and SD card logging.",
  },
  {
    icon: Shield,
    name: "Secure by Design",
    desc: "Built on Zephyr RTOS with secure boot and encrypted communication for mission-critical apps.",
  },
  {
    icon: Zap,
    name: "Edge Computing",
    desc: "Run Wasm workloads at the edge. Perform AI inference and data processing locally.",
  },
  {
    icon: LockOpen,
    name: "Open Source",
    desc: "All hardware designs and firmware are open source. Customise and extend as needed.",
  },
];

const solutions = [
  {
    icon: Gauge,
    title: "Smart Metering",
    desc: "Collect utility consumption data from wireless meters and relay it securely to Magistrala.",
    tags: ["Wireless M-Bus", "NB-IoT", "Billing"],
  },
  {
    icon: Settings2,
    title: "Industrial Automation",
    desc: "Monitor equipment health and trigger alerts at the edge without cloud round-trips.",
    tags: ["Sensors", "Edge Logic", "Alerts"],
  },
  {
    icon: MapPin,
    title: "Remote Deployments",
    desc: "Battery-backed operation in locations without permanent power: pipelines, silos, and remote infrastructure.",
    tags: ["Battery", "Low-Power", "Remote"],
  },
  {
    icon: Brain,
    title: "Edge AI",
    desc: "Execute lightweight inference workloads on-device using Propeller's Wasm runtime.",
    tags: ["Wasm", "Inference", "On-Device"],
  },
];

const integrations = [
  "Magistrala",
  "Propeller",
  "Zephyr RTOS",
  "W5500 Ethernet",
  "SIM7080G (NB-IoT/LTE-M)",
  "TSS721A (M-Bus)",
];

const faqs = [
  {
    q: "What is Zephyr RTOS?",
    a: "Zephyr is a small, scalable real-time operating system designed for resource-constrained and embedded devices. It is maintained by the Linux Foundation and supports a wide range of microcontrollers including the ESP32-C6 used on the A0 Board.",
  },
  {
    q: "What is the difference between A0 and A1?",
    a: "A0 runs Zephyr RTOS on an ESP32-C6 microcontroller, optimised for low power and constrained environments. A1 runs full Linux on a RISC-V compute board (BeagleV-Fire) and supports containers and heavier workloads.",
  },
  {
    q: "Do I need the Baseboard to use A0?",
    a: "No. The A0 Board is fully functional on its own for wireless applications. The Baseboard adds wired Ethernet, M-Bus transceiver, SD card logging, industrial power input, and DIN-rail mounting for more demanding deployments.",
  },
  {
    q: "Can I customise the A0 firmware?",
    a: "Yes. The A0 firmware is open source. You can modify, extend, or replace it. The hardware schematics are also published, so you can adapt the board design for your specific requirements.",
  },
  {
    q: "Does A0 support Propeller Wasm workloads?",
    a: "Yes. A0 includes a lightweight Propeller runtime for Zephyr RTOS that allows the device to receive and execute Wasm workloads deployed remotely through the Propeller manager.",
  },
];
---

<BaseLayout
  title="A0 Edge Gateway — Abstract Machines"
  description="Low-power Zephyr RTOS gateway with Wireless M-Bus, NB-IoT, LTE-M, and Wasm support. Open hardware, built for constrained edge deployments."
>
  <Header />
  <main>

    <!-- Hero -->
    <section class="prod-hero has-video">
      <video
        class="hero-bg-video"
        autoplay
        muted
        loop
        playsinline
        poster="/video/hero-background-poster.webp"
        aria-hidden="true"
      >
        <source src="/video/hero-background.webm" type="video/webm" />
        <source src="/video/hero-background.mp4" type="video/mp4" />
      </video>
      <div class="container-wide">
        <div class="hero-grid">
          <div class="hero-copy">
            <div class="logo-mark">
              <span class="swatch" style="background:rgba(255,255,255,0.12);"></span>
              A0 · Edge Gateway · Hardware
            </div>
            <h1 class="tagline">A0 – Zephyr-based Gateway for Wireless IoT.</h1>
            <p class="lede" style="margin-top:16px; max-width:48ch;">
              A0 combines the A0 Board with the Baseboard into a low-power,
              Zephyr RTOS gateway. Built on ESP32-C6 RISC-V, it delivers
              multi-protocol wireless connectivity for smart metering,
              industrial automation, and constrained edge deployments.
            </p>
            <div class="btn-row" style="margin-top:32px;">
              <a href="https://www.absmach.eu/docs/hardware/s0-gateway/getting-started" class="btn btn-primary" target="_blank" rel="noopener">Start Building ↗</a>
              <a href="/contact" class="btn">Contact Us</a>
            </div>
            <div style="margin-top:20px;">
              <span class="badge success"><span class="dot"></span>Open Hardware</span>
            </div>
          </div>
          <div class="hero-visual" style="padding:16px;">
            <img
              src="/img/products/s0-board.webp"
              alt="A0 edge gateway board"
              style="object-fit:contain; max-height:420px;"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- Stats bar -->
    <div style="border-bottom:1px solid var(--line-3);">
      <div class="container-wide">
        <div class="a0-metrics metrics" style="border:none; border-radius:0; border-left:1px solid var(--line-3);">
          <div class="metric featured">
            <div class="v">ESP32-C6</div>
            <div class="l">RISC-V microcontroller</div>
          </div>
          <div class="metric">
            <div class="v">5+</div>
            <div class="l">Wireless protocols</div>
          </div>
          <div class="metric">
            <div class="v">Wasm</div>
            <div class="l">Edge compute ready</div>
          </div>
          <div class="metric">
            <div class="v">Open</div>
            <div class="l">Hardware &amp; firmware</div>
          </div>
        </div>
      </div>
    </div>

    <!-- A0 Board + Baseboard components -->
    <section class="section" style="border-bottom:1px solid var(--line-3);">
      <div class="container-wide">

        <!-- Component 1: A0 Board -->
        <div class="a0-component">
          <div class="a0-component-header">
            <span class="kicker">Component 1</span>
            <h2 class="h-2" style="margin-top:8px;">A0 Board</h2>
          </div>
          <div class="a0-component-body">
            <div class="a0-img-wrap">
              <img
                src="/img/products/s0-board-detail.webp"
                alt="A0 Board"
                class="a0-img"
                loading="lazy"
              />
            </div>
            <div class="a0-component-text">
              <p class="lede">
                The <strong>A0 Board</strong> is the wireless compute core of the A0 gateway.
                Built on the ESP32-C6 RISC-V microcontroller running <strong>Zephyr RTOS</strong>,
                it handles multi-protocol wireless data collection and cloud backhaul
                in a compact, low-power form factor.
              </p>
              <ul class="a0-spec-list">
                {a0BoardSpecs.map(spec => (
                  <li class="a0-spec-item">
                    <span class="a0-check">✓</span>
                    <span>{spec}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>

        <div class="a0-divider"></div>

        <!-- Component 2: Baseboard -->
        <div class="a0-component">
          <div class="a0-component-header">
            <span class="kicker">Component 2</span>
            <h2 class="h-2" style="margin-top:8px;">Baseboard</h2>
          </div>
          <div class="a0-component-body">
            <div class="a0-img-wrap">
              <img
                src="/img/products/s0-baseboard.webp"
                alt="A0 Baseboard"
                class="a0-img"
                loading="lazy"
              />
            </div>
            <div class="a0-component-text">
              <p class="lede">
                The <strong>Baseboard</strong> extends the A0 Board into a complete industrial
                gateway. It adds wired Ethernet, M-Bus transceiver, SD card logging,
                24V DC power, battery backup, and DIN-rail mounting: everything needed
                for professional smart metering and industrial installations.
              </p>
              <ul class="a0-spec-list">
                {baseboardSpecs.map(spec => (
                  <li class="a0-spec-item">
                    <span class="a0-check">✓</span>
                    <span>{spec}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>

      </div>
    </section>

    <!-- Features -->
    <section class="section" style="background:var(--paper-2); border-bottom:1px solid var(--line-3);">
      <div class="container-wide">
        <div class="section-head" style="text-align:center; display:block;">
          <span class="kicker">Features</span>
          <h2 class="h-2" style="margin-top:14px;">Built for Industrial IoT.</h2>
          <p class="lede" style="margin:12px auto 0; max-width:52ch;">
            Everything you need for smart metering and industrial automation
            in a modular, open-source platform.
          </p>
        </div>
        <div class="a0-feat-grid feature-grid" style="margin-top:48px;">
          {features.map(({ icon: Icon, name, desc }) => (
            <div class="feature">
              <div class="ic"><Icon size={18} /></div>
              <div class="name">{name}</div>
              <p class="desc">{desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Solutions -->
    <section class="section">
      <div class="container-wide">
        <div class="section-head">
          <div class="left">
            <span class="kicker">Solutions</span>
            <h2 class="h-2" style="margin-top:14px;">Where A0 deploys.</h2>
          </div>
        </div>
        <div class="a0-sol-grid sol-grid">
          {solutions.map(({ icon: Icon, title, desc, tags }) => (
            <div class="sol-card">
              <div class="icon-frame"><Icon size={22} /></div>
              <h3 class="name">{title}</h3>
              <p class="desc">{desc}</p>
              <div class="tags">
                {tags.map(t => <span class="tag">{t}</span>)}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Integrations -->
    <section class="section" style="background:var(--paper-2); border-top:1px solid var(--line-3); border-bottom:1px solid var(--line-3);">
      <div class="container-wide">
        <div class="section-head">
          <div class="left">
            <span class="kicker">Integrations</span>
            <h2 class="h-2" style="margin-top:14px;">Connects with the full stack.</h2>
          </div>
          <p class="lede">A0 is designed to run Magistrala and Propeller workloads at the extreme edge.</p>
        </div>
        <div class="integ-grid">
          {integrations.map(name => (
            <div class="integ-chip">
              <span class="dot"></span>
              {name}
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="section">
      <div class="container-wide">
        <div class="section-head">
          <div class="left">
            <span class="kicker">FAQ</span>
            <h2 class="h-2" style="margin-top:14px;">Common questions.</h2>
          </div>
        </div>
        <FAQAccordion items={faqs} />
      </div>
    </section>

    <!-- CTA -->
    <section class="section" style="background:var(--paper-2); border-top:1px solid var(--line-3);">
      <div class="container-narrow" style="text-align:center;">
        <span class="kicker">Get started</span>
        <h2 class="h-2" style="margin-top:14px;">Start building at the edge.</h2>
        <p class="lede" style="margin:20px auto 36px;">Read the getting-started guide, explore the open hardware schematics, or get in touch with the team.</p>
        <div class="btn-row" style="justify-content:center;">
          <a href="https://www.absmach.eu/docs/hardware/s0-gateway/getting-started" class="btn btn-primary" target="_blank" rel="noopener">Start Building ↗</a>
          <a href="/contact" class="btn">Contact Us</a>
        </div>
      </div>
      <div class="container-narrow" style="margin-top:48px; padding-top:32px; border-top:1px solid var(--line-3);">
        <p style="font-size:12px; color:var(--ink-4); text-align:center; line-height:1.6;">
          A0 hardware was developed with support from the European Union's Horizon Europe research and innovation programme as part of the <a href="/projects/elastic" style="color:var(--ink-3); text-decoration:underline;">ELASTIC project</a>.
        </p>
      </div>
    </section>

  </main>
  <Footer />
  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "Product",
    "name": "A0 Edge Gateway",
    "description": "Low-power Zephyr RTOS gateway with Wireless M-Bus, NB-IoT, LTE-M, and Wasm support. Open hardware, built for constrained edge deployments.",
    "url": "https://www.absmach.eu/products/a0",
    "brand": {
      "@type": "Brand",
      "name": "Abstract Machines"
    }
  }
  </script>
</BaseLayout>

<style>
  /* Metrics */
  .a0-metrics {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }
  @media (max-width: 640px) {
    .a0-metrics {
      grid-template-columns: 1fr;
    }
    .a0-metrics .metric {
      border-right: none;
    }
  }

  /* Component sections */
  .a0-component {
    padding: 48px 0;
  }
  .a0-component-header {
    margin-bottom: 40px;
  }
  .a0-component-body {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
    align-items: center;
  }
  @media (max-width: 768px) {
    .a0-component-body {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }

  .a0-img-wrap {
    border-radius: 16px;
    overflow: hidden;
    background: var(--paper-2);
    border: 1px solid var(--line-3);
  }
  .a0-img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 15px;
  }

  .a0-component-text .lede {
    color: var(--ink-2);
    margin-bottom: 24px;
  }
  .a0-component-text strong {
    color: var(--ink);
    font-weight: 600;
  }

  .a0-spec-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .a0-spec-item {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 14px;
    color: var(--ink-2);
  }
  .a0-check {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--paper-3);
    color: var(--ink-2);
    font-size: 11px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    font-weight: 700;
  }

  .a0-divider {
    height: 1px;
    background: var(--line-3);
  }

  /* Features grid */
  .a0-feat-grid {
    grid-template-columns: repeat(3, 1fr);
  }
  @media (max-width: 980px) {
    .a0-feat-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 640px) {
    .a0-feat-grid {
      grid-template-columns: 1fr;
    }
  }

  /* Solutions grid */
  .a0-sol-grid {
    grid-template-columns: repeat(2, 1fr);
  }
  @media (max-width: 640px) {
    .a0-sol-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
