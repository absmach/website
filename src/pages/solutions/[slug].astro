---
export const prerender = true;

import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import FAQAccordion from "../../components/FAQAccordion.astro";
import { solutions } from "../../data/solutions";

export async function getStaticPaths() {
  return solutions.map((sol) => ({
    params: { slug: sol.slug },
    props: { sol },
  }));
}

const { sol } = Astro.props;
---

<BaseLayout
  title={`${sol.title} — Abstract Machines`}
  description={sol.metaDescription}
>
  <Header />
  <main>
    <!-- Hero — 2-col on large screens -->
    <section class="sol-hero">
      <div class="container-wide">
        <a href="/solutions/" class="btn-link" style="font-size:13px; display:inline-flex; margin-bottom:24px;">← Solutions</a>
        <div class="hero-grid">
          <!-- Left: title + description + buttons -->
          <div class="hero-left">
            <span class="kicker">Solution Pack</span>
            <h1 class="h-1" style="margin-top:10px;">{sol.title}</h1>
            <p class="lede" style="margin-top:16px;">{sol.description}</p>
            <div class="btn-row" style="margin-top:28px;">
              <a
                href="https://cloud.magistrala.absmach.eu"
                target="_blank"
                rel="noopener noreferrer"
                class="btn btn-primary"
              >
                Try it free
              </a>
              <a href="/contact/" class="btn">Talk to us</a>
            </div>
          </div>
          <!-- Right: Why Magistrala callout -->
          <div class="hero-right">
            <div class="why-callout">
              <div class="why-callout-label">
                <span class="why-spark">✦</span>
                Why Magistrala
              </div>
              <p class="why-callout-text">{sol.whyMagistrala}</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Dashboard carousel -->
    {sol.dashboardScreenshots.length > 0 && (
      <section class="section-tight" style="background:var(--paper-2); border-top:1px solid var(--line-3); border-bottom:1px solid var(--line-3);">
        <div class="container-wide">
          <div style="text-align:center; margin-bottom:32px;">
            <span class="kicker">Platform Dashboards</span>
            <h2 class="h-2" style="margin-top:10px;">See it in action</h2>
            <p class="lede" style="margin-top:8px; max-width:560px; margin-left:auto; margin-right:auto;">
              Purpose-built dashboards for every layer of your {sol.title.toLowerCase()} deployment.
            </p>
          </div>
          <div class="carousel" id={`carousel-${sol.slug}`}>
            <div class="carousel-track">
              {sol.dashboardScreenshots.map((ss, i) => (
                <div class={`carousel-slide${i === 0 ? " active" : ""}`} data-index={i}>
                  <img
                    src={ss.src}
                    alt={ss.alt}
                    loading={i === 0 ? "eager" : "lazy"}
                    decoding="async"
                  />
                </div>
              ))}
            </div>
            {sol.dashboardScreenshots.length > 1 && (
              <div class="carousel-controls">
                <button class="carousel-btn prev" aria-label="Previous screenshot">‹</button>
                <div class="carousel-dots">
                  {sol.dashboardScreenshots.map((_, i) => (
                    <button class={`carousel-dot${i === 0 ? " active" : ""}`} data-dot={i} aria-label={`Screenshot ${i + 1}`}></button>
                  ))}
                </div>
                <button class="carousel-btn next" aria-label="Next screenshot">›</button>
              </div>
            )}
          </div>
        </div>
      </section>
    )}

    <!-- Challenges -->
    <section>
      <div class="container-wide">
        <div class="section-head">
          <div class="left">
            <span class="kicker">The Challenge</span>
            <h2 class="h-2" style="margin-top:10px;">{sol.challenges.title}</h2>
            <p class="lede" style="margin-top:10px;">{sol.challenges.subtitle}</p>
          </div>
        </div>
        <div class="feat-grid" style="margin-top:36px;">
          {sol.challenges.items.map(({ ic: Ic, title, desc }) => (
            <div class="card">
              <div class="icon-frame" style="width:40px; height:40px; border-radius:var(--radius-sm); background:color-mix(in srgb,var(--warn) 10%,transparent); border:1px solid color-mix(in srgb,var(--warn) 20%,transparent); display:flex; align-items:center; justify-content:center; color:var(--warn); margin-bottom:16px;">
                <Ic size={18} />
              </div>
              <h3 class="h-3">{title}</h3>
              <p style="margin-top:8px; font-size:13px; color:var(--ink-2); line-height:1.65;">{desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- How it works -->
    <section style="background:var(--paper-2); border-top:1px solid var(--line-3); border-bottom:1px solid var(--line-3);">
      <div class="container-wide">
        <div class="section-head">
          <div class="left">
            <span class="kicker">How it works</span>
            <h2 class="h-2" style="margin-top:10px;">From device to insight</h2>
            <p class="lede" style="margin-top:10px;">{sol.howItWorks.subtitle}</p>
          </div>
        </div>
        <div class="hiw-steps" style="margin-top:36px;">
          {sol.howItWorks.steps.map((step, i) => (
            <div class="card">
              <span class="step-num">{String(i + 1).padStart(2, "0")}</span>
              <h3 class="h-3" style="margin-top:12px;">{step.title}</h3>
              <p style="margin-top:8px; font-size:13px; color:var(--ink-2); line-height:1.65;">{step.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Applications -->
    <section>
      <div class="container-wide">
        <div class="section-head">
          <div class="left">
            <span class="kicker">Applications</span>
            <h2 class="h-2" style="margin-top:10px;">{sol.applications.title}</h2>
            <p class="lede" style="margin-top:10px;">{sol.applications.subtitle}</p>
          </div>
        </div>
        <div class="app-grid" style="margin-top:36px;">
          {sol.applications.items.map(({ ic: Ic, title, desc }) => (
            <div class="card" style="display:flex; gap:16px;">
              <div class="icon-frame" style="width:40px; height:40px; flex-shrink:0; border-radius:var(--radius-sm); background:var(--paper-2); border:1px solid var(--line-3); display:flex; align-items:center; justify-content:center; color:var(--ink-2);">
                <Ic size={18} />
              </div>
              <div>
                <h3 style="font-weight:600; font-size:14px;">{title}</h3>
                <p style="margin-top:6px; font-size:13px; color:var(--ink-2); line-height:1.65;">{desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Benefits -->
    <section style="background:var(--paper-2); border-top:1px solid var(--line-3); border-bottom:1px solid var(--line-3);">
      <div class="container-wide">
        <div class="section-head">
          <div class="left">
            <span class="kicker">Benefits</span>
            <h2 class="h-2" style="margin-top:10px;">What you get out of the box</h2>
          </div>
        </div>
        <ul class="benefits-list" style="margin-top:36px;">
          {sol.benefits.map((b) => (
            <li>
              <span class="benefit-check" aria-hidden="true">✓</span>
              <span>{b}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- FAQ -->
    {sol.faq.length > 0 && (
      <section>
        <div class="container-narrow">
          <div style="margin-bottom:32px;">
            <span class="kicker">FAQ</span>
            <h2 class="h-2" style="margin-top:10px;">Common questions</h2>
          </div>
          <FAQAccordion items={sol.faq.map((f) => ({ q: f.question, a: f.answer }))} />
        </div>
      </section>
    )}

    <!-- CTA -->
    <section class="section-tight" style="background:var(--paper-2); border-top:1px solid var(--line-3);">
      <div class="container-narrow" style="text-align:center;">
        <h2 class="h-2">Ready to deploy {sol.title}?</h2>
        <p class="lede" style="margin-top:12px;">
          Start free on Magistrala Cloud or contact us to scope a custom
          deployment for your organisation.
        </p>
        <div class="btn-row" style="margin-top:28px; justify-content:center;">
          <a
            href="https://magistrala.absmach.com"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-primary"
          >
            Start for free
          </a>
          <a href="/contact/" class="btn">Contact sales</a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  /* ── Hero ──────────────────────────────────────────────────── */
  .sol-hero {
    padding: 64px 0 56px;
    border-bottom: 1px solid var(--line-3);
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: start;
  }
  .hero-left {
    display: flex;
    flex-direction: column;
  }
  .hero-right {
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    padding-top: 8px;
  }

  /* ── Why Magistrala callout ─────────────────────────────────── */
  .why-callout {
    background: var(--paper-2);
    border: 1px solid var(--line-3);
    border-radius: var(--radius);
    padding: 20px 24px;
  }
  .why-callout-label {
    display: flex;
    align-items: center;
    gap: 6px;
    font-family: "JetBrains Mono", monospace;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--ink-3);
    margin-bottom: 8px;
  }
  .why-spark {
    font-size: 12px;
  }
  .why-callout-text {
    font-size: 13px;
    color: var(--ink-2);
    line-height: 1.65;
    margin: 0;
  }

  /* ── Carousel ───────────────────────────────────────────────── */
  .carousel {
    position: relative;
    max-width: 860px;
    margin: 0 auto;
  }
  .carousel-track {
    position: relative;
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--line-3);
    background: var(--paper);
    aspect-ratio: 16 / 9;
  }
  .carousel-slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .carousel-slide.active {
    opacity: 1;
    position: relative;
  }
  .carousel-slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    display: block;
  }
  .carousel-controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    margin-top: 16px;
  }
  .carousel-btn {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 1px solid var(--line-3);
    background: var(--paper);
    cursor: pointer;
    font-size: 20px;
    line-height: 1;
    color: var(--ink-2);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: border-color 0.15s, background 0.15s;
  }
  .carousel-btn:hover {
    border-color: var(--line-2);
    background: var(--paper-2);
  }
  .carousel-dots {
    display: flex;
    gap: 6px;
    align-items: center;
  }
  .carousel-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    border: none;
    background: var(--line-2);
    cursor: pointer;
    padding: 0;
    transition: background 0.15s, transform 0.15s;
  }
  .carousel-dot.active {
    background: var(--ink);
    transform: scale(1.3);
  }

  /* ── Section grids ──────────────────────────────────────────── */
  .feat-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }
  .hiw-steps {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }
  .app-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
  }
  .step-num {
    font-family: "JetBrains Mono", monospace;
    font-size: 11px;
    font-weight: 700;
    color: var(--ink-4);
    letter-spacing: 0.1em;
  }

  /* ── Benefits ───────────────────────────────────────────────── */
  .benefits-list {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .benefits-list li {
    display: flex;
    align-items: start;
    gap: 10px;
    font-size: 14px;
    color: var(--ink-2);
    line-height: 1.6;
  }
  .benefit-check {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--paper-3);
    color: var(--ink-2);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 10px;
    font-weight: 700;
    flex-shrink: 0;
    margin-top: 2px;
  }

  /* ── Responsive ─────────────────────────────────────────────── */
  @media (max-width: 980px) {
    .hero-grid { grid-template-columns: 1fr; gap: 28px; }
    .feat-grid { grid-template-columns: 1fr; }
    .hiw-steps { grid-template-columns: repeat(2, 1fr); }
    .benefits-list { grid-template-columns: 1fr; }
  }
  @media (max-width: 600px) {
    .hiw-steps { grid-template-columns: 1fr; }
    .app-grid { grid-template-columns: 1fr; }
  }
</style>

<script is:inline>
  document.querySelectorAll(".carousel").forEach((carousel) => {
    const slides = carousel.querySelectorAll(".carousel-slide");
    const dots = carousel.querySelectorAll(".carousel-dot");
    const prev = carousel.querySelector(".prev");
    const next = carousel.querySelector(".next");
    let current = 0;

    function goTo(n) {
      slides[current].classList.remove("active");
      dots[current]?.classList.remove("active");
      current = (n + slides.length) % slides.length;
      slides[current].classList.add("active");
      dots[current]?.classList.add("active");
    }

    prev?.addEventListener("click", () => goTo(current - 1));
    next?.addEventListener("click", () => goTo(current + 1));
    dots.forEach((dot, i) => dot.addEventListener("click", () => goTo(i)));
  });
</script>
