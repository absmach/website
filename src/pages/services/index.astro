---
import { ArrowRight, ArrowUpRight } from "@lucide/astro";
import IdentityLayout from "../../layouts/IdentityLayout.astro";
import "../../styles/identity-editorial.css";
import "../../styles/identity-pages.css";

const serviceLines = [
  {
    title: "Managed deployments",
    description:
      "End-to-end deployment and operations for your infrastructure.",
    bullets: [
      "Infrastructure setup",
      "Monitoring and alerting",
      "Performance optimisation",
      "Security updates",
      "Backup and disaster recovery",
      "SLA-backed support",
    ],
  },
  {
    title: "Custom development",
    description:
      "Tailored software for unique integration and extension requirements.",
    bullets: [
      "Custom protocols",
      "System integrations",
      "Feature development",
      "Custom firmware",
      "API design",
      "Performance optimisation",
    ],
  },
  {
    title: "Architecture and consulting",
    description: "Expert guidance for infrastructure design and security.",
    bullets: [
      "Architecture review",
      "Stack selection",
      "Security audit",
      "Scalability planning",
      "Migration strategies",
      "Best practices",
    ],
  },
  {
    title: "Training and support",
    description:
      "Empower your team to operate and extend the stack independently.",
    bullets: [
      "On-site and remote training",
      "Documentation",
      "Workshops",
      "Dedicated support",
      "Knowledge transfer",
      "Community access",
    ],
  },
];

const process = [
  {
    title: "Discovery",
    desc: "We review your requirements, existing stack, and goals to scope the right engagement.",
  },
  {
    title: "Planning",
    desc: "Technical specifications, timeline, and resource allocation, agreed before work begins.",
  },
  {
    title: "Delivery",
    desc: "Iterative development and deployment with regular milestone reviews.",
  },
  {
    title: "Support",
    desc: "Ongoing maintenance, monitoring, and optimisation to keep things running well.",
  },
];

const models = [
  {
    kicker: "One-time",
    title: "Project-based",
    desc: "Fixed scope and timeline with clear deliverables. Good for well-defined integrations or builds.",
    featured: false,
  },
  {
    kicker: "Monthly",
    title: "Retainer",
    desc: "Ongoing support and development at a predictable monthly cost. Our most common engagement.",
    featured: true,
  },
  {
    kicker: "Hourly",
    title: "Time and materials",
    desc: "Flexible engagement for evolving requirements or exploratory work.",
    featured: false,
  },
];
---

<IdentityLayout
  title="Services"
  description="Managed deployments, custom development, architecture consulting, and training for open-source IoT and AI infrastructure, delivered by the engineers who built it."
  active="work"
>
  <section class="ip-hero" aria-labelledby="services-title">
    <nav class="is-breadcrumb" aria-label="Breadcrumb">
      <a href="/">Abstract Machines</a><span>/</span> Services
    </nav>
    <div class="ip-hero-grid">
      <div>
        <p class="ie-eyebrow">Services / Engineering</p>
        <h1 id="services-title">
          From requirements<br /><span>to running systems.</span>
        </h1>
      </div>
      <div class="ip-hero-aside">
        <p>
          We deploy, extend, and maintain the Abstract Machines stack for
          production environments. Every engagement is with the engineers who
          built it.
        </p>
        <div class="ip-hero-actions">
          <a class="ie-button ie-button-white" href="/contact/"
            >Start a conversation <ArrowUpRight size={19} /></a
          ><a class="text-link" href="/products/"
            >Explore our work <ArrowRight size={18} /></a
          >
        </div>
      </div>
    </div>
  </section>

  <section class="ip-section" aria-labelledby="lines-title">
    <div class="ip-heading">
      <div>
        <p class="ie-eyebrow">What we do</p>
        <h2 id="lines-title">Four<br /><span>service lines.</span></h2>
      </div>
      <p>
        From first deployment to long-term operations, each line is staffed by
        the people who build the products.
      </p>
    </div>
    <ol class="ip-steps ip-steps-2">
      {
        serviceLines.map((line, i) => (
          <li>
            <span class="ie-number">{String(i + 1).padStart(2, "0")}</span>
            <h3>{line.title}</h3>
            <p>{line.description}</p>
            <ul class="ip-list ip-list-2" style="margin-top: 22px;">
              {line.bullets.map((bullet) => (
                <li>{bullet}</li>
              ))}
            </ul>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="ip-section ip-section--soft" aria-labelledby="process-title">
    <div class="ip-heading">
      <div>
        <p class="ie-eyebrow">Process</p>
        <h2 id="process-title">
          From discovery<br /><span>to delivery.</span>
        </h2>
      </div>
    </div>
    <ol class="ip-steps">
      {
        process.map((step, i) => (
          <li>
            <span class="ie-number">{String(i + 1).padStart(2, "0")}</span>
            <h3>{step.title}</h3>
            <p>{step.desc}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="ip-section" aria-labelledby="models-title">
    <div class="ip-heading">
      <div>
        <p class="ie-eyebrow">Engagement models</p>
        <h2 id="models-title">Pick the shape<br /><span>that fits.</span></h2>
      </div>
    </div>
    <div class="ip-grid ip-grid-3">
      {
        models.map((model) => (
          <article
            class:list={["ip-card", { "ip-card--navy": model.featured }]}
          >
            <div class="ip-card-top">
              <span class="ip-kicker">{model.kicker}</span>
              {model.featured && <span class="ip-kicker">Most common</span>}
            </div>
            <h3>{model.title}</h3>
            <p>{model.desc}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="ip-cta" aria-labelledby="services-cta-title">
    <div>
      <p class="ie-eyebrow">Ready to scope an engagement?</p>
      <h2 id="services-cta-title">
        Tell us what<br /><span>you’re building.</span>
      </h2>
    </div>
    <div>
      <p>We will come back with a concrete proposal within a few days.</p>
      <div class="ip-actions">
        <a class="ie-button ie-button-white" href="/contact/"
          >Start a conversation <ArrowUpRight size={19} /></a
        ><a class="text-link" href="/solutions/"
          >See our solution packs <ArrowRight size={18} /></a
        >
      </div>
    </div>
  </section>
</IdentityLayout>
