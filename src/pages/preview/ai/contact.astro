---
import { ArrowUpRight } from "@lucide/astro";
import IdentityLayout from "../../../layouts/IdentityLayout.astro";
import { identityPhoto } from "../../../data/identity-photos";
import { products } from "../../../data/identity-products";
---

<IdentityLayout
  title="Let’s talk"
  description="Talk with Abstract Machines about AI products, connected systems, and research partnerships."
>
  <section class="co-hero">
    <nav class="is-breadcrumb" aria-label="Breadcrumb">
      <a href="/preview/ai/">Abstract Machines</a><span>/</span> Contact
    </nav><h1>Every good project<br /><span>starts somewhere.</span></h1><p>
      Tell us what you’re exploring. A product, an engineering challenge, or a
      research question—we’d like to hear about it.
    </p>
  </section>
  <section class="co-body">
    <div>
      <form
        id="contact-draft-form"
        class="co-form"
        action="mailto:info@absmach.eu"
        method="post"
        enctype="text/plain"
      >
        <h2>What’s on your mind?</h2><fieldset class="co-topic">
          <legend>I’d like to discuss</legend><div class="co-topic-options">
            <label
              ><input type="radio" name="topic" value="product" checked /><span
                >A product</span
              ></label
            ><label
              ><input type="radio" name="topic" value="engineering" /><span
                >An engineering project</span
              ></label
            ><label
              ><input type="radio" name="topic" value="research" /><span
                >A research partnership</span
              ></label
            >
          </div>
        </fieldset><div class="co-fields">
          <div class="co-field">
            <label for="contact-name">Your name</label><input
              id="contact-name"
              name="name"
              autocomplete="name"
              required
              maxlength="150"
            />
          </div><div class="co-field">
            <label for="contact-email">Email address</label><input
              id="contact-email"
              name="email"
              type="email"
              autocomplete="email"
              required
              maxlength="254"
            />
          </div><div class="co-field">
            <label for="contact-company"
              >Organisation <span>(optional)</span></label
            ><input
              id="contact-company"
              name="organisation"
              autocomplete="organization"
              maxlength="200"
            />
          </div><div class="co-field">
            <label for="contact-product">Product of interest</label><select
              id="contact-product"
              name="product"
              ><option value="">Let’s find the right fit</option>{
                products.map((product) => (
                  <option value={product.name} data-slug={product.slug}>
                    {product.name}
                  </option>
                ))
              }</select
            >
          </div><div class="co-field co-full">
            <label for="contact-message"
              >What are you building or exploring?</label
            ><textarea
              id="contact-message"
              name="message"
              required
              maxlength="5000"
              rows="6"
              placeholder="A little context about your project, the challenge, and what you have in mind."
            ></textarea>
          </div>
        </div><div class="co-actions">
          <button class="is-button" type="submit"
            >Prepare your message <ArrowUpRight size={19} /></button
          ><p>
            Prepare an email draft, then open it in your email app to review and
            send.
          </p>
        </div><p
          id="contact-status"
          class="co-status"
          role="status"
          aria-live="polite"
        >
        </p>
      </form><section
        class="co-draft"
        id="contact-draft"
        aria-labelledby="draft-title"
        hidden
      >
        <h3 id="draft-title">Your conversation starts here.</h3><p>
          Review the draft below. Send it from your email app or copy it to your
          preferred mail service.
        </p><label for="draft-body" class="section-label">EMAIL DRAFT</label
        ><textarea id="draft-body" readonly></textarea><div
          class="co-draft-actions"
        >
          <a
            id="draft-mail-link"
            class="is-button"
            href="mailto:info@absmach.eu"
            >Open in email app <ArrowUpRight size={18} /></a
          ><button id="copy-draft" type="button">Copy message</button>
        </div>
      </section>
    </div><aside class="co-aside">
      <img
        class="co-aside-image"
        {...identityPhoto("contact-paris.webp")}
        loading="lazy"
      /><div>
        <p class="section-label">
          <span class="label-line"></span> BASED IN PARIS
        </p><h2>Working across borders.</h2><a
          class="co-email"
          href="mailto:info@absmach.eu">info@absmach.eu</a
        ><address class="co-address">
          Abstract Machines<br />141 Quai de Valmy<br />75010 Paris, France
        </address><div class="co-aside-links">
          <a class="text-link" href="/preview/ai/company/"
            >Meet the company <ArrowUpRight size={16} /></a
          ><a class="text-link" href="https://github.com/absmach"
            >GitHub <ArrowUpRight size={16} /></a
          >
        </div>
      </div>
    </aside>
  </section>
  <script>
    const form = document.querySelector<HTMLFormElement>("#contact-draft-form");
    const product =
      document.querySelector<HTMLSelectElement>("#contact-product");
    const query = new URLSearchParams(location.search);
    const requestedProduct = query.get("product")?.toLowerCase();
    if (product && requestedProduct) {
      const option = Array.from(product.options).find(
        (option) =>
          option.value.toLowerCase() === requestedProduct ||
          option.dataset.slug === requestedProduct,
      );
      if (option) product.value = option.value;
    }
    const requestedTopic = query.get("topic");
    if (
      requestedTopic &&
      ["product", "engineering", "research"].includes(requestedTopic)
    ) {
      const radio = document.querySelector<HTMLInputElement>(
        `input[name="topic"][value="${requestedTopic}"]`,
      );
      if (radio) radio.checked = true;
    }
    const draft = document.querySelector<HTMLTextAreaElement>("#draft-body");
    const panel = document.querySelector<HTMLElement>("#contact-draft");
    const status = document.querySelector<HTMLElement>("#contact-status");
    const mail = document.querySelector<HTMLAnchorElement>("#draft-mail-link");
    form?.addEventListener("submit", (event) => {
      event.preventDefault();
      if (!form.reportValidity()) return;
      const fields = new FormData(form);
      const topic = String(fields.get("topic"));
      const subject = `Abstract Machines — ${topic === "research" ? "Research partnership" : topic === "engineering" ? "Engineering project" : "Product conversation"}${fields.get("product") ? ` / ${fields.get("product")}` : ""}`;
      const body = `Hello Abstract Machines,\n\n${String(fields.get("message")).trim()}\n\nName: ${String(fields.get("name")).trim()}\nEmail: ${String(fields.get("email")).trim()}${fields.get("organisation") ? `\nOrganisation: ${String(fields.get("organisation")).trim()}` : ""}${fields.get("product") ? `\nProduct: ${fields.get("product")}` : ""}`;
      if (draft)
        draft.value = `To: info@absmach.eu\nSubject: ${subject}\n\n${body}`;
      if (mail)
        mail.href = `mailto:info@absmach.eu?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
      if (panel) panel.hidden = false;
      if (status)
        status.textContent =
          "Your draft is ready. Open it in your email app to review and send.";
      panel?.scrollIntoView({
        behavior: matchMedia("(prefers-reduced-motion: reduce)").matches
          ? "auto"
          : "smooth",
        block: "nearest",
      });
    });
    document
      .querySelector("#copy-draft")
      ?.addEventListener("click", async () => {
        if (!draft) return;
        try {
          await navigator.clipboard.writeText(draft.value);
          if (status)
            status.textContent =
              "Message copied. Paste it into your preferred email app.";
        } catch {
          draft.focus();
          draft.select();
          if (status)
            status.textContent =
              "Select and copy the draft, then paste it into your email app.";
        }
      });
  </script>
</IdentityLayout>
