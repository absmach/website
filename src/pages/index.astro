---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import HeroBig from "../components/HeroBig.astro";
import ProductsPreview from "../components/ProductsPreview.astro";
import ProjectsPreview from "../components/ProjectsPreview.astro";
import FinalCTA from "../components/FinalCTA.astro";
import PartnersCarousel from "../components/PartnersCarousel.astro";
---

<BaseLayout
  title="Secure Cloud & Edge Systems | Abstract Machines"
  description="Secure, open-source infrastructure for distributed cloud and edge systems."
>
  <Header />
  <main>
    <HeroBig
      title="Secure Cloud & Edge Systems"
      subtitle="Build secure, open-source infrastructure combining messaging, orchestration, and gateway technologies for cloud and edge computing."
      backgroundClass="hero-grid"
      primary={{
        label: "Explore Products",
        href: "#products",
        external: false,
        ariaLabel: "Explore our products"
      }}
      secondary={{
        label: "Get Started",
        href: "/contact/",
        external: false,
        ariaLabel: "Get started with Abstract Machines"
      }}
    >
      <PartnersCarousel />
    </HeroBig>
    <ProductsPreview />
    <ProjectsPreview />
    <FinalCTA />
  </main>
  <Footer />
</BaseLayout>
