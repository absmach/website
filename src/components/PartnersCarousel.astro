---
const logos: [string, string][] = [
  ["/img/logos/nokia.svg", "Nokia"],
  ["/img/logos/nokia-bellLabs.svg", "Nokia Bell Labs"],
  ["/img/logos/intel.png", "Intel"],
  ["/img/logos/ericsson.png", "Ericsson"],
  ["/img/logos/telefonica.png", "Telefonica"],
  ["/img/logos/THALES.png", "Thales"],
  ["/img/logos/IMEC.png", "IMEC"],
  ["/img/logos/fraunhofer.png", "Fraunhofer"],
  ["/img/logos/fujitsu.png", "Fujitsu"],
  ["/img/logos/vtt.png", "VTT"],
  ["/img/logos/tno.png", "TNO"],
  ["/img/logos/wings-logo.png", "WINGS"],
  ["/img/logos/LUND.png", "Lund University"],
  ["/img/logos/POLITO.png", "Politecnico di Torino"],
  ["/img/logos/imdea.png", "IMDEA"],
  ["/img/logos/TUC.png", "Technical University of Crete"],
  ["/img/logos/tuw.png", "TU Wien"],
  ["/img/logos/tue.png", "TU Eindhoven"],
  ["/img/logos/ucd.png", "University College Dublin"],
  ["/img/logos/AAL.png", "Aalto University"],
  ["/img/logos/parc.png", "PARC"],
  ["/img/logos/target.png", "Target"],
  ["/img/logos/zen.png", "Zen"],
  ["/img/logos/greennet.png", "GreenNet"],
  ["/img/logos/eu.png", "European Union"],
];
---

<section class="section-tight" style="padding-top:1rem;">
  <div class="container-wide">
    <div class="marquee-wrap">
      <div class="marquee-track">
        {
          [...logos, ...logos].map(([file, name]) => (
            <img src={file} alt={name} loading="lazy" />
          ))
        }
      </div>
    </div>
  </div>
</section>
