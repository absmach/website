---
import { ArrowUpRight, ArrowRight } from "@lucide/astro";
import IdentityLayout from "../../../layouts/IdentityLayout.astro";
import { identityPhoto } from "../../../data/identity-photos";
import "../../../styles/identity-editorial.css";

const principles = [
  {
    title: "Think in systems.",
    text: "An intelligent application depends on everything around it: data, identity, software, and the decisions people make. We work across those boundaries.",
  },
  {
    title: "Make the work inspectable.",
    text: "Readable source, clear interfaces, and evidence people can examine. Open-source engineering is a practical part of how we build.",
  },
  {
    title: "Stay close to the problem.",
    text: "A product starts with a useful job to do. Research gives us room to explore; engineering turns what we learn into something people can use.",
  },
];
---

<IdentityLayout
  title="Company"
  description="An applied AI company based in Paris, building on open-source software, connected systems, and European research."
  active="company"
>
  <section class="ie-company-hero ie-shell">
    <div class="ie-company-intro">
      <p class="ie-eyebrow">Company / Abstract Machines</p>
      <h1>Curiosity.<br />Conviction.<br /><span>Engineering.</span></h1>
      <p class="ie-lead">
        We build intelligent software and the infrastructure that makes it
        useful.
      </p>
      <p>
        Based in Paris, Abstract Machines brings together applied AI,
        open-source engineering, and research into the systems behind tomorrow’s
        applications.
      </p>
      <a class="text-link" href="/preview/ai/contact/"
        >Get to know us <ArrowUpRight size={20} /></a
      >
    </div>
    <figure class="ie-company-photo">
      <img {...identityPhoto("company-paris.webp")} fetchpriority="high" />
      <figcaption>
        <span>Paris, France</span><span
          >A European perspective.<br />An open outlook.</span
        >
      </figcaption>
    </figure>
  </section>

  <div class="ie-facts ie-shell" aria-label="About Abstract Machines">
    <div><span>Founded</span><strong>2023</strong></div>
    <div><span>Based in</span><strong>Paris, France</strong></div>
    <div>
      <span>Engineering culture</span><a href="https://github.com/absmach"
        >Open source <ArrowUpRight size={18} /></a
      >
    </div>
    <div>
      <span>Research</span><a href="/preview/ai/research/"
        >European collaboration <ArrowUpRight size={18} /></a
      >
    </div>
  </div>

  <section
    class="ie-shell ie-section ie-company-story"
    aria-labelledby="company-direction"
  >
    <div>
      <p class="ie-eyebrow">Our next chapter</p><h2 id="company-direction">
        New possibilities.<br /><span>The same foundations.</span>
      </h2>
    </div>
    <div class="ie-prose">
      <p class="ie-lead">
        Our work began with the practical challenges of connected systems.
      </p>
      <p>
        Moving data between devices and applications. Managing identity and
        access. Building software that can run at the edge and in the cloud.
        Those questions shaped our connectivity portfolio and our approach to
        engineering.
      </p>
      <p>
        AI brings a new set of possibilities to that foundation. Today, our work
        extends to tools for creating applications, designing electronics,
        turning product knowledge into content, and exploring the behaviour of
        complex infrastructure.
      </p>
      <p>
        We develop products and research new approaches with the same purpose:
        to give people more capable software, and more control over how it
        works.
      </p>
      <a class="text-link" href="/preview/ai/work/"
        >Meet our products <ArrowRight size={19} /></a
      >
    </div>
  </section>

  <section
    id="approach"
    class="ie-principles ie-shell ie-section"
    aria-labelledby="principles-title"
  >
    <div class="ie-section-heading">
      <div>
        <p class="ie-eyebrow">How we work</p><h2 id="principles-title">
          An engineering<br /><span>point of view.</span>
        </h2>
      </div><p>
        Principles that connect our products,<br />our research, and our
        everyday work.
      </p>
    </div>
    <div class="ie-principle-grid">
      {
        principles.map((principle, index) => (
          <article>
            <>
              <span class="ie-number">0{index + 1}</span>
              <h3>{principle.title}</h3>
              <p>{principle.text}</p>
            </>
          </article>
        ))
      }
    </div>
  </section>

  <section class="ie-company-research" aria-labelledby="company-research-title">
    <img {...identityPhoto("company-research.webp")} loading="lazy" />
    <div>
      <p class="ie-eyebrow">Research & collaboration</p><h2
        id="company-research-title"
      >
        Good questions<br />take us further.
      </h2><p>
        Through European research partnerships, we contribute to work on service
        orchestration, confidential computing, and security across the cloud and
        edge.
      </p><a class="text-link" href="/preview/ai/research/"
        >Explore our research <ArrowUpRight size={20} /></a
      >
    </div>
  </section>

  <section
    class="ie-shell ie-section ie-closing"
    aria-labelledby="company-contact-title"
  >
    <div>
      <p class="ie-eyebrow">Let’s work together</p><h2
        id="company-contact-title"
      >
        What are you<br /><span>working towards?</span>
      </h2>
    </div><div>
      <p>
        A product to explore, a system to build, or a research question to
        investigate. We would like to hear about it.
      </p><a class="ie-button" href="/preview/ai/contact/"
        >Start a conversation <ArrowUpRight size={20} /></a
      >
    </div>
  </section>
</IdentityLayout>
