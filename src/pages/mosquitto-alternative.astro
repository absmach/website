---
import { ArrowRight, ArrowUpRight } from "@lucide/astro";
import IdentityLayout from "../layouts/IdentityLayout.astro";
import Faq from "../components/identity/Faq.astro";
import "../styles/identity-editorial.css";
import "../styles/identity-pages.css";

const comparisonRows = [
  { feature: "MQTT 3.1.1 and 5.0", fluxmq: "Yes", mosquitto: "Yes" },
  { feature: "AMQP 0.9.1", fluxmq: "Yes", mosquitto: "No" },
  { feature: "AMQP 1.0", fluxmq: "Yes", mosquitto: "No" },
  { feature: "CoAP bridge", fluxmq: "Yes", mosquitto: "No" },
  {
    feature: "Built-in horizontal clustering",
    fluxmq: "Yes (embedded etcd)",
    mosquitto: "No",
  },
  {
    feature: "Durable message queues",
    fluxmq: "Yes (consumer groups, DLQ)",
    mosquitto: "No",
  },
  { feature: "Kafka-style retention", fluxmq: "Yes", mosquitto: "No" },
  { feature: "Raft-based replication", fluxmq: "Yes", mosquitto: "No" },
  {
    feature: "Per-IP and per-client rate limiting",
    fluxmq: "Yes",
    mosquitto: "Plugin required",
  },
  {
    feature: "mTLS inter-broker gRPC",
    fluxmq: "Yes",
    mosquitto: "N/A (no clustering)",
  },
  {
    feature: "Zero external dependencies",
    fluxmq: "Yes (single Go binary)",
    mosquitto: "Yes (single C binary)",
  },
  { feature: "License", fluxmq: "Apache 2.0", mosquitto: "EPL 2.0 / EDL 1.0" },
];

const strengths = [
  {
    title: "Development and testing",
    desc: "Fast to spin up, minimal configuration, runs everywhere. The standard choice for local development and integration testing.",
  },
  {
    title: "Constrained devices",
    desc: "The Mosquitto C binary is lean enough to run on embedded Linux systems with very limited resources.",
  },
  {
    title: "Small deployments",
    desc: "For a single-site installation with a few hundred devices and no high-availability requirement, Mosquitto is simple and reliable.",
  },
  {
    title: "Broad client compatibility",
    desc: "Every MQTT client library has been tested against Mosquitto. It is the reference implementation.",
  },
];

const limits = [
  {
    title: "No built-in clustering",
    desc: "Mosquitto is a single-node broker. High-availability setups require external tooling such as load balancers, shared state stores, or broker bridges, none of which Mosquitto manages itself.",
  },
  {
    title: "No durable queues",
    desc: "Mosquitto has QoS 1/2 and retained messages but no durable queue semantics: no consumer groups, offset tracking, dead-letter queues, or Kafka-style retention with replay.",
  },
  {
    title: "MQTT only",
    desc: "Mosquitto speaks MQTT. If your architecture also has AMQP services such as RabbitMQ consumers, SAP integrations, or Azure Service Bus connectors, you need a separate broker for that traffic.",
  },
  {
    title: "Limited at scale",
    desc: "Mosquitto handles hundreds of thousands of connections on capable hardware but cannot distribute that load across multiple nodes natively. FluxMQ scales linearly by adding nodes.",
  },
];

const migration = [
  {
    title: "Run FluxMQ alongside Mosquitto",
    desc: "Start FluxMQ on the same network. Point a test client at FluxMQ on port 1883. Both brokers can run simultaneously during migration.",
  },
  {
    title: "Validate client compatibility",
    desc: "Connect your existing MQTT clients to FluxMQ. QoS levels, retained messages, Last Will and Testament, and shared subscriptions all work as expected.",
  },
  {
    title: "Cut over and enable clustering",
    desc: "Redirect clients to FluxMQ. When ready for high availability, add cluster nodes in the YAML configuration. etcd handles coordination automatically.",
  },
];

const faqs = [
  {
    q: "Why do teams outgrow Mosquitto?",
    a: "Mosquitto is a single-node broker. When deployments need high availability, horizontal scaling, or durable message delivery guarantees, Mosquitto cannot be extended without external orchestration. FluxMQ ships clustering, Raft replication, and durable queues out of the box.",
  },
  {
    q: "Is FluxMQ a drop-in replacement for Mosquitto?",
    a: "Yes for clients. Any MQTT 3.1.1 or 5.0 client that works with Mosquitto connects to FluxMQ without code changes, because the wire protocol is identical. The operational difference is that FluxMQ is configured differently and adds AMQP, durable queues, and clustering on top.",
  },
  {
    q: "Does FluxMQ support the same MQTT feature set as Mosquitto?",
    a: "FluxMQ supports all standard MQTT 3.1.1 and 5.0 features including QoS 0/1/2, retained messages, Last Will and Testament, shared subscriptions, flow control, and user properties. MQTT 5.0 feature coverage is complete.",
  },
  {
    q: "Can I run FluxMQ as a single node like Mosquitto?",
    a: "Yes. FluxMQ runs as a single node with the same single-binary operational model as Mosquitto. Clustering is opt-in: add cluster peers in the YAML configuration when you are ready to scale.",
  },
  {
    q: "What is the license difference?",
    a: "Mosquitto is dual-licensed under the Eclipse Public License 2.0 and Eclipse Distribution License 1.0. FluxMQ is Apache 2.0. Both are open source. Apache 2.0 is generally considered more permissive for commercial use and integration into proprietary systems.",
  },
  {
    q: "How does FluxMQ handle 500K+ concurrent connections?",
    a: "FluxMQ uses zero-copy packet parsing, object pooling, and efficient trie-based topic matching to sustain high connection counts. Session ownership is tracked per broker node, with sub-100ms session takeover when a node fails.",
  },
];

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map(({ q, a }) => ({
      "@type": "Question",
      name: q,
      acceptedAnswer: { "@type": "Answer", text: a },
    })),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Home",
        item: "https://www.absmach.eu/",
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "Mosquitto Alternative",
        item: "https://www.absmach.eu/mosquitto-alternative/",
      },
    ],
  },
];
const cellClass = (value: string) =>
  value === "No" || value.startsWith("N/A")
    ? "is-no"
    : value === "Yes"
      ? "is-yes"
      : undefined;
---

<IdentityLayout
  title="Mosquitto alternative: FluxMQ MQTT broker"
  description="Looking for a Mosquitto alternative with clustering, durable queues, and AMQP? FluxMQ is an open-source MQTT 5.0 broker designed for enterprise IoT: 500K+ connections, no external dependencies, Apache 2.0."
  active="work"
>
  <Fragment slot="head">
    {
      structuredData.map((entry) => (
        <script type="application/ld+json" set:html={JSON.stringify(entry)} />
      ))
    }
  </Fragment>

  <section class="ip-hero" aria-labelledby="alt-title">
    <nav class="is-breadcrumb" aria-label="Breadcrumb">
      <a href="/">Abstract Machines</a><span>/</span><a href="/products/fluxmq/"
        >FluxMQ</a
      ><span>/</span> Mosquitto alternative
    </nav>
    <div class="ip-hero-grid">
      <div>
        <p class="ie-eyebrow">Mosquitto alternative / FluxMQ</p>
        <h1 id="alt-title">
          Where Mosquitto stops,<br /><span>FluxMQ takes over.</span>
        </h1>
      </div>
      <div class="ip-hero-aside">
        <p>
          Eclipse Mosquitto is excellent for development and small deployments.
          When you need clustering, durable message delivery, AMQP support, and
          100K+ connections, FluxMQ picks up where Mosquitto leaves off.
        </p>
        <div class="ip-hero-actions">
          <a class="ie-button ie-button-white" href="/products/fluxmq/"
            >Explore FluxMQ <ArrowRight size={19} /></a
          ><a class="text-link" href="https://github.com/absmach/fluxmq"
            >GitHub <ArrowUpRight size={18} /></a
          >
        </div>
      </div>
    </div>
  </section>

  <section class="ip-section ip-section--tight" aria-label="Summary">
    <div class="ip-note">
      <h2>When does Mosquitto need an alternative?</h2>
      <p>
        Mosquitto is a single-node MQTT broker. It has no built-in clustering,
        no durable queues, and no AMQP support. Teams that need high
        availability, horizontal scaling beyond a single node, or guaranteed
        message delivery to consumer groups typically migrate to a distributed
        broker like FluxMQ.
      </p>
    </div>
  </section>

  <section class="ip-section" aria-labelledby="context-title">
    <div class="ip-heading">
      <div>
        <p class="ie-eyebrow">Context</p>
        <h2 id="context-title">What Mosquitto<br /><span>is good at.</span></h2>
      </div>
      <p>
        Mosquitto is a mature, lightweight MQTT broker maintained by the Eclipse
        Foundation. It is the right tool for many use cases.
      </p>
    </div>
    <div class="ip-grid ip-grid-2">
      {
        strengths.map((item) => (
          <article class="ip-card">
            <h3>{item.title}</h3>
            <p>{item.desc}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="ip-section ip-section--soft" aria-labelledby="limits-title">
    <div class="ip-heading">
      <div>
        <p class="ie-eyebrow">Limitations</p>
        <h2 id="limits-title">
          Where Mosquitto<br /><span>hits its ceiling.</span>
        </h2>
      </div>
    </div>
    <div class="ip-points">
      {
        limits.map((item) => (
          <div class="ip-point">
            <h3>{item.title}</h3>
            <p>{item.desc}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="ip-section" aria-labelledby="compare-title">
    <div class="ip-heading">
      <div>
        <p class="ie-eyebrow">Comparison</p>
        <h2 id="compare-title">
          FluxMQ and Mosquitto,<br /><span>feature by feature.</span>
        </h2>
      </div>
    </div>
    <div class="ip-table-wrap">
      <table class="ip-table">
        <thead>
          <tr>
            <th scope="col">Feature</th>
            <th scope="col" class="is-highlight">FluxMQ</th>
            <th scope="col">Mosquitto</th>
          </tr>
        </thead>
        <tbody>
          {
            comparisonRows.map(({ feature, fluxmq, mosquitto }) => (
              <tr>
                <th scope="row">{feature}</th>
                <td class="is-highlight is-yes">{fluxmq}</td>
                <td class={cellClass(mosquitto)}>{mosquitto}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <p class="ip-table-note">
      Sources: Eclipse Mosquitto documentation (mosquitto.org) and FluxMQ source
      code and documentation (github.com/absmach/fluxmq). The Mosquitto plugin
      ecosystem can extend some features; the table reflects out-of-the-box
      capabilities.
    </p>
  </section>

  <section
    class="ip-section ip-section--navy"
    aria-labelledby="highlights-title"
  >
    <div class="ip-heading">
      <div>
        <p class="ie-eyebrow">FluxMQ</p>
        <h2 id="highlights-title">
          Built for what<br /><span>Mosquitto doesn’t cover.</span>
        </h2>
      </div>
      <p>
        Same MQTT wire protocol. Full clustering, durable queues, and AMQP
        support added. Apache 2.0 for all features.
      </p>
    </div>
    <div class="ip-stats">
      <div>
        <strong>500K+</strong><span>Concurrent connections per node</span>
      </div>
      <div><strong>300K+</strong><span>Messages per second per node</span></div>
      <div><strong>&lt;10ms</strong><span>Local latency</span></div>
      <div>
        <strong>Apache 2.0</strong><span>All features, no enterprise tier</span>
      </div>
    </div>
  </section>

  <section class="ip-section" aria-labelledby="migration-title">
    <div class="ip-heading">
      <div>
        <p class="ie-eyebrow">Migration</p>
        <h2 id="migration-title">
          Moving from Mosquitto<br /><span>to FluxMQ.</span>
        </h2>
      </div>
      <p>
        Client code does not change. Any MQTT 3.1.1 or 5.0 client that connects
        to Mosquitto connects to FluxMQ without modification.
      </p>
    </div>
    <ol class="ip-steps ip-steps-3">
      {
        migration.map((step, i) => (
          <li>
            <span class="ie-number">{String(i + 1).padStart(2, "0")}</span>
            <h3>{step.title}</h3>
            <p>{step.desc}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="ip-section ip-section--soft" aria-labelledby="faq-title">
    <div class="ip-heading">
      <div>
        <p class="ie-eyebrow">FAQ</p>
        <h2 id="faq-title">Common questions.</h2>
      </div>
    </div>
    <Faq items={faqs} />
  </section>

  <section class="ip-cta" aria-labelledby="scale-title">
    <div>
      <p class="ie-eyebrow">Get started</p>
      <h2 id="scale-title">
        Ready to scale<br /><span>beyond Mosquitto?</span>
      </h2>
    </div>
    <div>
      <p>
        FluxMQ is open source, Apache 2.0, and ships as a single Go binary. No
        external dependencies. Full clustering from day one.
      </p>
      <div class="ip-actions">
        <a
          class="ie-button ie-button-white"
          href="https://github.com/absmach/fluxmq"
          >View on GitHub <ArrowUpRight size={19} /></a
        ><a class="text-link" href="https://www.absmach.eu/docs/fluxmq"
          >Documentation <ArrowUpRight size={18} /></a
        >
      </div>
    </div>
  </section>
</IdentityLayout>
