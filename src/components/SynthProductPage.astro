---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import FAQAccordion from "./FAQAccordion.astro";
import SynthLogo from "./SynthLogo.astro";
import {
  ArrowRight,
  Check,
  CircuitBoard,
  GitBranch,
  ShieldCheck,
  Sparkles,
} from "@lucide/astro";

const edition = "Community + Enterprise";
const faqs = [
  {
    q: "What is Synth?",
    a: "Synth is an open-source circuit compiler built for engineers and AI agents. Agents turn prompts into readable circuit source; Synth compiles it into KiCad schematics, boards, and BOMs with deterministic placement and routing. Compiler diagnostics, electrical-rule checks (ERC), and design-rule checks (DRC) give agents concrete feedback for correction loops and engineers reviewable results.",
  },
  {
    q: "What is the difference between Synth Community and Synth EE?",
    a: "They are two editions of the same Synth product, and both can connect to LLMs. Community is the open-source starting point for individuals and teams. Synth EE is the managed SaaS edition, adding a custom agent harness, MCP tools, access to world-model and EBM capabilities, MCTS-style simulation tools, organisation-wide governance, and support for teams shipping sensitive hardware.",
  },
  {
    q: "Can Synth work with existing EDA tools?",
    a: "Yes. Synth is designed around open, inspectable project artifacts and can fit alongside KiCad and other ECAD tools. The goal is to accelerate design work without hiding the source files engineers need to verify and ship.",
  },
  {
    q: "What does Synth EE include?",
    a: "Synth EE is delivered as SaaS. It includes the Synth workflow and LLM access, plus a custom agent harness, MCP tools, world-model and EBM access, and MCTS-style simulation capabilities for more advanced PCB design tasks.",
  },
];

const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map(({ q, a }) => ({
    "@type": "Question",
    name: q,
    acceptedAnswer: { "@type": "Answer", text: a },
  })),
});

const features = [
  {
    icon: CircuitBoard,
    title: "Deterministic compilation",
    desc: "A typed compiler turns circuit source into KiCad schematics, boards, and BOMs. Deterministic placement and routing make results reproducible for the same source, parts, and settings.",
  },
  {
    icon: Sparkles,
    title: "Errors agents can act on",
    desc: "Agents work as they do with other programming languages: write code, compile, read errors, fix the source, and recompile. Structured diagnostics identify source locations and provide suggested fixes where available.",
  },
  {
    icon: ShieldCheck,
    title: "Electrical and physical checks",
    desc: "Electrical-rule checks (ERC) flag circuit issues such as missing decoupling. Design-rule checks (DRC) inspect routed boards for clearance, trace-width, drill-size, and courtyard violations.",
  },
  {
    icon: GitBranch,
    title: "Review the agent’s changes",
    desc: "Components, connections, and constraints live in readable circuit source. Review the agent’s edits in Git, rerun the compiler and checks, and inspect generated outputs in KiCad.",
  },
];

const comparison = [
  [
    "Design input",
    "Prompt → generated circuit specification (.synth)",
    "Prompt + KiCad project",
    "Prompt or editor project",
    "Schematic + board outline",
  ],
  [
    "How designs are built",
    "AI-written source → deterministic compiler",
    "LLM-directed edits in KiCad",
    "LLM-driven design in a PCB editor (non-deterministic)",
    "Reinforcement-learning layout engine",
  ],
  [
    "Validation and feedback",
    "The coding loop agents know: compile → fix → recompile, with deterministic compiler checks + ERC/DRC",
    "KiCad ERC/DRC reports via editor or CLI",
    "Non-deterministic LLM review + separate DRC checks",
    "Layout validation + physics-rule checks",
  ],
  [
    "Design traceability",
    "Readable circuit source, Git diffs, reproducible builds",
    "KiCad files + agent session history",
    "Workspace version history",
    "Layout candidates + validation reports",
  ],
  [
    "Compiler / engine access",
    "Open compiler + MCP; run locally (CE)",
    "Open-source KiCad; provider AI",
    "Hosted editor and AI",
    "Vendor-managed layout engine",
  ],
];

const heroLabel = "Synth · AI-assisted PCB design";
const heroTitle = "From circuit intent to a board you can review.";
const heroDesc =
  "Start with a prompt. Your AI agent writes circuit source; Synth compiles it into KiCad outputs with deterministic placement and routing. Compiler errors, electrical checks, and design-rule checks give the agent concrete feedback to fix and recheck its work.";
---

<BaseLayout
  title="Synth — AI-Assisted PCB Design | Abstract Machines"
  description={heroDesc}
  ogImageAlt={`Synth ${edition}`}
>
  <Header />
  <main class="synth-page">
    <section class="prod-hero synth-hero">
      <div class="container-wide synth-hero-grid">
        <div class="synth-hero-copy">
          <div class="synth-wordmark">
            <SynthLogo />
          </div>
          <p class="kicker">{heroLabel}</p>
          <h1>{heroTitle}</h1>
          <p class="lede">{heroDesc}</p>
          <div class="btn-row" style="margin-top:32px;">
            <a
              href="https://github.com/absmach/synth"
              class="btn btn-primary"
              target="_blank"
              rel="noopener">Explore Synth on GitHub <ArrowRight size={16} /></a
            >
            <a href="#editions" class="btn">Compare editions</a>
          </div>
          <div class="synth-hero-notes">
            <span><Check size={14} /> Constraint-aware</span><span
              ><Check size={14} /> Open source</span
            ><span><Check size={14} /> Agent-ready</span>
          </div>
        </div>
        <div
          class="document-stage"
          aria-label="Synth design intelligence illustration"
        >
          <div class="stage-topbar">
            <span class="window-dots"><i></i><i></i><i></i></span><span
              class="stage-path">SYNTH / DESIGN INTELLIGENCE</span
            ><span class="stage-status">BOARD CANDIDATE</span>
          </div>
          <div class="synth-illustration">
            <div class="illustration-inputs">
              <span class="illustration-kicker">DESIGN INPUTS</span><b
                >USB-C field node</b
              ><span><i class="input-dot blue"></i>Power budget</span><span
                ><i class="input-dot orange"></i>Approved parts</span
              ><span><i class="input-dot green"></i>RF keepout</span>
            </div>
            <div class="illustration-board">
              <div class="board-grid"></div><span
                class="illustration-chip chip-mcu"
                >RP2350<small>MCU</small></span
              ><span class="illustration-chip chip-power"
                >3V3<small>POWER</small></span
              ><span class="illustration-chip chip-radio"
                >BG95<small>MODEM</small></span
              ><span class="illustration-chip chip-usb"
                >USB-C<small>EDGE</small></span
              ><span class="illustration-trace t-one"></span><span
                class="illustration-trace t-two"></span><span
                class="illustration-trace t-three"></span><span
                class="illustration-board-label">4-LAYER BOARD · 50Ω RF</span
              >
            </div>
            <div class="illustration-checks">
              <span class="illustration-kicker">DESIGN CHECKS</span><b
                ><Check size={13} /> 18 nets resolved</b
              ><b><Check size={13} /> 4 constraints held</b><b
                ><Check size={13} /> KiCad output ready</b
              >
            </div>
          </div>
          <div class="stage-footer">
            <span
              ><span class="pulse-dot"></span> Requirements remain attached to the
              board</span
            ><span>SPECIFY · DESIGN · VERIFY</span>
          </div>
        </div>
      </div>
      <div class="hero-grid-lines" aria-hidden="true"></div>
    </section>

    <section class="synth-intro section">
      <div class="container-narrow intro-lockup">
        <span class="kicker">A compiler for AI circuit design</span><h2
          class="h-2"
        >
          Give your agent a compile–check–fix loop.
        </h2><p class="lede">
          Synth turns each design attempt into actionable feedback: compiler
          errors tied to source, electrical-rule violations, and physical
          design-rule reports. The agent can correct the source and run the
          checks again; you review the changes and the resulting board.
        </p>
      </div>
    </section>

    <section class="synth-evidence" id="evidence">
      <div class="container-wide">
        <div class="section-head">
          <div class="left">
            <span class="kicker">Built with Synth EE</span><h2 class="h-2">
              A board brief that turns into a KiCad board.
            </h2>
          </div><p class="lede">
            This Synth field node combines USB-C power and charging, an RP2350
            controller, secure-element storage, cellular connectivity, RF
            matching, and explicit antenna keepouts.
          </p>
        </div><div class="evidence-grid">
          <article class="evidence-board">
            <div class="evidence-label">
              <span>SYNTH FIELD NODE / 4-LAYER BOARD</span><b
                >KiCad 3D render · generated output</b
              >
            </div><div class="kicad-render">
              <img
                src="/img/synth/synth-field-node-kicad-tight.png"
                alt="KiCad 3D render of a Synth-generated four-layer field node board with USB-C on the board edge"
              /><span class="kicad-edge-label">USB-C EDGE</span>
            </div><div class="evidence-stats">
              <span><b>4</b> layers</span><span><b>50Ω</b> antenna pair</span
              ><span><b>1</b> secure element</span>
            </div>
          </article><article class="evidence-copy">
            <span class="kicker">The source is the artifact</span><h3
              class="h-3"
            >
              Not a generated picture of a board.
            </h3><p>
              The field node is authored as a readable <code>.synth</code> design,
              compiled by Synth EE, and exported as KiCad source. The render is the
              last step in a chain that still exposes parts, nets, constraints, keepouts,
              and manufacturing intent.
            </p><div class="source-callout">
              <code
                >diff_pair u3_main_ant bal1_unbal<br />&#123; impedance 50ohm
                &#125;</code
              ><span>RF constraints stay attached to the design.</span>
            </div><a href="/synth/orbit-board.synth" class="btn" download
              >Download the Synth source <ArrowRight size={15} /></a
            >
          </article>
        </div>
      </div>
    </section>

    <section class="synth-features">
      <div class="container-wide">
        <div class="section-head">
          <div class="left">
            <span class="kicker">Built for the agent loop</span><h2 class="h-2">
              Reproducible builds. Actionable errors. Reviewable designs.
            </h2>
          </div><p class="lede">
            Synth gives AI circuit design a compiler workflow: generate source,
            compile, inspect diagnostics, and correct. Engineers can reproduce
            the build and review every source change.
          </p>
        </div><div class="synth-feature-grid">
          {
            features.map(({ icon: Icon, title, desc }) => (
              <article class="synth-feature feature">
                <>
                  <div class="ic">
                    <Icon size={20} />
                  </div>
                  <h3 class="h-4">{title}</h3>
                  <p>{desc}</p>
                </>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="synth-editions" id="editions">
      <div class="container-wide">
        <div class="section-head">
          <div class="left">
            <span class="kicker">One product, two editions</span><h2
              class="h-2"
            >
              Start open. Scale with an agent harness.
            </h2>
          </div><p class="lede">
            Both editions can use LLMs. Synth EE adds the tools and managed
            infrastructure for deeper, more autonomous design exploration.
          </p>
        </div><div class="edition-grid">
          <article class="edition-card">
            <div class="edition-card-top">
              <SynthLogo compact edition="CE" /><span class="edition-badge"
                >Community Edition</span
              >
            </div><h3 class="h-3">
              Open design intelligence for every engineer.
            </h3><p>
              Explore requirements, schematics, parts, placement, and routing
              with an open foundation you can extend and run yourself.
            </p><ul>
              <li><Check size={15} /> Open-source foundation</li><li>
                <Check size={15} /> LLM access
              </li><li><Check size={15} /> KiCad-friendly project flow</li><li>
                <Check size={15} /> Model-flexible architecture
              </li>
            </ul><a
              href="https://github.com/absmach/synth"
              class="btn"
              target="_blank"
              rel="noopener"
              >View the GitHub repository <ArrowRight size={15} /></a
            >
          </article><article class="edition-card edition-card-enterprise">
            <div class="edition-card-top">
              <SynthLogo compact inverted edition="EE" /><span
                class="edition-badge">Enterprise Edition</span
              >
            </div><h3 class="h-3">
              Managed SaaS with a custom agent harness.
            </h3><p>
              Bring repeatable, governed AI-assisted PCB design to your
              engineering organisation with a deeper toolchain for exploring and
              validating design choices.
            </p><ul>
              <li><Check size={15} /> Everything in Community</li><li>
                <Check size={15} /> Custom agent harness + MCP tools
              </li><li><Check size={15} /> World-model / EBM access</li><li>
                <Check size={15} /> MCTS-style simulation tools
              </li><li>
                <Check size={15} /> Managed SaaS operations and support
              </li>
            </ul><a href="/contact" class="btn btn-primary"
              >Talk to our team <ArrowRight size={15} /></a
            >
          </article>
        </div>
      </div>
    </section>

    <section class="synth-workflow">
      <div class="container-wide workflow-grid">
        <div>
          <span class="kicker">A calmer way to work</span><h2 class="h-2">
            The board is the interface.
          </h2><p class="lede">
            Synth turns the messy middle of PCB design into a visible,
            reviewable flow.
          </p><div class="workflow-steps">
            <div>
              <span>01</span><b>Specify</b><p>
                Bring in requirements, interfaces, constraints, and target
                parts.
              </p>
            </div><div>
              <span>02</span><b>Design</b><p>
                Explore schematic, placement, and routing candidates in context.
              </p>
            </div><div>
              <span>03</span><b>Verify</b><p>
                Review nets, design rules, diffs, and manufacturing readiness.
              </p>
            </div>
          </div>
        </div><div class="source-map">
          <div class="map-center">
            <SynthLogo compact inverted /><b>Board candidate</b><small
              >18 nets · 6 constraints</small
            >
          </div><div class="map-node node-a">
            <span class="source-dot blue"></span><b>Requirements</b><small
              >USB · power · size</small
            >
          </div><div class="map-node node-b">
            <span class="source-dot orange"></span><b>Part decisions</b><small
              >MCU · regulator · passives</small
            >
          </div><div class="map-node node-c">
            <span class="source-dot green"></span><b>Design checks</b><small
              >DRC · ERC · review</small
            >
          </div><svg class="map-lines" viewBox="0 0 500 440" aria-hidden="true"
            ><path d="M250 210 L95 96 M250 210 L405 96 M250 235 L250 365"
            ></path></svg
          >
        </div>
      </div>
    </section>

    <section class="synth-compare">
      <div class="container-wide">
        <div class="section-head">
          <div class="left">
            <span class="kicker">AI-assisted PCB design</span>
            <h2 class="h-2">Where Synth fits in the new EDA stack.</h2>
          </div>
          <p class="lede">
            Design hardware like you write software. The agent writes circuit
            code, compiles it, reads compiler errors, fixes the source, and
            recompiles—just as with other programming languages. Synth adds
            electrical and physical rule checks, with deterministic generation
            of KiCad outputs.
          </p>
        </div>
        <div class="compare-shell">
          <div class="compare-header">
            <span>Capability</span>
            <span class="synth-column">Synth</span>
            <span>Astra + KiCad</span>
            <span>Other AI PCB workspace</span>
            <span>Other AI layout service</span>
          </div>
          {
            comparison.map(([label, synth, astra, workspace, layout]) => (
              <div class="compare-row">
                <b>{label}</b>
                <span class="synth-column">{synth}</span>
                <span>{astra}</span>
                <span>{workspace}</span>
                <span>{layout}</span>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section synth-faq">
      <div class="container-wide">
        <div class="section-head">
          <div class="left">
            <span class="kicker">Questions</span><h2 class="h-2">
              A clear place to start.
            </h2>
          </div>
        </div><FAQAccordion items={faqs} />
      </div>
    </section>

    <section class="synth-cta">
      <div class="container-narrow cta-panel">
        <div>
          <span class="kicker">Start with the board you already have</span><h2
            class="h-2"
          >
            Give your engineering team a better copilot.
          </h2><p>
            Build with the open Synth Community Edition and connect it to
            LLMs—or talk to us about Synth EE’s managed agent, MCP, world-model,
            EBM, and MCTS toolchain.
          </p>
        </div><div class="btn-row">
          <a
            href="https://github.com/absmach/synth"
            class="btn btn-primary"
            target="_blank"
            rel="noopener">Start with Synth <ArrowRight size={16} /></a
          >
        </div>
      </div>
    </section>

    <script type="application/ld+json" set:html={faqSchema} />
  </main>
  <Footer />
</BaseLayout>

<style>
  /* Page layout uses the shared product typography, spacing, and Blueprint tokens. */
  .synth-page {
    background: var(--paper);
    color: var(--ink);
  }
  .synth-hero {
    background: var(--paper-2);
  }
  .synth-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(28px, 5vw, 56px);
    align-items: center;
    position: relative;
    z-index: 1;
  }
  .synth-wordmark {
    display: flex;
    margin-bottom: 24px;
  }
  .synth-hero-copy .lede {
    margin-top: 24px;
  }
  .synth-hero-notes {
    display: flex;
    gap: 18px;
    flex-wrap: wrap;
    margin-top: 28px;
    color: var(--ink-2);
    font: 11px var(--font-mono);
  }
  .synth-hero-notes span {
    display: flex;
    align-items: center;
    gap: 5px;
  }
  .synth-hero-notes svg {
    color: var(--green);
  }
  .document-stage {
    min-width: 0;
    background: var(--surface-accent);
    color: var(--on-accent);
    border: 1px solid var(--line-3);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    overflow: hidden;
  }
  .synth-illustration {
    display: grid;
    grid-template-columns: 110px minmax(0, 1fr) 120px;
    gap: 14px;
    align-items: center;
    min-height: 424px;
    padding: 28px 16px;
    background: var(--paper-2);
    color: var(--ink);
  }
  .illustration-inputs,
  .illustration-checks {
    display: grid;
    gap: 12px;
    align-content: center;
    font-size: 10px;
  }
  .illustration-inputs b,
  .illustration-checks b {
    font-size: 11px;
    line-height: 1.35;
  }
  .illustration-kicker {
    color: var(--ink-3);
    font: 9px var(--font-mono);
    letter-spacing: 0.12em;
  }
  .illustration-inputs > span:not(.illustration-kicker),
  .illustration-checks b {
    display: flex;
    align-items: center;
    gap: 7px;
    color: var(--ink-2);
  }
  .input-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    flex: none;
  }
  .input-dot.blue {
    background: var(--accent);
  }
  .input-dot.orange {
    background: var(--accent-2);
  }
  .input-dot.green {
    background: var(--green);
  }
  .illustration-checks b svg {
    flex: none;
    color: var(--green);
  }
  .illustration-board {
    height: 280px;
    position: relative;
    overflow: hidden;
    border: 1px solid #547a98;
    border-radius: 12px;
    background: #174d4a;
    box-shadow:
      inset 0 0 0 7px #113c3b,
      inset 0 0 0 8px #4b8c7e,
      0 14px 30px rgba(7, 55, 99, 0.15);
  }
  .board-grid {
    position: absolute;
    inset: 16px;
    opacity: 0.26;
    background-image: radial-gradient(#c1e2d4 1px, transparent 1px);
    background-size: 16px 16px;
  }
  .illustration-chip {
    position: absolute;
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    width: 68px;
    height: 48px;
    border: 1px solid #bdd5e3;
    border-radius: 5px;
    color: #f4fbff;
    background: #234c70;
    box-shadow: 0 5px 14px #09221f88;
    font: 600 10px var(--font-mono);
  }
  .illustration-chip small {
    margin-top: 4px;
    color: #b6cedb;
    font-size: 7px;
    font-weight: 400;
  }
  .chip-mcu {
    width: 88px;
    height: 78px;
    top: 101px;
    left: 35%;
    background: #073763;
  }
  .chip-power {
    top: 38px;
    left: 12%;
    background: #3f526d;
  }
  .chip-radio {
    top: 46px;
    right: 10%;
    background: #46604a;
    border-color: #bce29a;
  }
  .chip-usb {
    bottom: 38px;
    left: 10%;
    background: #64434c;
    border-color: #dda5ae;
  }
  .illustration-trace {
    position: absolute;
    z-index: 1;
    display: block;
    height: 3px;
    border-radius: 99px;
    transform-origin: left center;
  }
  .t-one {
    width: 125px;
    left: 27%;
    top: 93px;
    background: #76c9ff;
    transform: rotate(19deg);
  }
  .t-two {
    width: 135px;
    left: 47%;
    top: 165px;
    background: #f2a16b;
    transform: rotate(-29deg);
  }
  .t-three {
    width: 150px;
    left: 22%;
    top: 194px;
    background: #73daa7;
    transform: rotate(22deg);
  }
  .illustration-board-label {
    position: absolute;
    z-index: 3;
    right: 13px;
    bottom: 12px;
    padding: 5px 7px;
    color: #c7e9dc;
    background: #0b2d2bdd;
    border-radius: 3px;
    font: 8px var(--font-mono);
  }

  .stage-topbar,
  .stage-footer {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 16px;
    color: var(--on-accent-dim);
    font: 10px var(--font-mono);
    line-height: 1.5;
    border-bottom: 1px solid var(--dark-border);
  }
  .stage-path {
    flex: 1;
  }
  .stage-status {
    color: var(--on-accent-muted);
    font-size: 9px;
  }
  .stage-footer {
    justify-content: space-between;
    flex-wrap: wrap;
    border: 0;
  }
  .window-dots {
    display: flex;
    gap: 5px;
  }
  .window-dots i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--on-accent-muted);
  }
  .pulse-dot {
    display: inline-block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #70d29c;
    margin-right: 6px;
  }
  .hero-grid-lines {
    position: absolute;
    inset: 0;
    opacity: 0.32;
    pointer-events: none;
    background-image:
      linear-gradient(var(--line-3) 1px, transparent 1px),
      linear-gradient(90deg, var(--line-3) 1px, transparent 1px);
    background-size: 70px 70px;
    mask-image: linear-gradient(90deg, transparent, black 72%);
  }
  .intro-lockup {
    text-align: center;
  }
  .intro-lockup h2 {
    margin: 14px auto 20px;
