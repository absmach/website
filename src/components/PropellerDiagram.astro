<div class="prop-topo" role="img" aria-label="Propeller deployment topology">
  <span class="pt-mark pt-tl" aria-hidden="true"></span>
  <span class="pt-mark pt-tr" aria-hidden="true"></span>
  <span class="pt-mark pt-bl" aria-hidden="true"></span>
  <span class="pt-mark pt-br" aria-hidden="true"></span>

  <!-- User (top-center) -->
  <div class="pt-row-center">
    <div class="pt-cell pt-cell-user">
      <div class="pt-name">User</div>
      <div class="pt-meta">CLI · API</div>
    </div>
  </div>

  <!-- T-junction: stem from User, horizontal bar, two branches to Manager (HTTP) and K8s Operator (K8S) -->
  <div class="pt-pipe-fork" aria-hidden="true">
    <div class="pt-fork-stem"><div class="pt-vbeam"></div></div>
    <div class="pt-fork-half">
      <div class="pt-vline">
        <div class="pt-vbeam" style="animation-delay:.3s;"></div>
      </div>
      <span class="pt-proto-sm">HTTP</span>
    </div>
    <div class="pt-fork-half">
      <div class="pt-vline">
        <div class="pt-vbeam" style="animation-delay:.8s;"></div>
      </div>
      <span class="pt-proto-sm">K8S</span>
    </div>
  </div>

  <!-- Cloud layer -->
  <div class="pt-layer">
    <div class="pt-lbl">Cloud</div>
    <div class="pt-cells">
      <div class="pt-cell">
        <div class="pt-name">Manager</div>
        <div class="pt-meta">Scheduler · DB</div>
      </div>
      <div class="pt-cell">
        <div class="pt-name">K8s Operator</div>
        <div class="pt-meta">Kubernetes</div>
      </div>
    </div>
  </div>

  <!-- MQTT pipe -->
  <div class="pt-pipe" aria-hidden="true">
    <div class="pt-vline">
      <div class="pt-vbeam"></div>
      <div class="pt-vbeam pt-vbeam-rev"></div>
    </div>
    <span class="pt-proto">MQTT</span>
  </div>

  <!-- Service Mesh layer -->
  <div class="pt-layer">
    <div class="pt-lbl pt-lbl-accent">Service Mesh</div>
    <div class="pt-cells">
      <a href="/products/magistrala" class="pt-cell pt-cell-mesh pt-cell-link">
        <div class="pt-name">Magistrala</div>
        <div class="pt-meta">IoT platform</div>
      </a>
    </div>
  </div>

  <!-- MQTT fork: Magistrala → Proplet L & Proplet R (direct connections) -->
  <div class="pt-pipe-edge-fork" aria-hidden="true">
    <div class="pt-fork-stem-center">
      <div class="pt-vbeam" style="animation-delay:.2s;"></div>
    </div>
    <div class="pt-edge-br pt-edge-br--l">
      <div class="pt-vline">
        <div class="pt-vbeam" style="animation-delay:.5s;"></div>
      </div>
      <span class="pt-proto-sm">MQTT</span>
    </div>
    <div class="pt-edge-br pt-edge-br--r">
      <div class="pt-vline">
        <div class="pt-vbeam" style="animation-delay:1.9s;"></div>
      </div>
      <span class="pt-proto-sm">MQTT</span>
    </div>
  </div>

  <!-- Edge grid: Proplet ←MQTT→ Proxy ←MQTT→ Proplet (OCI workload fetch), Proxy →HTTP→ OCI -->
  <div class="pt-edge-grid">
    <div class="pt-lbl pt-lbl-edge">Edge &amp; MCU</div>

    <div class="pt-cell pt-eg-p1">
      <div class="pt-name">Proplet</div>
      <div class="pt-meta">Linux · Cloud node</div>
      <span class="pt-wasm">Wasm</span>
    </div>

    <div class="pt-hconn pt-eg-c1" aria-hidden="true">
      <div class="pt-hline"><div class="pt-hbeam"></div></div>
      <span class="pt-hproto">MQTT</span>
    </div>

    <div class="pt-cell pt-eg-proxy">
      <div class="pt-name">Proxy</div>
      <div class="pt-meta">HTTP to MQTT</div>
    </div>

    <div class="pt-hconn pt-eg-c2" aria-hidden="true">
      <div class="pt-hline">
        <div class="pt-hbeam" style="animation-direction:reverse;"></div>
      </div>
      <span class="pt-hproto">MQTT</span>
    </div>

    <div class="pt-cell pt-eg-p2">
      <div class="pt-name">Proplet</div>
      <div class="pt-meta">Zephyr · MCU</div>
      <span class="pt-wasm">Wasm</span>
    </div>

    <div class="pt-vpipe-sm pt-eg-vpipe" aria-hidden="true">
      <div class="pt-vline">
        <div class="pt-vbeam" style="animation-delay:1.1s;"></div>
      </div>
      <span class="pt-proto-sm">HTTP ↕</span>
    </div>

    <div class="pt-cell pt-cell-oci pt-eg-oci">
      <div class="pt-name">OCI Registry</div>
      <div class="pt-meta">Artifact store</div>
      <span class="pt-http">HTTP</span>
    </div>
  </div>
</div>

<style>
  /* ── Layout ── */
  .prop-topo {
    display: flex;
    flex-direction: column;
    gap: 0;
    padding: 28px 26px;
    position: relative;
    height: 100%;
  }

  /* ── Corner marks ── */
  .pt-mark {
    position: absolute;
    pointer-events: none;
    z-index: 1;
  }
  .pt-mark::before,
  .pt-mark::after {
    content: "";
    position: absolute;
    background: rgba(7, 55, 99, 0.25);
  }
  .pt-mark::before {
    width: 1px;
    height: 14px;
  }
  .pt-mark::after {
    height: 1px;
    width: 14px;
  }
  .pt-tl {
    top: 0;
    left: 0;
  }
  .pt-tl::before {
    top: -14px;
    left: -1px;
  }
  .pt-tl::after {
    top: -1px;
    left: -14px;
  }
  .pt-tr {
    top: 0;
    right: 0;
  }
  .pt-tr::before {
    top: -14px;
    right: -1px;
  }
  .pt-tr::after {
    top: -1px;
    right: -14px;
  }
  .pt-bl {
    bottom: 0;
    left: 0;
  }
  .pt-bl::before {
    bottom: -14px;
    left: -1px;
  }
  .pt-bl::after {
    bottom: -1px;
    left: -14px;
  }
  .pt-br {
    bottom: 0;
    right: 0;
  }
  .pt-br::before {
    bottom: -14px;
    right: -1px;
  }
  .pt-br::after {
    bottom: -1px;
    right: -14px;
  }

  /* ── Layer groups ── */
  .pt-layer {
    display: flex;
    flex-direction: column;
    gap: 7px;
  }
  .pt-lbl {
    font-family: "JetBrains Mono", monospace;
    font-size: 9px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: rgba(7, 55, 99, 0.4);
  }
  .pt-lbl-accent {
    color: rgba(255, 122, 74, 0.85);
  }

  .pt-cells {
    display: flex;
    gap: 6px;
  }
  .pt-cell {
    flex: 1;
    border: 1px solid rgba(7, 55, 99, 0.15);
    border-radius: 7px;
    padding: 14px 16px;
    background: rgba(7, 55, 99, 0.03);
    display: flex;
    flex-direction: column;
    gap: 3px;
  }
  .pt-cell-mesh {
    background: rgba(255, 122, 74, 0.05);
    border-color: rgba(255, 122, 74, 0.3);
  }
  .pt-cell-link {
    text-decoration: none;
    color: inherit;
    cursor: pointer;
    transition:
      border-color 0.15s,
      background 0.15s;
  }
  .pt-cell-link:hover {
    border-color: rgba(255, 122, 74, 0.55);
    background: rgba(255, 122, 74, 0.09);
  }
  .pt-cell-oci {
    border-color: rgba(255, 122, 74, 0.22);
    background: rgba(255, 122, 74, 0.03);
  }

  .pt-name {
    font-family: "JetBrains Mono", monospace;
    font-size: 13px;
    font-weight: 600;
    color: rgba(7, 55, 99, 0.88);
    line-height: 1.2;
  }
  .pt-meta {
    font-family: "JetBrains Mono", monospace;
    font-size: 11px;
    color: rgba(7, 55, 99, 0.45);
    line-height: 1.35;
  }

  /* ── Orange pill badges (Wasm, HTTP) ── */
  .pt-wasm,
  .pt-http {
    display: inline-block;
    margin-top: 7px;
    background: rgba(255, 122, 74, 0.09);
    border: 1px solid rgba(255, 122, 74, 0.32);
    border-radius: 999px;
    font-family: "JetBrains Mono", monospace;
    font-size: 8px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #c85000;
    padding: 2px 8px;
    align-self: flex-start;
  }

  /* ── Vertical pipe (between layers) ── */
  .pt-pipe {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 44px;
    flex-shrink: 0;
    position: relative;
    margin: 2px 0;
  }
  .pt-pipe::before,
  .pt-pipe::after {
    content: "";
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    width: 0;
    height: 0;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    z-index: 3;
  }
  .pt-pipe::before {
    top: 2px;
    border-bottom: 5px solid rgba(7, 55, 99, 0.3);
  }
  .pt-pipe::after {
    bottom: 2px;
    border-top: 5px solid rgba(7, 55, 99, 0.3);
  }

  /* ── Shared vertical line ── */
  .pt-vline {
    position: absolute;
    left: 50%;
    top: 0;
    bottom: 0;
    width: 2px;
    background: rgba(7, 55, 99, 0.12);
    transform: translateX(-50%);
    overflow: hidden;
    border-radius: 1px;
  }

  /* ── Animated vertical beam ── */
  .pt-vbeam {
    position: absolute;
    left: 0;
    top: -40%;
    width: 100%;
    height: 40%;
    background: linear-gradient(
      to bottom,
      transparent,
      rgba(7, 55, 99, 0.5),
      transparent
    );
    animation: ptVBeam 2.8s ease-in-out infinite;
    border-radius: 2px;
  }
  .pt-vbeam-rev {
    animation-delay: 1.4s;
    animation-direction: reverse;
  }
  @keyframes ptVBeam {
    from {
      top: -40%;
    }
    to {
      top: 140%;
    }
  }

  /* ── Proto label (main pipes) ── */
  .pt-proto {
    position: relative;
    z-index: 2;
    background: var(--paper-2);
    border: 1px solid rgba(7, 55, 99, 0.18);
    padding: 3px 11px;
    border-radius: 999px;
    font-family: "JetBrains Mono", monospace;
    font-size: 8px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: rgba(7, 55, 99, 0.6);
  }

  /* ── Small proto label (fork pipe branches, HTTP↓) ── */
  .pt-proto-sm {
    position: relative;
    z-index: 2;
    background: var(--paper-2);
    border: 1px solid rgba(7, 55, 99, 0.16);
    padding: 2px 7px;
    border-radius: 999px;
    font-family: "JetBrains Mono", monospace;
    font-size: 7px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: rgba(7, 55, 99, 0.55);
    white-space: nowrap;
  }

  /* ── User row (centered card) ── */
  .pt-row-center {
    display: flex;
    justify-content: center;
  }
  .pt-cell-user {
    width: 46%;
    min-width: 140px;
    max-width: 200px;
  }

  /* ── Fork pipe — T-junction (User → Manager + K8s Operator) ── */
  .pt-pipe-fork {
    position: relative;
    display: flex;
    height: 44px;
    flex-shrink: 0;
    margin: 2px 0;
  }
  /* Upward arrowhead at top-center pointing toward User card */
  .pt-pipe-fork::after {
    content: "";
    position: absolute;
    top: 2px;
    left: 50%;
    transform: translateX(-50%);
    width: 0;
    height: 0;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-bottom: 5px solid rgba(7, 55, 99, 0.3);
    z-index: 3;
  }
  /* Horizontal bar connecting the two branches at the midpoint */
  .pt-pipe-fork::before {
    content: "";
    position: absolute;
    top: 50%;
    left: 25%;
    right: 25%;
    height: 2px;
    background: rgba(7, 55, 99, 0.12);
    transform: translateY(-50%);
    border-radius: 1px;
  }
  /* Vertical stem from User card down to the junction bar */
  .pt-fork-stem {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 2px;
    height: calc(50% + 1px);
    background: rgba(7, 55, 99, 0.12);
    border-radius: 1px;
    overflow: hidden;
    z-index: 1;
  }
  /* Each branch spans the full fork height; vline starts at the junction */
  .pt-fork-half {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }
  /* Branch vline: starts at junction (top:50%) and runs to the Cloud layer below */
  .pt-fork-half .pt-vline {
    top: 50%;
  }
  /* No top arrowhead — the stem handles the upward connection */
  .pt-fork-half::before {
    display: none;
  }
  /* Downward arrowhead pointing into Cloud layer */
  .pt-fork-half::after {
    content: "";
    position: absolute;
    bottom: 2px;
    left: 50%;
    transform: translateX(-50%);
    width: 0;
    height: 0;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid rgba(7, 55, 99, 0.3);
    z-index: 3;
  }

  /* ── Edge grid (5 columns + OCI below Proxy) ── */
  .pt-edge-grid {
    display: grid;
    grid-template-columns: 1fr 44px 1fr 44px 1fr;
    grid-template-rows: auto auto auto auto;
    row-gap: 0;
    column-gap: 0;
  }
  .pt-lbl-edge {
    grid-column: 1 / -1;
    grid-row: 1;
    margin-bottom: 7px;
  }
  .pt-eg-p1 {
    grid-column: 1;
    grid-row: 2;
  }
  .pt-eg-c1 {
    grid-column: 2;
    grid-row: 2;
  }
  .pt-eg-proxy {
    grid-column: 3;
    grid-row: 2;
  }
  .pt-eg-c2 {
    grid-column: 4;
    grid-row: 2;
  }
  .pt-eg-p2 {
    grid-column: 5;
    grid-row: 2;
  }
  .pt-eg-vpipe {
    grid-column: 3;
    grid-row: 3;
  }
  /* margin-top matches the visual gap the section labels (CLOUD, SERVICE MESH) create above other cards */
  .pt-eg-oci {
    grid-column: 3;
    grid-row: 4;
    margin-top: 14px;
  }

  /* ── Horizontal MQTT connector ── */
  .pt-hconn {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    position: relative;
  }
  /* Left arrowhead */
  .pt-hconn::before {
    content: "";
    position: absolute;
    left: 2px;
    top: 50%;
    transform: translateY(-50%);
    width: 0;
    height: 0;
    border-top: 4px solid transparent;
    border-bottom: 4px solid transparent;
    border-right: 5px solid rgba(7, 55, 99, 0.3);
    z-index: 3;
  }
  /* Right arrowhead */
  .pt-hconn::after {
    content: "";
    position: absolute;
    right: 2px;
    top: 50%;
    transform: translateY(-50%);
    width: 0;
    height: 0;
    border-top: 4px solid transparent;
    border-bottom: 4px solid transparent;
    border-left: 5px solid rgba(7, 55, 99, 0.3);
    z-index: 3;
  }
  .pt-hline {
    position: absolute;
    top: 50%;
    left: 0;
    right: 0;
    height: 2px;
    background: rgba(7, 55, 99, 0.12);
    transform: translateY(-50%);
    overflow: hidden;
    border-radius: 1px;
  }
  .pt-hbeam {
    position: absolute;
    top: 0;
    left: -30%;
    height: 100%;
    width: 30%;
    background: linear-gradient(
      to right,
      transparent,
      rgba(7, 55, 99, 0.5),
      transparent
    );
    animation: ptHBeam 2.5s ease-in-out infinite;
    border-radius: 2px;
  }
  @keyframes ptHBeam {
    from {
      left: -30%;
    }
    to {
      left: 130%;
    }
  }
  .pt-hproto {
    position: relative;
    z-index: 2;
    background: var(--paper-2);
    border: 1px solid rgba(7, 55, 99, 0.16);
    padding: 2px 6px;
    border-radius: 999px;
    font-family: "JetBrains Mono", monospace;
    font-size: 7px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: rgba(7, 55, 99, 0.55);
    white-space: nowrap;
  }

  /* ── HTTP pipe (Proxy → OCI Registry) ── */
  .pt-vpipe-sm {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 44px;
    position: relative;
    margin: 2px 0;
  }
  /* Upward arrowhead pointing toward Proxy */
  .pt-vpipe-sm::before {
    content: "";
    position: absolute;
    top: 2px;
    left: 50%;
    transform: translateX(-50%);
    width: 0;
    height: 0;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-bottom: 5px solid rgba(7, 55, 99, 0.3);
    z-index: 3;
  }
  /* Downward arrowhead pointing into OCI Registry */
  .pt-vpipe-sm::after {
    content: "";
    position: absolute;
    bottom: 2px;
    left: 50%;
    transform: translateX(-50%);
    width: 0;
    height: 0;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid rgba(7, 55, 99, 0.3);
    z-index: 3;
  }

  /* ── Edge fork: Magistrala → Proplet L & Proplet R ── */
  /* Uses the same grid-template-columns as pt-edge-grid so branches align exactly */
  .pt-pipe-edge-fork {
    display: grid;
    grid-template-columns: 1fr 44px 1fr 44px 1fr;
    height: 44px;
    flex-shrink: 0;
    margin: 2px 0;
    position: relative;
  }
  /* Upward arrowhead at top-center pointing toward Magistrala */
  .pt-pipe-edge-fork::after {
    content: "";
    position: absolute;
    top: 2px;
    left: 50%;
    transform: translateX(-50%);
    width: 0;
    height: 0;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-bottom: 5px solid rgba(7, 55, 99, 0.3);
    z-index: 3;
  }
  /* Horizontal bar: calc aligns precisely with the centers of the 1fr columns */
  .pt-pipe-edge-fork::before {
    content: "";
    position: absolute;
    top: 50%;
    left: calc((100% - 88px) / 6);
    right: calc((100% - 88px) / 6);
    height: 2px;
    background: rgba(7, 55, 99, 0.12);
    transform: translateY(-50%);
    border-radius: 1px;
  }
  /* Vertical stem from Magistrala center down to the horizontal bar */
  .pt-fork-stem-center {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 2px;
    height: calc(50% + 1px);
    background: rgba(7, 55, 99, 0.12);
    border-radius: 1px;
    overflow: hidden;
    z-index: 1;
  }
  /* Branch grid items — column 1 (left Proplet) and column 5 (right Proplet) */
  .pt-edge-br {
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }
  .pt-edge-br--l {
    grid-column: 1;
  }
  .pt-edge-br--r {
    grid-column: 5;
  }
  /* Branch vline starts at the horizontal bar midpoint */
  .pt-edge-br .pt-vline {
    top: 50%;
  }
  /* No top arrowhead — stem handles the upward connection */
  .pt-edge-br::before {
    display: none;
  }
  /* Downward arrowhead pointing into the Proplet card */
  .pt-edge-br::after {
    content: "";
    position: absolute;
    bottom: 2px;
    left: 50%;
    transform: translateX(-50%);
    width: 0;
    height: 0;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid rgba(7, 55, 99, 0.3);
    z-index: 3;
  }

  /* ── Mobile responsive ── */
  @media (max-width: 640px) {
    .prop-topo {
      padding: 16px 14px;
      height: auto;
    }
    .pt-cell {
      padding: 10px 12px;
    }
    .pt-name {
      font-size: 11px;
    }
    .pt-meta {
      font-size: 9px;
    }
    .pt-cell-user {
      width: 70%;
      max-width: none;
    }
    .pt-edge-grid {
      grid-template-columns: 1fr 28px 1fr 28px 1fr;
    }
    .pt-hproto,
    .pt-proto-sm {
      font-size: 6px;
      padding: 1px 4px;
    }
    .pt-wasm,
    .pt-http {
      font-size: 7px;
      padding: 2px 5px;
      margin-top: 5px;
    }
    .pt-pipe {
      height: 36px;
    }
    .pt-pipe-fork {
      height: 36px;
    }
    .pt-vpipe-sm {
      height: 36px;
    }
    /* OCI full-width on mobile — vpipe-sm center aligns with it by grid symmetry */
    .pt-eg-oci {
      grid-column: 1 / -1;
      margin-top: 0;
    }
    /* Edge fork: match edge grid column widths so branches stay aligned */
    .pt-pipe-edge-fork {
      grid-template-columns: 1fr 28px 1fr 28px 1fr;
      height: 36px;
    }
    .pt-pipe-edge-fork::before {
      left: calc((100% - 56px) / 6);
      right: calc((100% - 56px) / 6);
    }
  }

  @media (max-width: 380px) {
    .pt-edge-grid {
      grid-template-columns: 1fr 18px 1fr 18px 1fr;
    }
    .pt-pipe-edge-fork {
      grid-template-columns: 1fr 18px 1fr 18px 1fr;
    }
    .pt-pipe-edge-fork::before {
      left: calc((100% - 36px) / 6);
      right: calc((100% - 36px) / 6);
    }
    .pt-hproto {
      display: none;
    }
    .pt-name {
      font-size: 10px;
    }
    .pt-meta {
      font-size: 8px;
    }
    .pt-cell {
      padding: 8px 9px;
    }
  }
</style>
