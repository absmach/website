---
interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<span class:list={["synth-logo", { compact }]} aria-label="Synth">
  <img src="/img/products/synth.svg" alt="" aria-hidden="true" />
  {!compact && <span>SYNTH</span>}
</span>

<style>
  .synth-logo { display:inline-flex; align-items:center; gap:10px; color:#1c1640; font:600 14px var(--font-mono); letter-spacing:.16em; }
  .synth-logo img { width:38px; height:38px; }
  .synth-logo.compact img { width:28px; height:28px; }
</style>
