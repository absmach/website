---
import { ArrowUpRight, ArrowRight } from "@lucide/astro";
import IdentityLayout from "../../layouts/IdentityLayout.astro";
import AssociationMembership from "../../components/identity/AssociationMembership.astro";
import { identityPhoto } from "../../data/identity-photos";
import { researchBrands } from "../../data/identity-research";
import "../../styles/identity-editorial.css";

const projects = [
  {
    slug: "elastic",
    name: "ELASTIC",
    status: "Ongoing",
    dates: "2024–2027",
    theme: "Orchestration / Cloud & edge",
    title: "A more flexible foundation for connected services.",
    description:
      "Research into portable, secure service orchestration using WebAssembly, serverless computing, and edge infrastructure.",
    photo: identityPhoto("research-elastic.webp"),
  },
  {
    slug: "confidential6g",
    name: "CONFIDENTIAL6G",
    status: "Completed",
    dates: "2023–2025",
    theme: "Security / Confidential computing",
    title: "Protecting data wherever computation happens.",
    description:
      "A European collaboration exploring confidential computing, post-quantum cryptography, and privacy across future 6G networks.",
    photo: identityPhoto("research-confidential.webp"),
  },
];
---

<IdentityLayout
  title="Research"
  description="Applied research and European collaboration in secure computing, WebAssembly, service orchestration, and cloud-edge infrastructure."
  active="research"
>
  <section class="ie-research-hero ie-shell">
    <div>
      <p class="ie-eyebrow">Research & collaboration</p><h1>
        Progress begins<br />with a better<br /><span>question.</span>
      </h1><p>
        We explore the infrastructure behind intelligent systems, working with
        industry and academia to turn shared questions into engineering work.
      </p><a class="text-link" href="#programmes"
        >Explore the programmes <ArrowRight size={20} /></a
      >
    </div>
    <figure>
      <img
        {...identityPhoto("research-hero.webp")}
        fetchpriority="high"
      /><figcaption>Computation. Security. Connectivity.</figcaption>
    </figure>
  </section>

  <section
    class="ie-shell ie-section ie-research-intro"
    aria-labelledby="research-questions-title"
  >
    <p class="ie-eyebrow">From questions to systems</p><div>
      <h2 id="research-questions-title">
        The next application<br /><span>needs new foundations.</span>
      </h2><p>
        How can workloads move across different environments? How do we protect
        sensitive data during computation? What does reliable orchestration look
        like at the edge? These are some of the questions behind our research
        partnerships.
      </p>
    </div>
  </section>

  <section
    id="programmes"
    class="ie-shell ie-programmes"
    aria-labelledby="programmes-title"
  >
    <div class="ie-programmes-heading">
      <h2 id="programmes-title">European research programmes</h2><span
        >Horizon Europe</span
      >
    </div>
    {
      projects.map((project) => (
        <article class="ie-programme-row">
          <>
            <a
              class="ie-programme-photo"
              href={`/research/${project.slug}/`}
              tabindex="-1"
              aria-hidden="true"
            >
              <>
                <img {...project.photo} alt="" loading="lazy" />
                <span
                  class={`ie-programme-brand ie-programme-brand--${project.slug}`}
                >
                  <img
                    src={researchBrands[project.slug].logo}
                    width={researchBrands[project.slug].logoWidth}
                    height={researchBrands[project.slug].logoHeight}
                    alt=""
                    loading="lazy"
                  />
                </span>
              </>
            </a>
            <div class="ie-programme-copy">
              <>
                <div class="ie-project-meta">
                  <>
                    <span>{project.theme}</span>
                    <span
                      class:list={[
                        "ie-status",
                        {
                          "ie-status-complete": project.status === "Completed",
                        },
                      ]}
                    >
                      {project.status} · {project.dates}
                    </span>
                  </>
                </div>
                <h3>
                  <a href={`/research/${project.slug}/`}>
                    {project.name} <ArrowUpRight size={30} />
                  </a>
                </h3>
                <h4>{project.title}</h4>
                <p>{project.description}</p>
                <p class="ie-programme-role">
                  <span>Our role</span>
                  {researchBrands[project.slug].role}
                </p>
                <a class="text-link" href={`/research/${project.slug}/`}>
                  Explore the project <ArrowRight size={18} />
                </a>
              </>
            </div>
          </>
        </article>
      ))
    }
    <AssociationMembership />
  </section>

  <section
    class="ie-research-invitation ie-shell ie-section"
    aria-labelledby="research-invitation-title"
  >
    <div>
      <p class="ie-eyebrow">A shared endeavour</p><h2
        id="research-invitation-title"
      >
        Bring a question.<br /><span>Build a collaboration.</span>
      </h2>
    </div><div>
      <p>
        We welcome conversations with research teams, industry partners, and
        consortia working on intelligent software, security, and distributed
        systems.
      </p><a class="ie-button ie-button-white" href="/contact/?topic=research"
        >Discuss a research partnership <ArrowUpRight size={20} /></a
      ><a class="text-link" href="/company/"
        >Get to know Abstract Machines <ArrowRight size={18} /></a
      >
    </div>
  </section>
</IdentityLayout>
