---
interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<span class:list={["synth-logo", { compact }]} aria-label="Synth">
  <span class="synth-word">SYNTH</span>
</span>

<style>
  .synth-logo { display:inline-flex; align-items:center; color:var(--ink); font:700 17px var(--font-sans); letter-spacing:.04em; }
  .synth-logo.compact { font-size:13px; }
</style>
