---
import { ArrowUpRight, Search } from "@lucide/astro";
import IdentityLayout from "../../../../layouts/IdentityLayout.astro";
import ProductVisual from "../../../../components/identity/ProductVisual.astro";
import { products } from "../../../../data/identity-products";
import { identityPhoto } from "../../../../data/identity-photos";
const filters = [
  { label: "AI & applications", value: "ai", group: "AI" },
  { label: "Infrastructure", value: "infrastructure", group: "Infrastructure" },
  { label: "Hardware", value: "hardware", group: "Hardware" },
];
---

<IdentityLayout
  title="Our work"
  active="work"
  description="Explore AI applications, identity, messaging, IoT platforms, and hardware from Abstract Machines."
>
  <section class="wi-hero" aria-labelledby="work-title">
    <img
      class="wi-hero-photo"
      {...identityPhoto("work-hero.webp")}
      fetchpriority="high"
    />
    <div class="wi-hero-shade" aria-hidden="true"></div>
    <nav class="is-breadcrumb" aria-label="Breadcrumb">
      <a href="/preview/ai/">Abstract Machines</a><span>/</span> Our work
    </nav><div class="wi-intro">
      <p class="section-label">
        <span class="label-line"></span> IDEAS INTO PRACTICE
      </p>
      <h1 id="work-title">
        Ambitious ideas.<br /><span>Working systems.</span>
      </h1>
    </div>
    <div class="wi-hero-bottom">
      <p>
        AI applications. The infrastructure behind them. And the hardware that
        connects software to the world.
      </p><a class="text-link" href="/preview/ai/contact/"
        >Find the right starting point <ArrowUpRight size={18} /></a
      >
    </div>
  </section>
  <section id="portfolio" class="wi-catalogue" aria-label="Product portfolio">
    <div class="wi-toolbar">
      <div class="wi-filters" role="tablist" aria-label="Product categories">
        {
          filters.map((filter) => (
            <button
              id={`work-category-${filter.value}`}
              data-work-filter={filter.value}
              role="tab"
              aria-selected={filter.value === "ai" ? "true" : "false"}
              aria-controls="work-products"
              tabindex={filter.value === "ai" ? 0 : -1}
            >
              {filter.label}
              <span class="wi-filter-count" aria-hidden="true">
                {String(
                  products.filter((product) => product.group === filter.group)
                    .length,
                ).padStart(2, "0")}
              </span>
            </button>
          ))
        }
      </div><label class="wi-search"
        ><Search size={18} /><input
          id="work-search"
          type="search"
          aria-label="Search this category"
          placeholder="Search this category"
          autocomplete="off"
        /></label
      >
    </div><div class="wi-meta">
      <span id="work-count" aria-live="polite"
        >{products.filter((product) => product.group === "AI").length} projects</span
      ><span>Open a project to explore its purpose and progress.</span>
    </div>
    <div
      id="work-products"
      role="tabpanel"
      aria-labelledby="work-category-ai"
      tabindex="0"
    >
      <div class="wi-grid">
        {
          products.map((product) => (
            <article
              class="wi-card"
              data-work-group={product.group.toLowerCase()}
              data-search={`${product.name} ${product.eyebrow} ${product.summary} ${product.group}`.toLowerCase()}
              hidden={product.group !== "AI"}
            >
              <>
                <a
                  class="wi-card-visual"
                  href={`/preview/ai/work/${product.slug}/`}
                  aria-label={`Explore ${product.name}`}
                >
                  <>
                    <ProductVisual product={product} compact />
                    <span class="wi-card-arrow">
                      <ArrowUpRight size={18} />
                    </span>
                  </>
                </a>
                <div class="wi-card-meta">
                  <>
                    <span>{product.eyebrow}</span>
                    <span>{product.stage}</span>
                  </>
                </div>
                <h2>
                  <a href={`/preview/ai/work/${product.slug}/`}>
                    {product.name}
                  </a>
                </h2>
                <p>{product.summary}</p>
                <a class="text-link" href={`/preview/ai/work/${product.slug}/`}>
                  Explore {product.name} <ArrowUpRight size={17} />
                </a>
              </>
            </article>
          ))
        }
      </div><div class="wi-empty" hidden>
        <h2>No matches yet.</h2><p>
          Try another search or choose a different category.
        </p><button class="wi-reset">Clear search</button>
      </div>
    </div>
  </section>
  <section class="wi-connections">
    <h2>Different starting points.<br />Shared engineering principles.</h2><div>
      <p>
        Some projects help people create. Others establish identity, carry
        messages, or connect devices. Each has a clear purpose—and a place in a
        wider systems practice.
      </p><a class="text-link" href="/preview/ai/company/#approach"
        >How we work <ArrowUpRight size={18} /></a
      >
    </div>
  </section>
  <section class="is-page-cta">
    <h2>What are you working on?</h2><a
      class="is-button"
      href="/preview/ai/contact/"
      >Start a conversation <ArrowUpRight size={20} /></a
    >
  </section>
  <script>
    const filters = Array.from(
      document.querySelectorAll<HTMLButtonElement>("[data-work-filter]"),
    );
    const cards = Array.from(
      document.querySelectorAll<HTMLElement>(".wi-card"),
    );
    const search = document.querySelector<HTMLInputElement>("#work-search");
    const count = document.querySelector("#work-count");
    const empty = document.querySelector<HTMLElement>(".wi-empty");
    const panel = document.querySelector("#work-products");
    const initial = new URLSearchParams(location.search).get("focus");
    // Keep existing links into the connected-systems portfolio useful.
    let active =
      initial === "hardware"
        ? "hardware"
        : initial === "infrastructure" || initial === "connected"
          ? "infrastructure"
          : "ai";
    const render = (updateUrl = false) => {
      const query = search?.value.trim().toLowerCase() ?? "";
      filters.forEach((button) => {
        const selected = button.dataset.workFilter === active;
        button.setAttribute("aria-selected", String(selected));
        button.tabIndex = selected ? 0 : -1;
      });
      panel?.setAttribute("aria-labelledby", `work-category-${active}`);
      let visible = 0;
      cards.forEach((card) => {
        card.hidden =
          card.dataset.workGroup !== active ||
          !(card.dataset.search ?? "").includes(query);
        if (!card.hidden) visible++;
      });
      if (count)
        count.textContent = `${visible} ${visible === 1 ? "project" : "projects"}`;
      if (empty) empty.hidden = visible > 0;
      if (updateUrl) {
        const url = new URL(location.href);
        if (active === "ai") url.searchParams.delete("focus");
        else url.searchParams.set("focus", active);
        history.replaceState(null, "", url);
      }
    };
    filters.forEach((button, index) => {
      button.addEventListener("click", () => {
        active = button.dataset.workFilter ?? "ai";
        render(true);
      });
      button.addEventListener("keydown", (event) => {
        let next = index;
        if (event.key === "ArrowRight") next = (index + 1) % filters.length;
        else if (event.key === "ArrowLeft")
          next = (index - 1 + filters.length) % filters.length;
        else if (event.key === "Home") next = 0;
        else if (event.key === "End") next = filters.length - 1;
        else return;
        event.preventDefault();
        filters[next]?.focus();
        filters[next]?.click();
      });
    });
    search?.addEventListener("input", () => render());
    document.querySelector(".wi-reset")?.addEventListener("click", () => {
      if (search) search.value = "";
      render(true);
      search?.focus();
    });
    render();
  </script>
</IdentityLayout>
