---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import FAQAccordion from "../../components/FAQAccordion.astro";
import {
  Users,
  Zap,
  KeyRound,
  Building2,
  SearchCode,
  SquareCode,
  Braces,
  Route,
  Server,
  Terminal,
  LayoutGrid,
  ShieldCheck,
  MapPin,
} from "@lucide/astro";

const features = [
  {
    icon: Users,
    name: "Identity Model",
    desc: "Humans, devices, services, workloads, and applications share one identity model. No special user class.",
  },
  {
    icon: Zap,
    name: "Runtime Authorization",
    desc: "Every policy decision is evaluated live. Token changes and revocations take effect on the next request — no restarts.",
  },
  {
    icon: KeyRound,
    name: "Authentication",
    desc: "JWT sessions, API keys, and OIDC social login (Google, GitHub). All flows produce a standard Atom JWT with zero-downtime key rotation.",
  },
  {
    icon: Building2,
    name: "Multi-Tenancy",
    desc: "Tenant isolation across entities, resources, and policies. Each tenant gets a bootstrapped admin role with full lifecycle enforcement.",
  },
  {
    icon: SearchCode,
    name: "Authorization Debugger",
    desc: "Ask why a request was allowed or denied. The explain endpoint returns a full decision trace — matched policies, skipped bindings, ABAC steps.",
  },
  {
    icon: SquareCode,
    name: "Open Source",
    desc: "Apache 2.0. GraphQL, REST, and gRPC APIs. Single Rust binary, PostgreSQL auto-migrated on startup. No vendor lock-in.",
  },
];

const steps = [
  [
    "01",
    "Run Atom",
    "Clone the repo and start the stack with Docker Compose. Atom migrates the database and seeds the admin account automatically.",
  ],
  [
    "02",
    "Model your system",
    "Create tenants, entity kinds, and resource definitions through the Admin UI or API. Profiles let you describe your platform's vocabulary.",
  ],
  [
    "03",
    "Enforce access",
    "Call the authorization endpoint from your services. The policy engine evaluates live state and returns ALLOW or DENY instantly.",
  ],
];

const policyFeatures = [
  {
    name: "Explicit deny",
    desc: "A deny binding overrides any allow immediately — no policy ordering tricks.",
  },
  {
    name: "Group inheritance",
    desc: "Policies on a group propagate to all members in real time.",
  },
  {
    name: "ABAC conditions",
    desc: "Attach conditions to any binding — match on entity or resource attributes using dot-path assertions.",
  },
  {
    name: "Bulk checks",
    desc: "Check dozens of permissions in one call — designed for gateway-level enforcement.",
  },
  {
    name: "Explain endpoint",
    desc: "Get a full decision trace: matched policies, skipped bindings, ABAC evaluation, and final verdict.",
  },
  {
    name: "Deny by default",
    desc: "No matching allow policy means denied. Nothing is implicitly permitted.",
  },
];

const devSurface = [
  {
    icon: Braces,
    name: "GraphQL API",
    desc: "All management at a single endpoint — full schema introspection and a built-in Playground.",
  },
  {
    icon: Route,
    name: "Custom REST",
    desc: "Define REST routes in the Admin UI backed by GraphQL operations. No code deployment needed.",
  },
  {
    icon: Server,
    name: "gRPC Runtime",
    desc: "High-throughput authorization checks over gRPC — used by Magistrala and microservice backends.",
  },
  {
    icon: Terminal,
    name: "Built-in Playground",
    desc: "Explore the schema, run queries, and debug policies directly from the Admin UI.",
  },
];

const quickstart = [
  {
    step: "1. Start with Docker",
    code: `git clone https://github.com/absmach/atom.git
cd atom
docker compose up -d`,
  },
  {
    step: "2. Open the Admin UI",
    code: `# Open in your browser:
# http://localhost:3005
#
# Log in as the super admin
# using the credentials you
# set in ADMIN_SECRET`,
  },
];

const solutions = [
  {
    icon: Building2,
    title: "Multi-Tenant SaaS",
    desc: "Tenant-scoped identities and runtime policy enforcement with full lifecycle isolation.",
    tags: ["SaaS", "Multi-tenancy", "Isolation"],
  },
  {
    icon: LayoutGrid,
    title: "IoT Platforms",
    desc: "Devices and gateways as first-class identities with credentials and fine-grained runtime policy coverage.",
    tags: ["IoT", "Device Identity", "MQTT"],
  },
  {
    icon: Server,
    title: "Microservices",
    desc: "Centralized runtime authorization across services. One HTTP or gRPC call per check, policy changes propagate instantly.",
    tags: ["Microservices", "API Keys", "gRPC"],
  },
  {
    icon: ShieldCheck,
    title: "Security Operations",
    desc: "Access explainability through the API. Answer 'why denied?' and 'who can access this?' without touching the database.",
    tags: ["SecOps", "Audit", "Compliance"],
  },
  {
    icon: MapPin,
    title: "Edge Systems",
    desc: "Single-binary deployment alongside edge infrastructure. Minimal footprint with full policy enforcement.",
    tags: ["Edge", "Propeller", "Gateway"],
  },
];

const uiFeatures = [
  {
    id: "dashboard",
    title: "Dashboard",
    desc: "Live platform summary — entity counts, recent activity, authorization outcomes, and expiring credentials at a glance.",
    img: "/img/atom-ui/dashboard.png",
    alt: "Atom Admin Dashboard",
  },
  {
    id: "entities",
    title: "Entity Management",
    desc: "Create, update, and manage humans, devices, services, workloads, and applications with credentials and group membership.",
    img: "/img/atom-ui/entities.png",
    alt: "Atom Entity Management",
  },
  {
    id: "policies",
    title: "Policy Bindings",
    desc: "Create and inspect RBAC and ABAC bindings. Set explicit deny rules and view all bindings for any subject or resource.",
    img: "/img/atom-ui/policies.png",
    alt: "Atom Policy Bindings",
  },
  {
    id: "roles",
    title: "Roles",
    desc: "Define roles and assign capabilities. Role membership is evaluated live — no token reissuance when roles change.",
    img: "/img/atom-ui/roles.png",
    alt: "Atom Roles Management",
  },
  {
    id: "debugger",
    title: "Authorization Debugger",
    desc: "Run explain queries interactively. See matched policies, skipped bindings, and ABAC evaluation steps without writing any code.",
    img: "/img/atom-ui/authorization-debugger.png",
    alt: "Atom Authorization Debugger",
  },
  {
    id: "audit",
    title: "Audit Logs",
    desc: "Every significant event — login, logout, credential creation, authorization checks — logged immutably and exportable to CSV.",
    img: "/img/atom-ui/audit.png",
    alt: "Atom Audit Logs",
  },
  {
    id: "playground",
    title: "GraphQL Playground",
    desc: "Built-in Playground with full schema introspection. Explore the API, run queries, and test policies interactively.",
    img: "/img/atom-ui/playground.png",
    alt: "Atom GraphQL Playground",
  },
];

const faqs = [
  {
    q: "How is Atom different from Keycloak?",
    a: "Keycloak embeds permissions in tokens — policy changes require token reissuance. Atom evaluates every authorization decision live through the PDP. It also ships as a single binary backed by one PostgreSQL database, with no JGroups, no Infinispan, and no XML configuration.",
  },
  {
    q: "Does Atom support RBAC and ABAC?",
    a: "Yes. Both are expressed through the same PolicyBinding primitive. RBAC uses role grants with no conditions. ABAC attaches dot-path conditions evaluated against entity or resource attributes. You can combine both in a single binding.",
  },
  {
    q: "Does Atom support OIDC?",
    a: "Yes. Atom supports OIDC social login with Google, GitHub, and any standards-compliant provider. The OIDC flow produces a standard Atom JWT — same as password login. Atom also exposes a JWKS endpoint for zero-downtime key rotation.",
  },
  {
    q: "Can Atom run in Kubernetes?",
    a: "Yes. Atom is a single stateless binary that reads config from environment variables. Deploy it as a Kubernetes Deployment with a PostgreSQL service. Migrations run on startup — no init container or migration job needed.",
  },
  {
    q: "Are permissions embedded in JWTs?",
    a: "No. Atom JWTs carry only the entity ID and session ID. Authorization is evaluated live on every request. A policy change or session revocation takes effect immediately — no token reissuance or cache invalidation needed.",
  },
  {
    q: "Is Atom open source?",
    a: "Yes. Atom is licensed under Apache 2.0. The source is at github.com/absmach/atom. All APIs — GraphQL, REST, and gRPC — are fully open with no commercial restrictions.",
  },
  {
    q: "Does Atom support compliance requirements like GDPR, SOC 2, HIPAA, or ISO 27001?",
    a: "Atom's audit log records every authentication event, credential lifecycle change, and authorization check immutably — exportable to CSV for compliance reporting. This satisfies the access-log requirements for SOC 2 Type II, HIPAA audit trail obligations, and ISO 27001 access control controls. The explainability API (ask why a request was allowed or denied) provides the documentation chain auditors require. Runtime policy enforcement means access rights reflect revocations immediately, satisfying GDPR's right-to-erasure and minimal-access requirements without stale-token windows.",
  },
];

const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map(({ q, a }) => ({
    "@type": "Question",
    name: q,
    acceptedAnswer: { "@type": "Answer", text: a },
  })),
});
---

<BaseLayout
  title="Atom — Open-Source IAM with Runtime RBAC & ABAC"
  description="Open-source IAM platform with runtime RBAC, ABAC, JWT authentication, and a full Admin UI for policy management. Single Rust binary, zero sidecars, backed by PostgreSQL."
>
  <Header />
  <main>
    <!-- Hero -->
    <section class="prod-hero has-video">
      <video
        class="hero-bg-video"
        autoplay
        muted
        loop
        playsinline
        width="1920"
        height="1080"
        poster="/video/hero-background-poster.webp"
        aria-hidden="true"
      >
        <source src="/video/hero-background.webm" type="video/webm" />
        <source src="/video/hero-background.mp4" type="video/mp4" />
      </video>
      <div class="container-wide">
        <div class="hero-copy" style="text-align: center;">
          <div style="text-align: left;">
            <p class="atom-wordmark">Atom</p>
          </div>
          <h1 class="tagline">
            Open-Source Identity &amp; Authorization — RBAC, ABAC, JWT in One
            Rust Binary.
          </h1>
          <p
            class="lede"
            style="margin-top:16px; max-width:52ch; margin-left:auto; margin-right:auto;"
          >
            One Rust binary, one PostgreSQL database — no sidecars, no runtime
            dependencies. Authentication, RBAC, ABAC, and live policy
            enforcement in a single deployable service.
          </p>
          <div class="btn-row" style="margin-top:32px; justify-content:center;">
            <a href="/docs/atom" class="btn btn-primary">Documentation ↗</a>
            <a href="/contact" class="btn">Contact Us →</a>
          </div>
          <div style="margin-top:20px;">
            <span class="badge success"
              ><span class="dot"></span>Open Source · Apache 2.0</span
            >
          </div>
        </div>
      </div>
    </section>

    <!-- Stats bar -->
    <div style="border-bottom:1px solid var(--line-3);">
      <div class="container-wide">
        <div
          class="metrics atom-metrics"
          style="border:none; border-radius:0; border-left:1px solid var(--line-3);"
        >
          <div class="metric featured">
            <div class="v">1 binary</div>
            <div class="l">Zero sidecars, zero dependencies</div>
          </div>
          <div class="metric">
            <div class="v">5</div>
            <div class="l">Entity kinds</div>
          </div>
          <div class="metric">
            <div class="v">∞</div>
            <div class="l">Policy flexibility</div>
          </div>
          <div class="metric">
            <div class="v">
              <a
                href="https://github.com/absmach/atom"
                target="_blank"
                rel="noopener">Apache 2.0 ↗</a
              >
            </div>
            <div class="l">Open-source license</div>
          </div>
        </div>
      </div>
    </div>

    <!-- Features -->
    <section class="section" style="border-bottom:1px solid var(--line-3);">
      <div class="container-wide">
        <div class="section-head">
          <div class="left">
            <span class="kicker">Features</span>
            <h2 class="h-2" style="margin-top:14px;">
              Built for modern identity and access control.
            </h2>
          </div>
          <p class="lede">
            Authentication, authorization, identity management, and policy
            enforcement — one service.
          </p>
        </div>
        <div class="feature-grid">
          {
            features.map(({ icon: Icon, name, desc }) => (
              <div class="feature">
                <div class="ic atom-ic">
                  <Icon size={20} />
                </div>
                <div class="name">{name}</div>
                <p class="desc">{desc}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Admin UI — with screenshots -->
    <section
      class="section"
      style="background:var(--paper-2); border-bottom:1px solid var(--line-3);"
    >
      <div class="container-wide">
        <div class="section-head">
          <div class="left">
            <span class="kicker">Admin UI</span>
            <h2 class="h-2" style="margin-top:14px;">Built for operators.</h2>
          </div>
          <p class="lede">
            Manage every object in the system from one interface. No SQL
            console, no curl scripts.
          </p>
        </div>
        <div class="pui-layout">
          <div class="pui-tabs" id="pui-tabs">
            {
              uiFeatures.map(({ id, title, desc }, i) => (
                <div
                  class={`pui-tab${i === 0 ? " active" : ""}`}
                  data-target={id}
                >
                  <button class="pui-tab-btn" type="button">
                    <span class="pui-tab-title">{title}</span>
                    <span class="pui-chevron">›</span>
                  </button>
                  <p class="pui-tab-desc">{desc}</p>
                </div>
              ))
            }
          </div>
          <div class="pui-panel">
            {
              uiFeatures.map(({ id, img, alt }, i) => (
                <div
                  class={`pui-img-wrap${i === 0 ? " active" : ""}`}
                  data-panel={id}
                >
                  <img src={img} alt={alt} class="pui-img" loading="lazy" />
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <!-- Architecture -->
    <section
      class="section"
      style="background:var(--paper-2); border-bottom:1px solid var(--line-3);"
    >
      <div class="container-wide">
        <div class="section-head">
          <div class="left">
            <span class="kicker">Architecture</span>
            <h2 class="h-2" style="margin-top:14px;">
              Two modules. One binary.
            </h2>
          </div>
          <p class="lede">
            Identity and Authorization run in the same process, backed by a
            single PostgreSQL database. No sidecars, no external services.
          </p>
        </div>
        <div class="atom-arch-outer">
          <!-- Left: Atom block -->
          <div class="atom-block-diagram">
            <div class="atom-bd-label">Atom</div>

            <!-- Modules row -->
            <div class="atom-bd-modules">
              <div class="atom-bd-module">
                <div class="atom-bd-module-name">Identity Module</div>
                <div class="atom-bd-module-tags">
                  <span>entities</span><span>credentials</span><span
                    >sessions</span
                  ><span>groups</span><span>ownerships</span>
                </div>
              </div>
              <div class="atom-bd-module">
                <div class="atom-bd-module-name">Authorization Module</div>
                <div class="atom-bd-module-tags">
                  <span>resources</span><span>capabilities</span><span
                    >roles</span
                  ><span>policy_bindings</span><span>PDP engine</span>
                </div>
              </div>
            </div>

            <!-- Database row -->
            <div class="atom-bd-db-row">
              <div class="atom-bd-db">
                <div class="atom-bd-db-name">PostgreSQL</div>
                <div class="atom-bd-db-sub">
                  Single database · Auto-migrated on startup
                </div>
              </div>
            </div>
          </div>

          <!-- Right: Request pipeline block -->
          <div class="atom-pipeline-block">
            <div class="atom-bd-label">Request Pipeline</div>
            <div class="atom-bd-pipeline">
              <div class="atom-bd-block">
                <div class="atom-bd-block-name">Handler</div>
                <div class="atom-bd-block-desc">HTTP · parse · respond</div>
              </div>
              <div class="atom-bd-arrow">↓</div>
              <div class="atom-bd-block">
                <div class="atom-bd-block-name">Service / Engine</div>
                <div class="atom-bd-block-desc">Business logic · audit</div>
              </div>
              <div class="atom-bd-arrow">↓</div>
              <div class="atom-bd-block">
                <div class="atom-bd-block-name">Repo</div>
                <div class="atom-bd-block-desc">SQL only · domain types</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- How it works -->
    <section class="section" style="border-bottom:1px solid var(--line-3);">
      <div class="container-wide">
        <div class="section-head">
          <div class="left">
            <span class="kicker">How it works</span>
            <h2 class="h-2" style="margin-top:14px;">
              Deploy. Model. Enforce.
            </h2>
          </div>
        </div>
        <div class="steps">
          {
            steps.map(([num, title, desc]) => (
              <div class="step">
                <div class="num">{num}</div>
                <h4>{title}</h4>
                <p>{desc}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Policy Engine — dark section -->
    <section class="atom-policy-section">
      <div class="container-wide">
        <div class="section-head" style="color:inherit;">
          <div class="left">
            <span class="kicker" style="color:rgba(246,244,238,0.5);"
              >Policy Engine</span
            >
            <h2 class="h-2" style="margin-top:14px; color:var(--paper);">
              One policy primitive. RBAC and ABAC unified.
            </h2>
          </div>
          <p class="lede" style="color:rgba(246,244,238,0.65); max-width:38ch;">
            Both role-based and attribute-based access control are expressed
            through a single PolicyBinding — no separate systems to manage.
          </p>
        </div>
        <div class="atom-policy-layout">
          <div class="atom-policy-code-wrap">
            <div class="atom-policy-code-label">PolicyBinding</div>
            <pre
              class="atom-policy-code">{`PolicyBinding {
  subject:    group("operators")
  grant:      capability("publish")
  scope:      tenant("factory-a")
  effect:     allow
  conditions: {
    "resource.env": "production"
  }
}`}</pre>
            <p class="atom-policy-note">
              No permissions embedded in tokens. Every decision is evaluated
              online.
            </p>
          </div>
          <div class="atom-policy-features">
            {
              policyFeatures.map(({ name, desc }) => (
                <div class="atom-policy-feature">
                  <div class="atom-policy-fname">{name}</div>
                  <div class="atom-policy-fdesc">{desc}</div>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <!-- Developer Surface -->
    <section class="section" style="border-bottom:1px solid var(--line-3);">
      <div class="container-wide">
        <div class="section-head">
          <div class="left">
            <span class="kicker">Developer Surface</span>
            <h2 class="h-2" style="margin-top:14px;">
              GraphQL-native. Runtime-ready.
            </h2>
          </div>
          <p class="lede">
            One endpoint for management. A dedicated gRPC channel for
            high-throughput runtime checks.
          </p>
        </div>
        <div class="feature-grid">
          {
            devSurface.map(({ icon: Icon, name, desc }) => (
              <div class="feature">
                <div class="ic atom-ic">
                  <Icon size={20} />
                </div>
                <div class="name">{name}</div>
                <p class="desc">{desc}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Quick Start -->
    <section
      class="section"
      style="background:var(--paper-2); border-bottom:1px solid var(--line-3);"
    >
      <div class="container-wide">
        <div class="section-head">
          <div class="left">
            <span class="kicker">Quick start</span>
            <h2 class="h-2" style="margin-top:14px;">
              Up and running in minutes.
            </h2>
          </div>
        </div>
        <div class="atom-qs-grid">
          {
            quickstart.map(({ step, code }) => (
              <div class="atom-qs-card">
                <div class="atom-qs-step">{step}</div>
                <pre class="atom-qs-code">{code}</pre>
              </div>
            ))
          }
        </div>
        <div class="btn-row" style="margin-top:40px;">
          <a
            href="https://github.com/absmach/atom"
            class="btn btn-primary"
            target="_blank"
            rel="noopener">View on GitHub ↗</a
          >
          <a href="/docs/atom" class="btn">Read docs ↗</a>
        </div>
      </div>
    </section>

    <!-- Use Cases -->
    <section class="section" style="border-bottom:1px solid var(--line-3);">
      <div class="container-wide">
        <div class="section-head">
          <div class="left">
            <span class="kicker">Use Cases</span>
            <h2 class="h-2" style="margin-top:14px;">Where Atom fits.</h2>
          </div>
        </div>
        <div class="sol-grid atom-sol-grid">
          {
            solutions.map(({ icon: Icon, title, desc, tags }) => (
              <div class="sol-card">
                <div class="atom-sol-icon">
                  <Icon size={22} />
                </div>
                <h3 class="name">{title}</h3>
                <p class="desc">{desc}</p>
                <div class="tags">
                  {tags.map((t) => (
                    <span class="tag">{t}</span>
                  ))}
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Deployment — dark section -->
    <section class="atom-deploy-section">
      <div class="container-wide">
        <div class="section-head" style="color:inherit;">
          <div class="left">
            <span class="kicker" style="color:rgba(246,244,238,0.5);"
              >Deployment</span
            >
            <h2 class="h-2" style="margin-top:14px; color:var(--paper);">
              One binary.
            </h2>
          </div>
          <p class="lede" style="color:rgba(246,244,238,0.65); max-width:38ch;">
            Self-contained and operational immediately after deployment. No
            infrastructure assembly required.
          </p>
        </div>
        <div class="atom-deploy-grid">
          {
            [
              [
                "Single Rust binary",
                "No runtime dependencies, no JVM, no Node.",
              ],
              [
                "PostgreSQL only",
                "No Redis, no message queues, no coordination service.",
              ],
              [
                "Auto migrations",
                "Schema migrations run on startup automatically.",
              ],
              [
                "Key generation",
                "JWT signing key generated and stored on first boot.",
              ],
              ["Docker Compose", "Atom + PostgreSQL, ready in one command."],
              [
                "Kubernetes",
                "Single Deployment + Service. Config from env vars.",
              ],
            ].map(([name, desc]) => (
              <div class="atom-deploy-item">
                <div class="atom-deploy-name">{name}</div>
                <div class="atom-deploy-desc">{desc}</div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Comparison -->
    <!-- <section class="section" style="background:var(--paper-2); border-bottom:1px solid var(--line-3);">
      <div class="container-wide">
        <div class="section-head">
          <div class="left">
            <span class="kicker">Comparison</span>
            <h2 class="h-2" style="margin-top:14px;">Why teams choose Atom.</h2>
          </div>
          <p class="lede">
            Identity and authorization in one operationally simple platform —
            no infrastructure assembly, no split deployment.
          </p>
        </div>
        <div class="atom-comparison-wrap">
          <table class="atom-comparison-table">
            <thead>
              <tr>
                <th>Feature</th>
                <th class="atom-col-atom">Atom</th>
                <th>Keycloak</th>
                <th>Ory</th>
                <th>Cerbos</th>
              </tr>
            </thead>
            <tbody>
              {comparisonRows.map(({ feature, atom, keycloak, ory, cerbos }) => (
                <tr>
                  <td>{feature}</td>
                  <td class={`atom-col-atom ${atom === "Yes" ? "atom-yes" : "atom-partial"}`}>{atom}</td>
