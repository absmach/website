---
import {
  ArrowRight,
  ArrowUpRight,
  DollarSign,
  FlaskConical,
  GitBranch,
  Globe,
  TrendingUp,
  Zap,
} from "@lucide/astro";
import IdentityLayout from "../layouts/IdentityLayout.astro";
import "../styles/identity-editorial.css";
import "../styles/identity-pages.css";

const benefits = [
  {
    ic: Globe,
    title: "Remote-first",
    desc: "Work from anywhere in Europe with flexible hours. We care about outcomes, not office time.",
  },
  {
    ic: GitBranch,
    title: "Open source",
    desc: "Contribute to projects used by thousands of developers worldwide. Your work ships publicly.",
  },
  {
    ic: FlaskConical,
    title: "Research",
    desc: "Work on Horizon Europe projects in confidential computing, service orchestration, and 6G networks.",
  },
  {
    ic: TrendingUp,
    title: "Growth",
    desc: "Continuous learning, conference attendance, and the space to explore new technologies.",
  },
  {
    ic: Zap,
    title: "Impact",
    desc: "Build infrastructure that runs at Nokia, Intel, and Ericsson scale. What you ship matters.",
  },
  {
    ic: DollarSign,
    title: "Competitive",
    desc: "Market-rate compensation and equity. We reward the people who make the work excellent.",
  },
];

const process = [
  {
    title: "Apply",
    desc: "Send us your CV and a short note about what interests you. No cover letter required.",
  },
  {
    title: "Screen",
    desc: "A 30-minute intro call with someone from the team to discuss your background and interests.",
  },
  {
    title: "Interview",
    desc: "A technical and values conversation relevant to the role. No whiteboard puzzles.",
  },
  {
    title: "Offer",
    desc: "We move quickly. If it is a fit, you will have an offer within a few days of the final round.",
  },
];
---

<IdentityLayout
  title="Careers"
  description="Join Abstract Machines and help build open-source infrastructure for AI, IoT, and edge computing. Remote-first, research-driven, based in Paris."
  active="company"
>
  <section class="ip-hero" aria-labelledby="careers-title">
    <nav class="is-breadcrumb" aria-label="Breadcrumb">
      <a href="/">Abstract Machines</a><span>/</span><a href="/company/"
        >Company</a
      ><span>/</span> Careers
    </nav>
    <div class="ip-hero-grid">
      <div>
        <p class="ie-eyebrow">Careers / Abstract Machines</p>
        <h1 id="careers-title">
          Build the future<br /><span>with us.</span>
        </h1>
      </div>
      <div class="ip-hero-aside">
        <p>
          Join a small, expert team pushing the boundaries of distributed
          systems, applied AI, and edge computing. Openly, from wherever you
          are.
        </p>
        <div class="ip-hero-actions">
          <a class="ie-button ie-button-white" href="/contact/"
            >Get in touch <ArrowUpRight size={19} /></a
          ><a class="text-link" href="https://github.com/absmach"
            >View our work <ArrowUpRight size={18} /></a
          >
        </div>
      </div>
    </div>
  </section>

  <section class="ip-section" aria-labelledby="why-title">
    <div class="ip-heading">
      <div>
        <p class="ie-eyebrow">Why join us</p>
        <h2 id="why-title">What makes us<br /><span>different.</span></h2>
      </div>
      <p>Six reasons people choose to work at Abstract Machines.</p>
    </div>
    <div class="ip-grid ip-grid-3">
      {
        benefits.map(({ ic: Icon, title, desc }) => (
          <article class="ip-card">
            <span class="ip-card-icon">
              <Icon size={20} />
            </span>
            <h3>{title}</h3>
            <p>{desc}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="ip-section ip-section--soft" aria-labelledby="hiring-title">
    <div class="ip-panel">
      <span class="ip-status">Hiring status</span>
      <h2 id="hiring-title">No open roles right now.</h2>
      <p>
        We have no active listings, but we are always interested in hearing from
        strong engineers, researchers, and solutions architects. Send us a note.
        If there is a fit, we will make room.
      </p>
      <div class="ip-actions">
        <a class="ie-button" href="/contact/"
          >Send a note <ArrowUpRight size={19} /></a
        ><a class="text-link" href="mailto:info@absmach.eu"
          >info@absmach.eu <ArrowRight size={18} /></a
        >
      </div>
    </div>
  </section>

  <section class="ip-section" aria-labelledby="process-title">
    <div class="ip-heading">
      <div>
        <p class="ie-eyebrow">Process</p>
        <h2 id="process-title">What to expect.</h2>
      </div>
      <p>A straightforward, respectful hiring process. No surprises.</p>
    </div>
    <ol class="ip-steps">
      {
        process.map((step, i) => (
          <li>
            <span class="ie-number">{String(i + 1).padStart(2, "0")}</span>
            <h3>{step.title}</h3>
            <p>{step.desc}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="ip-cta" aria-labelledby="careers-cta-title">
    <div>
      <p class="ie-eyebrow">Open conversation</p>
      <h2 id="careers-cta-title">Don’t see<br /><span>a fit?</span></h2>
    </div>
    <div>
      <p>
        We are always interested in hearing from talented people. Send us your
        details and let’s talk.
      </p>
      <div class="ip-actions">
        <a class="ie-button ie-button-white" href="/contact/"
          >Get in touch <ArrowUpRight size={19} /></a
        ><a class="text-link" href="/company/"
          >Get to know Abstract Machines <ArrowRight size={18} /></a
        >
      </div>
    </div>
  </section>
</IdentityLayout>
