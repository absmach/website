---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import FAQAccordion from "../../components/FAQAccordion.astro";

const a0BoardSpecs = [
  "ESP32-C6 RISC-V Core",
  "Wireless M-Bus (868 MHz)",
  "NB-IoT / LTE-M (SIM7080G)",
  "WiFi & Bluetooth LE",
  "Zephyr RTOS",
  "Open Source Hardware",
];

const beagleVFireSpecs = [
  "RISC-V Linux SoC (PolarFire)",
  "Full Linux Operating System",
  "High-Performance Edge Compute",
  "Advanced Networking Stack",
  "Container & Wasm Workloads",
  "Edge AI / ML Inference",
];

const features = [
  {
    ic: "🔲",
    name: "A0 Board + BeagleV-Fire",
    desc: "A1 combines the A0 module with the BeagleV-Fire board, pairing multi-protocol wireless capabilities with powerful Linux compute in a single gateway.",
  },
  {
    ic: "🐧",
    name: "Linux-Based OS",
    desc: "Runs a full Linux operating system, enabling richer software stacks, containerised workloads, and support for a wide range of open-source tools.",
  },
  {
    ic: "⚙️",
    name: "RISC-V Architecture",
    desc: "Built on RISC-V architecture, delivering high-performance computing for demanding industrial and edge AI applications.",
  },
  {
    ic: "📡",
    name: "Multi-Protocol Wireless",
    desc: "Inherits the A0 module's multi-protocol connectivity (Wireless M-Bus, NB-IoT, LTE-M, WiFi, and BLE) for versatile IoT deployments.",
  },
  {
    ic: "☁️",
    name: "Edge-to-Cloud Integration",
    desc: "Seamlessly integrates edge devices with cloud platforms via MQTT, CoAP, and WebSockets, powered by the Magistrala IoT platform.",
  },
  {
    ic: "🏭",
    name: "Industrial-Grade Reliability",
    desc: "Designed for demanding industrial environments requiring high-performance computing, robust connectivity, and long-term operational stability.",
  },
];

const solutions = [
  {
    title: "Smart Metering",
    desc: "Aggregate data from multiple A0 wireless gateways and forward it securely to Magistrala.",
    tags: ["Aggregation", "M-Bus", "MQTT"],
  },
  {
    title: "Industrial Automation",
    desc: "Run control logic and monitoring applications directly on the gateway in industrial environments.",
    tags: ["Control Logic", "Edge", "Reliability"],
  },
  {
    title: "Edge Computing",
    desc: "Process data locally with containers or Wasm before sending aggregated results to the cloud.",
    tags: ["Containers", "Wasm", "Bandwidth"],
  },
  {
    title: "Edge AI Inference",
    desc: "Deploy and update ML models over the air using Propeller. Run inference at line speed.",
    tags: ["ML Models", "OTA", "Inference"],
  },
];

const integrations = [
  "Magistrala",
  "Propeller",
  "BeagleV-Fire",
  "Docker",
  "MQTT",
  "CoAP",
  "WebSocket",
  "A0 Module",
];

const faqs = [
  {
    q: "What is the difference between A0 and A1?",
    a: "A0 runs Zephyr RTOS on an ESP32-C6 microcontroller, optimised for ultra-low power and constrained environments. A1 runs full Linux on a RISC-V compute board (BeagleV-Fire) and is suited to workloads requiring a full OS, containers, or higher processing power.",
  },
  {
    q: "When should I choose Linux over Zephyr RTOS?",
    a: "Choose A1 when you need standard tooling, container support, Python or higher-level runtimes, or when the workload requires more memory and compute than a microcontroller can provide. Choose A0 when power consumption and form factor are the primary constraints.",
  },
  {
    q: "Does A1 support container workloads?",
    a: "Yes. A1 runs a full Linux stack and can run Docker containers alongside WebAssembly workloads managed by Propeller. Both runtimes can coexist on the same device.",
  },
  {
    q: "How does A1 connect to Magistrala?",
    a: "A1 communicates with Magistrala over MQTT, CoAP, or HTTP. The A0 wireless radio module on A1 handles the communication with field devices, while the BeagleV-Fire compute board routes aggregated data to the cloud platform.",
  },
  {
    q: "What is the BeagleV-Fire?",
    a: "BeagleV-Fire is an open-hardware single-board computer based on the Microchip PolarFire SoC, which combines a RISC-V processor with an FPGA. It provides the Linux compute core for the A1 gateway.",
  },
];
---

<BaseLayout
  title="A1 Industrial Gateway — Abstract Machines"
  description="RISC-V Linux gateway for industrial IoT with container and Wasm workload support. Full Linux OS, edge AI, and industrial-grade reliability."
>
  <Header />
  <main>

    <!-- Hero -->
    <section class="prod-hero has-video">
      <video
        class="hero-bg-video"
        autoplay
        muted
        loop
        playsinline
        poster="/video/hero-background-poster.webp"
        aria-hidden="true"
      >
        <source src="/video/hero-background.webm" type="video/webm" />
        <source src="/video/hero-background.mp4" type="video/mp4" />
      </video>
      <div class="container-wide">
        <div class="hero-grid">
          <div>
            <div class="logo-mark">
              <span class="swatch" style="background:rgba(255,255,255,0.12);"></span>
              A1 · Industrial Gateway · Hardware
            </div>
            <h1 class="tagline">A1 – Linux Gateway for Industrial IoT.</h1>
            <p class="lede" style="margin-top:16px; max-width:48ch;">
              A1 is a powerful Linux-based IoT gateway built on RISC-V
              architecture. It offers robust connectivity, advanced processing
              capabilities, and scalability for industrial IoT applications.
            </p>
            <div class="btn-row" style="margin-top:32px;">
              <a href="https://hardware.absmach.eu/docs/s1-gateway" class="btn btn-primary" target="_blank" rel="noopener">Learn More ↗</a>
              <a href="/contact" class="btn">Contact Us</a>
            </div>
            <div style="margin-top:20px;">
              <span class="badge success"><span class="dot"></span>Open Hardware</span>
            </div>
          </div>
          <div class="hero-visual" style="padding:32px;">
            <img
              src="/img/products/s1-beagle.png"
              alt="A1 industrial gateway with BeagleV-Fire compute board"
              style="object-fit:contain; max-height:400px;"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- Stats bar -->
    <div style="border-bottom:1px solid var(--line-3);">
      <div class="container-wide">
        <div class="a1-metrics metrics" style="border:none; border-radius:0; border-left:1px solid var(--line-3);">
          <div class="metric featured">
            <div class="v">RISC-V</div>
            <div class="l">BeagleV-Fire compute</div>
          </div>
          <div class="metric">
            <div class="v">Full Linux</div>
            <div class="l">Operating system</div>
          </div>
          <div class="metric">
            <div class="v">Container + Wasm</div>
            <div class="l">Workload support</div>
          </div>
          <div class="metric">
            <div class="v">Industrial</div>
            <div class="l">Grade reliability</div>
          </div>
        </div>
      </div>
    </div>

    <!-- A0 Board + BeagleV-Fire components -->
    <section class="section" style="border-bottom:1px solid var(--line-3);">
      <div class="container-wide">

        <!-- Component 1: A0 Board -->
        <div class="a1-component">
          <div class="a1-component-header">
            <span class="kicker">Component 1</span>
            <h2 class="h-2" style="margin-top:8px;">A0 Board</h2>
          </div>
          <div class="a1-component-body">
            <div class="a1-img-wrap">
              <img
                src="/img/products/s0-board-detail.webp"
                alt="A0 Board"
                class="a1-img"
                loading="lazy"
              />
            </div>
            <div class="a1-component-text">
              <p class="lede">
                The <strong>A0 Board</strong> is the wireless connectivity core of the A1
                gateway. It handles multi-protocol wireless data collection
                (Wireless M-Bus, NB-IoT, LTE-M, WiFi, and BLE) and passes data
                to the <strong>BeagleV-Fire</strong> for Linux-side processing and cloud backhaul.
              </p>
              <ul class="a1-spec-list">
                {a0BoardSpecs.map(spec => (
                  <li class="a1-spec-item">
                    <span class="a1-check">✓</span>
                    <span>{spec}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>

        <div class="a1-divider"></div>

        <!-- Component 2: BeagleV-Fire -->
        <div class="a1-component">
          <div class="a1-component-header">
            <span class="kicker">Component 2</span>
            <h2 class="h-2" style="margin-top:8px;">BeagleV-Fire</h2>
          </div>
          <div class="a1-component-body">
            <div class="a1-img-wrap">
              <img
                src="/img/products/s1-beaglev-fire.webp"
                alt="BeagleV-Fire compute board"
                class="a1-img"
                loading="lazy"
              />
            </div>
            <div class="a1-component-text">
              <p class="lede">
                The <strong>BeagleV-Fire</strong> brings a full <strong>Linux operating system</strong> to the
                A1 gateway on a RISC-V PolarFire SoC. It provides the compute
                power needed for containerised workloads, edge AI inference,
                advanced networking, and seamless cloud integration;
                capabilities not available on a bare-metal RTOS.
              </p>
              <ul class="a1-spec-list">
                {beagleVFireSpecs.map(spec => (
                  <li class="a1-spec-item">
                    <span class="a1-check">✓</span>
                    <span>{spec}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>

      </div>
    </section>

    <!-- Features -->
    <section class="section">
      <div class="container-wide">
        <div class="section-head" style="text-align:center; display:block;">
          <span class="kicker">Features</span>
          <h2 class="h-2" style="margin-top:14px;">A1 Features.</h2>
          <p class="lede" style="margin:12px auto 0; max-width:52ch;">
            A0 Board + BeagleV-Fire: the Linux-based gateway for demanding
            industrial and edge computing deployments.
          </p>
        </div>
        <div class="a1-feat-grid feature-grid" style="margin-top:48px;">
          {features.map(({ ic, name, desc }) => (
            <div class="feature">
              <div class="ic" style="font-size:18px;">{ic}</div>
              <div class="name">{name}</div>
              <p class="desc">{desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Solutions -->
    <section class="section" style="background:var(--paper-2); border-top:1px solid var(--line-3); border-bottom:1px solid var(--line-3);">
      <div class="container-wide">
        <div class="section-head">
          <div class="left">
            <span class="kicker">Solutions</span>
            <h2 class="h-2" style="margin-top:14px;">Where A1 deploys.</h2>
          </div>
        </div>
        <div class="a1-sol-grid sol-grid">
          {solutions.map(({ title, desc, tags }) => (
            <div class="sol-card">
              <div class="icon-frame">{title.charAt(0)}</div>
              <h3 class="name">{title}</h3>
              <p class="desc">{desc}</p>
              <div class="tags">
                {tags.map(t => <span class="tag">{t}</span>)}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Integrations -->
    <section class="section">
      <div class="container-wide">
        <div class="section-head">
          <div class="left">
            <span class="kicker">Integrations</span>
            <h2 class="h-2" style="margin-top:14px;">Connects with the full stack.</h2>
          </div>
          <p class="lede">A1 pairs with Magistrala for device management and Propeller for edge workload orchestration.</p>
        </div>
        <div class="integ-grid">
          {integrations.map(name => (
            <div class="integ-chip">
              <span class="dot"></span>
              {name}
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="section" style="background:var(--paper-2); border-top:1px solid var(--line-3); border-bottom:1px solid var(--line-3);">
      <div class="container-wide">
        <div class="section-head">
          <div class="left">
            <span class="kicker">FAQ</span>
            <h2 class="h-2" style="margin-top:14px;">Common questions.</h2>
          </div>
        </div>
        <FAQAccordion items={faqs} />
      </div>
    </section>

    <!-- CTA -->
    <section class="section">
      <div class="container-narrow" style="text-align:center;">
        <span class="kicker">Get started</span>
        <h2 class="h-2" style="margin-top:14px;">Deploy Linux at the industrial edge.</h2>
        <p class="lede" style="margin:20px auto 36px;">Read the documentation, explore the open hardware, or talk to the team about your deployment requirements.</p>
        <div class="btn-row" style="justify-content:center;">
          <a href="https://hardware.absmach.eu/docs/s1-gateway" class="btn btn-primary" target="_blank" rel="noopener">Learn More ↗</a>
          <a href="/contact" class="btn">Contact Us</a>
        </div>
      </div>
      <div class="container-narrow" style="margin-top:48px; padding-top:32px; border-top:1px solid var(--line-3);">
        <p style="font-size:12px; color:var(--ink-4); text-align:center; line-height:1.6;">
          A1 hardware was developed with support from the European Union's Horizon Europe research and innovation programme as part of the <a href="/projects/elastic" style="color:var(--ink-3); text-decoration:underline;">ELASTIC project</a>.
        </p>
      </div>
    </section>

  </main>
  <Footer />
  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "Product",
    "name": "A1 Industrial Gateway",
    "description": "RISC-V Linux gateway for industrial IoT with container and Wasm workload support. Full Linux OS, edge AI, and industrial-grade reliability.",
    "url": "https://absmach.eu/products/a1",
    "brand": {
      "@type": "Brand",
      "name": "Abstract Machines"
    }
  }
  </script>
</BaseLayout>

<style>
  /* Metrics */
  .a1-metrics {
    grid-template-columns: repeat(4, 1fr);
  }
  @media (max-width: 640px) {
    .a1-metrics {
      grid-template-columns: repeat(2, 1fr);
    }
    .a1-metrics .metric {
      border-right: none;
    }
  }

  /* Component sections */
  .a1-component {
    padding: 48px 0;
  }
  .a1-component-header {
    margin-bottom: 40px;
  }
  .a1-component-body {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
    align-items: center;
  }
  @media (max-width: 768px) {
    .a1-component-body {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }

  .a1-img-wrap {
    border-radius: 16px;
    overflow: hidden;
    background: var(--paper-2);
    border: 1px solid var(--line-3);
  }
  .a1-img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 15px;
  }

  .a1-component-text .lede {
    color: var(--ink-2);
    margin-bottom: 24px;
  }
  .a1-component-text strong {
    color: var(--ink);
    font-weight: 600;
  }

  .a1-spec-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .a1-spec-item {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 14px;
    color: var(--ink-2);
  }
  .a1-check {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--paper-3);
    color: var(--ink-2);
    font-size: 11px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    font-weight: 700;
  }

  .a1-divider {
    height: 1px;
    background: var(--line-3);
  }

  /* Features grid */
  .a1-feat-grid {
    grid-template-columns: repeat(3, 1fr);
  }
  @media (max-width: 980px) {
    .a1-feat-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 640px) {
    .a1-feat-grid {
      grid-template-columns: 1fr;
    }
  }

  /* Solutions grid */
  .a1-sol-grid {
    grid-template-columns: repeat(2, 1fr);
  }
  @media (max-width: 640px) {
    .a1-sol-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
