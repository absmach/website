---
const products = [
  {
    href: "/products/magistrala",
    className: "b-magistrala",
    category: "Flagship · IoT Platform",
    name: "Magistrala",
    nameLogo: "/img/logos/Magistrala_logo_web_4_btb.png",
    description:
      "Device identity, multi-protocol connectivity, and fine-grained access control for IoT deployments at any scale.",
    meta: "MQTT · CoAP · HTTP · WebSocket",
    badge: "v0.40.0",
  },
  {
    href: "/products/fluxmq",
    className: "b-fluxmq",
    category: "Platform · Messaging",
    name: "FluxMQ",
    description:
      "Durable, low-latency MQTT broker for distributed event streams.",
  },
  {
    href: "/products/atom",
    className: "b-atom",
    category: "Platform · Identity",
    name: "Atom",
    description:
      "Identity and authorization for every entity, online at runtime.",
  },
  {
    href: "/products/propeller",
    className: "b-propeller",
    category: "Orchestration",
    name: "Propeller",
    nameLogo: "/img/logos/Propeller_logo_web_4_btw.png",
    description:
      "WebAssembly orchestration and IoT rule engine for cloud-to-edge workloads.",
  },
  {
    href: "/products/a0",
    className: "b-a0",
    category: "Hardware · Edge",
    name: "A0 Gateway",
    description:
      "Ultra-low-power Zephyr RTOS gateway for constrained sensor networks.",
  },
  {
    href: "/products/a1",
    className: "b-a1",
    category: "Hardware · Industrial",
    name: "A1 Gateway",
    description: "Linux-based IoT gateway built on RISC-V architecture.",
  },
  {
    href: "/products/quarc",
    className: "b-quarc",
    category: "Hardware · Security",
    name: "Quarc",
    description:
      "Post-quantum cryptographic coprocessor for hardware-rooted security.",
  },
];
---

<section
  style="background: var(--paper-2); border-top:1px solid var(--line-3); border-bottom:1px solid var(--line-3);"
>
  <div class="container-wide">
    <div class="section-head">
      <div class="left">
        <span class="kicker"
          >Products · Seven products. One coherent stack.</span
        >
        <h2 class="h-1" style="margin-top:14px;">
          Software and hardware,<br />built for secure connectivity.
        </h2>
      </div>
      <a href="/products" class="btn-link">All products →</a>
    </div>
    <div class="bento">
      {
        products.map((product) => (
          <a href={product.href} class={`b ${product.className}`}>
            <div class="top">
              <div>
                <div class="pcat">{product.category}</div>
                {product.nameLogo ? (
                  <img
                    src={product.nameLogo}
                    alt={product.name}
                    class="pname-logo"
                    loading="lazy"
                  />
                ) : (
                  <div class="pname" style="margin-top:6px;">
                    {product.name}
                  </div>
                )}
                {product.className === "b-magistrala" && (
                  <p class="pdesc" style="margin-top:14px;">
                    {product.description}
                  </p>
                )}
              </div>
              {product.badge ? (
                <span class="badge">
                  <span class="dot" />
                  {product.badge}
                </span>
              ) : (
                <span class="arrow">→</span>
              )}
            </div>

            {product.className === "b-magistrala" && (
              <div class="b-platform-stack" aria-label="Built on">
                <span class="b-platform-label">Built with</span>
                <span class="b-platform-tag">FluxMQ</span>
                <span class="b-platform-tag">Atom</span>
              </div>
            )}

            {product.className !== "b-magistrala" && (
              <p class="pdesc" style="margin-top:14px;">
                {product.description}
              </p>
            )}

            {product.meta && (
              <div style="display:flex; align-items:center; gap:12px; z-index:2; position:relative;">
                <span
                  class="btn btn-primary"
                  style="font-size:13px; padding:8px 14px;"
                >
                  Explore →
                </span>
                <span class="muted" style="font-size:12px;">
                  {product.meta}
                </span>
              </div>
            )}
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .pname-logo {
    display: block;
    height: 48px;
    width: auto;
    margin-top: 10px;
    object-fit: contain;
    object-position: left center;
  }
  .b-magistrala .pname-logo {
    filter: invert(1);
  }
  .b-platform-stack {
    display: flex;
    align-items: center;
    gap: 8px;
    position: relative;
    z-index: 2;
  }
  .b-platform-label {
    font-family: "JetBrains Mono", monospace;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--on-accent-subtle);
  }
  .b-platform-tag {
    font-family: "JetBrains Mono", monospace;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.06em;
    padding: 3px 9px;
    border-radius: 4px;
    border: 1px solid var(--dark-border);
    color: var(--on-accent-muted);
    background: var(--dark-input-bg);
  }
</style>
