---
interface Props {
  items: { q: string; a: string }[];
}
const { items } = Astro.props;
---

<div class="faq-list">
  {
    items.map(({ q, a }) => (
      <details class="faq-item">
        <summary class="faq-q">{q}</summary>
        <p class="faq-a">{a}</p>
      </details>
    ))
  }
</div>
