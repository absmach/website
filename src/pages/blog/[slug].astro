---
export const prerender = true;

import { ArrowLeft, ArrowRight, ArrowUpRight, X } from "@lucide/astro";
import { getCollection } from "astro:content";
import IdentityLayout from "../../layouts/IdentityLayout.astro";
import BlogCard from "../../components/identity/BlogCard.astro";
import AudioReader from "../../components/AudioReader.astro";
import {
  formatDate,
  isRasterImage,
  postSlug,
  summarizePost,
} from "../../lib/blog";
import "../../styles/identity-editorial.css";
import "../../styles/identity-blog.css";

export async function getStaticPaths() {
  const posts = await getCollection("blogs", ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.data.slug ?? post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();
const summary = summarizePost(post);
const updatedAt = post.data.updatedAt ? new Date(post.data.updatedAt) : null;

const ogImage =
  post.data.ogImage?.url ??
  (isRasterImage(summary.coverImage) ? summary.coverImage : null) ??
  "/img/logos/social-preview.png";
const canonical = post.data.canonical ?? summary.href;
const shareUrl = /^https?:\/\//.test(canonical)
  ? canonical
  : new URL(canonical, Astro.site ?? "https://www.absmach.eu").toString();
const shareOnX = `https://twitter.com/intent/tweet?text=${encodeURIComponent(post.data.title)}&url=${encodeURIComponent(shareUrl)}`;
const shareOnLinkedIn = `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(shareUrl)}`;

const coverVideo = post.data.coverVideo ?? null;
const getYouTubeEmbedSrc = (rawUrl: string) => {
  try {
    const url = new URL(rawUrl);
    const hostname = url.hostname.replace(/^www\./, "");
    let videoId = "";
    if (hostname === "youtu.be") {
      videoId = url.pathname.slice(1);
    } else if (
      hostname === "youtube.com" ||
      hostname === "m.youtube.com" ||
      hostname === "youtube-nocookie.com"
    ) {
      if (url.pathname === "/watch") {
        videoId = url.searchParams.get("v") ?? "";
      } else if (
        url.pathname.startsWith("/embed/") ||
        url.pathname.startsWith("/shorts/")
      ) {
        videoId = url.pathname.split("/")[2] ?? "";
      }
    }
    if (!videoId) return null;
    const embedBase =
      hostname === "youtube-nocookie.com"
        ? "https://www.youtube-nocookie.com"
        : "https://www.youtube.com";
    const embedUrl = new URL(`${embedBase}/embed/${videoId}`);
    embedUrl.searchParams.set("autoplay", "1");
    embedUrl.searchParams.set("mute", "1");
    embedUrl.searchParams.set("playsinline", "1");
    embedUrl.searchParams.set("rel", "0");
    return embedUrl.toString();
  } catch {
    return null;
  }
};
const coverVideoIframeSrc = coverVideo ? getYouTubeEmbedSrc(coverVideo) : null;

const allPosts = await getCollection("blogs", ({ data }) => !data.draft);
const related = allPosts
  .filter((entry) => postSlug(entry) !== summary.slug)
  .sort(
    (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
  )
  .slice(0, 3)
  .map(summarizePost);

const structuredData = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  description: post.data.description,
  datePublished: summary.dateISO,
  dateModified: (updatedAt ?? summary.date).toISOString(),
  author: { "@type": "Person", name: summary.author },
  publisher: {
    "@type": "Organization",
    name: "Abstract Machines",
    logo: {
      "@type": "ImageObject",
      url: "https://www.absmach.eu/img/logos/abstract-machines_logo_landscape-black.png",
    },
  },
  image: summary.coverImage
    ? new URL(summary.coverImage, "https://www.absmach.eu").toString()
    : "https://www.absmach.eu/img/logos/social-preview.png",
  url: shareUrl,
  keywords: summary.tags.join(", "),
  mainEntityOfPage: { "@type": "WebPage", "@id": shareUrl },
};
---

<IdentityLayout
  title={post.data.title}
  description={summary.description}
  type="article"
  image={ogImage}
  imageAlt={post.data.title}
  canonical={canonical}
>
  <Fragment slot="head">
    <meta property="article:published_time" content={summary.dateISO} />
    {
      updatedAt && (
        <meta
          property="article:modified_time"
          content={updatedAt.toISOString()}
        />
      )
    }
    <meta property="article:author" content={summary.author} />
    {summary.tags.map((tag) => <meta property="article:tag" content={tag} />)}
    <script
      type="application/ld+json"
      set:html={JSON.stringify(structuredData)}
    />
  </Fragment>

  <section class="ib-post-hero ie-shell">
    <a class="ie-back" href="/blog/"><ArrowLeft size={16} /> Engineering blog</a
    >
    <div class="ib-post-topline">
      <p class="ie-eyebrow">{summary.categoryLabel} / {summary.dateLabel}</p>
      <span>{summary.readingMinutes} min read</span>
    </div>
    <h1>{post.data.title}</h1>
    <p class="ib-post-subtitle">{summary.description}</p>
    <div class="ib-post-author">
      {
        summary.authorPicture ? (
          <img
            src={summary.authorPicture}
            alt=""
            width="48"
            height="48"
            loading="eager"
            decoding="async"
          />
        ) : (
          <span aria-hidden="true">{summary.author.slice(0, 1)}</span>
        )
      }
      <p>
        {summary.author}<span
          >Published {summary.dateLabel}{
            updatedAt && ` · Updated ${formatDate(updatedAt)}`
          }</span
        >
      </p>
    </div>
  </section>

  {
    (coverVideo || summary.coverImage) && (
      <section class="ib-post-cover ie-shell">
        <figure>
          {coverVideo ? (
            coverVideoIframeSrc ? (
              <iframe
                src={coverVideoIframeSrc}
                title={`${post.data.title} cover video`}
                allow="autoplay; encrypted-media; picture-in-picture; web-share"
                allowfullscreen
              />
            ) : (
              <video
                src={coverVideo}
                controls
                autoplay
                muted
                playsinline
                preload="metadata"
                poster={summary.coverImage ?? undefined}
              >
                Your browser does not support the video tag.
              </video>
            )
          ) : (
            <img
              class="ib-cover"
              src={summary.coverImage!}
              alt={post.data.title}
              width="1280"
              height="720"
              loading="eager"
              fetchpriority="high"
              decoding="async"
            />
          )}
        </figure>
      </section>
    )
  }

  <div class="ie-shell ib-post-layout">
    <aside class="ib-post-aside">
      <div class="ib-aside-block">
        <span>Share</span>
        <div class="ib-share">
          <a class="text-link" href={shareOnX}
            >Share on X <ArrowUpRight size={16} /></a
          ><a class="text-link" href={shareOnLinkedIn}
            >Share on LinkedIn <ArrowUpRight size={16} /></a
          >
        </div>
      </div>
      {
        summary.tags.length > 0 && (
          <div class="ib-aside-block">
            <span>Tags</span>
            <div class="ib-post-tags">
              {summary.tags.map((tag) => (
                <a
                  class="ib-tag"
                  href={`/blog/?tags=${encodeURIComponent(tag)}`}
                >
                  {tag}
                </a>
              ))}
            </div>
          </div>
        )
      }
      <div class="ib-aside-block">
        <span>More</span>
        <a class="text-link" href="/blog/"
          >All articles <ArrowRight size={16} /></a
        >
      </div>
    </aside>
    <article class="ib-article">
      <AudioReader target="#post" />
      <div id="post" class="ib-prose">
        <Content />
      </div>
    </article>
  </div>

  <section class="ib-newsletter" aria-labelledby="newsletter-title">
    <div>
      <p class="ie-eyebrow">Newsletter</p>
      <h2 id="newsletter-title">
        Updates from the team,<br /><span>in your inbox.</span>
      </h2>
    </div>
    <div>
      <p>
        Release notes, engineering articles, and announcements from Abstract
        Machines.
      </p>
      <form
        class="ib-newsletter-form"
        action="https://absmach.us11.list-manage.com/subscribe/post?u=70b43c7181d005024187bfb31&id=0a319b6b63&f_id=002611e1f0"
        method="post"
        target="_blank"
      >
        <label
          >Email address<input
            id="mce-EMAIL"
            name="EMAIL"
            type="email"
            placeholder="you@company.com"
            autocomplete="email"
            required
          /></label
        >
        <button class="ie-button" type="submit"
          >Subscribe <ArrowUpRight size={18} /></button
        >
        <input name="tags" type="hidden" value="8115259" />
        <div class="ib-newsletter-honeypot" aria-hidden="true">
          <input
            name="b_70b43c7181d005024187bfb31_0a319b6b63"
            tabindex="-1"
            type="text"
            value=""
          />
        </div>
      </form>
      <p class="ib-newsletter-note">
        By subscribing, you agree to our <a href="/privacy/">Privacy Policy</a>
        and <a href="/terms/">Terms of Service</a>. You can unsubscribe at any
        time.
      </p>
    </div>
  </section>

  {
    related.length > 0 && (
      <section class="ib-next ie-shell" aria-labelledby="next-title">
        <div class="ie-section-heading">
          <div>
            <p class="ie-eyebrow">Continue reading</p>
            <h2 id="next-title">More from the blog.</h2>
          </div>
          <a class="text-link" href="/blog/">
            All articles <ArrowRight size={18} />
          </a>
        </div>
        <div class="ib-grid">
          {related.map((entry) => (
            <BlogCard post={entry} level={3} />
          ))}
        </div>
      </section>
    )
  }

  <div id="blog-lb" role="dialog" aria-modal="true" aria-label="Image zoom">
    <button id="blog-lb-close" aria-label="Close image"><X size={18} /></button>
    <img id="blog-lb-img" src="" alt="" />
  </div>

  <script type="module" is:inline>
    const preBlocks = document.querySelectorAll('pre[data-language="mermaid"]');
    if (preBlocks.length > 0) {
      try {
        const { default: mermaid } =
          await import("https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs");
        mermaid.initialize({
          startOnLoad: false,
          theme: "base",
          themeVariables: {
            primaryColor: "#f1f4f6",
            primaryTextColor: "#073763",
            primaryBorderColor: "#b8c9da",
            lineColor: "#2547ff",
            edgeLabelBackground: "#e7eaff",
            secondaryColor: "#e6ecf5",
            fontFamily: "'DM Sans', sans-serif",
          },
        });
        for (const pre of preBlocks) {
          const div = document.createElement("div");
          div.className = "mermaid";
          div.textContent = pre.textContent ?? "";
          pre.replaceWith(div);
        }
        await mermaid.run({ querySelector: ".mermaid" });
      } catch (error) {
        console.warn("Mermaid diagrams could not be rendered", error);
      }
    }
  </script>

  <script>
    const COPY_ICON =
      '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>';
    const CHECK_ICON =
      '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>';

    const post = document.getElementById("post");
    if (post) {
      // Group consecutive image-only paragraphs into a two-column grid.
      const isImageParagraph = (el: Element): boolean => {
        if (el.tagName !== "P") return false;
        let images = 0;
        for (const node of el.childNodes) {
          if (node.nodeType === Node.TEXT_NODE) {
            if ((node.textContent ?? "").trim() !== "") return false;
          } else if (
            node.nodeType === Node.ELEMENT_NODE &&
            (node as Element).tagName === "IMG"
          ) {
            images++;
          } else {
            return false;
          }
        }
        return images === 1;
      };
      const children = Array.from(post.children);
      let i = 0;
      while (i < children.length) {
        if (isImageParagraph(children[i])) {
          let j = i + 1;
          while (j < children.length && isImageParagraph(children[j])) j++;
          const group = children.slice(i, j);
          if (group.length >= 2) {
            const grid = document.createElement("div");
            grid.className = "blog-img-grid";
            post.insertBefore(grid, group[0]);
            group.forEach((p) => grid.appendChild(p));
          }
          i = j;
        } else {
          i++;
        }
      }

      // Copy buttons on code blocks.
      post
        .querySelectorAll<HTMLPreElement>("pre:not([data-language='mermaid'])")
        .forEach((pre) => {
          const wrapper = document.createElement("div");
          wrapper.className = "code-block-wrap";
          pre.parentNode?.insertBefore(wrapper, pre);
          wrapper.appendChild(pre);
          const button = document.createElement("button");
          button.className = "copy-btn";
          button.type = "button";
          button.setAttribute("aria-label", "Copy code");
          button.innerHTML = COPY_ICON;
          wrapper.appendChild(button);
          button.addEventListener("click", () => {
            const text = pre.querySelector("code")?.innerText ?? pre.innerText;
            navigator.clipboard.writeText(text).then(() => {
              button.innerHTML = CHECK_ICON;
              button.classList.add("copied");
              setTimeout(() => {
                button.innerHTML = COPY_ICON;
                button.classList.remove("copied");
              }, 2000);
            });
          });
        });

      // Lightbox for article images.
      const lightbox = document.getElementById("blog-lb");
      const lightboxImage = document.getElementById(
        "blog-lb-img",
      ) as HTMLImageElement | null;
      if (lightbox && lightboxImage) {
        const close = () => {
          lightbox.classList.remove("is-open");
          document.body.style.overflow = "";
        };
        post.addEventListener("click", (event) => {
          const img = (event.target as Element).closest("img");
          if (!img) return;
          lightboxImage.src = img.src;
          lightboxImage.alt = img.getAttribute("alt") ?? "";
          lightbox.classList.add("is-open");
          document.body.style.overflow = "hidden";
        });
        document
          .getElementById("blog-lb-close")
          ?.addEventListener("click", close);
        lightbox.addEventListener("click", (event) => {
          if (event.target === lightbox) close();
        });
        document.addEventListener("keydown", (event) => {
          if (event.key === "Escape" && lightbox.classList.contains("is-open"))
            close();
        });
      }
    }

    document.querySelectorAll<HTMLImageElement>(".ib-cover").forEach((img) => {
      const fit = () => {
        if (img.naturalHeight > img.naturalWidth)
          img.style.objectFit = "contain";
      };
      if (img.complete) fit();
      else img.addEventListener("load", fit);
    });
  </script>
</IdentityLayout>
