---
import { ArrowUpRight, Menu, X } from "@lucide/astro";
import photoCredits from "../../public/preview/ai/media/photos-sources.json";
import heroFilm from "../../public/preview/ai/media/video-source.json";
import "../styles/identity-preview.css";
import "../styles/identity-site.css";
interface Props {
  title?: string;
  description?: string;
  active?: string;
  headerTone?: "light" | "overlay";
  /** Social image path; defaults to the Paris hero film poster. */
  image?: string;
  imageAlt?: string;
  type?: "website" | "article";
  /** Canonical path or absolute URL; defaults to the current path. */
  canonical?: string;
}
const {
  title = "Abstract Machines",
  description = "AI products, secure infrastructure, and connected systems. Engineering intelligence at Abstract Machines.",
  active = "",
  headerTone = "light",
  image = heroFilm.poster_path,
  imageAlt = heroFilm.poster_alt,
  type = "website",
  canonical,
} = Astro.props;
const navigation = [
  { label: "Our work", href: "/products/", key: "work" },
  { label: "Research", href: "/research/", key: "research" },
  { label: "Company", href: "/company/", key: "company" },
];
const pageTitle =
  title === "Abstract Machines"
    ? `${title} | Engineering intelligence`
    : `${title} | Abstract Machines`;
const canonicalUrl = new URL(
  canonical ?? Astro.url.pathname,
  Astro.site ?? "https://www.absmach.eu/",
);
const socialImage = new URL(image, canonicalUrl);
const organization = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "Abstract Machines",
  url: new URL("/", canonicalUrl).href,
  logo: new URL("/preview/ai/media/am-logo.png", canonicalUrl).href,
  sameAs: [
    "https://github.com/absmach",
    "https://www.linkedin.com/company/abstract-machines",
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" /><meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />
    <title>{pageTitle}</title><meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:site_name" content="Abstract Machines" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Abstract Machines Blog"
      href="/rss.xml"
    />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(organization)}
    />
    <link rel="icon" href="/favicon.ico" /><link
      rel="preload"
      href="/preview/ai/fonts/manrope.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    /><link
      rel="preload"
      href="/preview/ai/fonts/dm-sans.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <slot name="head" />
  </head>
  <body class:list={["identity-page", `identity-page--${headerTone}`]}>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <a class="brand" href="/" aria-label="Abstract Machines home"
        ><img
          src="/preview/ai/media/am-logo.png"
          width="639"
          height="77"
          alt="Abstract Machines"
        /><span class="brand-caption">Engineering intelligence.</span></a
      >
      <nav class="desktop-nav" aria-label="Main navigation">
        {
          navigation.map((item) => (
            <a
              href={item.href}
              aria-current={active === item.key ? "page" : undefined}
            >
              {item.label}
            </a>
          ))
        }
      </nav>
      <a class="header-contact" href="/contact/"
        >Let’s talk <ArrowUpRight size={17} /></a
      >
      <button
        class="menu-toggle"
        aria-label="Open navigation"
        aria-controls="mobile-nav"
        aria-expanded="false"
        ><Menu class="menu-open-icon" size={24} /><X
          class="menu-close-icon"
          size={24}
        /></button
      >
      <nav
        id="mobile-nav"
        class="mobile-nav"
        aria-label="Mobile navigation"
        hidden
      >
        {
          navigation.map((item) => (
            <a
              href={item.href}
              aria-current={active === item.key ? "page" : undefined}
            >
              {item.label}
              <ArrowUpRight size={20} />
            </a>
          ))
        }<a href="/contact/">Let’s talk <ArrowUpRight size={20} /></a>
      </nav>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <div class="footer-main">
        <a class="footer-wordmark" href="/"
          >Abstract Machines<span>Engineering intelligence.</span></a
        ><div class="footer-links">
          <a href="/products/">Our work</a><a href="/research/">Research</a><a
            href="/company/">Company</a
          ><a href="/services/">Services</a><a href="/careers/">Careers</a><a
            href="/contact/">Contact</a
          ><a href="/blog/">Blog</a><a
            href="https://www.absmach.eu/docs/magistrala/">Docs</a
          ><a href="https://github.com/absmach"
            >GitHub <ArrowUpRight size={14} /></a
          >
        </div>
      </div><div class="footer-bottom">
        <span>© {new Date().getFullYear()} Abstract Machines</span>
        <button id="credits-open">Photography & film</button>
        <a href="/privacy/">Privacy</a><a href="/terms/">Terms</a><a
          href="/imprint/">Imprint</a
        >
      </div>
    </footer>
    <dialog id="media-credits" aria-labelledby="credits-title">
      <div class="credits-top">
        <h2 id="credits-title">Photography & film</h2><button
          id="credits-close"
          aria-label="Close media credits"><X size={22} /></button
        >
      </div><p>
        Selected stock imagery illustrates our areas of work. It does not depict
        Abstract Machines’ team or offices.
      </p><ul class="credits-photo-list">
        {
          photoCredits.map((photo) => (
            <li>
              <>
                <>
                  <span>{photo.usage_label}</span>
                  <a href={photo.source_url}>
                    {photo.photographer} / {photo.provider ?? "Unsplash"}
                  </a>
                </>
              </>
            </li>
          ))
        }
        <li>
          <span>Paris architecture film</span><a href={heroFilm.source_url}
            >{heroFilm.title} / {heroFilm.creator} / {heroFilm.provider}</a
          >
        </li>
      </ul><p>
        Photography under the <a href="https://unsplash.com/license"
          >Unsplash License</a
        > and <a href="https://www.pexels.com/license/">Pexels License</a>. Film
        under the <a href={heroFilm.license_url}>{heroFilm.license_name}</a>.
      </p>
    </dialog>

    <script>
      document
        .querySelectorAll<HTMLAnchorElement>("a[href]")
        .forEach((link) => {
          const url = new URL(link.href, window.location.href);
          if (
            (url.protocol === "https:" || url.protocol === "http:") &&
            url.origin !== window.location.origin
          ) {
            link.target = "_blank";
            link.relList.add("noopener", "noreferrer");
          }
        });

      const toggle = document.querySelector<HTMLButtonElement>(".menu-toggle");
      const nav = document.querySelector<HTMLElement>("#mobile-nav");
      const setMenu = (open: boolean) => {
        toggle?.setAttribute("aria-expanded", String(open));
        toggle?.setAttribute(
          "aria-label",
          open ? "Close navigation" : "Open navigation",
        );
        if (nav) nav.hidden = !open;
      };
      toggle?.addEventListener("click", () =>
        setMenu(toggle.getAttribute("aria-expanded") !== "true"),
      );
      nav
        ?.querySelectorAll("a")
        .forEach((link) =>
          link.addEventListener("click", () => setMenu(false)),
        );
      document.addEventListener("keydown", (event) => {
        if (
          event.key === "Escape" &&
          toggle?.getAttribute("aria-expanded") === "true"
        ) {
          setMenu(false);
          toggle.focus();
        }
      });
      window
        .matchMedia("(min-width: 801px)")
        .addEventListener("change", (event) => {
          if (event.matches) setMenu(false);
        });
      const credits =
        document.querySelector<HTMLDialogElement>("#media-credits");
      document
        .querySelector("#credits-open")
        ?.addEventListener("click", () => credits?.showModal());
      document
        .querySelector("#credits-close")
        ?.addEventListener("click", () => credits?.close());
      credits?.addEventListener("click", (event) => {
        if (event.target === credits) {
          const bounds = credits.getBoundingClientRect();
          if (
            event.clientX < bounds.left ||
            event.clientX > bounds.right ||
            event.clientY < bounds.top ||
            event.clientY > bounds.bottom
          )
            credits.close();
        }
      });
    </script>
  </body>
</html>
