---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import ProductsPreview from "../../components/ProductsPreview.astro";
---

<BaseLayout
  title="Products — Abstract Machines"
  description="The full Abstract Machines IoT stack: platform, message broker, Wasm orchestrator, and edge hardware. Open source and production-ready."
>
  <Header />
  <main>

    <section class="page-hero">
      <div class="container-wide">
        <span class="kicker">Products</span>
        <h1 class="h-1" style="margin-top:14px; max-width:18ch;">Purpose-built for the IoT stack.</h1>
        <p class="lede" style="margin-top:20px; max-width:52ch;">From edge hardware to cloud platform: every layer of secure, event-driven connectivity, open source.</p>
      </div>
    </section>

    <ProductsPreview />

    <section class="section">
      <div class="container-wide">
        <div class="products-split">
          <div>
            <span class="kicker" style="display:block; margin-bottom:14px;">Software</span>
            <h2 class="h-3">Three layers of the stack.</h2>
            <p style="color:var(--ink-2); margin-top:16px; font-size:15px; line-height:1.65;">
              Magistrala is the IoT platform (device identity, multi-protocol messaging, RBAC). FluxMQ is the high-performance
              broker powering its data plane. Propeller extends the stack to the edge with WebAssembly orchestration
              across cloud and microcontrollers.
            </p>
            <div class="btn-row" style="margin-top:28px;">
              <a href="/products/magistrala" class="btn btn-primary">Magistrala</a>
              <a href="/products/fluxmq" class="btn">FluxMQ</a>
              <a href="/products/propeller" class="btn">Propeller</a>
            </div>
          </div>
          <div>
            <span class="kicker" style="display:block; margin-bottom:14px;">Hardware</span>
            <h2 class="h-3">Gateways built for the edge.</h2>
            <p style="color:var(--ink-2); margin-top:16px; font-size:15px; line-height:1.65;">
              S0 and S1 are gateways designed to run Magistrala and Propeller workloads at the edge. S0 targets
              constrained deployments with Zephyr RTOS; S1 brings full Linux to industrial environments.
            </p>
            <div class="btn-row" style="margin-top:28px;">
              <a href="/products/s0" class="btn btn-primary">S0 Gateway</a>
              <a href="/products/s1" class="btn">S1 Gateway</a>
            </div>
          </div>
        </div>
      </div>
    </section>

  </main>
  <Footer />
</BaseLayout>
