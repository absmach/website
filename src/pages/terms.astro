---
import LegalPage from "../components/identity/LegalPage.astro";

const sections = [
  { id: "definitions", label: "Definitions" },
  { id: "eligibility", label: "Eligibility and account registration" },
  { id: "license", label: "License and restrictions" },
  { id: "payment", label: "Orders, payment, and billing" },
  { id: "availability", label: "Service availability and support" },
  { id: "data", label: "Data and content" },
  { id: "acceptable-use", label: "Acceptable use policy" },
  { id: "delivery", label: "Delivery and performance" },
  { id: "termination", label: "Term and termination" },
  { id: "intellectual-property", label: "Intellectual property" },
  { id: "warranties", label: "Warranties and disclaimers" },
  { id: "liability", label: "Limitation of liability" },
  { id: "indemnification", label: "Indemnification" },
  { id: "changes", label: "Changes to terms" },
  { id: "governing-law", label: "Governing law and disputes" },
  { id: "general", label: "General provisions" },
  { id: "contact", label: "Contact information" },
];
