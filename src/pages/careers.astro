---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import FinalCTA from "../components/FinalCTA.astro";

const benefits = [
  {
    ic: "◈",
    title: "Remote-First",
    desc: "Work from anywhere in Europe with flexible hours. We care about outcomes, not office time.",
  },
  {
    ic: "⊞",
    title: "Open Source",
    desc: "Contribute to projects used by thousands of developers worldwide. Your work ships publicly.",
  },
  {
    ic: "◉",
    title: "Research",
    desc: "Work on cutting-edge EU Horizon Europe projects in confidential computing and 6G networks.",
  },
  {
    ic: "▲",
    title: "Growth",
    desc: "Continuous learning, conference attendance, and the space to explore new technologies.",
  },
  {
    ic: "◆",
    title: "Impact",
    desc: "Build infrastructure running at Nokia, Intel, and Ericsson scale. What you ship matters.",
  },
  {
    ic: "⬡",
    title: "Competitive",
    desc: "Market-rate compensation and equity. We reward the people who make the work excellent.",
  },
];

const process = [
  {
    step: "01",
    title: "Apply",
    desc: "Send us your CV and a short note about what interests you. No cover letter required.",
  },
  {
    step: "02",
    title: "Screen",
    desc: "A 30-minute intro call with someone from the team to discuss your background and interests.",
  },
  {
    step: "03",
    title: "Interview",
    desc: "Technical and values assessment, relevant to the role, no whiteboard puzzles.",
  },
  {
    step: "04",
    title: "Offer",
    desc: "We move quickly. If it's a fit, you'll have an offer within a few days of the final round.",
  },
];
---

<BaseLayout
  title="Careers — Abstract Machines"
  description="Join Abstract Machines and help build open-source infrastructure for IoT and edge computing. Remote-first, research-driven, based in Paris."
>
  <Header />
  <main>

    <!-- Hero -->
    <section class="section-tight" style="background:var(--paper-2); border-bottom:1px solid var(--line-3); text-align:center;">
      <div class="container-wide">
        <span class="kicker">Careers</span>
        <h1 class="h-1" style="margin-top:8px;">Build the future with us.</h1>
        <p class="lede" style="margin-top:16px; max-width:560px; margin-left:auto; margin-right:auto;">
          Join a small, expert team pushing the boundaries of distributed systems,
          IoT, and edge computing, openly, from wherever you are.
        </p>
        <div class="btn-row" style="margin-top:28px; justify-content:center;">
          <a href="/contact/" class="btn btn-primary">Get in touch</a>
          <a href="https://github.com/absmach" target="_blank" rel="noopener noreferrer" class="btn">View our work ↗</a>
        </div>
      </div>
    </section>

    <!-- Benefits -->
    <section>
      <div class="container-wide">
        <div class="section-head">
          <div class="left">
            <span class="kicker">Why join us</span>
            <h2 class="h-2" style="margin-top:10px;">What makes us different</h2>
            <p class="lede" style="margin-top:10px;">Six reasons people choose to work at Abstract Machines.</p>
          </div>
        </div>
        <div class="ben-grid" style="margin-top:36px;">
          {benefits.map((b) => (
            <div class="card">
              <div class="ben-icon">{b.ic}</div>
              <h3 class="h-3" style="margin-top:16px;">{b.title}</h3>
              <p style="margin-top:8px; font-size:14px; color:var(--ink-2); line-height:1.65;">{b.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Hiring status callout -->
    <section class="section-tight" style="background:var(--paper-2); border-top:1px solid var(--line-3); border-bottom:1px solid var(--line-3);">
      <div class="container-narrow">
        <div class="hiring-callout">
          <div class="hiring-status">
            <span class="hiring-dot"></span>
            <span class="hiring-label">Hiring status</span>
          </div>
          <h2 class="h-2" style="margin-top:14px;">No open roles right now</h2>
          <p style="margin-top:12px; font-size:15px; color:var(--ink-2); line-height:1.65; max-width:520px;">
            We don't have active listings, but we're always interested in hearing from
            strong engineers, researchers, and solutions architects. Send us a note;
            if there's a fit, we'll make room.
          </p>
          <div class="btn-row" style="margin-top:24px;">
            <a href="/contact/" class="btn btn-primary">Send a note</a>
            <a href="mailto:info@absmach.eu" class="btn">info@absmach.eu</a>
          </div>
        </div>
      </div>
    </section>

    <!-- Process -->
    <section>
      <div class="container-wide">
        <div class="section-head">
          <div class="left">
            <span class="kicker">Process</span>
            <h2 class="h-2" style="margin-top:10px;">What to expect</h2>
            <p class="lede" style="margin-top:10px;">A straightforward, respectful hiring process. No surprises.</p>
          </div>
        </div>
        <div class="process-grid" style="margin-top:36px;">
          {process.map((p) => (
            <div class="card">
              <span class="step-num">{p.step}</span>
              <h3 class="h-3" style="margin-top:12px;">{p.title}</h3>
              <p style="margin-top:8px; font-size:13px; color:var(--ink-2); line-height:1.65;">{p.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <FinalCTA
      title="Don't see a fit?"
      subtitle="We're always interested in hearing from talented people. Send us your details and let's talk."
      primary={{ label: "Get in touch", href: "/contact/" }}
      secondary={null}
    />

  </main>
  <Footer />
</BaseLayout>

<style>
  /* ── Benefits ───────────────────────────────────────────────── */
  .ben-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }
  .ben-icon {
    width: 40px;
    height: 40px;
    border-radius: var(--radius-sm);
    background: color-mix(in srgb, var(--accent) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--accent) 20%, transparent);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 16px;
    color: var(--accent);
  }

  /* ── Hiring status ──────────────────────────────────────────── */
  .hiring-callout {
    background: var(--paper);
    border: 1px solid var(--line-3);
    border-radius: var(--radius);
    padding: 36px 40px;
  }
  .hiring-status {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: color-mix(in srgb, var(--ink-3) 8%, transparent);
    border: 1px solid var(--line-3);
    border-radius: 999px;
    padding: 5px 12px;
  }
  .hiring-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--ink-3);
    flex-shrink: 0;
  }
  .hiring-label {
    font-family: "JetBrains Mono", monospace;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--ink-3);
  }

  /* ── Process ────────────────────────────────────────────────── */
  .process-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }
  .step-num {
    font-family: "JetBrains Mono", monospace;
    font-size: 11px;
    font-weight: 700;
    color: var(--ink-4);
    letter-spacing: 0.1em;
  }

  /* ── Responsive ─────────────────────────────────────────────── */
  @media (max-width: 980px) {
    .ben-grid { grid-template-columns: repeat(2, 1fr); }
    .process-grid { grid-template-columns: repeat(2, 1fr); }
    .hiring-callout { padding: 28px 24px; }
  }
  @media (max-width: 600px) {
    .ben-grid { grid-template-columns: 1fr; }
    .process-grid { grid-template-columns: 1fr; }
  }
</style>
