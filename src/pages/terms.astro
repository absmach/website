---
import LegalPage from "../components/identity/LegalPage.astro";

const sections = [
  { id: "scope", label: "Scope" },
  { id: "use", label: "Use and content" },
  { id: "responsibility", label: "Responsibility" },
  { id: "changes", label: "Changes and disputes" },
];
---

<LegalPage
  title="Website Terms"
  description="Terms for using the Abstract Machines company website."
  sections={sections}
  meta={[{ label: "Updated", value: "3 November 2026" }]}
>
  <Fragment slot="lead">
    <p>
      These terms concern the Abstract Machines company website. Our identity
      and contact details appear in the <a href="/imprint/">legal notice</a>.
    </p>
  </Fragment>
  <section id="scope">
    <h2>Scope</h2>
    <p>
      Browsing this website or sending an enquiry does not purchase a service.
      Product purchases, subscriptions and professional services are governed by
      the offer and terms accepted for that service. <a
        href="https://atomicapp.dev/legal/"
        >Atomic has its own legal documents</a
      >. Existing customer agreements are not amended by this page.
    </p>
  </section>
  <section id="use">
    <h2>Use and content</h2>
    <p>
      Do not use the site unlawfully, infringe others’ rights, disrupt its
      operation or attempt unauthorized access. Website content remains subject
      to its applicable intellectual-property rights. Open-source licences,
      credited third-party licences and exceptions permitted by law remain
      applicable.
    </p>
    <p>
      Personal information is handled as described in our <a href="/privacy/"
        >privacy notice</a
      >.
    </p>
  </section>
  <section id="responsibility">
    <h2>Responsibility</h2>
    <p>
      Website descriptions do not create a service-level guarantee or a
      commercial warranty. Availability, support, delivery, payment and
      cancellation conditions belong to the applicable accepted offer. Each
      party remains responsible under applicable law; mandatory consumer
      guarantees and other statutory rights are preserved.
    </p>
  </section>
  <section id="changes">
    <h2>Changes and disputes</h2>
    <p>
      We may update these website terms and their revision date. Publication
      does not amend an existing service contract or replace any legally
      required notice or consent.
    </p>
    <p>
      French law applies, without depriving consumers of mandatory protection in
      their country of habitual residence. Jurisdiction follows applicable law.
      For enquiries or complaints, write to <a href="mailto:info@absmach.eu"
        >info@absmach.eu</a
      > or our registered office.
    </p>
  </section>
</LegalPage>
