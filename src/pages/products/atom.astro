  <script is:inline>
    (() => {
      const tabs = document.querySelectorAll("#pui-tabs .pui-tab");
      const panels = document.querySelectorAll(".pui-img-wrap");

      tabs.forEach((tab) => {
        tab.querySelector(".pui-tab-btn").addEventListener("click", () => {
          const target = tab.dataset.target;
          tabs.forEach((t) => t.classList.remove("active"));
          panels.forEach((p) => p.classList.remove("active"));
          tab.classList.add("active");
          document
            .querySelector(`.pui-img-wrap[data-panel="${target}"]`)
            ?.classList.add("active");
        });
      });
    })();
  </script>
