---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import FAQAccordion from "./FAQAccordion.astro";
import {
  ArrowRight,
  Check,
  CircuitBoard,
  CircleAlert,
  GitBranch,
  LockKeyhole,
  Search,
  ShieldCheck,
  SquareCode,
  Sparkles,
} from "@lucide/astro";

const edition = "Community + Enterprise";
const faqs = [
  { q: "What is Synth?", a: "Synth is an open-source AI-assisted PCB design workspace. It helps turn requirements into schematics, component choices, placement, routing suggestions, and reviewable KiCad-ready work—while keeping the engineer in control of the design." },
  { q: "What is the difference between Synth Community and Synth EE?", a: "They are two editions of the same Synth product, and both can connect to LLMs. Community is the open-source starting point for individuals and teams. Synth EE is the managed SaaS edition, adding a custom agent harness, MCP tools, access to world-model and EBM capabilities, MCTS-style simulation tools, organisation-wide governance, and support for teams shipping sensitive hardware." },
  { q: "Can Synth work with existing EDA tools?", a: "Yes. Synth is designed around open, inspectable project artifacts and can fit alongside KiCad and other ECAD tools. The goal is to accelerate design work without hiding the source files engineers need to verify and ship." },
  { q: "What does Synth EE include?", a: "Synth EE is delivered as SaaS. It includes the Synth workflow and LLM access, plus a custom agent harness, MCP tools, world-model and EBM access, and MCTS-style simulation capabilities for more advanced PCB design tasks." },
];

const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map(({ q, a }) => ({
    "@type": "Question",
    name: q,
    acceptedAnswer: { "@type": "Answer", text: a },
  })),
});

const features = [
  { icon: CircuitBoard, title: "Design from intent", desc: "Start with a board brief or an existing KiCad project. Synth keeps requirements, interfaces, constraints, and design decisions connected to the board." },
  { icon: Search, title: "Parts with context", desc: "Compare component options against availability, electrical requirements, package constraints, and the role each part plays in the circuit." },
  { icon: GitBranch, title: "Placement and routing you can review", desc: "Generate candidates, inspect the affected nets, and see what changed. The result is a design conversation—not a black-box export." },
  { icon: Sparkles, title: "Model-flexible and open", desc: "Use the right model for the task. Synth keeps project artifacts inspectable and the workflow portable across providers and deployments." },
];

const comparison = [
  ["Primary workflow", "Requirements → schematic → board", "Agent operates EDA tools", "AI schematic + routing workspace", "Automated placement + routing"],
  ["KiCad fit", "Open project artifacts + guided flow", "Shown operating KiCad", "KiCad supported in cloud flow", "KiCad import / export"],
  ["Routing approach", "Constraint-aware candidates + review", "Prompt-led computer use", "AI auto-layout + DRC", "Physics-driven optimization"],
  ["Design traceability", "Requirements, nets, parts, changes", "Session and tool trace", "Workspace history", "Candidate layouts + checks"],
  ["Deployment model", "Open source / private / self-hosted", "Provider-controlled model", "Cloud platform", "Cloud service"],
  ["Best fit", "Repeatable, inspectable engineering work", "Fast visual prototyping", "Integrated cloud EDA", "Offloading layout work"],
];

const heroLabel = "Synth · AI-assisted PCB design";
const heroTitle = "From circuit intent to a board you can review.";
const heroDesc = "Turn requirements into schematics, component choices, placement, and routing suggestions—then inspect every decision in the tools engineers already use. Both editions connect to LLMs; Synth EE adds a deeper agent and simulation toolchain.";
---

<BaseLayout
  title="Synth — AI-Assisted PCB Design | Abstract Machines"
  description={heroDesc}
  ogImageAlt={`Synth ${edition}`}
>
  <Header />
  <main class="synth-page">
    <section class="synth-hero">
      <div class="container-wide synth-hero-grid">
        <div class="synth-hero-copy">
          <div class="synth-wordmark"><span class="synth-mark">S</span><span>SYNTH</span><span class="synth-edition">{edition}</span></div>
          <p class="kicker">{heroLabel}</p>
          <h1>{heroTitle}</h1>
          <p class="lede">{heroDesc}</p>
          <div class="btn-row" style="margin-top:32px;">
            <a href="https://github.com/absmach/synth" class="btn btn-primary" target="_blank" rel="noopener">Explore Synth on GitHub <ArrowRight size={16} /></a>
            <a href="#editions" class="btn">Compare editions</a>
          </div>
          <div class="synth-hero-notes"><span><Check size={14} /> Constraint-aware</span><span><Check size={14} /> Open source</span><span><Check size={14} /> Agent-ready</span></div>
        </div>
        <div class="document-stage" aria-label="Synth AI-assisted PCB design workspace preview">
          <div class="stage-topbar"><span class="window-dots"><i></i><i></i><i></i></span><span class="stage-path">project / sensor-node</span><span class="stage-status">LIVE DESIGN</span></div>
          <div class="stage-body">
            <aside class="stage-sidebar"><div class="sidebar-label">PROJECT</div><div class="side-item active"><CircuitBoard size={14} /> Board overview</div><div class="side-item"><SquareCode size={14} /> Schematic</div><div class="side-item"><GitBranch size={14} /> Layout</div><div class="sidebar-label source-label">DESIGN INPUTS · 08</div><div class="source-item"><span class="source-dot blue"></span>Board brief.md</div><div class="source-item"><span class="source-dot orange"></span>Power constraints</div><div class="source-item"><span class="source-dot green"></span>Approved parts</div></aside>
            <div class="document-canvas pcb-canvas"><div class="canvas-meta"><span>PCB layout candidate · v04</span><span>KiCad project · 4 layers</span></div><div class="pcb-board"><div class="board-chip chip-one">U1<br /><small>MCU</small></div><div class="board-chip chip-two">U2<br /><small>REG</small></div><div class="board-chip chip-three">J1<br /><small>USB-C</small></div><div class="board-part part-one">C1</div><div class="board-part part-two">R3</div><div class="board-part part-three">C4</div><svg viewBox="0 0 500 260" aria-hidden="true"><path class="trace trace-blue" d="M122 82 H210 V42 H350 V92 H418" /><path class="trace trace-orange" d="M122 110 H176 V188 H300 V154 H418" /><path class="trace trace-green" d="M242 82 V122 H300 V188 H418" /><path class="trace trace-violet" d="M242 154 H270 V220 H418" /><circle cx="122" cy="82" r="4" /><circle cx="418" cy="92" r="4" /><circle cx="122" cy="110" r="4" /><circle cx="418" cy="154" r="4" /></svg><div class="board-label label-top">USB differential pair</div><div class="board-label label-bottom">power path · reviewed</div></div><div class="doc-callout"><span class="callout-icon"><Sparkles size={15} /></span><div><strong>Routing candidate ready</strong><p>18 nets complete · 0 unrouted · 2 constraints to review</p></div><span class="confidence">DRC 98%</span></div><div class="doc-row"><div class="mini-source"><span class="source-dot blue"></span><div><b>Constraint trace</b><small>USB-C → U1 · 4 nets</small></div></div><div class="mini-source"><ShieldCheck size={15} /><div><b>Engineer review</b><small>2 decisions pending</small></div></div></div></div>
          </div>
          <div class="stage-footer"><span><span class="pulse-dot"></span> Synth is checking 18 nets and 6 constraints</span><span>⌘ ↵ Generate candidate</span></div>
        </div>
      </div>
      <div class="hero-grid-lines" aria-hidden="true"></div>
    </section>

    <section class="synth-intro section-tight"><div class="container-narrow intro-lockup"><span class="kicker">The missing layer</span><h2>Models can draw. Synth helps you <em>ship the board.</em></h2><p class="lede">A screenshot of traces is not a finished design. Real PCB work needs constraints, net integrity, part choices, reviewable files, and a clear path from requirement to manufacturing output.</p></div></section>

    <section class="synth-features"><div class="container-wide"><div class="section-head"><div class="left"><span class="kicker">One workspace, fewer dead ends</span><h2 class="h-2">From circuit intent to a board you can defend.</h2></div><p class="lede">Synth gives the work a shape—without forcing engineering decisions into a chat transcript.</p></div><div class="synth-feature-grid">{features.map(({ icon: Icon, title, desc }, index) => <article class="synth-feature card"><div class="feature-number">0{index + 1}</div><Icon size={22} stroke-width={1.6} /><h3>{title}</h3><p>{desc}</p></article>)}</div></div></section>

    <section class="synth-editions" id="editions"><div class="container-wide"><div class="section-head"><div class="left"><span class="kicker">One product, two editions</span><h2 class="h-2">Start open. Scale with an agent harness.</h2></div><p class="lede">Both editions can use LLMs. Synth EE adds the tools and managed infrastructure for deeper, more autonomous design exploration.</p></div><div class="edition-grid"><article class="edition-card"><div class="edition-card-top"><span class="synth-mark">S</span><span class="edition-badge">Community Edition</span></div><h3>Open design intelligence for every engineer.</h3><p>Explore requirements, schematics, parts, placement, and routing with an open foundation you can extend and run yourself.</p><ul><li><Check size={15} /> Open-source foundation</li><li><Check size={15} /> LLM access</li><li><Check size={15} /> KiCad-friendly project flow</li><li><Check size={15} /> Model-flexible architecture</li></ul><a href="https://github.com/absmach/synth" class="btn" target="_blank" rel="noopener">View the GitHub repository <ArrowRight size={15} /></a></article><article class="edition-card edition-card-enterprise"><div class="edition-card-top"><span class="synth-mark">S</span><span class="edition-badge">Enterprise Edition</span></div><h3>Managed SaaS with a custom agent harness.</h3><p>Bring repeatable, governed AI-assisted PCB design to your engineering organisation with a deeper toolchain for exploring and validating design choices.</p><ul><li><Check size={15} /> Everything in Community</li><li><Check size={15} /> Custom agent harness + MCP tools</li><li><Check size={15} /> World-model / EBM access</li><li><Check size={15} /> MCTS-style simulation tools</li><li><Check size={15} /> Managed SaaS operations and support</li></ul><a href="/contact" class="btn btn-primary">Talk to our team <ArrowRight size={15} /></a></article></div></div></section>

    <section class="synth-workflow"><div class="container-wide workflow-grid"><div><span class="kicker">A calmer way to work</span><h2 class="h-2">The board is the interface.</h2><p class="lede">Synth turns the messy middle of PCB design into a visible, reviewable flow.</p><div class="workflow-steps"><div><span>01</span><b>Specify</b><p>Bring in requirements, interfaces, constraints, and target parts.</p></div><div><span>02</span><b>Design</b><p>Explore schematic, placement, and routing candidates in context.</p></div><div><span>03</span><b>Verify</b><p>Review nets, design rules, diffs, and manufacturing readiness.</p></div></div></div><div class="source-map"><div class="map-center"><span class="synth-mark">S</span><b>Board candidate</b><small>18 nets · 6 constraints</small></div><div class="map-node node-a"><span class="source-dot blue"></span><b>Requirements</b><small>USB · power · size</small></div><div class="map-node node-b"><span class="source-dot orange"></span><b>Part decisions</b><small>MCU · regulator · passives</small></div><div class="map-node node-c"><span class="source-dot green"></span><b>Design checks</b><small>DRC · ERC · review</small></div><svg class="map-lines" viewBox="0 0 500 440" aria-hidden="true"><path d="M250 210 L95 96 M250 210 L405 96 M250 235 L250 365" /></svg></div></div></section>

    <section class="synth-compare"><div class="container-wide"><div class="section-head"><div class="left"><span class="kicker">AI-assisted PCB design</span><h2 class="h-2">Where Synth fits in the new EDA stack.</h2></div><p class="lede">Astra proves that an AI agent can operate KiCad. Flux and Quilter automate important parts of the EDA workflow. Synth is built around the engineering loop that connects intent, constraints, design files, and review.</p></div><div class="compare-shell"><div class="compare-header"><span>Capability</span><span class="synth-column">Synth</span><span>GPT-6 Astra</span><span>Flux</span><span>Quilter</span></div>{comparison.map(([label, synth, astra, flux, quilter]) => <div class="compare-row"><b>{label}</b><span class="synth-column"><Check size={15} />{synth}</span><span class="astra-column"><CircleAlert size={15} />{astra}</span><span><CircleAlert size={15} />{flux}</span><span><CircleAlert size={15} />{quilter}</span></div>)}</div><p class="compare-note"><LockKeyhole size={15} /> The point is not to replace the engineer with a prompt. Synth makes AI-assisted design inspectable enough to earn an engineer’s trust.</p></div></section>

    <section class="synth-cta"><div class="container-wide cta-panel"><div><span class="kicker">Start with the board you already have</span><h2 class="h-2">Give your engineering team a better copilot.</h2><p>Build with the open Synth Community Edition and connect it to LLMs—or talk to us about Synth EE’s managed agent, MCP, world-model, EBM, and MCTS toolchain.</p></div><div class="btn-row"><a href="https://github.com/absmach/synth" class="btn btn-primary" target="_blank" rel="noopener">Start with Synth <ArrowRight size={16} /></a></div></div></section>

    <section class="section synth-faq"><div class="container-narrow"><div class="section-head" style="display:block; margin-bottom:40px;"><span class="kicker">Questions</span><h2 class="h-2" style="margin-top:14px;">A clear place to start.</h2></div><FAQAccordion items={faqs} /></div></section>
    <script type="application/ld+json" set:html={faqSchema}></script>
  </main>
  <Footer />
</BaseLayout>

<style>
  .synth-page { --synth-violet:#6d45e8; --synth-violet-soft:#eeeaff; --synth-ink:#1c1640; background:var(--paper); color:var(--synth-ink); }
  .synth-page .kicker { color:var(--synth-violet); }
  .synth-hero { min-height:calc(100vh - 70px); padding:90px 0 86px; position:relative; overflow:hidden; background:linear-gradient(130deg,#f7f5ff 0%,#fff 52%,#fbf8ff 100%); border-bottom:1px solid #e7e0fa; }
  .synth-hero-grid { display:grid; grid-template-columns:minmax(0,.86fr) minmax(500px,1.14fr); gap:clamp(36px,6vw,88px); align-items:center; position:relative; z-index:1; }
  .synth-wordmark { display:flex; align-items:center; gap:10px; color:var(--synth-ink); font:600 14px var(--font-mono); letter-spacing:.16em; margin-bottom:24px; }
  .synth-mark { width:32px; height:32px; display:inline-flex; align-items:center; justify-content:center; border-radius:10px; color:#fff; background:linear-gradient(145deg,#9f7aff,#5530c8); box-shadow:0 8px 20px #8662ed55; font:600 17px var(--font-sans); letter-spacing:0; }
  .synth-edition { color:var(--synth-violet); font-size:10px; letter-spacing:.1em; border:1px solid #cfc3f2; border-radius:99px; padding:6px 9px; margin-left:4px; }
  .synth-hero-copy h1 { max-width:680px; margin-top:14px; font-size:clamp(48px,5.3vw,78px); line-height:1.01; letter-spacing:-.05em; color:var(--synth-ink); }
  .synth-hero-copy .lede { margin-top:24px; max-width:560px; color:#514b6f; }
  .synth-hero-copy .btn-primary { background:var(--synth-violet); border-color:var(--synth-violet); }
  .synth-hero-notes { display:flex; gap:18px; flex-wrap:wrap; margin-top:28px; color:#6b6486; font:11px var(--font-mono); }
  .synth-hero-notes span { display:flex; align-items:center; gap:5px; }
  .synth-hero-notes svg { color:#35a273; }
  .document-stage { min-height:510px; background:#1c1732; color:#fff; border:1px solid #4d3d78; border-radius:16px; box-shadow:0 28px 70px #4f3c9c2b, 0 3px 8px #31225e33; overflow:hidden; transform:perspective(1200px) rotateY(-4deg) rotateX(2deg); }
  .stage-topbar,.stage-footer { display:flex; align-items:center; gap:14px; height:42px; padding:0 16px; color:#aaa2c8; font:10px var(--font-mono); letter-spacing:.04em; border-bottom:1px solid #3a3053; }
  .stage-topbar .stage-path { flex:1; }.stage-status { color:#a992f5; font-size:9px; }.window-dots { display:flex; gap:5px; }.window-dots i { width:7px; height:7px; border-radius:50%; background:#5b4c7d; }.window-dots i:first-child { background:#ee8b8b; }.window-dots i:nth-child(2) { background:#e5bf75; }.window-dots i:last-child { background:#74c69b; }
  .stage-body { display:grid; grid-template-columns:172px 1fr; min-height:424px; }.stage-sidebar { padding:23px 13px; background:#211b3b; border-right:1px solid #3a3053; font-size:10px; color:#aaa2c8; }.sidebar-label { padding:0 8px 10px; color:#72698e; font:9px var(--font-mono); letter-spacing:.14em; }.source-label { margin-top:30px; }.side-item { display:flex; align-items:center; gap:7px; padding:9px 8px; border-radius:5px; margin-bottom:2px; }.side-item.active { color:#fff; background:#493776; }.source-item { display:flex; align-items:center; gap:7px; padding:8px; font-size:9px; }.source-dot { width:7px; height:7px; border-radius:50%; flex:none; display:inline-block; }.source-dot.blue { background:#60a7ff; }.source-dot.orange { background:#f19b69; }.source-dot.green { background:#66c993; }
  .document-canvas { padding:28px 35px; background:#fff; color:#29223d; }.canvas-meta { display:flex; justify-content:space-between; color:#978fa9; font:9px var(--font-mono); text-transform:uppercase; letter-spacing:.08em; }.document-canvas h3 { font-size:28px; margin:28px 0 5px; letter-spacing:-.03em; }.canvas-subtitle { color:#80778f; font-size:12px; margin:0 0 22px; }.document-canvas > p:not(.canvas-subtitle) { font-size:12px; line-height:1.8; color:#5a5368; }.document-canvas mark { background:#e9defe; color:#4f31a5; padding:2px 4px; }.document-canvas sup { color:#6744d4; font-weight:700; }.doc-callout { display:flex; gap:10px; align-items:flex-start; padding:13px; margin-bottom:20px; border:1px solid #ded3fa; border-left:3px solid #7650df; border-radius:5px; background:#faf8ff; }.callout-icon { color:#7650df; }.doc-callout strong { font-size:11px; }.doc-callout p { margin:4px 0 0; font-size:11px; line-height:1.5; color:#655d75; }.confidence { margin-left:auto; color:#43a479; font:600 12px var(--font-mono); }.doc-row { display:flex; gap:8px; margin-top:24px; }.mini-source { flex:1; display:flex; align-items:center; gap:8px; padding:10px; background:#faf9fc; border:1px solid #e9e5ee; border-radius:5px; color:#6d6780; }.mini-source svg { color:#43a479; }.mini-source b,.mini-source small { display:block; font-size:9px; }.mini-source small { margin-top:3px; color:#aaa3b2; }.stage-footer { justify-content:space-between; border-top:1px solid #3a3053; border-bottom:0; }.pulse-dot { display:inline-block; width:6px; height:6px; border-radius:50%; background:#70d29c; box-shadow:0 0 0 4px #70d29c22; margin-right:6px; }
  .pcb-canvas { padding:22px 28px 20px; background:#f8f7fb; }.pcb-board { height:230px; margin:20px 0 18px; position:relative; overflow:hidden; border:1px solid #9c91b0; border-radius:8px; background:radial-gradient(circle at 20% 20%,#294f4c 0,#173b39 38%,#10312f 100%); box-shadow:inset 0 0 0 7px #143532, inset 0 0 0 8px #2e655b; }.pcb-board::before { content:""; position:absolute; inset:14px; border:1px dashed #71b29d66; border-radius:3px; }.pcb-board svg { position:absolute; inset:0; width:100%; height:100%; }.trace { fill:none; stroke-width:3; stroke-linecap:round; stroke-linejoin:round; }.trace-blue { stroke:#73c7ff; }.trace-orange { stroke:#f3a26b; }.trace-green { stroke:#66d0a1; }.trace-violet { stroke:#bd9dff; }.pcb-board circle { fill:#dbe9d9; stroke:#183d3b; stroke-width:2; }.board-chip,.board-part { position:absolute; z-index:2; display:flex; align-items:center; justify-content:center; text-align:center; color:#d3e9df; background:#283a56; border:1px solid #91b4c4; border-radius:4px; font:600 9px var(--font-mono); box-shadow:0 3px 8px #09221f99; }.board-chip small { color:#91b4c4; font-size:7px; }.chip-one { width:52px; height:65px; top:50px; left:82px; }.chip-two { width:48px; height:55px; top:126px; left:205px; background:#50374c; border-color:#d19cae; }.chip-three { width:54px; height:42px; top:44px; right:54px; background:#3b4d37; border-color:#a6d28c; }.board-part { width:24px; height:14px; color:#d6cda7; background:#685b3a; border-color:#e3d38f; font-size:7px; }.part-one { top:132px; left:142px; }.part-two { top:70px; left:270px; }.part-three { top:174px; right:96px; }.board-label { position:absolute; z-index:3; padding:4px 6px; border-radius:3px; background:#111e1dde; color:#a6d8ca; font:8px var(--font-mono); }.label-top { top:12px; left:12px; }.label-bottom { right:12px; bottom:12px; }
  .hero-grid-lines { position:absolute; inset:0; opacity:.32; background-image:linear-gradient(#d9cff5 1px,transparent 1px),linear-gradient(90deg,#d9cff5 1px,transparent 1px); background-size:70px 70px; mask-image:linear-gradient(90deg,transparent,black 72%); }
  .synth-intro { background:#fff; }.intro-lockup { text-align:center; }.intro-lockup h2 { margin:14px auto 22px; max-width:750px; font-size:clamp(34px,4vw,54px); letter-spacing:-.04em; }.intro-lockup em { color:var(--synth-violet); font-style:normal; }.intro-lockup .lede { margin:auto; }
  .synth-features { padding:96px 0; background:#faf9ff; border-top:1px solid #eeeafa; border-bottom:1px solid #eeeafa; }.synth-feature-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:14px; }.synth-feature { min-height:270px; padding:25px; background:#fff; border-color:#e8e3f5; }.synth-feature svg { color:var(--synth-violet); margin:22px 0 28px; }.synth-feature h3 { font-size:18px; }.synth-feature p { margin-top:12px; color:#665f7b; font-size:13px; line-height:1.65; }.feature-number { color:#afa4cb; font:10px var(--font-mono); }
  .synth-editions { padding:96px 0; background:#fff; }.edition-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:18px; }.edition-card { padding:32px; border:1px solid #e5dff1; border-radius:12px; background:#fff; box-shadow:var(--shadow-sm); }.edition-card-enterprise { color:#fff; border-color:#4a347e; background:linear-gradient(135deg,#241a48,#5f3fc2); box-shadow:0 18px 36px #5b3cc52b; }.edition-card-top { display:flex; align-items:center; justify-content:space-between; gap:16px; }.edition-badge { color:var(--synth-violet); font:10px var(--font-mono); text-transform:uppercase; letter-spacing:.12em; }.edition-card-enterprise .edition-badge { color:#d7caff; }.edition-card h3 { max-width:18ch; margin-top:28px; font-size:24px; letter-spacing:-.03em; }.edition-card p { max-width:48ch; margin-top:14px; color:#665f7b; font-size:14px; line-height:1.65; }.edition-card-enterprise p { color:#d7cff0; }.edition-card ul { display:grid; gap:10px; margin:24px 0 30px; padding:0; list-style:none; color:#554b6f; font-size:13px; }.edition-card-enterprise ul { color:#eee9ff; }.edition-card li { display:flex; align-items:center; gap:8px; }.edition-card li svg { color:#43a479; flex:none; }.edition-card-enterprise li svg { color:#9de4bd; }.edition-card .btn-primary { background:#fff; color:#3c2875; border-color:#fff; }
