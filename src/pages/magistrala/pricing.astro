---
import { ArrowRight, ArrowUpRight } from "@lucide/astro";
import IdentityLayout from "../../layouts/IdentityLayout.astro";
import Pricing from "../../components/Pricing.astro";
import "../../styles/identity-editorial.css";
import "../../styles/identity-pages.css";
---

<IdentityLayout
  title="Magistrala pricing"
  description="Magistrala pricing across three models: the free, open-source Community Edition, fully managed Private Cloud plans, and self-managed Enterprise licensing. Monthly, annual, or perpetual billing."
  image="/img/og/og-magistrala.png"
  imageAlt="Magistrala pricing"
  active="work"
>
  <section class="ip-hero" aria-labelledby="pricing-title">
    <nav class="is-breadcrumb" aria-label="Breadcrumb">
      <a href="/">Abstract Machines</a><span>/</span><a
        href="/products/magistrala/">Magistrala</a
      ><span>/</span> Pricing
    </nav>
    <div class="ip-hero-grid">
      <div>
        <p class="ie-eyebrow">Pricing / Magistrala</p>
        <h1 id="pricing-title">
          Choose how you<br /><span>run Magistrala.</span>
        </h1>
      </div>
      <div class="ip-hero-aside">
        <p>
          Free and open source, fully managed in our private cloud, or
          self-managed in your own environment. The same platform, priced for
          the way you want to operate it.
        </p>
        <div class="ip-hero-actions">
          <a
            class="ie-button ie-button-white"
            href="https://github.com/absmach/magistrala"
            >Start for free <ArrowUpRight size={19} /></a
          ><a class="text-link" href="/contact/?product=Magistrala"
            >Contact sales <ArrowRight size={18} /></a
          >
        </div>
      </div>
    </div>
  </section>

  <Pricing />

  <section class="ip-cta" aria-labelledby="pricing-cta-title">
    <div>
      <p class="ie-eyebrow">Your next step</p>
      <h2 id="pricing-cta-title">
        Not sure which<br /><span>plan fits?</span>
      </h2>
    </div>
    <div>
      <p>
        Tell us about your devices, message volumes, and where you want to run
        the platform. We will recommend the right starting point.
      </p>
      <div class="ip-actions">
        <a class="ie-button ie-button-white" href="/contact/?product=Magistrala"
          >Talk to sales <ArrowUpRight size={19} /></a
        ><a class="text-link" href="/products/magistrala/"
          >Explore Magistrala <ArrowRight size={18} /></a
        >
      </div>
    </div>
  </section>
</IdentityLayout>
