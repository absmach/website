---
import { ArrowRight, ArrowUpRight } from "@lucide/astro";
import IdentityLayout from "../../layouts/IdentityLayout.astro";
import SolutionCard from "../../components/identity/SolutionCard.astro";
import { solutions } from "../../data/solutions";
import "../../styles/identity-editorial.css";
import "../../styles/identity-pages.css";
---

<IdentityLayout
  title="Solutions"
  description="Industry-specific IoT solution packs for water, energy, smart cities, agriculture, and more. Pre-built dashboards, rules, and alerts, powered by Magistrala."
  active="work"
>
  <section class="ip-hero" aria-labelledby="solutions-title">
    <nav class="is-breadcrumb" aria-label="Breadcrumb">
      <a href="/">Abstract Machines</a><span>/</span><a href="/products/"
        >Our work</a
      ><span>/</span> Solutions
    </nav>
    <div class="ip-hero-grid">
      <div>
        <p class="ie-eyebrow">Solution packs / Magistrala</p>
        <h1 id="solutions-title">
          Pick a solution.<br /><span>Deploy in minutes.</span>
        </h1>
      </div>
      <div class="ip-hero-aside">
        <p>
          Pre-configured solution packs built on Magistrala. Dashboards,
          detection rules, and compliance reports are wired up and ready to
          deploy in minutes, not months.
        </p>
        <div class="ip-hero-actions">
          <a
            class="ie-button ie-button-white"
            href="/contact/?product=Magistrala"
            >Talk to us <ArrowUpRight size={19} /></a
          ><a class="text-link" href="/products/magistrala/"
            >About the platform <ArrowRight size={18} /></a
          >
        </div>
      </div>
    </div>
  </section>

  <section class="ip-section" aria-labelledby="packs-title">
    <div class="ip-heading">
      <div>
        <p class="ie-eyebrow">{solutions.length} packs</p>
        <h2 id="packs-title">
          Built for the industries<br /><span>we work in.</span>
        </h2>
      </div>
      <p>
        Each pack bundles the devices, dashboards, rules, and reports a
        deployment needs on day one. Open one to see how it works.
      </p>
    </div>
    <div class="ip-grid ip-grid-3">
      {
        solutions.map((solution, index) => (
          <SolutionCard solution={solution} eager={index < 3} />
        ))
      }
    </div>
  </section>

  <section class="ip-section ip-section--navy" aria-labelledby="proof-title">
    <div class="ip-heading">
      <div>
        <p class="ie-eyebrow">In the field</p>
        <h2 id="proof-title">
          The same platform,<br /><span>many deployments.</span>
        </h2>
      </div>
      <p>
        Every pack runs on the Magistrala platform that already carries
        production workloads across utilities, cities, and industry.
      </p>
    </div>
    <div class="ip-stats">
      <div><strong>400+</strong><span>Production deployments</span></div>
      <div>
        <strong>{solutions.length}</strong><span>Industry verticals</span>
      </div>
      <div>
        <strong>Minutes</strong><span>Time to the first dashboard</span>
      </div>
      <div>
        <strong>Open source</strong><span>Apache 2.0 platform core</span>
      </div>
    </div>
  </section>

  <section class="ip-cta" aria-labelledby="solutions-cta-title">
    <div>
      <p class="ie-eyebrow">Custom packs</p>
      <h2 id="solutions-cta-title">
        Don’t see<br /><span>your industry?</span>
      </h2>
    </div>
    <div>
      <p>
        Our team builds custom solution packs. Bring your requirements and we
        will scope a deployment together.
      </p>
      <div class="ip-actions">
        <a class="ie-button ie-button-white" href="/contact/"
          >Talk to us <ArrowUpRight size={19} /></a
        ><a class="text-link" href="/services/"
          >View our services <ArrowRight size={18} /></a
        >
      </div>
    </div>
  </section>
</IdentityLayout>
