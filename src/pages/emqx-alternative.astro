---
import { ArrowRight, ArrowUpRight } from "@lucide/astro";
import IdentityLayout from "../layouts/IdentityLayout.astro";
import Faq from "../components/identity/Faq.astro";
import "../styles/identity-editorial.css";
import "../styles/identity-pages.css";

const comparisonRows = [
  { feature: "MQTT 3.1.1 and 5.0", fluxmq: "Yes", emqx: "Yes" },
  { feature: "AMQP 0.9.1", fluxmq: "Yes", emqx: "No" },
  { feature: "AMQP 1.0", fluxmq: "Yes", emqx: "No" },
  { feature: "CoAP bridge", fluxmq: "Yes", emqx: "Yes (plugin)" },
  {
    feature: "Built-in clustering",
    fluxmq: "Yes (embedded etcd)",
    emqx: "Yes (Erlang distribution)",
  },
  {
    feature: "Durable queues with consumer groups",
    fluxmq: "Yes",
    emqx: "Enterprise edition only",
  },
  {
    feature: "Dead-letter queues",
    fluxmq: "Yes",
    emqx: "Enterprise edition only",
  },
  {
    feature: "Single binary, no runtime dependencies",
    fluxmq: "Yes (Go binary)",
    emqx: "No (Erlang/OTP runtime bundled)",
  },
  {
    feature: "License",
    fluxmq: "Apache 2.0 (all features)",
    emqx: "Apache 2.0 (community) / Commercial (enterprise)",
  },
  { feature: "Implementation language", fluxmq: "Go", emqx: "Erlang/OTP" },
];

const strengths = [
  {
    title: "Mature clustering",
    desc: "EMQX’s Erlang-based distribution layer is battle-tested for large-scale, multi-node deployments.",
  },
  {
    title: "Large plugin ecosystem",
    desc: "An extensive rule engine, data bridge connectors, and authentication plugins are available in the enterprise edition.",
  },
  {
    title: "Active community",
    desc: "A large user base, extensive documentation, and regular releases backed by EMQ Technologies.",
  },
  {
    title: "Dashboard UI",
    desc: "EMQX ships a web dashboard for monitoring connections, topics, and subscriptions.",
  },
];

const differences = [
  {
    title: "AMQP 0.9.1 and 1.0 on the same broker",
    desc: "EMQX is an MQTT broker. FluxMQ natively speaks MQTT, AMQP 0.9.1, AMQP 1.0, CoAP, and HTTP-MQTT, all routing through the same Queue Manager. No separate broker for enterprise AMQP services.",
  },
  {
    title: "Single Go binary, zero runtime dependencies",
    desc: "EMQX bundles the Erlang/OTP runtime. FluxMQ is a single compiled Go binary. No runtime to configure, no OTP distribution protocol, no node cookies. Drop it in and run.",
  },
  {
    title: "Durable queues in the open edition",
    desc: "Consumer groups, offset tracking, dead-letter queues, and Kafka-style retention are in FluxMQ’s Apache 2.0 release, not locked behind a commercial tier.",
  },
  {
    title: "Embedded etcd for coordination",
    desc: "FluxMQ uses embedded etcd for cluster coordination and gRPC with mTLS for inter-broker communication. No Erlang distribution protocol tuning is needed to build a cluster.",
  },
];

const faqs = [
  {
    q: "What is the main difference between FluxMQ and EMQX?",
    a: "FluxMQ is a single Go binary with no external runtime dependencies and ships all features, including clustering, durable queues, and AMQP support, under Apache 2.0. EMQX is a well-established Erlang broker with a large community edition and a separate enterprise edition that unlocks features like advanced rule engines and data persistence. FluxMQ targets teams that want full capability under a single open-source license without a commercial upgrade path.",
  },
  {
    q: "Does FluxMQ support AMQP like EMQX?",
    a: "FluxMQ supports both AMQP 0.9.1 and AMQP 1.0 natively. EMQX does not have native AMQP support; it is an MQTT broker. If your architecture needs to bridge MQTT IoT devices with AMQP-based enterprise services, FluxMQ handles both protocols on the same broker core.",
  },
  {
    q: "Is EMQX Community Edition fully open source?",
    a: "Yes, EMQX Community Edition is Apache 2.0. However, certain enterprise-grade features, including advanced data bridging, durable queue persistence, and priority support, are only available in EMQX Enterprise, which is commercially licensed.",
  },
  {
    q: "Is FluxMQ suitable for the same scale as EMQX?",
    a: "FluxMQ targets high-throughput IoT deployments: 500K+ concurrent connections and 300K to 500K messages per second per node, scaling linearly with cluster size. EMQX is also designed for large-scale deployments. Teams should evaluate both against their specific workload characteristics.",
  },
  {
    q: "How difficult is it to operate FluxMQ compared to EMQX?",
    a: "FluxMQ is a single Go binary. Configuration is a YAML file. No Erlang runtime, no node cookie management, no OTP distribution protocol tuning. For teams not already running Erlang infrastructure, the operational surface is significantly smaller.",
  },
  {
    q: "Which should I choose for an IoT platform like Magistrala?",
    a: "Both can serve as the message broker for an IoT platform. FluxMQ is the recommended broker for Magistrala deployments. It integrates with Magistrala’s device identity and RBAC layer out of the box and is developed by the same team.",
  },
];

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map(({ q, a }) => ({
      "@type": "Question",
      name: q,
      acceptedAnswer: { "@type": "Answer", text: a },
    })),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Home",
        item: "https://www.absmach.eu/",
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "EMQX Alternative",
        item: "https://www.absmach.eu/emqx-alternative/",
      },
    ],
  },
];
const cellClass = (value: string) =>
  value === "No" ? "is-no" : value === "Yes" ? "is-yes" : undefined;
---

<IdentityLayout
  title="EMQX alternative: FluxMQ MQTT broker"
  description="Looking for an open-source EMQX alternative? FluxMQ is Apache 2.0 with no enterprise tier: MQTT 5.0, AMQP 0.9.1 and 1.0, built-in clustering, durable queues, and a single Go binary with zero external dependencies."
  active="work"
>
  <Fragment slot="head">
    {
      structuredData.map((entry) => (
        <script type="application/ld+json" set:html={JSON.stringify(entry)} />
      ))
    }
  </Fragment>

  <section class="ip-hero" aria-labelledby="alt-title">
    <nav class="is-breadcrumb" aria-label="Breadcrumb">
      <a href="/">Abstract Machines</a><span>/</span><a href="/products/fluxmq/"
        >FluxMQ</a
      ><span>/</span> EMQX alternative
    </nav>
    <div class="ip-hero-grid">
      <div>
        <p class="ie-eyebrow">EMQX alternative / FluxMQ</p>
        <h1 id="alt-title">
          Open source.<br /><span>No enterprise tier.</span>
        </h1>
      </div>
      <div class="ip-hero-aside">
        <p>
          EMQX is a mature MQTT broker. FluxMQ ships clustering, durable queues,
          AMQP support, and 500K+ connections per node, all under Apache 2.0
          with no features locked behind a commercial edition.
        </p>
        <div class="ip-hero-actions">
          <a class="ie-button ie-button-white" href="/products/fluxmq/"
            >Explore FluxMQ <ArrowRight size={19} /></a
          ><a class="text-link" href="https://github.com/absmach/fluxmq"
            >GitHub <ArrowUpRight size={18} /></a
          >
        </div>
      </div>
    </div>
  </section>

  <section class="ip-section ip-section--tight" aria-label="Summary">
    <div class="ip-note">
      <h2>Why do teams look for an EMQX alternative?</h2>
      <p>
        EMQX Community Edition is Apache 2.0, but several production-grade
        capabilities, including durable queue persistence, advanced data
        bridging, and priority support, require EMQX Enterprise, which is
        commercially licensed. Teams that want full feature access under a
        single open-source license often evaluate FluxMQ or other
        Apache-licensed brokers.
      </p>
    </div>
  </section>

  <section class="ip-section" aria-labelledby="context-title">
    <div class="ip-heading">
      <div>
        <p class="ie-eyebrow">Context</p>
        <h2 id="context-title">What EMQX<br /><span>is good at.</span></h2>
      </div>
      <p>
        EMQX is a production-proven MQTT broker used by organisations globally,
        with a large ecosystem and strong enterprise support.
      </p>
    </div>
    <div class="ip-grid ip-grid-2">
      {
        strengths.map((item) => (
          <article class="ip-card">
            <h3>{item.title}</h3>
            <p>{item.desc}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="ip-section ip-section--soft" aria-labelledby="diff-title">
    <div class="ip-heading">
      <div>
        <p class="ie-eyebrow">Differentiators</p>
        <h2 id="diff-title">Where FluxMQ<br /><span>is different.</span></h2>
      </div>
    </div>
    <div class="ip-points">
      {
        differences.map((item) => (
          <div class="ip-point">
            <h3>{item.title}</h3>
            <p>{item.desc}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="ip-section" aria-labelledby="compare-title">
    <div class="ip-heading">
      <div>
        <p class="ie-eyebrow">Comparison</p>
        <h2 id="compare-title">
          FluxMQ and EMQX,<br /><span>feature by feature.</span>
        </h2>
      </div>
    </div>
    <div class="ip-table-wrap">
      <table class="ip-table">
        <thead>
          <tr>
            <th scope="col">Feature</th>
            <th scope="col" class="is-highlight">FluxMQ</th>
            <th scope="col">EMQX Community</th>
          </tr>
        </thead>
        <tbody>
          {
            comparisonRows.map(({ feature, fluxmq, emqx }) => (
              <tr>
                <th scope="row">{feature}</th>
                <td class="is-highlight is-yes">{fluxmq}</td>
                <td class={cellClass(emqx)}>{emqx}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <p class="ip-table-note">
      Sources: EMQX documentation (emqx.com/docs) and FluxMQ source code and
      documentation (github.com/absmach/fluxmq). EMQX Enterprise features are
      based on publicly documented Enterprise Edition capabilities.
    </p>
  </section>

  <section
    class="ip-section ip-section--navy"
    aria-labelledby="highlights-title"
  >
    <div class="ip-heading">
      <div>
        <p class="ie-eyebrow">FluxMQ</p>
        <h2 id="highlights-title">
          Apache 2.0. All features.<br /><span>One binary.</span>
        </h2>
      </div>
      <p>
        No enterprise edition. No feature flags. No commercial upgrade path.
        Everything ships in the open-source release.
      </p>
    </div>
    <div class="ip-stats">
      <div>
        <strong>MQTT 5.0</strong><span>Plus AMQP 0.9.1, AMQP 1.0, and CoAP</span
        >
      </div>
      <div>
        <strong>500K+</strong><span>Concurrent connections per node</span>
      </div>
      <div>
        <strong>Consumer groups</strong><span
          >Dead-letter queues and Kafka-style retention</span
        >
      </div>
      <div>
        <strong>Apache 2.0</strong><span>All features, no commercial tier</span>
      </div>
    </div>
  </section>

  <section class="ip-section" aria-labelledby="faq-title">
    <div class="ip-heading">
      <div>
        <p class="ie-eyebrow">FAQ</p>
        <h2 id="faq-title">Common questions.</h2>
      </div>
    </div>
    <Faq items={faqs} />
  </section>

  <section class="ip-cta" aria-labelledby="try-title">
    <div>
      <p class="ie-eyebrow">Get started</p>
      <h2 id="try-title">Try<br /><span>FluxMQ.</span></h2>
    </div>
    <div>
      <p>
        Open source, Apache 2.0, a single Go binary. Run it with Docker Compose
        in under five minutes.
      </p>
      <div class="ip-actions">
        <a
          class="ie-button ie-button-white"
          href="https://github.com/absmach/fluxmq"
          >View on GitHub <ArrowUpRight size={19} /></a
        ><a class="text-link" href="https://www.absmach.eu/docs/fluxmq"
          >Documentation <ArrowUpRight size={18} /></a
        >
      </div>
    </div>
  </section>
</IdentityLayout>
