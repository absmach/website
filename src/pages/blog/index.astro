---
import { ArrowUpRight, ChevronDown, Rss, Search } from "@lucide/astro";
import { getCollection } from "astro:content";
import IdentityLayout from "../../layouts/IdentityLayout.astro";
import BlogCard from "../../components/identity/BlogCard.astro";
import {
  PRODUCT_CATEGORIES,
  sortPosts,
  summarizePost,
  type BlogSummary,
} from "../../lib/blog";
import "../../styles/identity-editorial.css";
import "../../styles/identity-blog.css";

const entries = await getCollection("blogs", ({ data }) => !data.draft);
const posts = sortPosts(entries.map(summarizePost));

const normalize = (value: string) => value.trim().toLowerCase();
const matchesProduct = (post: BlogSummary, matchers: string[]) => {
  const tags = new Set(post.tags.map(normalize));
  const text = normalize(
    `${post.title} ${post.description} ${post.tags.join(" ")}`,
  );
  return matchers.some(
    (matcher) => tags.has(matcher) || text.includes(matcher),
  );
};
const productFilters = [
  { key: "", label: "All", count: posts.length },
  ...PRODUCT_CATEGORIES.map((category) => ({
    key: category.key,
    label: category.label,
    count: posts.filter((post) => matchesProduct(post, category.matchTags))
      .length,
  })),
].filter((filter) => filter.count > 0);

const productTags = new Set(
  PRODUCT_CATEGORIES.flatMap((category) => category.matchTags),
);
const allTags = Array.from(new Set(posts.flatMap((post) => post.tags)))
  .filter((tag) => !productTags.has(normalize(tag)))
  .sort((a, b) => a.localeCompare(b));

const blogData = JSON.stringify({
  posts: posts.map((post) => ({
    href: post.href,
    title: post.title,
    description: post.description,
    author: post.author,
    tags: post.tags,
  })),
  products: Object.fromEntries(
    PRODUCT_CATEGORIES.map((category) => [
      category.key,
      { label: category.label, matchers: category.matchTags },
    ]),
  ),
}).replace(/</g, "\\u003c");
---

<IdentityLayout
  title="Engineering blog"
  description="Technical articles on IoT, MQTT, edge computing, open-source infrastructure, and product updates from the Abstract Machines engineering team."
>
  <section class="ib-hero" aria-labelledby="blog-title">
    <nav class="is-breadcrumb" aria-label="Breadcrumb">
      <a href="/">Abstract Machines</a><span>/</span> Blog
    </nav>
    <div class="ib-hero-grid">
      <h1 id="blog-title">
        Notes from<br /><span>the engineering team.</span>
      </h1>
      <div class="ib-hero-aside">
        <p>
          Technical articles, product announcements, and open-source deep dives
          from the people building Abstract Machines.
        </p>
        <div class="ib-hero-links">
          <span>{posts.length} articles</span><a
            class="text-link"
            href="/rss.xml">Subscribe with RSS <Rss size={16} /></a
          >
        </div>
      </div>
    </div>
  </section>

  <section class="ib-catalogue" aria-label="Articles">
    <div class="ib-toolbar">
      <div class="ib-filters" aria-label="Filter by product">
        {
          productFilters.map((filter) => (
            <button
              type="button"
              class="ib-product"
              data-product={filter.key}
              aria-pressed={filter.key === "" ? "true" : "false"}
            >
              {filter.label}
              <span class="ib-filter-count" aria-hidden="true">
                {String(filter.count).padStart(2, "0")}
              </span>
            </button>
          ))
        }
      </div>
      <label class="ib-search"
        ><Search size={18} /><input
          id="blog-search"
          type="search"
          aria-label="Search articles"
          placeholder="Search articles"
          autocomplete="off"
        /></label
      >
    </div>
    <details class="ib-tags" id="tag-panel">
      <summary>
        <span>Filter by tag · {allTags.length} tags</span><ChevronDown
          size={16}
        />
      </summary>
      <div class="ib-tag-list">
        {
          allTags.map((tag) => (
            <button
              type="button"
              class="ib-tag"
              data-tag={tag}
              aria-pressed="false"
            >
              {tag}
            </button>
          ))
        }
      </div>
    </details>
    <div class="ib-meta">
      <div>
        <span id="result-count" aria-live="polite">{posts.length} articles</span
        ><div id="applied-filters" class="ib-active-filters" hidden></div>
      </div>
      <button type="button" class="ib-clear" data-clear hidden
        >Clear filters</button
      >
    </div>
    <div class="ib-grid" id="blog-results">
      {
        posts.map((post, index) => (
          <BlogCard
            post={post}
            featured={post.featured && index === 0}
            eager={index < 2}
          />
        ))
      }
    </div>
    <div id="blog-empty-state" class="ib-empty" hidden>
      <h2>No matches yet.</h2>
      <p>Try another search or clear the filters.</p>
      <button type="button" class="ib-clear" data-clear>Clear filters</button>
    </div>
  </section>

  <section class="is-page-cta">
    <h2>Working on something similar?</h2>
    <a class="is-button" href="/contact/"
      >Start a conversation <ArrowUpRight size={20} /></a
    >
  </section>

  <script type="application/json" id="blog-data" set:html={blogData} />
  <script>
    interface BlogPost {
      href: string;
      title: string;
      description: string;
      author: string;
      tags: string[];
    }
    interface BlogData {
      posts: BlogPost[];
      products: Record<string, { label: string; matchers: string[] }>;
    }
    const data: BlogData = JSON.parse(
      document.querySelector("#blog-data")?.textContent || "{}",
    );
    const posts = data.posts ?? [];
    const products = data.products ?? {};
    const cards = Array.from(
      document.querySelectorAll<HTMLElement>("[data-post-href]"),
    );
    const productButtons = Array.from(
      document.querySelectorAll<HTMLButtonElement>(".ib-product"),
    );
    const tagButtons = Array.from(
      document.querySelectorAll<HTMLButtonElement>(".ib-tag"),
    );
    const clearButtons = Array.from(
      document.querySelectorAll<HTMLButtonElement>("[data-clear]"),
    );
    const search = document.querySelector<HTMLInputElement>("#blog-search");
    const count = document.querySelector("#result-count");
    const applied = document.querySelector<HTMLElement>("#applied-filters");
    const empty = document.querySelector<HTMLElement>("#blog-empty-state");
    const tagPanel = document.querySelector<HTMLDetailsElement>("#tag-panel");

    const normalize = (value: string) => value.trim().toLowerCase();
    const state = { q: "", tags: new Set<string>(), product: "" };

    const matchesProduct = (post: BlogPost) => {
      const matchers = products[state.product]?.matchers ?? [];
      if (!matchers.length) return true;
      const tags = new Set(post.tags.map(normalize));
      const text = normalize(
        `${post.title} ${post.description} ${post.tags.join(" ")}`,
      );
      return matchers.some(
        (matcher) => tags.has(matcher) || text.includes(matcher),
      );
    };
    const matches = (post: BlogPost) => {
      const query = normalize(state.q);
      const haystack = normalize(
        `${post.title} ${post.description} ${post.author} ${post.tags.join(" ")}`,
      );
      if (query && !haystack.includes(query)) return false;
      if (!matchesProduct(post)) return false;
      for (const tag of state.tags) if (!post.tags.includes(tag)) return false;
      return true;
    };

    const syncControls = () => {
      productButtons.forEach((button) =>
        button.setAttribute(
          "aria-pressed",
          String((button.dataset.product ?? "") === state.product),
        ),
      );
      tagButtons.forEach((button) =>
        button.setAttribute(
          "aria-pressed",
          String(state.tags.has(button.dataset.tag ?? "")),
        ),
      );
      const filters = [
        ...(state.product ? [products[state.product]?.label ?? ""] : []),
        ...state.tags,
      ].filter(Boolean);
      if (applied) {
        applied.replaceChildren(
          ...filters.map((label) => {
            const chip = document.createElement("span");
            chip.textContent = label;
            return chip;
          }),
        );
        applied.hidden = filters.length === 0;
      }
      const active = filters.length > 0 || state.q.trim() !== "";
      clearButtons.forEach((button) => (button.hidden = !active));
    };

    const writeUrl = () => {
      const params = new URLSearchParams();
      if (state.q.trim()) params.set("q", state.q.trim());
      if (state.tags.size) params.set("tags", Array.from(state.tags).join(","));
      if (state.product) params.set("product", state.product);
      const query = params.toString();
      history.replaceState(
        null,
        "",
        query ? `${location.pathname}?${query}` : location.pathname,
      );
    };

    const render = () => {
      const visible = new Set(posts.filter(matches).map((post) => post.href));
      cards.forEach((card) => {
        card.hidden = !visible.has(card.dataset.postHref ?? "");
      });
      if (count)
        count.textContent = `${visible.size} ${visible.size === 1 ? "article" : "articles"}`;
      if (empty) empty.hidden = visible.size > 0;
      syncControls();
      writeUrl();
    };

    const readUrl = () => {
      const params = new URLSearchParams(location.search);
      state.q = params.get("q") ?? "";
      state.tags = new Set(
        (params.get("tags") ?? "")
          .split(",")
          .map((tag) => tag.trim())
          .filter(Boolean),
      );
      const product = (params.get("product") ?? "").toUpperCase();
      state.product = product in products ? product : "";
      if (search) search.value = state.q;
      if (tagPanel && state.tags.size) tagPanel.open = true;
    };

    search?.addEventListener("input", () => {
      state.q = search.value;
      render();
    });
    productButtons.forEach((button) =>
      button.addEventListener("click", () => {
        const key = button.dataset.product ?? "";
        state.product = state.product === key ? "" : key;
        render();
      }),
    );
    tagButtons.forEach((button) =>
      button.addEventListener("click", () => {
        const tag = button.dataset.tag ?? "";
        if (state.tags.has(tag)) state.tags.delete(tag);
        else state.tags.add(tag);
        render();
      }),
    );
    clearButtons.forEach((button) =>
      button.addEventListener("click", () => {
        state.q = "";
        state.tags.clear();
        state.product = "";
        if (search) search.value = "";
        render();
        search?.focus();
      }),
    );

    document.querySelectorAll<HTMLImageElement>(".ib-cover").forEach((img) => {
      const fit = () => {
        if (img.naturalHeight > img.naturalWidth)
          img.style.objectFit = "contain";
      };
      if (img.complete) fit();
      else img.addEventListener("load", fit);
    });

    readUrl();
    render();
  </script>
</IdentityLayout>
