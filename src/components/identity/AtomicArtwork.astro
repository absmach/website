---
interface Props {
  id: string;
}
const { id } = Astro.props;
const modules = [
  { x: 392, y: 202, top: "#edf5fc", left: "#b4cbe0", right: "#91aecb" },
  { x: 347, y: 226, top: "#d2e3f2", left: "#89a9ca", right: "#5c80ac" },
  { x: 482, y: 250, top: "#adc7e2", left: "#6b91b9", right: "#3e6691" },
  { x: 392, y: 250, top: "#f6faff", left: "#cedfeb", right: "#a8c3dc" },
  { x: 437, y: 274, top: "#739bc6", left: "#3c6596", right: "#214a7a" },
];
---

<svg viewBox="0 0 600 400" fill="none" aria-hidden="true">
  <defs>
    <linearGradient
      id={`${id}-module`}
      x1="392"
      y1="138"
      x2="482"
      y2="208"
      gradientUnits="userSpaceOnUse"
    >
      <stop stop-color="#5682b7"></stop><stop offset="1" stop-color="#234c82"
      ></stop>
    </linearGradient>
    <radialGradient id={`${id}-shadow`}>
      <stop stop-color="#537da7" stop-opacity=".19"></stop><stop
        offset="1"
        stop-color="#537da7"
        stop-opacity="0"></stop>
    </radialGradient>
  </defs>

  <image
    href="/preview/ai/media/products/atomic-mark.svg"
    x="40"
    y="30"
    width="36"
    height="36"
  />
  <text
    x="88"
    y="61"
    fill="#123957"
    font-size="31"
    font-weight="500"
    letter-spacing="-1">Atomic</text
  >
  <text
    x="560"
    y="57"
    text-anchor="end"
    fill="#657f97"
    font-size="9"
    letter-spacing="1.5">IDEA → APPLICATION</text
  >
  <text x="40" y="153" fill="#143b60" font-size="37" letter-spacing="-1.4"
    >Ideas,</text
  >
  <text x="40" y="197" fill="#627f99" font-size="37" letter-spacing="-1.4"
    >taking shape.</text
  >

  <ellipse cx="415" cy="333" rx="155" ry="43" fill={`url(#${id}-shadow)`}
  ></ellipse>
  <path
    d="m274 259 118-63 154 82M302 303l136 72 135-72"
    stroke="#8eacc7"
    stroke-opacity=".28"></path>
  <path
    d="M108 276h89l64-35 50 27"
    stroke="#789bbb"
    stroke-width="1.3"
    stroke-dasharray="3 6"></path>
  <circle cx="108" cy="276" r="4" fill="#7197bb"></circle>
  <circle cx="197" cy="276" r="3" fill="#e7eff7" stroke="#789bbb"></circle>
  <g stroke="#7c9fbe" stroke-width="1.15" opacity=".6">
    <path d="m257 237 25 14-25 14-25-14zM232 251v28l25 14 25-14v-28M257 265v28"
    ></path>
    <path d="m239 242-21-12m48 9 20-12" stroke-dasharray="3 5"></path>
  </g>

  {
    modules.map(({ x, y, top, left, right }) => (
      <g
        stroke="#edf5fc"
        stroke-opacity=".4"
        stroke-width=".7"
        stroke-linejoin="round"
      >
        <path d={`M${x - 45} ${y + 24}l45 24v44l-45-24z`} fill={left} />
        <path d={`M${x + 45} ${y + 24}l-45 24v44l45-24z`} fill={right} />
        <path d={`M${x} ${y}l45 24-45 24-45-24z`} fill={top} />
      </g>
    ))
  }

  <g stroke="#789bbb" stroke-width="1" stroke-dasharray="3 5" opacity=".6">
    <path d="M392 185v42M482 185v64M437 209v64"></path>
  </g>
  <g
    stroke="#e7f1ff"
    stroke-width=".8"
    stroke-opacity=".5"
    stroke-linejoin="round"
  >
    <path d="m392 166 45 24v44l-45-24z" fill="#456d9d"></path>
    <path d="m482 166-45 24v44l45-24z" fill="#1f477b"></path>
    <path d="m437 142 45 24-45 24-45-24z" fill={`url(#${id}-module)`}></path>
  </g>
  <g
    stroke="#eaf4ff"
    stroke-width="1.8"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <path d="m421 158-9 5 9 5m32-5 9 5-9 5m-12-17-9 18"></path>
  </g>
  <path d="M40 340h160" stroke="#a9bfce" stroke-opacity=".7"></path>
  <text x="40" y="363" fill="#607d96" font-size="9" letter-spacing="1.4"
    >FROM POSSIBILITY TO PRODUCT.</text
  >
</svg>
