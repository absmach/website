---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const email = "info@absmach.eu";
const contactApiEndpoint = "/api/contact";
---

<BaseLayout
  title="Contact — Abstract Machines"
  description="Talk to Abstract Machines about production deployments, integrations, research partnerships, and open-source support."
>
  <Header />
  <main>
    <section class="page-hero">
      <div class="container-wide">
        <div class="grid">
          <div class="stack stack-md">
            <span class="kicker">Contact</span>
            <h1 class="h-display">Start a conversation.</h1>
          </div>
          <p class="lede">
            Whether you're planning a production deployment, evaluating our stack, or exploring
            a research collaboration, we're direct and straightforward to work with.
          </p>
        </div>
      </div>
    </section>

    <section>
      <div class="container-wide">
        <div class="contact-grid">
          <form class="contact-form" method="post" action={contactApiEndpoint} data-contact-form>
            <span class="kicker" style="color:rgba(246,244,238,0.6);">Send a message</span>
            <h2 class="h-2" style="margin:14px 0 24px; color:var(--paper);">
              We typically reply in 1-2 business days.
            </h2>
            <div class="form-fields-row">
              <div class="field">
                <label for="name">Name</label>
                <input id="name" name="name" type="text" autocomplete="name" placeholder="Jane Doe" required />
              </div>
              <div class="field">
                <label for="email">Email</label>
                <input id="email" name="email" type="email" autocomplete="email" placeholder="jane@company.com" required />
              </div>
            </div>
            <div class="field">
              <label for="organization">Company</label>
              <input id="organization" name="organization" type="text" autocomplete="organization" placeholder="Acme Manufacturing" />
            </div>
            <div class="field">
              <label for="message">Message</label>
              <textarea id="message" name="message" rows="5" placeholder="What are you building? What do you need help with? Any scale or security constraints?" required></textarea>
            </div>
            <div aria-hidden="true" style="position:absolute; left:-5000px;">
              <label for="company">Company</label>
              <input id="company" name="company" tabindex="-1" autocomplete="off" />
            </div>
            <button type="submit" class="btn" style="width:100%; justify-content:center; background:var(--paper); color:var(--ink); border-color:rgba(255,255,255,0.25);" data-contact-submit>
              Send message →
            </button>
            <p
              style="min-height:24px; margin:14px 0 0; color:rgba(246,244,238,0.75); font-size:14px;"
              role="status"
              aria-live="polite"
              data-contact-status
            ></p>
          </form>

          <div class="contact-side">
            <div class="card">
              <span class="kicker">Direct email</span>
              <h3 class="h-4" style="margin-top:10px;"><a href={`mailto:${email}`}>{email}</a></h3>
              <p class="ink-2" style="font-size:14px; margin:8px 0 0;">
                Best for architecture reviews, production deployments, and security discussions.
              </p>
            </div>
            <div class="card">
              <h3 class="h-4">Other channels</h3>
              <ul class="channels">
                <li><span class="lbl">GitHub</span><a href="https://github.com/absmach" target="_blank" rel="noopener noreferrer">github.com/absmach</a></li>
                <li><span class="lbl">LinkedIn</span><a href="https://www.linkedin.com/company/abstract-machines" target="_blank" rel="noopener noreferrer">Abstract Machines</a></li>
                <li><span class="lbl">Twitter</span><a href="https://twitter.com/absmach" target="_blank" rel="noopener noreferrer">@absmach</a></li>
                <li><span class="lbl">YouTube</span><a href="https://www.youtube.com/@absmach" target="_blank" rel="noopener noreferrer">@absmach</a></li>
                <li><span class="lbl">Matrix</span><a href="https://matrix.to/#/#absmach:matrix.org" target="_blank" rel="noopener noreferrer">#absmach:matrix.org</a></li>
              </ul>
            </div>
            <div class="card card-dark">
              <span class="kicker" style="color:rgba(246,244,238,0.6);">Office</span>
              <p style="margin:12px 0 0; font-size:15px; line-height:1.6;">
                141 Quai de Valmy<br />75010 Paris, France
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
  <script is:inline>
    (() => {
      const form = document.querySelector("[data-contact-form]");
      if (!(form instanceof HTMLFormElement)) return;

      const statusEl = document.querySelector("[data-contact-status]");
      const submitButton = form.querySelector("[data-contact-submit]");
      if (!(statusEl instanceof HTMLElement)) return;
      if (!(submitButton instanceof HTMLButtonElement)) return;

      const defaultLabel = submitButton.textContent?.trim() || "Send message";

      const setStatus = (text, tone = "muted") => {
        statusEl.textContent = text;
        statusEl.style.color =
          tone === "success" ? "#b8f7c5" : tone === "error" ? "#ffb199" : "rgba(246,244,238,0.75)";
      };

      form.addEventListener("submit", async (event) => {
        event.preventDefault();
        submitButton.disabled = true;
        submitButton.setAttribute("aria-busy", "true");
        submitButton.textContent = "Sending...";
        setStatus("Sending your message...");

        try {
          const response = await fetch(form.action, {
            method: "POST",
            body: new FormData(form),
            headers: { Accept: "application/json" },
          });

          let payload = null;
          try {
            payload = await response.json();
          } catch {
            payload = null;
          }

          if (!response.ok || !payload?.ok) {
            throw new Error(payload?.error || "Unable to send your message. Please use direct email.");
          }

          form.reset();
          setStatus(payload?.message || "Thanks. Your message has been sent.", "success");
        } catch (error) {
          setStatus(
            error instanceof Error ? error.message : "Unable to send your message. Please use direct email.",
            "error",
          );
        } finally {
          submitButton.disabled = false;
          submitButton.removeAttribute("aria-busy");
          submitButton.textContent = defaultLabel;
        }
      });
    })();
  </script>
</BaseLayout>
