---
export const prerender = true;

import {
  ArrowLeft,
  ArrowRight,
  ArrowUpRight,
  ChevronLeft,
  ChevronRight,
} from "@lucide/astro";
import IdentityLayout from "../../layouts/IdentityLayout.astro";
import Faq from "../../components/identity/Faq.astro";
import SolutionCard from "../../components/identity/SolutionCard.astro";
import { solutions } from "../../data/solutions";
import "../../styles/identity-editorial.css";
import "../../styles/identity-pages.css";

export async function getStaticPaths() {
  return solutions.map((sol) => ({
    params: { slug: sol.slug },
    props: { sol },
  }));
}

const { sol } = Astro.props;
const related = solutions.filter((item) => item.slug !== sol.slug).slice(0, 3);
const faqSchema =
  sol.faq.length > 0
    ? JSON.stringify({
        "@context": "https://schema.org",
        "@type": "FAQPage",
        mainEntity: sol.faq.map((f) => ({
          "@type": "Question",
          name: f.question,
          acceptedAnswer: { "@type": "Answer", text: f.answer },
        })),
      })
    : null;
---

<IdentityLayout
  title={sol.title}
  description={sol.metaDescription}
  image={sol.image}
  imageAlt={`${sol.title} dashboard preview`}
  active="work"
>
  {
    faqSchema && (
      <Fragment slot="head">
        <script type="application/ld+json" set:html={faqSchema} />
      </Fragment>
    )
  }

  <section class="ip-hero ip-hero--light" aria-labelledby="solution-title">
    <a class="ie-back" href="/solutions/"
      ><ArrowLeft size={16} /> All solution packs</a
    >
    <div class="ip-hero-grid">
      <div>
        <p class="ie-eyebrow">Solution pack / Magistrala</p>
        <h1 id="solution-title">{sol.title}</h1>
      </div>
      <div class="ip-hero-aside">
        <p>{sol.description}</p>
        <div class="ip-hero-actions">
          <a class="ie-button" href="https://github.com/absmach/magistrala"
            >Try it free <ArrowUpRight size={19} /></a
          ><a class="text-link" href="/contact/?product=Magistrala"
            >Talk to us <ArrowRight size={18} /></a
          >
          {
            sol.docsPath && (
              <a class="text-link" href={sol.docsPath}>
                Read the documentation <ArrowRight size={18} />
              </a>
            )
          }
        </div>
      </div>
    </div>
  </section>

  <section class="ip-section ip-section--tight" aria-label="Why Magistrala">
    <div class="ip-note">
      <p class="ie-eyebrow">Why Magistrala</p>
      <p>{sol.whyMagistrala}</p>
      <a class="text-link" href="/products/magistrala/"
        >Explore the platform <ArrowRight size={16} /></a
      >
    </div>
  </section>

  {
    sol.dashboardScreenshots.length > 0 && (
      <section
        class="ip-section ip-section--soft"
        aria-labelledby="dashboards-title"
      >
        <div class="ip-heading">
          <div>
            <p class="ie-eyebrow">Platform dashboards</p>
            <h2 id="dashboards-title">See it in action.</h2>
          </div>
          <p>
            Purpose-built dashboards for every layer of your{" "}
            {sol.title.toLowerCase()} deployment.
          </p>
        </div>
        <div class="ip-carousel" id={`carousel-${sol.slug}`}>
          <div class="ip-carousel-track">
            {sol.dashboardScreenshots.map((shot, i) => (
              <div
                class={`ip-carousel-slide${i === 0 ? " active" : ""}`}
                data-index={i}
              >
                <img
                  src={shot.src}
                  alt={shot.alt}
                  loading={i === 0 ? "eager" : "lazy"}
                  decoding="async"
                />
              </div>
            ))}
          </div>
          {sol.dashboardScreenshots.length > 1 && (
            <div class="ip-carousel-controls">
              <button
                type="button"
                class="ip-carousel-btn prev"
                aria-label="Previous screenshot"
              >
                <ChevronLeft size={18} />
              </button>
              <div class="ip-carousel-dots">
                {sol.dashboardScreenshots.map((_, i) => (
                  <button
                    type="button"
                    class={`ip-carousel-dot${i === 0 ? " active" : ""}`}
                    data-dot={i}
                    aria-label={`Screenshot ${i + 1}`}
                  />
                ))}
              </div>
              <button
                type="button"
                class="ip-carousel-btn next"
                aria-label="Next screenshot"
              >
                <ChevronRight size={18} />
              </button>
            </div>
          )}
        </div>
      </section>
    )
  }

  <section class="ip-section" aria-labelledby="challenge-title">
    <div class="ip-heading">
      <div>
        <p class="ie-eyebrow">The challenge</p>
        <h2 id="challenge-title">{sol.challenges.title}</h2>
      </div>
      <p>{sol.challenges.subtitle}</p>
    </div>
    <div class="ip-grid ip-grid-3">
      {
        sol.challenges.items.map(({ ic: Icon, title, desc }) => (
          <article class="ip-card">
            <span class="ip-card-icon">
              <Icon size={20} />
            </span>
            <h3>{title}</h3>
            <p>{desc}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="ip-section ip-section--soft" aria-labelledby="hiw-title">
    <div class="ip-heading">
      <div>
        <p class="ie-eyebrow">How it works</p>
        <h2 id="hiw-title">From device<br /><span>to insight.</span></h2>
      </div>
      <p>{sol.howItWorks.subtitle}</p>
    </div>
    <ol class="ip-steps">
      {
        sol.howItWorks.steps.map((step, i) => (
          <li>
            <span class="ie-number">{String(i + 1).padStart(2, "0")}</span>
            <h3>{step.title}</h3>
            <p>{step.desc}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="ip-section" aria-labelledby="applications-title">
    <div class="ip-heading">
      <div>
        <p class="ie-eyebrow">Applications</p>
        <h2 id="applications-title">{sol.applications.title}</h2>
      </div>
      <p>{sol.applications.subtitle}</p>
    </div>
    <div class="ip-grid ip-grid-2">
      {
        sol.applications.items.map(({ ic: Icon, title, desc }) => (
          <article class="ip-card ip-card--row">
            <span class="ip-card-icon">
              <Icon size={20} />
            </span>
            <div>
              <h3>{title}</h3>
              <p>{desc}</p>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="ip-section ip-section--soft" aria-labelledby="benefits-title">
    <div class="ip-heading">
      <div>
        <p class="ie-eyebrow">Benefits</p>
        <h2 id="benefits-title">
          What you get<br /><span>out of the box.</span>
        </h2>
      </div>
    </div>
    <ul class="ip-list ip-list-2" style="margin-top: 50px;">
      {sol.benefits.map((benefit) => <li>{benefit}</li>)}
    </ul>
  </section>

  {
    sol.faq.length > 0 && (
      <section class="ip-section" aria-labelledby="faq-title">
        <div class="ip-heading">
          <div>
            <p class="ie-eyebrow">FAQ</p>
            <h2 id="faq-title">Common questions.</h2>
          </div>
        </div>
        <Faq items={sol.faq.map((f) => ({ q: f.question, a: f.answer }))} />
      </section>
    )
  }

  <section class="ip-cta" aria-labelledby="deploy-title">
    <div>
      <p class="ie-eyebrow">Your next step</p>
      <h2 id="deploy-title">Ready to deploy<br /><span>{sol.title}?</span></h2>
    </div>
    <div>
      <p>
        Start free on Magistrala Cloud, or contact us to scope a custom
        deployment for your organisation.
      </p>
      <div class="ip-actions">
        <a
          class="ie-button ie-button-white"
          href="https://magistrala.absmach.com"
          >Start for free <ArrowUpRight size={19} /></a
        ><a class="text-link" href="/contact/?product=Magistrala"
          >Contact sales <ArrowRight size={18} /></a
        >
      </div>
    </div>
  </section>

  <section class="ip-section" aria-labelledby="more-packs-title">
    <div class="ip-heading">
      <div>
        <p class="ie-eyebrow">More solution packs</p>
        <h2 id="more-packs-title">Other industries.</h2>
      </div>
      <a class="text-link" href="/solutions/"
        >All solution packs <ArrowRight size={18} /></a
      >
    </div>
    <div class="ip-grid ip-grid-3">
      {related.map((item) => <SolutionCard solution={item} level={3} />)}
    </div>
  </section>

  <script>
    document
      .querySelectorAll<HTMLElement>(".ip-carousel")
      .forEach((carousel) => {
        const slides =
          carousel.querySelectorAll<HTMLElement>(".ip-carousel-slide");
        const dots = carousel.querySelectorAll<HTMLElement>(".ip-carousel-dot");
        let current = 0;
        const goTo = (n: number) => {
          slides[current]?.classList.remove("active");
          dots[current]?.classList.remove("active");
          current = (n + slides.length) % slides.length;
          slides[current]?.classList.add("active");
          dots[current]?.classList.add("active");
        };
        carousel
          .querySelector(".prev")
          ?.addEventListener("click", () => goTo(current - 1));
        carousel
          .querySelector(".next")
          ?.addEventListener("click", () => goTo(current + 1));
        dots.forEach((dot, i) => dot.addEventListener("click", () => goTo(i)));
      });
  </script>
</IdentityLayout>
