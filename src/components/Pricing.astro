---
import { ArrowRight, ArrowUpRight, Check, Minus } from "@lucide/astro";
import Faq from "./identity/Faq.astro";

const fmt = (n: number) => n.toLocaleString("en-US");

// Private Cloud: fully managed, dedicated instances.
const privateTiers = [
  {
    name: "Prototype",
    goodFor:
      "Pilot projects and small deployments with low message bandwidth and best-effort delivery.",
    monthly: 150,
    annual: 1620,
    storage: "80 GB storage for messages",
    transfer: "3 TB data transfer",
    capacity: "~200 devices · 1M messages / month",
    inherits: null,
    featured: false,
    contact: false,
    cta: "Get started",
    features: [
      "Commercial UI with whitelabeling",
      "Basic UI and backend patches",
      "Security updates",
      "Security fixes",
      "Community support",
      "Dashboards",
    ],
  },
  {
    name: "Business",
    goodFor:
      "Deployments where availability matters and flexibility and features are important. This is where your business starts.",
    monthly: 500,
    annual: 5400,
    storage: "180 GB storage for messages",
    transfer: "8 TB data transfer",
    capacity: "~5k devices · 10M messages / month",
    inherits: "Prototype",
    featured: true,
    contact: false,
    cta: "Get started",
    features: [
      "Rules engine and custom message format",
      "Alarms",
      "Reports",
      "Priority support and issue addressing",
      "Dedicated support 2h / month",
      "Weekly backups, 4 restore points (28 days)",
    ],
  },
  {
    name: "Enterprise",
    goodFor: "Larger deployments where stability and performance matter.",
    monthly: 1000,
    annual: 10800,
    storage: "300 GB storage for messages",
    transfer: "8 TB data transfer",
    capacity: "~50k devices · 100M messages / month",
    inherits: "Business",
    featured: false,
    contact: false,
    cta: "Get started",
    features: [
      "Higher-priority support and issue addressing",
      "Dedicated support 12h / month (instead of 2)",
      "Daily backups instead of weekly, 7 restore points (7 days)",
    ],
  },
  {
    name: "Custom",
    goodFor:
      "Large production deployments where HA and SLA matter: huge device and message volumes, no acceptable message loss, and strict data residency and compliance.",
    monthly: null,
    annual: null,
    storage: null,
    transfer: null,
    capacity: null,
    inherits: null,
    featured: false,
    contact: true,
    cta: "Contact sales",
    features: [
      "Deploy on our dedicated cloud, your cloud (AWS, GCP, Azure), or on-premises",
      "Custom SLA with defined uptime guarantees",
      "High-availability clustering",
      "Dedicated infrastructure and data residency",
      "Custom integrations and message formats",
      "Priority engineering support",
    ],
  },
];

// Community Edition (free, open source).
const communityFeatures = [
  "Unlimited clients, channels, groups, tenants, messages",
  "Every update, free forever",
  "Full control of your data and infrastructure",
  "Open-source backend under Apache 2.0",
  "Free-to-use UI, deployed as a Docker container",
  "Community support",
];

// Self-managed: run Magistrala Enterprise in your own environment.
const eeFeatures = [
  "Commercial UI with whitelabeling",
  "Dashboards",
  "Rules engine and custom message formats",
  "Alarms",
  "Reports",
  "Audit logs",
];

// Compare Community with the Private Cloud tiers. Cell values:
// true → included, false → not included, string → specific value.
const compareCols = [
  "Community",
  "Prototype",
  "Business",
  "Enterprise",
  "Custom",
];
const compareGroups = [
  {
    group: "Platform",
    rows: [
      {
        f: "Open-source backend (Apache 2.0)",
        cells: [true, true, true, true, true],
      },
      {
        f: "Multi-protocol messaging (MQTT, CoAP, HTTP, WebSocket)",
        cells: [true, true, true, true, true],
      },
      {
        f: "Multi-tenancy and fine-grained access control",
        cells: [true, true, true, true, true],
      },
      {
        f: "Unlimited clients, channels, groups and messages",
        cells: [true, true, true, true, true],
        note: true,
      },
    ],
  },
  {
    group: "Capacity",
    rows: [
      { f: "Devices", cells: [false, "~200", "~5k", "~50k", "Custom"] },
      {
        f: "Messages / month",
        cells: [false, "~1M", "~10M", "~100M", "Custom"],
      },
      {
        f: "Message storage",
        cells: [false, "80 GB", "180 GB", "300 GB", "Custom"],
      },
      {
        f: "Data transfer / month",
        cells: [false, "3 TB", "8 TB", "8 TB", "Custom"],
      },
    ],
  },
  {
    group: "Interface and data",
    rows: [
      { f: "Audit logs", cells: [true, true, true, true, true] },
      {
        f: "Commercial UI with whitelabeling",
        cells: [false, true, true, true, true],
      },
      { f: "Dashboards", cells: [false, true, true, true, true] },
    ],
  },
  {
    group: "Enterprise features",
    rows: [
      {
        f: "Rules engine and custom message formats",
        cells: [false, false, true, true, true],
      },
      { f: "Alarms", cells: [false, false, true, true, true] },
      { f: "Reports", cells: [false, false, true, true, true] },
    ],
  },
  {
    group: "Operations and support",
    rows: [
      {
        f: "Security patches and updates",
        cells: ["Community", "Standard", "Priority", "Priority", "Priority"],
      },
      {
        f: "Support",
        cells: [
          "Community",
          "Community",
          "Priority",
          "Higher priority",
          "Higher priority",
        ],
      },
      {
        f: "Dedicated support hours",
        cells: [false, false, "2h / month", "12h / month", "Custom"],
      },
      {
        f: "Backups",
        cells: [false, false, "Weekly · 28 days", "Daily · 7 days", "Custom"],
      },
      {
        f: "Dedicated instance",
        cells: ["Self-hosted", true, true, true, true],
      },
    ],
  },
];

const pricingFaqs = [
  {
    q: "What is the difference between Community, Private Cloud, and Self-managed?",
    a: "Same platform, three ways to run it:",
    bullets: [
      {
        label: "Community",
        text: "free to run yourself. Open-source backend services (Apache 2.0) plus a free-to-use UI you deploy as a Docker container.",
      },
      {
        label: "Private Cloud",
        text: "a fully managed, dedicated instance of Magistrala Enterprise Edition that we host and operate for you.",
      },
      {
        label: "Self-managed",
        text: "Magistrala Enterprise Edition in your own environment, licensed to you to run yourself, or deployed and operated by us on your infrastructure.",
      },
    ],
  },
  {
    q: "What is included in a Private Cloud plan?",
    a: "Every Private Cloud tier covers license, hosting, deployment, monitoring, dashboards, audit logs, and the updates listed for that tier. Higher tiers add the rules engine, alarms, reports, and scheduled backups. You focus on your devices and data; we run the platform.",
  },
  {
    q: "How do backups work?",
    a: "Business takes a snapshot of your instance every week and keeps the last four, so you can restore to any of the previous four weekly points, covering 28 days. Enterprise takes one every day and keeps the last seven: at most 24 hours of data is ever at risk, across a 7-day window. Daily is the stronger guarantee even though its window is shorter, because what matters in a recovery is how recent your restore point is, not how far back the archive goes. Restores are performed by our team on request. Long-term archiving, point-in-time recovery, and custom retention are part of the Custom plan.",
  },
  {
    q: "What counts as a device?",
    a: "A device is any client that connects to the platform and exchanges messages, regardless of protocol (MQTT, CoAP, HTTP, or WebSocket). The device and message figures on each tier are guidance for typical workloads, not hard quotas.",
  },
  {
    q: "Do I get a dedicated instance?",
    a: "Yes. Every Private Cloud plan runs on a dedicated instance with no shared infrastructure. We provision, run, and manage the instance for you.",
  },
  {
    q: "What does “~200 devices · 1M messages / month” actually mean?",
    a: "Because each tier is a dedicated instance, that figure is a rough estimate of how many concurrent devices and messages the instance can comfortably handle. It is not a hard cap. We do not limit you artificially; the only limit is the hardware and how it is set up. We deliberately avoid a messages-per-second metric, because it is a weak and misleading number for a few reasons:",
    points: [
      "Message size varies enormously. A ping is a message, and so is a 100 MB binary upload. They do not cost the same, and they are not the same priority.",
      "Networking hiccups and load balancing have an outsized impact as you approach the upper limit of throughput.",
      "Messages carry different delivery modes and quality-of-service guarantees. Not all messages are equally important.",
      "Throughput also depends on delivery semantics: whether it includes consumer delivery and message persistence. Slow consumers can effectively serialize your infrastructure, and sometimes that is the intended behaviour, especially in low-bandwidth, high-QoS environments.",
    ],
  },
  {
    q: "What happens if I exceed my device or message limit?",
    a: "Limits are soft. We monitor usage and reach out to move you to the tier that fits, rather than cutting you off mid-cycle. If a burst is temporary, nothing breaks.",
  },
  {
    q: "Can I change plans later?",
    a: "Yes. Upgrades are available at any time. Downgrades require a migration on our side, so please contact us to arrange one. Changes are prorated, so you only pay for what you use in a billing period.",
  },
  {
    q: "How does annual billing work?",
    a: "Annual Private Cloud plans are billed once per year and work out roughly 10% cheaper than paying monthly. You can switch between monthly and annual billing when your term renews.",
  },
  {
    q: "What is the difference between a monthly and a perpetual self-managed license?",
    a: "Both cover a single-cluster deployment of the full Magistrala Enterprise Edition feature set. The difference is how updates work. A monthly license (€300 per cluster) gives you access to the latest release for as long as your subscription is active. A perpetual license (€3,999 per cluster) is a one-time payment that lets you run the version you bought indefinitely, including patches and minor updates for that version, but not upgrades to future major releases.",
  },
  {
    q: "Can I deploy on my own cloud or on-premises?",
    a: "Yes. With a self-managed license you run Magistrala Enterprise yourself, anywhere. With the “Managed by us” option we deploy and operate it on your infrastructure: AWS, GCP, Azure, or on-premises, including air-gapped environments, aligned to your SLA, security, and data-residency policies.",
  },
  {
    q: "Do you offer a custom SLA and high availability?",
    a: "A formal uptime SLA and high-availability clustering are part of the Custom plan and the self-managed “Managed by us” option only. The standard Private Cloud tiers (Prototype, Business, Enterprise) each run as a single dedicated instance with proactive monitoring and support, but without a contractual SLA or clustering. If you need a guaranteed uptime target or active-active high availability, that is what the Custom plan is for. Response times and architecture are tailored to your requirements.",
  },
  {
    q: "Is self-hosting free?",
    a: "Partly. The Magistrala backend is open source under the Apache 2.0 license and free to self-host forever, and the Community Edition UI is free to use and deploy as a Docker container. The Enterprise Edition, which unlocks the full feature set including the rules engine, alarms, reports, audit logs, and dashboards, requires a self-managed license or a managed plan.",
  },
];
---

<section class="ip-section mp" id="pricing" aria-label="Pricing options">
  <div class="mp-tabs" role="tablist" aria-label="Pricing options">
    <button
      type="button"
      class="mp-tab"
      data-tab="community"
      role="tab"
      aria-selected="false"
    >
      Community <span class="mp-tab-note">Free</span>
    </button>
    <button
      type="button"
      class="mp-tab"
      data-tab="private"
      role="tab"
      aria-selected="true"
    >
      Private Cloud <span class="mp-tab-note">Managed</span>
    </button>
    <button
      type="button"
      class="mp-tab"
      data-tab="self"
      role="tab"
      aria-selected="false"
    >
      Self-managed <span class="mp-tab-note">Your environment</span>
    </button>
  </div>

  <!-- Community -->
  <div class="mp-panel" data-panel="community" role="tabpanel" hidden>
    <p class="mp-intro">
      Free and open source, forever. Run the full platform on your own hardware
      and keep complete control of your data.
    </p>
    <div class="mp-community">
      <div>
        <span class="ip-kicker">Community Edition · Free</span>
        <h3>Free, and it always will be.</h3>
        <p>
          Community Edition is free to run yourself. The backend services are
          open source under Apache 2.0; the UI is free to use and deploy as a
          Docker container. Run the full multi-tenant IoT platform on your own
          hardware, keep complete control of your data, and build without
          license fees, seat limits, or vendor lock-in.
        </p>
        <div class="ip-actions">
          <a class="ie-button" href="https://github.com/absmach/magistrala"
            >Get started <ArrowUpRight size={19} /></a
          ><a class="text-link" href="https://www.absmach.eu/docs/magistrala"
            >Documentation <ArrowUpRight size={18} /></a
          >
        </div>
      </div>
      <ul class="ip-list">
        {communityFeatures.map((feature) => <li>{feature}</li>)}
      </ul>
    </div>
  </div>

  <!-- Private Cloud -->
  <div class="mp-panel" data-panel="private" role="tabpanel">
    <p class="mp-intro">
      All-inclusive hosting and infrastructure on dedicated instances, so you
      can focus on building your solutions.
    </p>
    <div class="mp-toggle" role="group" aria-label="Billing period">
      <button
        type="button"
        class="mp-toggle-opt"
        data-billing="monthly"
        aria-pressed="true">Monthly</button
      >
      <button
        type="button"
        class="mp-toggle-opt"
        data-billing="annual"
        aria-pressed="false">Annual <span>Save 10%</span></button
      >
    </div>
    <div class="mp-tiers">
      {
        privateTiers.map((tier) => (
          <article
            class:list={[
              "mp-tier",
              { "is-featured": tier.featured, "is-custom": tier.contact },
            ]}
          >
            <div class="mp-tier-head">
              <span class="ip-kicker">{tier.name}</span>
              {tier.featured && <span class="mp-badge">Popular</span>}
            </div>
            <div class="mp-price">
              {tier.contact ? (
                <strong>Contact</strong>
              ) : (
                <>
                  <strong
                    class="mp-amount"
                    data-amt-monthly={fmt(tier.monthly ?? 0)}
                    data-amt-annual={fmt(Math.round((tier.annual ?? 0) / 12))}
                  >
                    €{fmt(tier.monthly ?? 0)}
                  </strong>
                  <span>/ month</span>
                </>
              )}
            </div>
            {!tier.contact && (
              <p
                class="mp-price-note"
                data-note-monthly="billed monthly"
                data-note-annual={`€${fmt(tier.annual ?? 0)} billed yearly`}
              >
                billed monthly
              </p>
            )}
            <p class="mp-goodfor">{tier.goodFor}</p>
            <ul class="ip-list mp-feats">
              {tier.inherits && (
                <li class="mp-inherit">Everything in {tier.inherits}, plus:</li>
              )}
              {tier.features.map((feature) => (
                <li>{feature}</li>
              ))}
              {tier.capacity && <li class="mp-inherit">{tier.capacity}</li>}
              {tier.storage && <li>{tier.storage}</li>}
              {tier.transfer && <li>{tier.transfer} *</li>}
            </ul>
            <a
              class:list={["ie-button", { "ie-button-white": !tier.featured }]}
              href={`/contact/?product=Magistrala&plan=${tier.name}`}
            >
              {tier.cta} <ArrowUpRight size={18} />
            </a>
          </article>
        ))
      }
    </div>
    <p class="mp-footnote">
      * Data transfer is a soft guide. Extra transfer is billed at €20 per
      additional TB per month. Need more than 50k devices or a bespoke setup?
      <a href="/contact/?product=Magistrala">Talk to us</a>.
    </p>
    <div class="mp-emphasis">
      <div>
        <p class="ie-eyebrow">No artificial gates</p>
        <h3>Features,<br /><span>not fences.</span></h3>
      </div>
      <p>
        We do not meter you with arbitrary caps: no “10 devices”, no “400
        messages”, no “3 dashboards”. You either have a feature or you do not.
        Once you are licensed, the only limits are soft ones, set by your
        hardware and configuration, never by us. And every deployment, Private
        Cloud or self-managed, is a full, dedicated instance.
      </p>
    </div>
  </div>

  <!-- Self-managed -->
  <div class="mp-panel" data-panel="self" role="tabpanel" hidden>
    <p class="mp-intro">
      Run Magistrala Enterprise Edition in your own environment. License it and
      operate it yourself, or have us deploy and run it for you.
    </p>
    <div class="mp-toggle" role="group" aria-label="License term">
      <button
        type="button"
        class="mp-toggle-opt"
        data-billing="monthly"
        aria-pressed="true">Monthly</button
      >
      <button
        type="button"
        class="mp-toggle-opt"
        data-billing="perpetual"
        aria-pressed="false">Perpetual</button
      >
    </div>
    <div class="mp-tiers mp-tiers-2">
      <article class="mp-tier is-featured">
        <div class="mp-tier-head">
          <span class="ip-kicker">License only</span>
          <span class="mp-badge">License</span>
        </div>
        <div class="mp-price">
          <strong
            class="mp-amount"
            data-amt-monthly="300"
            data-amt-perpetual="3,999">€300</strong
          >
        </div>
        <p
          class="mp-price-note"
          data-note-monthly="per cluster · billed monthly"
          data-note-perpetual="per cluster · one-time license"
        >
          per cluster · billed monthly
        </p>
        <p class="mp-goodfor">
          Magistrala Enterprise Edition license for your own deployment. You run
          and operate it; we license the software, per cluster.
        </p>
        <ul class="ip-list mp-feats">
          <li class="mp-inherit">Everything in Community Edition, plus:</li>
          {eeFeatures.map((feature) => <li>{feature}</li>)}
          <li>
            Priority security patches and{" "}
            <span
              class="mp-term"
              data-term-monthly="updates"
              data-term-perpetual="updates for the purchased version"
              >updates</span
            >
          </li>
          <li class="mp-inherit">
            No limits: unlimited devices, messages, and features
          </li>
          <li class="mp-excl">Support not included; purchased separately</li>
        </ul>
        <a class="ie-button" href="/contact/?product=Magistrala&plan=License"
          >Get a license <ArrowUpRight size={18} /></a
        >
      </article>
      <article class="mp-tier">
        <div class="mp-tier-head">
          <span class="ip-kicker">Managed by us</span>
        </div>
        <div class="mp-price"><strong>Contact</strong></div>
        <p class="mp-goodfor">
          We deploy and operate Magistrala Enterprise on your infrastructure,
          aligned to your SLA, security, and data policies.
        </p>
        <ul class="ip-list mp-feats">
          <li class="mp-inherit">Everything in License only, plus:</li>
          <li>Deployed on your infrastructure</li>
          <li>Your SLA and uptime targets</li>
          <li>Your security and data-residency policies</li>
          <li>Compliance and certification support</li>
          <li>Operated, monitored, and updated by our team</li>
        </ul>
        <a
          class="ie-button ie-button-white"
          href="/contact/?product=Magistrala&plan=Managed"
          >Contact us <ArrowUpRight size={18} /></a
        >
      </article>
    </div>
  </div>

  <!-- Compare editions -->
  <div class="mp-compare">
    <div class="ip-heading">
      <div>
        <p class="ie-eyebrow">Editions and plans</p>
        <h2>Community and<br /><span>Private Cloud, compared.</span></h2>
      </div>
      <p>
        Limits are purely hardware- and setup-related. Capacity figures are soft
        guidance, not hard limits.
      </p>
    </div>
    <div class="ip-table-wrap">
      <table class="ip-table mp-table">
        <thead>
          <tr>
            <th scope="col">Feature</th>
            {compareCols.map((col) => <th scope="col">{col}</th>)}
          </tr>
        </thead>
        <tbody>
          {
            compareGroups.map((group) => (
              <>
                <tr class="mp-group">
                  <th scope="colgroup" colspan={compareCols.length + 1}>
                    {group.group}
                  </th>
                </tr>
                {group.rows.map((row) => (
                  <tr>
                    <th scope="row">
                      {row.f}
                      {"note" in row && " *"}
                    </th>
                    {row.cells.map((cell) => (
                      <td>
                        {typeof cell === "boolean" ? (
                          cell ? (
                            <Check
                              class="mp-yes"
                              size={18}
                              aria-label="Included"
                            />
                          ) : (
                            <Minus
                              class="mp-no"
                              size={18}
                              aria-label="Not included"
                            />
                          )
                        ) : (
                          cell
                        )}
                      </td>
                    ))}
                  </tr>
                ))}
              </>
            ))
          }
        </tbody>
      </table>
    </div>
    <p class="ip-table-note">
      * We never impose artificial caps. A formal uptime SLA and
      high-availability clustering are available on the Custom plan only. No
      license keys, no activation, no phone-home: we do not lock your deployment
      or track your activity, so your data never leaves the deployments you
      choose.
    </p>
  </div>

  <!-- FAQ -->
  <div class="mp-faq">
    <div class="ip-heading">
      <div>
        <p class="ie-eyebrow">Pricing FAQ</p>
        <h2>Questions about<br /><span>plans and billing.</span></h2>
      </div>
      <a class="text-link" href="/contact/?product=Magistrala"
        >Ask us directly <ArrowRight size={18} /></a
      >
    </div>
    <Faq items={pricingFaqs} />
  </div>
</section>

<script>
  const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);

  const tabs = document.querySelectorAll<HTMLButtonElement>(".mp-tab");
  const panels = document.querySelectorAll<HTMLElement>(".mp-panel");
  tabs.forEach((tab) =>
    tab.addEventListener("click", () => {
      const name = tab.dataset.tab;
      tabs.forEach((t) =>
        t.setAttribute("aria-selected", String(t.dataset.tab === name)),
      );
      panels.forEach((panel) => {
        panel.hidden = panel.dataset.panel !== name;
      });
    }),
  );

  document.querySelectorAll<HTMLElement>(".mp-toggle").forEach((toggle) => {
    const options =
      toggle.querySelectorAll<HTMLButtonElement>(".mp-toggle-opt");
    const scope: ParentNode = toggle.closest(".mp-panel") ?? document;
    options.forEach((option) =>
      option.addEventListener("click", () => {
        const mode = option.dataset.billing ?? "monthly";
        options.forEach((o) =>
          o.setAttribute("aria-pressed", String(o === option)),
        );
        scope.querySelectorAll<HTMLElement>(".mp-amount").forEach((el) => {
          const value = el.dataset[`amt${cap(mode)}`];
          if (value !== undefined) el.textContent = `€${value}`;
        });
        scope.querySelectorAll<HTMLElement>(".mp-price-note").forEach((el) => {
          const value = el.dataset[`note${cap(mode)}`];
          if (value !== undefined) el.textContent = value;
        });
        scope.querySelectorAll<HTMLElement>(".mp-term").forEach((el) => {
          const value = el.dataset[`term${cap(mode)}`];
          if (value !== undefined) el.textContent = value;
        });
      }),
    );
  });
</script>

<style>
  .mp-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding-bottom: 21px;
    border-bottom: 1px solid var(--am-line);
  }
  .mp-tab {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    min-height: 48px;
    padding: 12px 18px;
    background: transparent;
    border: 1px solid transparent;
    color: var(--am-muted);
    font-size: 15px;
    transition:
      background 0.2s,
      color 0.2s;
  }
  .mp-tab:hover {
    background: #edf3f7;
    color: var(--am-navy);
  }
  .mp-tab[aria-selected="true"] {
    background: var(--am-navy);
    border-color: var(--am-navy);
    color: #fff;
  }
  .mp-tab-note {
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    opacity: 0.7;
  }
  .mp-intro {
    max-width: 560px;
    margin-top: 36px;
    font-size: 17px;
    line-height: 1.7;
    color: var(--am-muted);
  }
