---
const pathname = Astro.url.pathname;

const isActive = (href: string) => {
  if (href === "/") return pathname === "/";
  return pathname.startsWith(href);
};

const products = [
  {
    group: "Software",
    items: [
      {
        label: "Magistrala",
        desc: "IoT Platform",
        href: "/products/magistrala",
      },
      { label: "FluxMQ", desc: "Message Broker", href: "/products/fluxmq" },
      {
        label: "Propeller",
        desc: "Wasm Orchestrator",
        href: "/products/propeller",
      },
    ],
  },
  {
    group: "Hardware",
    items: [
      { label: "S0", desc: "Edge Gateway", href: "/products/s0" },
      { label: "S1", desc: "Industrial Gateway", href: "/products/s1" },
    ],
  },
];

const solutions = [
  { label: "Smart Water Metering", href: "/solutions/smart-water" },
  { label: "Smart City", href: "/solutions/smart-city" },
  { label: "Smart Energy", href: "/solutions/smart-energy" },
  { label: "Cold Storage", href: "/solutions/cold-storage" },
  { label: "Smart Farming", href: "/solutions/smart-farming" },
  { label: "Oil & Gas", href: "/solutions/oil-gas" },
  { label: "Smart Irrigation", href: "/solutions/smart-irrigation" },
  { label: "Air Quality", href: "/solutions/air-quality" },
];

const projects = [
  { label: "ELASTIC", href: "/projects/elastic" },
  { label: "Confidential 6G", href: "/projects/confidential6g" },
];

const plainLinks = [
  { label: "Services", href: "/services" },
  { label: "Company", href: "/company" },
  { label: "Blog", href: "/blog" },
];
---

<nav class="site-nav" aria-label="Main navigation">
  <div class="site-nav-inner">
    <a href="/" class="brand" aria-label="Abstract Machines home">
      <img
        src="/img/logos/abstract-machines_logo_landscape-black.png"
        alt="Abstract Machines"
        width="149"
        height="22"
      />
    </a>

    <ul class="nav-links" role="list">
      <!-- Products dropdown -->
      <li class="nav-item has-dropdown">
        <a href="/products" class={isActive("/products") ? "active" : ""}>
          Products
          <svg
            class="nav-chevron"
            width="10"
            height="6"
            viewBox="0 0 10 6"
            fill="none"
            aria-hidden="true"
          >
            <path
              d="M1 1l4 4 4-4"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </a>
        <div class="nav-dropdown dropdown-products">
          {
            products.map(({ group, items }) => (
              <div class="dropdown-group">
                <div class="dropdown-group-label">{group}</div>
                {items.map(({ label, desc, href }) => (
                  <a
                    href={href}
                    class={`dropdown-item${isActive(href) ? " active" : ""}`}
                  >
                    <span class="dropdown-name">{label}</span>
                    <span class="dropdown-desc">{desc}</span>
                  </a>
                ))}
              </div>
            ))
          }
        </div>
      </li>

      <!-- Solutions dropdown -->
      <li class="nav-item has-dropdown">
        <a href="/solutions" class={isActive("/solutions") ? "active" : ""}>
          Solutions
          <svg
            class="nav-chevron"
            width="10"
            height="6"
            viewBox="0 0 10 6"
            fill="none"
            aria-hidden="true"
          >
            <path
              d="M1 1l4 4 4-4"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </a>
        <div class="nav-dropdown dropdown-solutions">
          {
            solutions.map(({ label, href }) => (
              <a
                href={href}
                class={`dropdown-item${isActive(href) ? " active" : ""}`}
              >
                <span class="dropdown-name">{label}</span>
              </a>
            ))
          }
        </div>
      </li>

      <!-- Services (plain) -->
      <li>
        <a href="/services" class={isActive("/services") ? "active" : ""}
          >Services</a
        >
      </li>

      <!-- Projects dropdown -->
      <li class="nav-item has-dropdown">
        <a href="/projects" class={isActive("/projects") ? "active" : ""}>
          Projects
          <svg
            class="nav-chevron"
            width="10"
            height="6"
            viewBox="0 0 10 6"
            fill="none"
            aria-hidden="true"
          >
            <path
              d="M1 1l4 4 4-4"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </a>
        <div class="nav-dropdown dropdown-projects">
          {
            projects.map(({ label, href }) => (
              <a
                href={href}
                class={`dropdown-item${isActive(href) ? " active" : ""}`}
              >
                <span class="dropdown-name">{label}</span>
              </a>
            ))
          }
        </div>
      </li>

      <!-- Plain links -->
      {
        plainLinks.map(({ label, href }) => (
          <li>
            <a href={href} class={isActive(href) ? "active" : ""}>
              {label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="nav-actions">
      <a
        href="https://github.com/absmach"
        class="btn"
        target="_blank"
        rel="noopener noreferrer"
        style="padding:8px 14px; font-size:13px;"
      >
        GitHub ↗
      </a>
      <a
        href="/contact"
        class="btn btn-primary"
        style="padding:8px 14px; font-size:13px;"
      >
        Contact us
      </a>
      <button
        class="nav-hamburger"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-nav-drawer"
        id="nav-hamburger-btn"
      >
        <svg
          width="22"
          height="22"
          viewBox="0 0 22 22"
          fill="none"
          aria-hidden="true"
        >
          <path
            d="M3 6h16M3 11h16M3 16h16"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"></path>
        </svg>
      </button>
    </div>
  </div>
</nav>

<!-- Mobile drawer -->
<div
  class="nav-drawer"
  id="mobile-nav-drawer"
  role="dialog"
  aria-modal="true"
  aria-label="Site navigation"
>
  <div class="nav-drawer-backdrop" id="nav-drawer-backdrop"></div>
  <div class="nav-drawer-panel">
    <button
      class="nav-drawer-close"
      aria-label="Close menu"
      id="nav-drawer-close">✕</button
    >

    <!-- Products -->
    <details class="nav-drawer-section">
      <summary class="nav-drawer-link nav-drawer-summary">Products</summary>
      <div class="nav-drawer-sub">
        <a href="/products" class="nav-drawer-sublink nav-drawer-sublink-all"
          >All Products →</a
        >
        {
          products.map(({ group, items }) => (
            <>
              <div class="nav-drawer-sub-group">{group}</div>
              {items.map(({ label, desc, href }) => (
                <a href={href} class="nav-drawer-sublink">
                  {label} <span class="nav-drawer-subdesc">— {desc}</span>
                </a>
              ))}
            </>
          ))
        }
      </div>
    </details>

    <!-- Solutions -->
    <details class="nav-drawer-section">
      <summary class="nav-drawer-link nav-drawer-summary">Solutions</summary>
      <div class="nav-drawer-sub">
        <a href="/solutions" class="nav-drawer-sublink nav-drawer-sublink-all"
          >All Solutions →</a
        >
        {
          solutions.map(({ label, href }) => (
            <a href={href} class="nav-drawer-sublink">
              {label}
            </a>
          ))
        }
      </div>
    </details>

    <a href="/services" class="nav-drawer-link">Services</a>

    <!-- Projects -->
    <details class="nav-drawer-section">
      <summary class="nav-drawer-link nav-drawer-summary">Projects</summary>
      <div class="nav-drawer-sub">
        <a href="/projects" class="nav-drawer-sublink nav-drawer-sublink-all"
          >All Projects →</a
        >
        {
          projects.map(({ label, href }) => (
            <a href={href} class="nav-drawer-sublink">
              {label}
            </a>
          ))
        }
      </div>
    </details>

    {
      plainLinks.map(({ label, href }) => (
        <a href={href} class="nav-drawer-link">
          {label}
        </a>
      ))
    }

    <div class="nav-drawer-actions">
      <a
        href="https://github.com/absmach"
        class="btn"
        target="_blank"
        rel="noopener noreferrer">GitHub ↗</a
      >
      <a href="/contact" class="btn btn-primary">Contact us</a>
    </div>
  </div>
</div>

<style>
  /* ── Dropdown trigger ───────────────────────────────────── */
  .nav-item {
    position: relative;
  }
  .nav-item > a {
    display: flex;
    align-items: center;
    gap: 4px;
  }
  .nav-chevron {
    transition: transform 0.2s ease;
    flex-shrink: 0;
  }
  .nav-item:hover .nav-chevron,
  .nav-item:focus-within .nav-chevron {
    transform: rotate(180deg);
  }

  /* ── Dropdown panel ─────────────────────────────────────── */
  .nav-dropdown {
    position: absolute;
    top: calc(100% + 10px);
    left: 50%;
    translate: -50% -6px;
    background: var(--paper);
    border: 1px solid var(--line-3);
    border-radius: var(--radius);
    box-shadow:
      0 12px 40px -8px rgba(0, 0, 0, 0.12),
      0 2px 8px -2px rgba(0, 0, 0, 0.06);
    padding: 8px;
    opacity: 0;
    pointer-events: none;
    transition:
      opacity 0.15s ease,
      translate 0.15s ease;
    z-index: 200;
  }
  /* Invisible bridge fills the gap between the link and the panel */
  .nav-dropdown::before {
    content: "";
    position: absolute;
    top: -10px;
    left: 0;
    right: 0;
    height: 10px;
  }
  .nav-item:hover .nav-dropdown,
  .nav-item:focus-within .nav-dropdown {
    opacity: 1;
    pointer-events: auto;
    translate: -50% 0;
  }

  /* Products: two groups side by side */
  .dropdown-products {
    display: flex;
    gap: 4px;
    min-width: 360px;
  }
  .dropdown-group {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .dropdown-group-label {
    font-family: "JetBrains Mono", monospace;
    font-size: 10px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--ink-4);
    padding: 6px 10px 4px;
  }

  /* Solutions: 2-col grid */
  .dropdown-solutions {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2px;
    min-width: 340px;
  }

  /* Projects: simple list */
  .dropdown-projects {
    min-width: 200px;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  /* Dropdown items */
  .dropdown-item {
    display: flex;
    flex-direction: column;
    gap: 1px;
    padding: 8px 10px;
    border-radius: calc(var(--radius) - 4px);
    text-decoration: none;
    transition: background 0.1s ease;
  }
  .dropdown-item:hover {
    background: var(--paper-2);
  }
  .dropdown-item.active .dropdown-name {
    font-weight: 600;
    color: var(--ink);
  }
  .dropdown-name {
    font-size: 13px;
    font-weight: 500;
    color: var(--ink);
    line-height: 1.3;
  }
  .dropdown-desc {
    font-size: 11px;
    color: var(--ink-3);
    font-family: "JetBrains Mono", monospace;
  }

  /* ── Mobile drawer additions ────────────────────────────── */
  .nav-drawer-section {
    border: none;
    background: none;
  }
  .nav-drawer-summary {
    cursor: pointer;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .nav-drawer-summary::-webkit-details-marker {
    display: none;
  }
  .nav-drawer-summary::after {
    content: "+";
    font-family: "JetBrains Mono", monospace;
    font-size: 16px;
    color: var(--ink-3);
    flex-shrink: 0;
  }
  .nav-drawer-section[open] .nav-drawer-summary::after {
    content: "−";
  }
  .nav-drawer-sub {
    display: flex;
    flex-direction: column;
    padding: 4px 0 8px 16px;
    border-left: 2px solid var(--line-3);
    margin-left: 4px;
    gap: 2px;
  }
  .nav-drawer-sublink {
    font-size: 14px;
    color: var(--ink-2);
    text-decoration: none;
    padding: 6px 8px;
    border-radius: var(--radius-sm);
    display: block;
  }
  .nav-drawer-sublink:hover {
    color: var(--ink);
    background: var(--paper-2);
  }
  .nav-drawer-sublink-all {
    font-size: 12px;
    font-family: "JetBrains Mono", monospace;
    color: var(--ink-3);
    margin-bottom: 4px;
  }
  .nav-drawer-sub-group {
    font-family: "JetBrains Mono", monospace;
    font-size: 10px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--ink-4);
    padding: 8px 8px 2px;
  }
  .nav-drawer-subdesc {
    color: var(--ink-3);
    font-size: 12px;
  }
</style>

<script is:inline>
  (() => {
    const btn = document.getElementById("nav-hamburger-btn");
    const drawer = document.getElementById("mobile-nav-drawer");
    const backdrop = document.getElementById("nav-drawer-backdrop");
    const closeBtn = document.getElementById("nav-drawer-close");
    if (!btn || !drawer) return;

    const open = () => {
      drawer.classList.add("open");
      btn.setAttribute("aria-expanded", "true");
      document.documentElement.style.overflow = "hidden";
    };
    const close = () => {
      drawer.classList.remove("open");
      btn.setAttribute("aria-expanded", "false");
      document.documentElement.style.overflow = "";
    };

    btn.addEventListener("click", open);
    closeBtn?.addEventListener("click", close);
    backdrop?.addEventListener("click", close);
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") close();
    });

    // Close on non-summary link click
    drawer
      .querySelectorAll("a")
      .forEach((a) => a.addEventListener("click", close));

    const mq = window.matchMedia("(min-width: 981px)");
    mq.addEventListener("change", (e) => {
      if (e.matches) close();
    });
  })();
</script>
