---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import FinalCTA from "../components/FinalCTA.astro";

const glance = [
  { label: "Founded", value: "2023" },
  { label: "Headquarters", value: "Paris, France" },
  {
    label: "Open source",
    value: "github.com/absmach",
    href: "https://github.com/absmach",
  },
  { label: "Research", value: "EU Horizon Europe", href: "/projects/" },
];

const values = [
  {
    ic: "⊞",
    title: "Open Source First",
    desc: "We build in public, contribute back, and believe transparency creates better software. Our entire stack is open source, not just the parts that are convenient.",
  },
  {
    ic: "⬡",
    title: "Security by Design",
    desc: "Security is a first-class requirement, not a feature bolted on later. From mTLS to confidential computing, we build it in from the start.",
  },
  {
    ic: "◈",
    title: "Innovation at the Edge",
    desc: "We push the frontier of distributed systems, IoT, and edge computing through production work and EU research programmes.",
  },
  {
    ic: "◉",
    title: "Pragmatic Excellence",
    desc: "Production-ready quality, delivered with engineering discipline. We ship systems that work at Nokia, Intel, and Ericsson scale.",
  },
];

const team = [
  {
    count: "10+",
    role: "Engineering",
    desc: "Expert developers building high-performance distributed systems",
  },
  {
    count: "2+",
    role: "Research",
    desc: "PhDs and researchers advancing IoT and edge computing",
  },
  {
    count: "4+",
    role: "Solutions",
    desc: "Architects and consultants delivering customer success",
  },
];
---

<BaseLayout
  title="Company — Abstract Machines"
  description="Abstract Machines is an open-source infrastructure company building secure IoT and edge computing systems. Based in Paris, founded 2023."
>
  <Header />
  <main>
    <!-- Hero -->
    <section class="comp-hero">
      <div class="container-wide">
        <div class="hero-grid">
          <div class="hero-left">
            <span class="kicker">Company</span>
            <h1 class="h-1" style="margin-top:10px;">
              Building open infrastructure<br />for a connected world.
            </h1>
            <p class="lede" style="margin-top:16px; max-width:520px;">
              Abstract Machines is an open-source infrastructure company based
              in Paris. We build secure, scalable systems for IoT and edge
              computing, used in production by enterprises, researchers, and
              innovators across Europe and beyond.
            </p>
            <div class="btn-row" style="margin-top:28px;">
              <a href="/contact/" class="btn btn-primary">Get in touch</a>
              <a href="/projects/" class="btn">Explore research</a>
            </div>
          </div>
          <div class="hero-right">
            <div class="glance-card card">
              <div class="glance-label">At a glance</div>
              <div class="glance-list">
                {
                  glance.map(({ label, value, href }) => (
                    <div class="glance-row">
                      <span class="glance-key">{label}</span>
                      <span class="glance-val">
                        {href ? (
                          <a
                            href={href}
                            target={
                              href.startsWith("http") ? "_blank" : undefined
                            }
                            rel={
                              href.startsWith("http")
                                ? "noopener noreferrer"
                                : undefined
                            }
                          >
                            {value}
                          </a>
                        ) : (
                          value
                        )}
                      </span>
                    </div>
                  ))
                }
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Metrics bar -->
    <section
      class="section-tight"
      style="background:var(--ink); color:var(--paper); border-top:1px solid var(--line-3);"
    >
      <div class="container-wide">
        <div class="comp-metrics">
          <div class="comp-metric">
            <div class="h-2" style="color:var(--paper);">2023</div>
            <div class="comp-metric-label">Founded</div>
          </div>
          <div class="comp-metric">
            <div class="h-2" style="color:var(--paper);">400+</div>
            <div class="comp-metric-label">Production deployments</div>
          </div>
          <div class="comp-metric">
            <div class="h-2" style="color:var(--paper);">13+</div>
            <div class="comp-metric-label">Global partners</div>
          </div>
          <div class="comp-metric" style="border-right:none;">
            <div class="h-2" style="color:var(--paper);">2</div>
            <div class="comp-metric-label">EU research projects</div>
          </div>
        </div>
      </div>
    </section>

    <!-- Mission -->
    <section
      style="background:var(--paper-2); border-bottom:1px solid var(--line-3);"
    >
      <div class="container-narrow" style="text-align:center;">
        <span class="kicker">Our mission</span>
        <h2 class="h-2" style="margin-top:10px;">Why we exist</h2>
        <blockquote class="mission-quote">
          To democratize access to enterprise-grade infrastructure through
          open-source innovation, enabling organisations of all sizes to build
          secure, scalable distributed systems without starting from scratch.
        </blockquote>
      </div>
    </section>

    <!-- Values -->
    <section>
      <div class="container-wide">
        <div class="section-head">
          <div class="left">
            <span class="kicker">Values</span>
            <h2 class="h-2" style="margin-top:10px;">What drives us</h2>
            <p class="lede" style="margin-top:10px;">
              Core principles guiding every line of code we ship.
            </p>
          </div>
        </div>
        <div class="val-grid" style="margin-top:36px;">
          {
            values.map((v) => (
              <div class="card">
                <div class="val-icon">{v.ic}</div>
                <h3 class="h-3" style="margin-top:16px;">
                  {v.title}
                </h3>
                <p style="margin-top:8px; font-size:14px; color:var(--ink-2); line-height:1.65;">
                  {v.desc}
                </p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Team -->
    <section
      style="background:var(--paper-2); border-top:1px solid var(--line-3); border-bottom:1px solid var(--line-3);"
    >
      <div class="container-wide">
        <div class="section-head">
          <div class="left">
            <span class="kicker">Team</span>
            <h2 class="h-2" style="margin-top:10px;">Expert and distributed</h2>
            <p class="lede" style="margin-top:10px;">
              Spread across the world, united by mission.
            </p>
          </div>
        </div>
        <div class="team-grid" style="margin-top:36px;">
          {
            team.map((t) => (
              <div class="card" style="text-align:center;">
                <div
                  class="h-1"
                  style="color:var(--ink); letter-spacing:-1px;"
                >
                  {t.count}
                </div>
                <h3 class="h-3" style="margin-top:8px;">
                  {t.role}
                </h3>
                <p style="margin-top:8px; font-size:13px; color:var(--ink-2); line-height:1.6;">
                  {t.desc}
                </p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Location -->
    <section>
      <div class="container-wide">
        <div class="section-head">
          <div class="left">
            <span class="kicker">Location</span>
            <h2 class="h-2" style="margin-top:10px;">Based in Paris</h2>
            <p class="lede" style="margin-top:10px;">
              Working with clients and partners across Europe and globally.
            </p>
          </div>
        </div>
        <div class="loc-grid" style="margin-top:36px;">
          <div class="card">
            <div class="loc-item">
              <div class="loc-icon">◎</div>
              <div>
                <div
                  style="font-weight:600; font-size:14px; margin-bottom:4px;"
                >
                  Address
                </div>
                <div
                  style="font-size:14px; color:var(--ink-2); line-height:1.6;"
                >
                  141 Quai de Valmy<br />75010 Paris, France
                </div>
              </div>
            </div>
            <div class="loc-item" style="margin-top:20px;">
              <div class="loc-icon">✉</div>
              <div>
                <div
                  style="font-weight:600; font-size:14px; margin-bottom:4px;"
                >
                  Email
                </div>
                <a
                  href="mailto:info@absmach.eu"
                  style="font-size:14px; color:var(--ink-2);"
                  >info@absmach.eu</a
                >
              </div>
            </div>
            <div
              style="margin-top:24px; display:flex; gap:10px; flex-wrap:wrap;"
            >
              <a href="/contact/" class="btn" style="font-size:13px;"
                >Send a message</a
              >
              <a
                href="https://github.com/absmach"
                target="_blank"
                rel="noopener noreferrer"
                class="btn"
                style="font-size:13px;">GitHub ↗</a
              >
            </div>
          </div>
          <div class="card" style="overflow:hidden; padding:0;">
            <iframe
              title="Abstract Machines office in Paris"
              class="loc-map"
              src="https://www.google.com/maps?q=141+Quai+de+Valmy+75010+Paris+France&output=embed"
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              allowfullscreen></iframe>
          </div>
        </div>
      </div>
    </section>

    <FinalCTA
      title="Join our mission"
      subtitle="We're always looking for talented people who share our values, and for organisations ready to build with open-source infrastructure."
      primary={{ label: "View openings", href: "/careers/" }}
      secondary={{ label: "Get in touch", href: "/contact/" }}
    />
  </main>
  <Footer />
</BaseLayout>

<style>
  /* ── Hero ──────────────────────────────────────────────────── */
  .comp-hero {
    padding: 64px 0 56px;
    border-bottom: 1px solid var(--line-3);
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 56px;
    align-items: start;
  }
  .hero-left {
    display: flex;
    flex-direction: column;
  }

  /* ── At a glance card ───────────────────────────────────────── */
  .glance-card {
    padding: 24px;
  }
  .glance-label {
    font-family: "JetBrains Mono", monospace;
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--ink-3);
    margin-bottom: 16px;
  }
  .glance-list {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .glance-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    background: var(--paper-2);
    border: 1px solid var(--line-3);
    border-radius: var(--radius-sm);
    padding: 10px 14px;
  }
  .glance-key {
    font-family: "JetBrains Mono", monospace;
    font-size: 10px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--ink-3);
  }
  .glance-val {
    font-size: 13px;
    font-weight: 600;
    text-align: right;
  }
  .glance-val a {
    color: var(--ink-2);
    text-decoration: none;
  }
  .glance-val a:hover {
    text-decoration: underline;
  }

  /* ── Metrics bar ────────────────────────────────────────────── */
  .comp-metrics {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border: 1px solid rgba(246, 244, 238, 0.15);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .comp-metric {
    padding: 32px;
    border-right: 1px solid rgba(246, 244, 238, 0.15);
  }
  .comp-metric-label {
    margin-top: 4px;
    font-size: 13px;
    color: rgba(246, 244, 238, 0.55);
  }

  /* ── Mission ────────────────────────────────────────────────── */
  .mission-quote {
    margin: 28px auto 0;
    max-width: 680px;
    font-size: 18px;
    line-height: 1.7;
    color: var(--ink-2);
    font-style: normal;
    quotes: none;
  }

  /* ── Values ─────────────────────────────────────────────────── */
  .val-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
  }
  .val-icon {
    width: 40px;
    height: 40px;
    border-radius: var(--radius-sm);
    background: var(--paper-2);
    border: 1px solid var(--line-3);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 16px;
    color: var(--ink-3);
  }

  /* ── Team ───────────────────────────────────────────────────── */
  .team-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }

  /* ── Location ───────────────────────────────────────────────── */
  .loc-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    align-items: start;
  }
  .loc-item {
    display: flex;
    gap: 14px;
    align-items: flex-start;
  }
  .loc-icon {
    width: 36px;
    height: 36px;
    border-radius: var(--radius-sm);
    background: var(--paper-2);
    border: 1px solid var(--line-3);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 14px;
    color: var(--ink-2);
    flex-shrink: 0;
  }
  .loc-map {
    width: 100%;
    aspect-ratio: 4 / 3;
    border: none;
    display: block;
  }

  /* ── Responsive ─────────────────────────────────────────────── */
  @media (max-width: 980px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .val-grid {
      grid-template-columns: 1fr;
    }
    .loc-grid {
      grid-template-columns: 1fr;
    }
    .comp-metrics {
      grid-template-columns: repeat(2, 1fr);
    }
    .comp-metric:nth-child(2) {
      border-right: none;
    }
    .comp-metric:nth-child(3) {
      border-top: 1px solid rgba(246, 244, 238, 0.15);
    }
    .comp-metric:nth-child(4) {
      border-top: 1px solid rgba(246, 244, 238, 0.15);
    }
  }
  @media (max-width: 600px) {
    .team-grid {
      grid-template-columns: 1fr;
    }
    .comp-metrics {
      grid-template-columns: 1fr 1fr;
    }
    .val-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
