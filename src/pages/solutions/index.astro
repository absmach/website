---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { solutions } from "../../data/solutions";
---

<BaseLayout
  title="Solutions — Abstract Machines"
  description="Industry-specific IoT solution packs for water, energy, cities, agriculture, and more. Pre-built dashboards, rules, and alerts — powered by Magistrala."
>
  <Header />
  <main>
    <!-- Hero -->
    <section class="page-hero">
      <div class="container-wide">
        <span class="kicker">Solutions</span>
        <h1 class="h-1" style="margin-top:14px; max-width:18ch;">Pick a solution. Deploy in minutes.</h1>
        <p class="lede" style="margin-top:20px; max-width:52ch;">
          Pre-configured solution packs built on Magistrala. Pre-wired
          dashboards, detection rules, and compliance reports, ready to deploy
          in minutes, not months.
        </p>
      </div>
    </section>

    <!-- Solutions grid -->
    <section>
      <div class="container-wide">
        <div class="sol-img-grid">
          {
            solutions.map((sol) => (
              <a href={`/solutions/${sol.slug}/`} class="sol-img-card">
                <div class="sol-img-wrap">
                  <img
                    src={sol.image}
                    alt={`${sol.title} dashboard preview`}
                    loading="lazy"
                    decoding="async"
                  />
                </div>
                <div class="sol-img-body">
                  <h2 class="sol-img-title">{sol.title}</h2>
                  <p class="sol-img-desc">{sol.summary}</p>
                  <span
                    class="btn-link"
                    style="font-size:13px; margin-top:auto;"
                  >
                    Explore solution →
                  </span>
                </div>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Proof bar -->
    <section
      class="section-tight"
      style="background:var(--ink); color:var(--paper); border-top:1px solid var(--line-3);"
    >
      <div class="container-wide">
        <div style="display:grid; grid-template-columns:repeat(3,1fr); gap:0; border:1px solid rgba(246,244,238,.15); border-radius:var(--radius); overflow:hidden;">
          <div style="padding:32px; border-right:1px solid rgba(246,244,238,.15);">
            <div class="h-2" style="color:var(--paper);">400+</div>
            <div style="margin-top:4px; font-size:13px; color:rgba(246,244,238,.55);">
              Production deployments
            </div>
          </div>
          <div style="padding:32px; border-right:1px solid rgba(246,244,238,.15);">
            <div class="h-2" style="color:var(--paper);">8</div>
            <div style="margin-top:4px; font-size:13px; color:rgba(246,244,238,.55);">
              Industry verticals
            </div>
          </div>
          <div style="padding:32px;">
            <div class="h-2" style="color:var(--paper);">Minutes</div>
            <div style="margin-top:4px; font-size:13px; color:rgba(246,244,238,.55);">
              Time-to-first-dashboard
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="section-tight">
      <div class="container-narrow" style="text-align:center;">
        <h2 class="h-2">Don't see your industry?</h2>
        <p class="lede" style="margin-top:12px;">
          Our team builds custom solution packs. Bring your requirements and
          we'll scope a deployment together.
        </p>
        <div class="btn-row" style="margin-top:28px; justify-content:center;">
          <a href="/contact/" class="btn btn-primary">Talk to us</a>
          <a href="/services/" class="btn">View services</a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .sol-img-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }

  .sol-img-card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--line-3);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--paper);
    text-decoration: none;
    color: inherit;
    transition:
      border-color 0.2s ease,
      box-shadow 0.2s ease,
      transform 0.2s ease;
  }
  .sol-img-card:hover {
    border-color: var(--line-2);
    box-shadow: var(--shadow);
    transform: translateY(-3px);
  }

  .sol-img-wrap {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--paper-2);
  }
  .sol-img-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    transition: transform 0.4s ease;
  }
  .sol-img-card:hover .sol-img-wrap img {
    transform: scale(1.04);
  }

  .sol-img-body {
    padding: 20px 20px 24px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    flex: 1;
  }
  .sol-img-title {
    font-family: "Montserrat", sans-serif;
    font-weight: 600;
    font-size: 15px;
    letter-spacing: 0;
    line-height: 1.3;
  }
  .sol-img-desc {
    font-size: 13px;
    color: var(--ink-2);
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (max-width: 1100px) {
    .sol-img-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media (max-width: 760px) {
    .sol-img-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 500px) {
    .sol-img-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
