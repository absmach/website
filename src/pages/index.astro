---
import {
  ArrowUpRight,
  ArrowRight,
  ArrowDown,
  Play,
  Pause,
} from "@lucide/astro";
import IdentityLayout from "../layouts/IdentityLayout.astro";
import ProductVisual from "../components/identity/ProductVisual.astro";
import AssociationMembership from "../components/identity/AssociationMembership.astro";
import EngineeringStories from "../components/identity/EngineeringStories.astro";
import { products } from "../data/identity-products";
import { stories } from "../data/identity-stories";

const atomic = products.find((product) => product.slug === "atomic")!;
const synth = products.find((product) => product.slug === "synth")!;
const featuredStories = stories.filter((story) =>
  ["nokia", "intel"].includes(story.slug),
);
const portfolioCategories = [
  {
    label: "AI & applications",
    value: "ai",
    products: products.filter((product) => product.group === "AI"),
  },
  {
    label: "Infrastructure",
    value: "infrastructure",
    products: products.filter((product) => product.group === "Infrastructure"),
  },
  {
    label: "Hardware",
    value: "hardware",
    products: products.filter((product) => product.group === "Hardware"),
  },
];
---

<IdentityLayout
  title="Intelligence. Engineered."
  headerTone="overlay"
  description="AI products, applied research, and secure connected systems. Discover the work of Abstract Machines."
>
  <section class="hero" aria-labelledby="hero-title">
    <video
      id="hero-video"
      class="hero-video"
      muted
      loop
      playsinline
      preload="none"
      poster="/preview/ai/media/hero-poster.webp"
      aria-hidden="true"
      tabindex="-1"
    >
      <source data-src="/preview/ai/media/hero-video.mp4" type="video/mp4" />
    </video>
    <div class="hero-shade" aria-hidden="true"></div>
    <div class="hero-topline">
      <span>APPLIED AI / ABSTRACT MACHINES</span><span
        >EUROPEAN ROOTS. OPEN HORIZONS.</span
      >
    </div>
    <div class="hero-content">
      <div class="hero-copy">
        <p class="hero-kicker">
          <span></span> A new chapter in engineering
        </p><h1 id="hero-title">
          Intelligence.<br /><span>Engineered.</span>
        </h1>
      </div>
      <div class="hero-aside">
        <p>
          AI products. Applied research. The infrastructure to bring ambitious
          ideas to life.
        </p><a class="button button-white" href="#selected-work"
          >Discover our work <ArrowUpRight size={20} /></a
        >
      </div>
    </div>
    <div class="hero-footer">
      <a href="#approach" class="scroll-cue"
        ><span class="circle-arrow"><ArrowDown size={18} /></span> Explore Abstract
        Machines</a
      ><div class="hero-film">
        <span>Ideas need foundations.</span><button
          id="video-toggle"
          aria-label="Play background video"
          hidden
          ><Play class="play-icon" size={16} /><Pause
            class="pause-icon"
            size={16}
          /></button
        >
      </div>
    </div>
    <div class="film-progress" aria-hidden="true">
      <span id="film-progress"></span>
    </div>
  </section>
  <div class="dispatch">
    <span class="dispatch-label">IN FOCUS <span class="live-dot"></span></span
    ><a href="/products/synth/"
      ><span
        >Synth: a new way to design circuit boards, built for engineers and AI
        agents.</span
      ><span class="dispatch-cta"
        >Explore the work <ArrowUpRight size={17} /></span
      ></a
    >
  </div>

  <section
    id="approach"
    class="intro section-shell"
    aria-labelledby="intro-title"
  >
    <div class="section-label">
      <span class="label-line"></span> THE NEXT ABSTRACT MACHINES
    </div>
    <div class="intro-grid">
      <h2 id="intro-title">
        A new era of work.<br /><span>Built on sound<br />engineering.</span>
      </h2><div class="intro-copy">
        <p class="lead">
          Intelligence becomes valuable when it can do something useful.
        </p><p>
          We build the products and infrastructure that put AI to work. From
          creating software and designing electronics to exploring complex
          systems, we bring research and engineering together.
        </p><a class="text-link" href="/products/"
          >Explore our world <ArrowUpRight size={20} /></a
        >
      </div>
    </div>
    <div class="focus-stories">
      <a class="focus-story story-wide" href="#selected-work"
        ><img
          src="/preview/ai/media/collaboration.webp"
          alt="People collaborating around a table with laptops"
          width="1600"
          height="1067"
          loading="lazy"
        /><div class="story-shade"></div><div class="story-top">
          <span>01 / APPLICATIONS</span><span class="story-arrow"
            ><ArrowUpRight size={22} /></span
          >
        </div><div class="story-copy">
          <h3>More room<br />for human ambition.</h3><p>
            AI tools for the way we create and work.
          </p>
        </div></a
      >
      <a class="focus-story story-narrow" href="/products/?focus=infrastructure"
        ><img
          src="/preview/ai/media/architecture.webp"
          alt="A geometric facade of folded blue glass"
          width="1600"
          height="900"
          loading="lazy"
        /><div class="story-shade"></div><div class="story-top">
          <span>02 / INFRASTRUCTURE</span><span class="story-arrow"
            ><ArrowUpRight size={22} /></span
          >
        </div><div class="story-copy">
          <h3>Strong foundations.<br />New possibilities.</h3><p>
            Control, coordination, and execution.
          </p>
        </div></a
      >
    </div>
  </section>

  <section
    id="selected-work"
    class="selected-work section-shell"
    aria-labelledby="work-title"
  >
    <div class="section-heading">
      <div>
        <p class="section-label">
          <span class="small-cross">+</span> Selected work
        </p><h2 id="work-title">
          From possibility<br /><span>to something tangible.</span>
        </h2>
      </div>
      <p>
        Selected products and projects.<br />A closer look at what we’re
        building.
      </p>
    </div>
    <div
      class="product-tabs"
      role="tablist"
      aria-label="Explore selected products"
    >
      <button
        id="tab-atomic"
        role="tab"
        aria-selected="true"
        aria-controls="panel-atomic"
        tabindex="0"><span>01</span> Atomic <ArrowUpRight size={18} /></button
      >
      <button
        id="tab-parallax"
        role="tab"
        aria-selected="false"
        aria-controls="panel-parallax"
        tabindex="-1"
        ><span>02</span> Parallax <ArrowUpRight size={18} /></button
      >
      <button
        id="tab-synth"
        role="tab"
        aria-selected="false"
        aria-controls="panel-synth"
        tabindex="-1"><span>03</span> Synth <ArrowUpRight size={18} /></button
      >
    </div>
    <div
      id="panel-atomic"
      class="product-panel"
      role="tabpanel"
      aria-labelledby="tab-atomic"
      tabindex="0"
    >
      <div class="product-copy">
        <p class="eyebrow">
          Software creation <span>In development</span>
        </p><h3>The next idea.<br />Made tangible.</h3><p>
          Atomic turns prompts into web applications. Generate and revise
          source, preview your changes, and publish from one workspace.
        </p><a class="text-link" href="/products/atomic/"
          >Discover Atomic <ArrowUpRight size={19} /></a
        >
      </div>
      <figure class="product-visual product-visual--illustration">
        <ProductVisual product={atomic} showCaption={false} />
      </figure>
    </div>
    <div
      id="panel-parallax"
      class="product-panel"
      role="tabpanel"
      aria-labelledby="tab-parallax"
      tabindex="0"
      hidden
    >
      <div class="product-copy">
        <p class="eyebrow">
          Predictive systems <span>In development</span>
        </p><h3>A view of<br />what could follow.</h3><p>
          Parallax explores how a Kubernetes system may respond to a proposed
          change, helping teams examine possible outcomes before acting.
        </p><a class="text-link" href="/products/parallax/"
          >Discover Parallax <ArrowUpRight size={19} /></a
        >
      </div>
      <figure class="product-visual parallax-visual">
        <div class="prediction-window">
          <div class="prediction-heading">
            <span>PARALLAX</span><span>Scenario exploration</span>
          </div><h4>One change.<br />Possible futures.</h4><svg
            viewBox="0 0 520 205"
            role="img"
            aria-label="Illustrative trajectories showing possible outcomes after a proposed change"
            ><g stroke="#ffffff18"
              ><path d="M0 35H520M0 85H520M0 135H520M0 185H520"></path><path
                d="M110 0V205M230 0V205M350 0V205M470 0V205"></path></g
            ><path
              d="M0 147L40 140L77 152L110 133L150 140L185 129L215 138L250 118"
              fill="none"
              stroke="#b6cde6"
              stroke-width="2.5"></path><path
              d="M250 118C320 80 380 58 520 28L520 156C390 149 320 145 250 118Z"
              fill="#8badde20"></path><path
              d="M250 118C330 75 390 58 520 28M250 118C320 130 400 140 520 156"
              fill="none"
              stroke="#8badde"
              stroke-width="1.5"
              stroke-dasharray="4 5"></path><path
              d="M250 118C330 90 390 115 520 77"
              fill="none"
              stroke="#9ac7ff"
              stroke-width="2.5"></path><path
              d="M250 0V205"
              stroke="#ffffff55"
              stroke-dasharray="3 5"></path><circle
              cx="250"
              cy="118"
              r="5"
              fill="#e7efff"></circle></svg
          ><div class="chart-labels">
            <span>Observed context</span><span>Proposed change</span><span
              >Possible outcomes</span
            >
          </div><p>Advisory predictions. Your team decides.</p>
        </div>
        <figcaption>
          Conceptual model illustration · Not measured predictions
        </figcaption>
      </figure>
    </div>
    <div
      id="panel-synth"
      class="product-panel"
      role="tabpanel"
      aria-labelledby="tab-synth"
      tabindex="0"
      hidden
    >
      <div class="product-copy">
        <p class="eyebrow">Electronic design <span>Open source</span></p><h3>
          Hardware begins<br />with an idea.
        </h3><p>
          Synth turns text-based circuit designs into KiCad schematics, PCB
          layouts, and bills of materials. Built for engineers and AI agents.
        </p><a class="text-link" href="/products/synth/"
          >Explore Synth <ArrowUpRight size={19} /></a
        >
      </div>
      <figure class="product-visual product-visual--illustration">
        <ProductVisual product={synth} showCaption={false} />
      </figure>
    </div>
    <div class="home-work-footer">
      <p>From AI applications to the systems beneath them.</p><a
        class="text-link"
        href="#portfolio">Browse our products <ArrowRight size={19} /></a
      >
    </div>
  </section>

  <section
    id="portfolio"
    class="portfolio section-shell"
    aria-labelledby="portfolio-title"
  >
    <div class="section-heading">
      <div>
        <p class="section-label">
          <span class="small-cross">+</span> Our products
        </p><h2 id="portfolio-title">One company.<br />Many ways forward.</h2>
      </div>
      <p>
        AI applications, secure infrastructure,<br />and hardware for connected
        systems.
      </p>
    </div>
    <div class="portfolio-controls">
      <div
        class="portfolio-filters"
        role="tablist"
        aria-label="Product categories"
      >
        {
          portfolioCategories.map((category, index) => (
            <button
              id={`home-category-${category.value}`}
              data-home-category={category.value}
              role="tab"
              aria-selected={index === 0 ? "true" : "false"}
              aria-controls={`home-products-${category.value}`}
              tabindex={index === 0 ? 0 : -1}
            >
              {category.label}
            </button>
          ))
        }
      </div>
      <span id="home-product-count" aria-live="polite"
        >{String(portfolioCategories[0].products.length).padStart(2, "0")} products</span
      >
    </div>
    {
      portfolioCategories.map((category, index) => (
        <div
          id={`home-products-${category.value}`}
          role="tabpanel"
          aria-labelledby={`home-category-${category.value}`}
          hidden={index !== 0}
        >
          <ul class="home-product-list">
            {category.products.map((product) => (
              <li class="project-row">
                <a
                  class="home-product-link"
                  href={`/products/${product.slug}/`}
                >
                  <>
                    <h3>{product.name}</h3>
                    <span class="project-summary">{product.tagline}</span>
                    <span class="project-group">
                      {product.group === "AI"
                        ? "AI & applications"
                        : product.group}
                    </span>
                    <ArrowUpRight size={23} />
                  </>
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
    <div class="home-portfolio-footer">
      <a class="text-link" href="/products/"
        >Explore the full portfolio <ArrowRight size={19} /></a
      >
    </div>
  </section>

  <section id="research" class="research" aria-labelledby="research-title">
    <figure class="research-image">
      <img
        src="/preview/ai/media/engineering.webp"
        alt="Hands-on electronics work using a magnifying glass and circuit board"
        width="1600"
        height="1067"
        loading="lazy"
      /><figcaption>PRECISION IN THE DETAILS. AMBITION IN THE WORK.</figcaption>
    </figure>
    <div class="research-content">
      <p class="section-label">
        <span class="label-line"></span> RESEARCH & COLLABORATION
      </p><h2 id="research-title">
        Progress starts<br />with a better<br /><span>question.</span>
      </h2><p>
        We explore what comes next through applied research and European
        partnerships. Our work spans computation, security, and the physical
        world.
      </p><div class="research-projects">
        <a href="/research/elastic/"
          ><div>
            <span class="eyebrow">Horizon Europe · 2024–2027</span><h3>
              ELASTIC
            </h3>
          </div><ArrowUpRight size={25} /></a
        ><a href="/research/confidential6g/"
          ><div>
            <span class="eyebrow">Horizon Europe · 2023–2025</span><h3>
              CONFIDENTIAL6G
            </h3>
          </div><ArrowUpRight size={25} /></a
        >
      </div><a class="text-link" href="/research/"
        >Explore our research partnerships <ArrowRight size={18} /></a
      >
      <AssociationMembership compact />
    </div>
  </section>

  <section
    id="company"
    class="heritage section-shell"
    aria-labelledby="heritage-title"
  >
    <div class="section-heading">
      <div>
        <p class="section-label">
          <span class="small-cross">+</span> Our foundations
        </p><h2 id="heritage-title">
          Deep roots in<br />connected systems.
        </h2>
      </div><div class="heritage-description">
        <p>
          Our work in AI builds on an active portfolio of identity, messaging,
          IoT platforms, and hardware.
        </p><a class="text-link" href="/products/?focus=infrastructure"
          >Explore our connectivity portfolio <ArrowUpRight size={18} /></a
        >
      </div>
    </div>
    <EngineeringStories items={featuredStories} />
    <div class="heritage-footer">
      <a class="text-link" href="/products/magistrala/#stories">
        More Magistrala stories <ArrowRight size={19} />
      </a>
    </div>
  </section>

  <section class="contact-section" aria-labelledby="contact-title">
    <img
      class="contact-image"
      src="/preview/ai/media/paris.webp"
      alt="The repeating steel arches of Pont de Bir-Hakeim in Paris"
      width="1200"
      height="1600"
      loading="lazy"
    /><div class="contact-shade"></div><div class="contact-top">
      <p class="eyebrow light">BUILT OPENLY IN PARIS.</p><span
        >WORKING ACROSS BORDERS.</span
      >
    </div><div class="contact-bottom">
      <h2 id="contact-title">
        The next chapter<br /><span>starts with a conversation.</span>
      </h2><a
        class="contact-circle"
        href="/contact/"
        aria-label="Contact Abstract Machines"><ArrowUpRight size={45} /></a
      >
    </div>
  </section>
  <script>
    const categoryTabs = Array.from(
      document.querySelectorAll<HTMLButtonElement>("[data-home-category]"),
    );
    const portfolioCount = document.querySelector("#home-product-count");
    const activateCategory = (tab: HTMLButtonElement) => {
      categoryTabs.forEach((item) => {
        const selected = item === tab;
        item.setAttribute("aria-selected", String(selected));
        item.tabIndex = selected ? 0 : -1;
        const panel = document.getElementById(
          item.getAttribute("aria-controls") ?? "",
        );
        if (panel) {
          panel.hidden = !selected;
          if (selected && portfolioCount)
            portfolioCount.textContent = `${String(panel.querySelectorAll(".project-row").length).padStart(2, "0")} products`;
        }
      });
    };
    categoryTabs.forEach((tab, index) => {
      tab.addEventListener("click", () => activateCategory(tab));
      tab.addEventListener("keydown", (event) => {
        let next: number;
        if (event.key === "ArrowRight")
          next = (index + 1) % categoryTabs.length;
        else if (event.key === "ArrowLeft")
          next = (index + categoryTabs.length - 1) % categoryTabs.length;
        else if (event.key === "Home") next = 0;
        else if (event.key === "End") next = categoryTabs.length - 1;
        else return;
        event.preventDefault();
        activateCategory(categoryTabs[next]);
        categoryTabs[next].focus();
      });
    });
    const video = document.querySelector<HTMLVideoElement>("#hero-video");
    const videoToggle =
      document.querySelector<HTMLButtonElement>("#video-toggle");
    const progress = document.querySelector<HTMLElement>("#film-progress");
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    const saveData = (
      navigator as Navigator & { connection?: { saveData?: boolean } }
    ).connection?.saveData;
    let wantsMotion = !reducedMotion.matches && !saveData;
    let heroVisible = true;
    const playVideo = async () => {
      if (!video) return;
      const source = video.querySelector("source");
      if (source && !source.getAttribute("src")) {
        source.src = source.dataset.src ?? "";
        video.load();
      }
      try {
        await video.play();
      } catch {
        videoToggle?.classList.remove("is-playing");
      }
    };
    if (video && videoToggle) {
      videoToggle.hidden = false;
      video.addEventListener("playing", () => {
        videoToggle.classList.add("is-playing");
        videoToggle.setAttribute("aria-label", "Pause background video");
      });
      video.addEventListener("pause", () => {
        videoToggle.classList.remove("is-playing");
        videoToggle.setAttribute("aria-label", "Play background video");
      });
      video.addEventListener("timeupdate", () => {
        if (progress && Number.isFinite(video.duration))
          progress.style.width = `${(video.currentTime / video.duration) * 100}%`;
      });
      videoToggle.addEventListener("click", () => {
        wantsMotion = video.paused;
        if (wantsMotion) void playVideo();
        else video.pause();
      });
      new IntersectionObserver(
        (entries) => {
          heroVisible = entries[0].isIntersecting;
          if (!heroVisible) video.pause();
          else if (wantsMotion && !document.hidden) void playVideo();
        },
        { threshold: 0.05 },
      ).observe(video);
      document.addEventListener("visibilitychange", () => {
        if (document.hidden) video.pause();
        else if (wantsMotion && heroVisible) void playVideo();
      });
      reducedMotion.addEventListener("change", (event) => {
        if (event.matches) {
          wantsMotion = false;
          video.pause();
        }
      });
    }
    const tabs = Array.from(
      document.querySelectorAll<HTMLButtonElement>(
        '#selected-work [role="tab"]',
      ),
    );
    const activateTab = (tab: HTMLButtonElement) => {
      tabs.forEach((item) => {
        const selected = item === tab;
        item.setAttribute("aria-selected", String(selected));
        item.tabIndex = selected ? 0 : -1;
        const panel = document.getElementById(
          item.getAttribute("aria-controls") ?? "",
        );
        if (panel) panel.hidden = !selected;
      });
    };
    tabs.forEach((tab, index) => {
      tab.addEventListener("click", () => activateTab(tab));
      tab.addEventListener("keydown", (event) => {
        let next: number;
        if (event.key === "ArrowRight") next = (index + 1) % tabs.length;
        else if (event.key === "ArrowLeft")
          next = (index + tabs.length - 1) % tabs.length;
        else if (event.key === "Home") next = 0;
        else if (event.key === "End") next = tabs.length - 1;
        else return;
        event.preventDefault();
        activateTab(tabs[next]);
        tabs[next].focus();
      });
    });
  </script>
</IdentityLayout>
