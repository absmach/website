---
import { ArrowRight, ArrowUpRight } from "@lucide/astro";
import IdentityLayout from "../layouts/IdentityLayout.astro";
import Faq from "../components/identity/Faq.astro";
import "../styles/identity-editorial.css";
import "../styles/identity-pages.css";

const layers = [
  {
    name: "Device and sensor layer",
    desc: "Physical endpoints: PLCs, RTUs, sensors, meters, actuators, and embedded modules. Devices communicate over field protocols (Modbus, OPC-UA, Wireless M-Bus, BACnet) or directly over IP (MQTT, CoAP, HTTP).",
    products: [],
    keywords: [
      "microcontrollers",
      "PLCs",
      "RTUs",
      "sensors",
      "Modbus",
      "OPC-UA",
    ],
  },
  {
    name: "Connectivity and edge gateway layer",
    desc: "Edge gateways aggregate device traffic, translate protocols, and act as the first hop toward the cloud. They run local logic to reduce bandwidth, filter noise, and operate offline when connectivity is lost.",
    products: [
      {
        name: "A0 Gateway",
        href: "/products/a0/",
        desc: "ESP32-C6 RISC-V module with six native radios",
      },
      {
        name: "A1 Gateway",
        href: "/products/a1/",
        desc: "RISC-V Linux gateway for heavier workloads",
      },
    ],
    keywords: [
      "protocol gateway",
      "edge computing",
      "protocol translation",
      "offline operation",
    ],
  },
  {
    name: "Message broker and transport layer",
    desc: "The message broker decouples device producers from platform consumers. MQTT is the dominant protocol for constrained devices; AMQP bridges enterprise services. High-availability brokers with durable queues prevent data loss during outages.",
    products: [
      {
        name: "FluxMQ",
        href: "/products/fluxmq/",
        desc: "Enterprise MQTT 5.0 and AMQP broker with built-in clustering",
      },
    ],
    keywords: [
      "MQTT broker",
      "message queue",
      "AMQP",
      "publish-subscribe",
      "QoS",
    ],
  },
  {
    name: "IoT platform and device management layer",
    desc: "The platform manages device identity, telemetry ingestion, rules processing, dashboards, and multi-tenant access control. It is the operational core that operators interact with daily.",
    products: [
      {
        name: "Magistrala",
        href: "/products/magistrala/",
        desc: "Open-source IoT platform with RBAC, dashboards, and a rules engine",
      },
    ],
    keywords: [
      "device management",
      "telemetry",
      "dashboards",
      "rules engine",
      "multi-tenancy",
    ],
  },
  {
    name: "Identity and authorization layer",
    desc: "Every device, user, and service must be authenticated and authorized before accessing resources. Runtime policy evaluation prevents the stale-permission windows that occur when permissions are embedded in tokens.",
    products: [
      {
        name: "Atom",
        href: "/products/atom/",
        desc: "Open-source IAM with runtime RBAC and ABAC for IoT",
      },
    ],
    keywords: [
      "device identity",
      "IAM",
      "RBAC",
      "ABAC",
      "JWT",
      "authorization",
    ],
  },
  {
    name: "Edge compute and orchestration layer",
    desc: "WebAssembly workloads can be deployed and updated remotely on both cloud nodes and microcontrollers. This layer enables AI inference, data transformation, and protocol bridging at the edge without firmware reflashing.",
    products: [
      {
        name: "Propeller",
        href: "/products/propeller/",
        desc: "WebAssembly edge orchestrator, from cloud to microcontroller",
      },
    ],
    keywords: [
      "WebAssembly",
      "edge AI",
      "FaaS",
      "OTA updates",
      "Wasm orchestration",
    ],
  },
  {
    name: "Security and cryptography layer",
    desc: "Long-lived IoT devices must remain secure after classical PKI is broken by quantum computers. Hardware-accelerated post-quantum cryptography provides forward-secure device identity that outlives the deployment lifetime.",
    products: [
      {
        name: "Quarc",
        href: "/products/quarc/",
        desc: "Post-quantum secure element with ML-KEM and ML-DSA",
      },
    ],
    keywords: [
      "post-quantum cryptography",
      "secure element",
      "hardware root of trust",
      "ML-KEM",
      "ML-DSA",
    ],
  },
];

const stack = [
  {
    label: "Applications and dashboards",
    product: "Magistrala",
    href: "/products/magistrala/",
    desc: "visual dashboards, alarm management, reports, rules engine",
  },
  {
    label: "Device management and platform",
    product: "Magistrala",
    href: "/products/magistrala/",
    desc: "device provisioning, channel management, multi-tenancy, SDKs",
  },
  {
    label: "Identity and authorization",
    product: "Atom",
    href: "/products/atom/",
    desc: "runtime RBAC and ABAC, JWT, OIDC, device credentials, policy engine",
  },
  {
    label: "Message transport",
    product: "FluxMQ",
    href: "/products/fluxmq/",
    desc: "MQTT 5.0, AMQP, CoAP, durable queues, 500K+ connections per node",
  },
  {
    label: "Edge compute and orchestration",
    product: "Propeller",
    href: "/products/propeller/",
    desc: "WebAssembly orchestrator, OCI registry, FaaS at the edge, Zephyr support",
  },
  {
    label: "Edge gateway (Linux)",
    product: "A1 Gateway",
    href: "/products/a1/",
    desc: "RISC-V Linux, containers, Wasm, manufactured in the EU",
  },
  {
    label: "Edge gateway (RTOS / MCU)",
    product: "A0 Gateway",
    href: "/products/a0/",
    desc: "ESP32-C6 RISC-V, Zephyr, Wi-Fi 6, BLE, 802.15.4, Wireless M-Bus, NB-IoT/LTE-M and sub-GHz modules",
  },
  {
    label: "Hardware security",
    product: "Quarc",
    href: "/products/quarc/",
    desc: "post-quantum secure element, ML-KEM-768, ML-DSA-65, hardware root of trust",
  },
];

const protocols = [
  {
    name: "MQTT",
    full: "Message Queuing Telemetry Transport",
    version: "3.1.1 / 5.0",
    use: "Primary IoT telemetry protocol. Lightweight publish-subscribe with QoS 0/1/2, retained messages, and Last Will. MQTT 5.0 adds shared subscriptions, flow control, and user properties.",
    transport: "TCP / WebSocket",
  },
  {
    name: "AMQP",
    full: "Advanced Message Queuing Protocol",
    version: "0.9.1 / 1.0",
    use: "Enterprise message queuing. Used for integrating IoT data streams with ERP, MES, and cloud services. Supports transactions, routing topologies, and dead-letter queues.",
    transport: "TCP",
  },
  {
    name: "CoAP",
    full: "Constrained Application Protocol",
    version: "RFC 7252",
    use: "REST-like protocol optimised for constrained devices with limited bandwidth. Runs over UDP and includes DTLS for security. Common in smart metering and sensor networks.",
    transport: "UDP / DTLS",
  },
  {
    name: "OPC-UA",
    full: "Open Platform Communications Unified Architecture",
    version: null,
    use: "Industrial automation standard for PLC and SCADA integration. Rich information model, complex address space, and built-in security. Common in manufacturing and process control.",
    transport: "TCP / WebSocket",
  },
  {
    name: "Modbus",
    full: "Modbus RTU / TCP",
    version: null,
    use: "Ubiquitous serial protocol in industrial automation. Runs over RS-485 (RTU) or Ethernet (TCP). No built-in security, so remote access requires gateway-level encryption.",
    transport: "RS-485 / TCP",
  },
  {
    name: "Wireless M-Bus",
    full: "EN 13757",
    version: "868 MHz",
    use: "European standard for wireless utility meter reading. Used for smart metering of electricity, gas, heat, and water. Operates at 868 MHz sub-GHz for range and wall penetration.",
    transport: "868 MHz RF",
  },
];

const edge = [
  "Control loops require sub-100ms response times, and cloud round-trips introduce too much latency",
  "Devices operate in locations with intermittent connectivity, so local processing must continue offline",
  "Data volume is high but only aggregates or anomalies are relevant to the cloud",
  "Data sovereignty or regulatory requirements restrict transmission of raw device data off-premises",
  "AI inference must run close to the sensor to be actionable, such as vision or predictive maintenance",
];
const cloud = [
  "Long-term storage and historical analysis are the primary use case, where cloud storage is cheaper and more scalable",
  "Cross-site correlation is needed, aggregating data from hundreds of sites for fleet-level analytics",
  "Heavy machine-learning training runs require GPU resources not available at the edge",
  "Compliance reporting and audit trails must be tamper-proof and centrally managed",
  "Dashboards and alerting are accessed by operators from anywhere",
];

const security = [
  {
    title: "Device identity",
    desc: "Every device needs a unique cryptographic identity issued at manufacture or provisioning. Device certificates or API keys authenticate the device to the message broker and platform. When a device is decommissioned, its credentials must be revoked and access blocked immediately. Runtime policy evaluation, rather than token-embedded permissions, guarantees this.",
    link: { href: "/products/atom/", label: "Atom, runtime IAM" },
  },
  {
    title: "Transport security",
    desc: "All device-to-broker and broker-to-platform communication should be encrypted: TLS 1.2+ for MQTT and HTTPS, mTLS for inter-service communication, DTLS for CoAP over UDP. For constrained devices where TLS is too heavy, lighter alternatives exist but increase risk; the gateway should terminate TLS on behalf of downstream devices.",
  },
  {
    title: "Secure boot and OTA updates",
    desc: "Firmware must be signed and the signature verified at boot before execution. OTA updates must be delivered over authenticated, encrypted channels and include rollback protection. A failed update must not brick the device or leave it in an unknown state.",
    link: {
      href: "/products/quarc/",
      label: "Quarc, hardware-enforced secure boot",
    },
  },
  {
    title: "Post-quantum preparedness",
    desc: "Industrial devices deployed today may still be in the field when quantum computers can break ECC and RSA. NIST finalised post-quantum cryptography standards in 2024 (FIPS 203, 204, 205). New designs should evaluate ML-KEM for key encapsulation and ML-DSA for signatures, especially for devices with 10+ year deployment lifetimes.",
    link: { href: "/products/quarc/", label: "Quarc, PQC secure element" },
  },
];

const products = [
  {
    name: "Magistrala",
    layer: "IoT platform",
    href: "/products/magistrala/",
    desc: "Multi-protocol IoT platform with device management, visual dashboards, a rules engine, and RBAC.",
  },
  {
    name: "FluxMQ",
    layer: "Message broker",
    href: "/products/fluxmq/",
    desc: "Enterprise MQTT 5.0 and AMQP broker. Clustering, durable queues, 500K+ connections per node.",
  },
  {
    name: "Atom",
    layer: "Identity and authorization",
    href: "/products/atom/",
    desc: "Runtime RBAC and ABAC for IoT. Single Rust binary, PostgreSQL-backed, live policy evaluation.",
  },
  {
    name: "Propeller",
    layer: "Edge compute",
    href: "/products/propeller/",
    desc: "WebAssembly orchestrator from cloud to Zephyr RTOS microcontrollers. OCI registry, FaaS at the edge.",
  },
  {
    name: "A1 Gateway",
    layer: "Linux edge gateway",
    href: "/products/a1/",
    desc: "RISC-V Linux gateway for industrial IoT. Containers, Wasm, and manufactured in the EU.",
  },
  {
    name: "A0 Gateway",
    layer: "RTOS edge module",
    href: "/products/a0/",
    desc: "ESP32-C6 RISC-V with six native radios: Wi-Fi 6, BLE, NB-IoT, Wireless M-Bus, Thread, Ethernet.",
  },
  {
    name: "Quarc",
    layer: "PQC secure element",
    href: "/products/quarc/",
    desc: "Post-quantum cryptography secure element. Hardware-accelerated ML-KEM-768 and ML-DSA-65.",
  },
];

const faqs = [
  {
    q: "What is IIoT platform architecture?",
    a: "IIoT platform architecture describes how industrial IoT systems are structured: the layers, components, and protocols that connect physical devices to cloud applications. A typical architecture includes device and sensor layers, edge gateways, message brokers, an IoT platform for device management and dashboards, an identity and authorization layer, and optional edge compute and cryptography layers.",
  },
  {
    q: "What is the difference between IoT and IIoT?",
    a: "IoT (Internet of Things) is the broad category of connected devices: consumer electronics, smart home devices, wearables. IIoT (Industrial Internet of Things) specifically refers to connected devices in industrial contexts such as manufacturing, energy, utilities, transportation, and infrastructure. IIoT systems typically have higher reliability requirements, longer device lifetimes, and stricter security and compliance needs.",
  },
  {
    q: "Why is MQTT the dominant protocol for IIoT?",
    a: "MQTT was designed for constrained devices over unreliable networks. Its publish-subscribe model decouples producers from consumers. Quality of Service levels (0/1/2) provide flexible delivery guarantees. It runs over TCP with minimal overhead, making it suitable for everything from microcontrollers to cloud-scale brokers. MQTT 5.0 adds features like shared subscriptions, topic aliases, and enhanced authentication that enterprise deployments need.",
  },
  {
    q: "What is an IoT gateway and do I need one?",
    a: "An IoT gateway is a device that aggregates data from local sensors and field devices and forwards it to a cloud platform. Gateways are necessary when field devices speak non-IP protocols (Modbus, Wireless M-Bus, Bluetooth), when local processing or offline buffering is required, or when you want to reduce cloud bandwidth by aggregating and filtering data at the edge. For devices with native IP and MQTT support, a gateway is optional.",
  },
  {
    q: "How does edge computing fit into IIoT architecture?",
    a: "Edge computing moves processing from the cloud to the device or gateway. In IIoT this reduces latency for time-critical control loops, lowers cloud bandwidth costs, and enables operation during cloud connectivity loss. Edge compute layers typically run lightweight runtimes such as containers, WebAssembly, or native binaries on gateway hardware. WebAssembly is increasingly used because it provides sandboxed isolation, sub-10ms startup, and portability from cloud servers down to microcontrollers.",
  },
  {
    q: "What is a message broker in IIoT architecture?",
    a: "A message broker is the central routing component for device telemetry. Devices publish messages to topics; platform services subscribe to those topics. The broker decouples producers from consumers, handles delivery guarantees (QoS), and can buffer messages during downstream failures. In enterprise IIoT, brokers also provide durable queues with consumer groups so multiple downstream services can consume the same data stream independently.",
  },
  {
    q: "How should IoT device identity be managed?",
    a: "Each device needs a unique cryptographic identity, typically a certificate or API key associated with a device record in the platform. That identity controls which topics the device can publish and subscribe to. Runtime policy evaluation, rather than token-embedded permissions, ensures that when a device is decommissioned or its credentials are revoked, access is blocked immediately without waiting for tokens to expire.",
  },
  {
    q: "Why does post-quantum cryptography matter for IIoT now?",
    a: "Industrial devices deployed today often remain in the field for 10 to 20 years. Quantum computers capable of breaking ECC and RSA are projected to become practical within that window. NIST finalised post-quantum cryptography standards in 2024. EU and US regulators project mandatory PQC adoption in critical infrastructure by 2030. Devices that ship now with only classical cryptography will be vulnerable before end-of-life.",
  },
];

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map(({ q, a }) => ({
      "@type": "Question",
      name: q,
      acceptedAnswer: { "@type": "Answer", text: a },
    })),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Home",
        item: "https://www.absmach.eu/",
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "IIoT Platform Architecture",
        item: "https://www.absmach.eu/iiot-platform-architecture/",
      },
    ],
  },
];
---

<IdentityLayout
  title="IIoT platform architecture explained"
  description="A complete guide to Industrial IoT platform architecture. Understand the device, connectivity, message broker, platform, identity, edge compute, and security layers, with protocol comparisons and open-source implementation examples."
  active="work"
>
  <Fragment slot="head">
    {
      structuredData.map((entry) => (
        <script type="application/ld+json" set:html={JSON.stringify(entry)} />
      ))
    }
  </Fragment>

  <section class="ip-hero" aria-labelledby="guide-title">
    <nav class="is-breadcrumb" aria-label="Breadcrumb">
      <a href="/">Abstract Machines</a><span>/</span><a href="/products/"
        >Our work</a
      ><span>/</span> IIoT architecture guide
    </nav>
    <div class="ip-hero-grid">
      <div>
        <p class="ie-eyebrow">Guide / Industrial IoT</p>
        <h1 id="guide-title">
          IIoT platform<br /><span>architecture.</span>
        </h1>
      </div>
      <div class="ip-hero-aside">
        <p>
          A practical guide to how industrial IoT systems are structured, from
          sensor to cloud, including the layers, the protocols, edge computing,
          device identity, and post-quantum security.
        </p>
        <div class="ip-hero-actions">
          <a class="ie-button ie-button-white" href="#layers"
            >Start with the layers <ArrowRight size={19} /></a
          ><a class="text-link" href="#stack"
            >See the open-source stack <ArrowRight size={18} /></a
          >
        </div>
      </div>
    </div>
  </section>

  <section class="ip-section ip-section--tight" aria-label="Definition">
    <div class="ip-note">
      <h2>What is IIoT platform architecture?</h2>
      <p>
        IIoT platform architecture describes how industrial IoT systems are
        structured across multiple layers: physical devices and sensors, edge
        gateways for local processing, a message broker for telemetry transport,
        a central IoT platform for device management and dashboards, and
        identity and security layers. Each layer has defined responsibilities,
        protocols, and scaling characteristics.
      </p>
    </div>
  </section>

  <section id="layers" class="ip-section" aria-labelledby="layers-title">
    <div class="ip-heading">
      <div>
        <p class="ie-eyebrow">Architecture</p>
        <h2 id="layers-title">
          The seven layers<br /><span>of an IIoT platform.</span>
        </h2>
      </div>
      <p>
        Industrial IoT systems are built from distinct functional layers.
        Understanding each layer’s role helps you choose the right components
        and avoid common design pitfalls.
      </p>
    </div>
    <div class="ip-layers">
      {
        layers.map((layer, i) => (
          <article class="ip-layer">
            <span class="ie-number">{String(i + 1).padStart(2, "0")}</span>
            <div>
              <h3>{layer.name}</h3>
              <p>{layer.desc}</p>
              <div class="ip-tags">
                {layer.keywords.map((keyword) => (
                  <span>{keyword}</span>
                ))}
              </div>
              {layer.products.length > 0 && (
                <div class="ip-layer-products">
                  <span class="ip-kicker">From Abstract Machines</span>
                  {layer.products.map((product) => (
                    <a href={product.href}>
                      <strong>{product.name}</strong>: {product.desc}
                    </a>
                  ))}
                </div>
              )}
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section
    id="stack"
    class="ip-section ip-section--soft"
    aria-labelledby="stack-title"
  >
    <div class="ip-heading">
      <div>
        <p class="ie-eyebrow">Stack overview</p>
        <h2 id="stack-title">
          How our stack maps<br /><span>to each layer.</span>
        </h2>
      </div>
      <p>
        Each product addresses a specific architectural layer. They can be
        deployed individually or as an integrated stack.
      </p>
    </div>
    <div class="ip-stack">
      {
        stack.map((row) => (
          <div class="ip-stack-row">
            <span class="ip-kicker">{row.label}</span>
            <p>
              <a href={row.href}>{row.product}</a>: {row.desc}
            </p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="ip-section" aria-labelledby="protocols-title">
    <div class="ip-heading">
      <div>
        <p class="ie-eyebrow">Protocols</p>
        <h2 id="protocols-title">
          Which protocol,<br /><span>and when.</span>
        </h2>
      </div>
      <p>
        Protocol selection depends on device constraints, network conditions,
        data volume, and integration requirements. Most production deployments
        use several.
      </p>
    </div>
    <div class="ip-grid ip-grid-3">
      {
        protocols.map((protocol) => (
          <article class="ip-card">
            <div class="ip-card-top">
              <span class="ip-kicker">{protocol.transport}</span>
              {protocol.version && (
                <span class="ip-kicker">{protocol.version}</span>
              )}
            </div>
            <h3>{protocol.name}</h3>
            <p class="ip-kicker" style="margin-top: 6px;">
              {protocol.full}
            </p>
            <p>{protocol.use}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="ip-section ip-section--soft" aria-labelledby="edge-title">
    <div class="ip-heading">
      <div>
        <p class="ie-eyebrow">Design decisions</p>
        <h2 id="edge-title">Edge or cloud<br /><span>processing?</span></h2>
      </div>
      <p>
        Where data is processed has significant implications for latency,
        bandwidth costs, offline resilience, and security.
      </p>
    </div>
    <div class="ip-grid ip-grid-2">
      <article class="ip-card">
        <h3>Process at the edge when</h3>
        <ul class="ip-list" style="margin-top: 20px;">
          {edge.map((item) => <li>{item}</li>)}
        </ul>
      </article>
      <article class="ip-card">
        <h3>Process in the cloud when</h3>
        <ul class="ip-list" style="margin-top: 20px;">
          {cloud.map((item) => <li>{item}</li>)}
        </ul>
      </article>
    </div>
  </section>

  <section class="ip-section" aria-labelledby="security-title">
    <div class="ip-heading">
      <div>
        <p class="ie-eyebrow">Security</p>
        <h2 id="security-title">
          IIoT security<br /><span>architecture.</span>
        </h2>
      </div>
      <p>
        Industrial IoT systems have distinct security requirements. Devices are
        long-lived, operate in physical environments, and often control critical
        infrastructure.
      </p>
    </div>
    <div class="ip-grid ip-grid-2">
      {
        security.map((item) => (
          <article class="ip-card">
            <h3>{item.title}</h3>
            <p>{item.desc}</p>
            {item.link && (
              <a class="text-link" href={item.link.href}>
                {item.link.label} <ArrowRight size={16} />
              </a>
            )}
          </article>
        ))
      }
    </div>
  </section>

  <section class="ip-section ip-section--soft" aria-labelledby="faq-title">
    <div class="ip-heading">
      <div>
        <p class="ie-eyebrow">FAQ</p>
        <h2 id="faq-title">Common questions.</h2>
      </div>
    </div>
    <Faq items={faqs} />
  </section>

  <section class="ip-section" aria-labelledby="products-title">
    <div class="ip-heading">
      <div>
        <p class="ie-eyebrow">Abstract Machines products</p>
        <h2 id="products-title">
          Open-source components<br /><span>for every layer.</span>
        </h2>
      </div>
      <a class="text-link" href="/products/"
        >Explore all our work <ArrowUpRight size={18} /></a
      >
    </div>
    <div class="ip-grid ip-grid-4">
      {
        products.map((product) => (
          <a class="ip-card" href={product.href}>
            <div class="ip-card-top">
              <span class="ip-kicker">{product.layer}</span>
              <ArrowUpRight size={20} />
            </div>
            <h3>{product.name}</h3>
            <p>{product.desc}</p>
          </a>
        ))
      }
    </div>
  </section>

  <section class="ip-cta" aria-labelledby="guide-cta-title">
    <div>
      <p class="ie-eyebrow">Your next step</p>
      <h2 id="guide-cta-title">
        Designing an<br /><span>industrial system?</span>
      </h2>
    </div>
    <div>
      <p>
        Tell us about the devices, the data, and the constraints. We will help
        you choose the right layers and components.
      </p>
      <div class="ip-actions">
        <a class="ie-button ie-button-white" href="/contact/"
          >Start a conversation <ArrowUpRight size={19} /></a
        ><a class="text-link" href="/services/"
          >Engineering services <ArrowRight size={18} /></a
        >
      </div>
    </div>
  </section>
</IdentityLayout>
