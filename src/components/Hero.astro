---

---

<section class="hero-asym has-video">
  <video
    class="hero-bg-video"
    autoplay
    muted
    loop
    playsinline
    preload="metadata"
    poster="/video/hero-background-poster.webp"
    aria-hidden="true"
  >
    <source src="/video/hero-background.webm" type="video/webm" />
    <source src="/video/hero-background.mp4" type="video/mp4" />
  </video>
  <div class="container-wide">
    <div class="grid">
      <div class="stack stack-lg">
        <span class="kicker">Paris · Open Source · Since 2023</span>
        <h1 class="h-display">Unified stack for secure IoT.</h1>
        <p class="lede">
          One secure, open-source platform covering messaging, device
          management, edge orchestration, and hardware - everything you need to
          build and operate IoT and Industrial systems end to end.
        </p>
        <div class="btn-row">
          <a href="/products" class="btn btn-primary"
            >Explore products <span aria-hidden="true">→</span></a
          >
          <a
            href="https://github.com/absmach"
            class="btn"
            target="_blank"
            rel="noopener noreferrer"
            >GitHub <span aria-hidden="true">↗</span></a
          >
        </div>
      </div>

      <div class="product-stack" aria-label="Product architecture stack">
        <span class="ps-mark ps-tl" aria-hidden="true"></span>
        <span class="ps-mark ps-tr" aria-hidden="true"></span>
        <span class="ps-mark ps-bl" aria-hidden="true"></span>
        <span class="ps-mark ps-br" aria-hidden="true"></span>
        <a href="/products/fluxmq" class="ps-cell ps-span ps-last ps-fluxmq">
          <span class="ps-name">FluxMQ</span>
          <span class="ps-tag">Multiprotocol Message Broker</span>
        </a>
        <a href="/products/magistrala" class="ps-cell ps-span ps-magistrala">
          <span class="ps-name">Magistrala</span>
          <span class="ps-tag">IoT Platform</span>
        </a>
        <a href="/products/propeller" class="ps-cell ps-span ps-propeller">
          <span class="ps-name">Propeller</span>
          <span class="ps-tag">Edge Orchestrator</span>
        </a>
        <a href="/products/s0" class="ps-cell ps-s0">
          <span class="ps-name">S0</span>
          <span class="ps-tag">Zephyr RTOS gateway</span>
        </a>
        <a href="/products/s1" class="ps-cell ps-s1">
          <span class="ps-name">S1</span>
          <span class="ps-tag">Linux gateway</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  /* ─── Keyframes ────────────────────────────────────────────────── */

  @keyframes cellFlyIn {
    from {
      opacity: 0;
      transform: var(--fly-from, translate(0, 30px));
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes cellBorderReveal {
    from {
      border-color: transparent;
    }
    to {
      border-color: rgba(7, 55, 99, 0.2);
    }
  }

  @keyframes containerReveal {
    to {
      border-color: rgba(7, 55, 99, 0.25);
    }
  }

  @keyframes markReveal {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  /* step 1: flash bright, step 2: settle to featured state */
  @keyframes magistralaHighlight {
    0% {
      background: rgba(7, 55, 99, 0.04);
      box-shadow: none;
    }
    45% {
      background: rgba(7, 55, 99, 0.14);
      box-shadow: inset 0 0 0 1px rgba(7, 55, 99, 0.35);
    }
    100% {
      background: rgba(7, 55, 99, 0.08);
      box-shadow: inset 0 0 0 1px rgba(7, 55, 99, 0.22);
    }
  }

  /* slow breathing glow after the highlight settles */
  @keyframes magistralaPulse {
    0%,
    100% {
      box-shadow: inset 0 0 0 1px rgba(7, 55, 99, 0.18);
    }
    50% {
      box-shadow: inset 0 0 0 1px rgba(7, 55, 99, 0.36);
    }
  }

  /* ─── Container ────────────────────────────────────────────────── */

  .product-stack {
    display: grid;
    grid-template-columns: 1fr 1fr;
    position: relative;
    border: 1px solid transparent;
    animation: containerReveal 0.5s ease-out 1.25s forwards;
  }

  /* ─── Cells (shared base) ──────────────────────────────────────── */

  .ps-cell {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 26px 28px;
    min-height: 120px;
    border-bottom: 1px solid transparent;
    background: rgba(7, 55, 99, 0.04);
    /* fly-in + border reveal — delays overridden per cell below */
    animation:
      cellFlyIn 1s cubic-bezier(0.25, 1, 0.5, 1) both,
      cellBorderReveal 0.35s ease-out both;
    transition: background 0.2s ease;
  }
  .ps-cell:hover {
    background: rgba(7, 55, 99, 0.08);
    cursor: pointer;
  }
  .ps-cell:hover .ps-name {
    color: var(--ink);
  }
  .ps-cell:focus-visible {
    outline: 2px solid rgba(7, 55, 99, 0.5);
    outline-offset: -2px;
  }
  .ps-cell.ps-span {
    grid-column: 1 / -1;
  }
  .ps-cell.ps-s0 {
    border-right: 1px solid transparent;
  }
  .ps-cell.ps-last {
    border-bottom: none;
  }

  /* ─── Per-cell fly directions & stagger ───────────────────────── */

  /* Propeller drops in from above */
  .ps-propeller {
    --fly-from: translate(-25px, -70px);
    animation-delay: 0s, 0.9s;
  }

  /* S0 slides in from the left, S1 from the right — simultaneous */
  .ps-s0 {
    --fly-from: translate(-80px, 0px);
    animation:
      cellFlyIn 1s cubic-bezier(0.25, 1, 0.5, 1) 0.12s both,
      cellBorderReveal 0.35s ease-out 1s both;
  }
  .ps-s1 {
    --fly-from: translate(80px, 0px);
    animation-delay: 0.12s, 1s;
  }

  /* Magistrala rises from below-right, then gets highlighted */
  .ps-magistrala {
    --fly-from: translate(25px, 55px);
    animation:
      cellFlyIn 1s cubic-bezier(0.25, 1, 0.5, 1) 0.24s both,
      cellBorderReveal 0.35s ease-out 1.1s both,
      magistralaHighlight 0.75s ease-in-out 1.65s forwards,
      magistralaPulse 3.5s ease-in-out 2.45s infinite;
  }

  /* FluxMQ rises from directly below */
  .ps-fluxmq {
    --fly-from: translate(0px, 80px);
    animation-delay: 0.38s, 1.2s;
  }

  /* ─── Typography ───────────────────────────────────────────────── */

  .ps-name {
    font-family: "Montserrat", sans-serif;
    font-weight: 600;
    font-size: 22px;
    color: var(--ink);
    letter-spacing: 0;
  }

  .ps-tag {
    align-self: flex-end;
    font-family: "JetBrains Mono", monospace;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.13em;
    color: var(--ink-3);
    padding: 4px 11px;
    border: 1px solid var(--line-2);
    border-radius: 999px;
    white-space: nowrap;
  }

  /* ─── Corner marks ─────────────────────────────────────────────── */

  .ps-mark {
    position: absolute;
    width: 0;
    height: 0;
    pointer-events: none;
    animation: markReveal 0.4s ease-out 1.35s both;
  }
  .ps-mark::before,
  .ps-mark::after {
    content: "";
    position: absolute;
    background: rgba(7, 55, 99, 0.25);
  }
  .ps-mark::before {
    width: 1px;
    height: 18px;
  }
  .ps-mark::after {
    height: 1px;
    width: 18px;
  }

  .ps-tl {
    top: 0;
    left: 0;
  }
  .ps-tl::before {
    top: -18px;
    left: -1px;
  }
  .ps-tl::after {
    top: -1px;
    left: -18px;
  }

  .ps-tr {
    top: 0;
    right: 0;
  }
  .ps-tr::before {
    top: -18px;
    right: -1px;
  }
  .ps-tr::after {
    top: -1px;
    right: -18px;
  }

  .ps-bl {
    bottom: 0;
    left: 0;
  }
  .ps-bl::before {
    bottom: -18px;
    left: -1px;
  }
  .ps-bl::after {
    bottom: -1px;
    left: -18px;
  }

  .ps-br {
    bottom: 0;
    right: 0;
  }
  .ps-br::before {
    bottom: -18px;
    right: -1px;
  }
  .ps-br::after {
    bottom: -1px;
    right: -18px;
  }

  /* ─── Row-divider edge ticks ───────────────────────────────────── */

  .ps-cell.ps-span:not(.ps-last)::before,
  .ps-cell.ps-s0::before {
    content: "";
    position: absolute;
    bottom: -1px;
    left: -18px;
    width: 18px;
    height: 1px;
    background: rgba(7, 55, 99, 0.25);
  }
  .ps-cell.ps-span:not(.ps-last)::after,
  .ps-cell.ps-s1::after {
    content: "";
    position: absolute;
    bottom: -1px;
    right: -18px;
    width: 18px;
    height: 1px;
    background: rgba(7, 55, 99, 0.25);
  }

  /* ─── Reduced motion ────────────────────────────────────────────── */

  @media (prefers-reduced-motion: reduce) {
    .ps-cell,
    .ps-mark,
    .product-stack {
      animation: none;
    }
    .product-stack {
      border-color: rgba(7, 55, 99, 0.25);
    }
    .ps-cell {
      border-bottom-color: rgba(7, 55, 99, 0.2);
      opacity: 1;
      transform: none;
    }
    .ps-s0 {
      border-right-color: rgba(7, 55, 99, 0.2);
    }
    .ps-magistrala {
      background: rgba(7, 55, 99, 0.08);
      box-shadow: inset 0 0 0 1px rgba(7, 55, 99, 0.22);
    }
  }

  @media (max-width: 640px) {
    .product-stack {
      display: none;
    }
  }
</style>
